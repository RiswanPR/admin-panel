<div class="container-fluid mt-4 mb-5">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="/teacher/announcements">Announcements</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Post</li>
                </ol>
            </nav>
            <h2 class="fw-bold m-0" style="color:var(--brand);">
                <i class="fa-solid fa-bullhorn me-2"></i> Post Announcement
            </h2>
            <small class="text-muted">Broadcast updates to students in your assigned courses and learning spaces</small>
        </div>

        <a href="/teacher/announcements" class="btn btn-outline-secondary px-4">
            <i class="fa-solid fa-arrow-left me-2"></i> Back to List
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card p-4 p-md-5">

                <form action="/teacher/announcements/create" method="POST" id="teacherAnnouncementForm" onsubmit="return validateTeacherForm(event)">

                    <!-- TITLE -->
                    <div class="mb-4">
                        <label for="announcementTitle" class="form-label fw-bold">
                            Title <span class="text-danger">*</span>
                        </label>
                        <input type="text" class="form-control form-control-lg" id="announcementTitle" name="title" placeholder="e.g., Assignment 3 submission deadline extended" required maxlength="200">
                    </div>

                    <!-- ROW: TYPE & PRIORITY -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label for="announcementType" class="form-label fw-bold">Type <span class="text-danger">*</span></label>
                            <select class="form-select" id="announcementType" name="type">
                                <option value="general" selected>General</option>
                                <option value="course">Course Notice</option>
                                <option value="learning_space">Learning Space Notice</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label for="announcementPriority" class="form-label fw-bold">Priority <span class="text-danger">*</span></label>
                            <select class="form-select" id="announcementPriority" name="priority">
                                <option value="normal" selected>Normal</option>
                                <option value="important">Important</option>
                            </select>
                        </div>
                    </div>

                    <!-- TARGET AUDIENCE (SCOPED) -->
                    <div class="mb-4">
                        <label for="targetType" class="form-label fw-bold">Target Audience <span class="text-danger">*</span></label>
                        <select class="form-select" id="targetType" name="targetType" onchange="handleTargetChange()">
                            <option value="course" selected>Students in Assigned Course</option>
                            <option value="learning_space">Members of Assigned Learning Space</option>
                        </select>
                    </div>

                    <!-- COURSE SELECTOR -->
                    <div class="mb-4" id="courseSelectorWrap">
                        <label for="courseId" class="form-label fw-bold">Select Course <span class="text-danger">*</span></label>
                        <select class="form-select" id="courseId" name="courseId">
                            <option value="">-- Choose Assigned Course --</option>
                            {{#each courses}}
                            <option value="{{this._id}}">{{this.name}}</option>
                            {{/each}}
                        </select>
                    </div>

                    <!-- LEARNING SPACE SELECTOR -->
                    <div class="mb-4" id="spaceSelectorWrap" style="display: none;">
                        <label for="learningSpaceId" class="form-label fw-bold">Select Learning Space <span class="text-danger">*</span></label>
                        <select class="form-select" id="learningSpaceId" name="learningSpaceId">
                            <option value="">-- Choose Assigned Space --</option>
                            {{#each spaces}}
                            <option value="{{this._id}}">{{this.name}} ({{this.code}})</option>
                            {{/each}}
                        </select>
                    </div>

                    <!-- MESSAGE -->
                    <div class="mb-4">
                        <label for="announcementMessage" class="form-label fw-bold">Message Content <span class="text-danger">*</span></label>
                        <textarea class="form-control" id="announcementMessage" name="message" rows="6" placeholder="Write your announcement content..." required></textarea>
                        <small class="text-muted">Basic formatting tags (b, i, u, a, p) are supported.</small>
                    </div>

                    <!-- PUBLISH OR DRAFT -->
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 pt-3 border-top">
                        <div class="d-flex align-items-center gap-3">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="publishNow" id="statusDraft" value="false" checked>
                                <label class="form-check-label" for="statusDraft">Save as Draft</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="publishNow" id="statusPublish" value="true">
                                <label class="form-check-label fw-bold text-success" for="statusPublish">Publish Immediately</label>
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <a href="/teacher/announcements" class="btn btn-light px-4">Cancel</a>
                            <button type="submit" class="btn btn-primary px-5">
                                <i class="fa-solid fa-paper-plane me-2"></i> Post
                            </button>
                        </div>
                    </div>

                </form>

            </div>
        </div>
    </div>

</div>

<script>
function handleTargetChange() {
    const target = document.getElementById('targetType').value;
    document.getElementById('courseSelectorWrap').style.display = target === 'course' ? 'block' : 'none';
    document.getElementById('spaceSelectorWrap').style.display = target === 'learning_space' ? 'block' : 'none';
}

function validateTeacherForm(e) {
    const title = document.getElementById('announcementTitle').value.trim();
    const message = document.getElementById('announcementMessage').value.trim();
    const target = document.getElementById('targetType').value;

    if (!title || !message) {
        Swal.fire('Validation Error', 'Title and message are required.', 'warning');
        return false;
    }

    if (target === 'course' && !document.getElementById('courseId').value) {
        Swal.fire('Validation Error', 'Please select a course.', 'warning');
        return false;
    }

    if (target === 'learning_space' && !document.getElementById('learningSpaceId').value) {
        Swal.fire('Validation Error', 'Please select a learning space.', 'warning');
        return false;
    }

    return true;
}
</script>
