<div class="container-fluid mt-4 mb-5">

    <!-- HERO HEADER -->
    <div class="hero-card mb-4" style="background: linear-gradient(135deg, rgba(18, 49, 76, 0.95), rgba(29, 78, 137, 0.9)), url('/images/banner.jpg') center/cover; padding: 32px 36px; border-radius: 24px; position: relative; overflow: hidden; box-shadow: 0 12px 32px rgba(18, 49, 76, 0.15);">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 position-relative" style="z-index: 2;">
            <div>
                <span class="badge mb-2 px-3 py-2" style="background: rgba(159, 213, 178, 0.2); color: #9fd5b2; border: 1px solid rgba(159, 213, 178, 0.35); border-radius: 30px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px;">
                    <i class="fa-solid fa-shapes me-1"></i> Educator Cohorts
                </span>
                <h2 class="text-white fw-bold m-0" style="font-size: 28px; letter-spacing: -0.5px;">My Learning Spaces</h2>
                <p class="text-light opacity-75 mt-2 mb-0" style="font-size: 14px;">Collaborate with students in your assigned cohorts, study groups, and batches.</p>
            </div>
        </div>
    </div>

    <!-- SPACES GRID -->
    {{#if spaces.length}}
    <div class="row g-4">
        {{#each spaces}}
        <div class="col-xl-4 col-md-6">
            <div class="card h-100 p-4 position-relative d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="badge bg-light text-dark border px-2 py-1">
                            <code>{{this.code}}</code>
                        </span>
                        <span class="badge bg-success px-2 py-1">Active</span>
                    </div>

                    <h5 class="fw-bold mb-1" style="color:var(--text);">{{this.name}}</h5>
                    <small class="badge bg-secondary mb-3">{{this.category}}</small>

                    <p class="text-muted small mb-4" style="line-height: 1.5; min-height: 42px;">
                        {{truncate this.description 110}}
                    </p>

                    <div class="d-flex justify-content-between align-items-center p-3 rounded-3 mb-3" style="background: var(--surface-2); border: 1px solid var(--border);">
                        <div>
                            <small class="text-muted d-block" style="font-size: 11px;">MEMBERS</small>
                            <span class="fw-bold fs-6"><i class="fa-solid fa-users me-1 text-primary"></i> {{this.memberCount}}</span>
                        </div>
                        <div>
                            <small class="text-muted d-block" style="font-size: 11px;">ACCESS</small>
                            <span class="fw-bold fs-6 text-capitalize">{{this.accessMode}}</span>
                        </div>
                        <div>
                            <small class="text-muted d-block" style="font-size: 11px;">START</small>
                            <span class="fw-bold fs-6">{{#if this.startDate}}{{formatDate this.startDate}}{{else}}Ongoing{{/if}}</span>
                        </div>
                    </div>
                </div>

                <div class="pt-3 border-top d-flex justify-content-between align-items-center">
                    <a href="/teacher/learning-spaces/{{this._id}}" class="btn btn-primary btn-sm px-3">
                        <i class="fa-solid fa-arrow-right-to-bracket me-1"></i> Enter Space
                    </a>
                </div>
            </div>
        </div>
        {{/each}}
    </div>
    {{else}}
    <div class="card p-5 text-center text-muted">
        <i class="fa-solid fa-shapes fa-3x mb-3 opacity-50"></i>
        <h5>No Learning Spaces Assigned</h5>
        <p class="mb-0">You are not currently assigned as an educator to any learning spaces. Contact an administrator for assignment.</p>
    </div>
    {{/if}}

</div>
