<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="description" content="Zeitnah Academy Admin Dashboard">
  <meta name="theme-color" content="#0b1220" id="themeMeta">

  <title>Zeitnah Academy</title>

  <link class="brand-favicon" rel="icon" type="image/png" href="/img/favicon.png">
  <link rel="shortcut icon" href="/favicon.ico">

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
    rel="stylesheet">

  <!-- Bootstrap -->
  <link rel="stylesheet" href="/stylesheets/css/bootstrap.min.css">

  <!-- Icons -->
  <link rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <!-- Admin Cards, Tables & View Toggle Design System -->
  <link rel="stylesheet" href="/stylesheets/admin-cards-tables.css">

  <!-- SweetAlert -->
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>

  <style>
    :root {
      --bg: #f8fafc;
      --surface: rgba(255, 255, 255, 0.88);
      --surface-2: rgba(241, 245, 249, 0.75);
      --card: rgba(255, 255, 255, 0.92);
      --card-solid: #ffffff;

      --text: #0f172a;
      --muted: #64748b;
      --border: rgba(226, 232, 240, 0.85);
      --border-subtle: rgba(226, 232, 240, 0.5);

      --brand: #0f172a;
      --brand-2: #1e3a5f;
      --brand-accent: #10b981;

      --green: #10b981;
      --yellow: #f59e0b;
      --red: #ef4444;
      --purple: #8b5cf6;
      --blue: #3b82f6;

      --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.04);
      --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -2px rgba(0, 0, 0, 0.03), inset 0 1px 0 rgba(255, 255, 255, 0.7);
      --shadow-md: 0 12px 24px -4px rgba(15, 23, 42, 0.06), 0 4px 6px -2px rgba(15, 23, 42, 0.03), inset 0 1px 0 rgba(255, 255, 255, 0.8);
      --shadow-lg: 0 20px 32px -8px rgba(15, 23, 42, 0.08), 0 8px 16px -4px rgba(15, 23, 42, 0.04);
      --shadow-glow: 0 0 24px rgba(16, 185, 129, 0.22);
      --shadow-brand: rgba(15, 23, 42, 0.12);
      --radius: 18px;

      --btn-primary-text: #ffffff;

      /* Chip / Badge colors */
      --chip-green-bg: rgba(16, 185, 129, 0.12);
      --chip-green-text: #059669;
      --chip-red-bg: rgba(239, 68, 68, 0.12);
      --chip-red-text: #dc2626;
      --chip-blue-bg: rgba(59, 130, 246, 0.12);
      --chip-blue-text: #2563eb;
      --chip-yellow-bg: rgba(245, 158, 11, 0.12);
      --chip-yellow-text: #d97706;
      --chip-purple-bg: rgba(139, 92, 246, 0.12);
      --chip-purple-text: #7c3aed;
      --chip-neutral-bg: rgba(241, 245, 249, 0.9);
      --chip-neutral-text: #334155;

      /* Component surfaces */
      --preview-bg: #f8fafc;
      --input-border: #e2e8f0;
      --progress-bg: #e2e8f0;
      --stat-gradient-text: #0f172a;
    }

    html[data-theme="dark"] {
      --bg: #090d16;
      --surface: rgba(15, 23, 42, 0.88);
      --surface-2: rgba(22, 33, 56, 0.7);
      --card: rgba(15, 23, 42, 0.85);
      --card-solid: #0d1526;

      --text: #f8fafc;
      --muted: #94a3b8;
      --border: rgba(255, 255, 255, 0.08);
      --border-subtle: rgba(255, 255, 255, 0.04);

      --brand: #9fd5b2;
      --brand-2: #70bf8e;
      --brand-accent: #34d399;

      --green: #34d399;
      --yellow: #fbbf24;
      --red: #f87171;
      --purple: #a78bfa;
      --blue: #60a5fa;

      --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.4);
      --shadow: 0 4px 12px 0 rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.08);
      --shadow-md: 0 14px 28px -4px rgba(0, 0, 0, 0.55), inset 0 1px 0 rgba(255, 255, 255, 0.1);
      --shadow-lg: 0 24px 48px -8px rgba(0, 0, 0, 0.65), inset 0 1px 0 rgba(255, 255, 255, 0.12);
      --shadow-glow: 0 0 28px rgba(52, 211, 153, 0.25);
      --shadow-brand: rgba(52, 211, 153, 0.2);

      --btn-primary-text: #090d16;

      /* Chip / Badge colors (dark) */
      --chip-green-bg: rgba(52, 211, 153, 0.15);
      --chip-green-text: #34d399;
      --chip-red-bg: rgba(248, 113, 113, 0.15);
      --chip-red-text: #f87171;
      --chip-blue-bg: rgba(96, 165, 250, 0.15);
      --chip-blue-text: #93c5fd;
      --chip-yellow-bg: rgba(251, 191, 36, 0.15);
      --chip-yellow-text: #fde047;
      --chip-purple-bg: rgba(167, 139, 250, 0.15);
      --chip-purple-text: #c4b5fd;
      --chip-neutral-bg: rgba(255, 255, 255, 0.08);
      --chip-neutral-text: #e2e8f0;

      /* Component surfaces (dark) */
      --preview-bg: rgba(22, 33, 56, 0.7);
      --input-border: rgba(255, 255, 255, 0.12);
      --progress-bg: rgba(30, 41, 59, 0.8);
      --stat-gradient-text: #ffffff;
    }

    * {
      box-sizing: border-box;
    }

    /* Sleek Custom Scrollbars */
    ::-webkit-scrollbar {
      width: 7px;
      height: 7px;
    }
    ::-webkit-scrollbar-track {
      background: transparent;
    }
    ::-webkit-scrollbar-thumb {
      background: rgba(15, 23, 42, 0.16);
      border-radius: 10px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: rgba(15, 23, 42, 0.28);
    }
    html[data-theme="dark"] ::-webkit-scrollbar-thumb {
      background: rgba(255, 255, 255, 0.16);
    }
    html[data-theme="dark"] ::-webkit-scrollbar-thumb:hover {
      background: rgba(255, 255, 255, 0.28);
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      padding: 0;
      font-family: 'Plus Jakarta Sans', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: 
        radial-gradient(ellipse 85% 55% at 50% -18%, rgba(16, 185, 129, 0.12), transparent 75%),
        radial-gradient(ellipse 60% 45% at 100% 0%, rgba(59, 130, 246, 0.06), transparent 60%),
        radial-gradient(ellipse 60% 45% at 0% 100%, rgba(16, 185, 129, 0.05), transparent 60%),
        var(--bg);
      background-attachment: fixed;
      color: var(--text);
      min-height: 100vh;
      overflow-x: hidden;
      transition: background-color 0.3s ease, color 0.3s ease;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      text-rendering: optimizeLegibility;
    }

    html[data-theme="dark"] body {
      background: 
        radial-gradient(ellipse 85% 55% at 50% -18%, rgba(52, 211, 153, 0.08), transparent 75%),
        radial-gradient(ellipse 60% 45% at 100% 0%, rgba(99, 102, 241, 0.06), transparent 60%),
        radial-gradient(ellipse 60% 45% at 0% 100%, rgba(16, 185, 129, 0.04), transparent 60%),
        var(--bg);
      background-attachment: fixed;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    img {
      max-width: 100%;
      display: block;
    }

    main {
      min-height: 100vh;
      transition: .25s ease;
    }

    /* Cards */
    .card {
      border: 1px solid var(--border) !important;
      border-radius: var(--radius);
      background: var(--card);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      color: var(--text);
      box-shadow: var(--shadow);
      transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.25s ease;
    }

    .card:hover {
      border-color: rgba(16, 185, 129, 0.3) !important;
    }

    /* Interactive animations for list cards */
    .student-card,
    .course-card {
      background: var(--card) !important;
      border: 1px solid var(--border) !important;
      border-radius: 20px;
      overflow: hidden;
      transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.25s ease !important;
    }

    .student-card:hover,
    .course-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-md), var(--shadow-glow) !important;
      border-color: rgba(16, 185, 129, 0.35) !important;
    }

    /* Buttons */
    .btn {
      border-radius: 12px;
      font-weight: 600;
      padding: 9px 20px;
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      border: none;
      letter-spacing: 0.1px;
      position: relative;
    }

    .btn:hover {
      transform: translateY(-1px);
    }

    .btn:active {
      transform: scale(0.98);
    }

    .btn-success {
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
      color: #ffffff !important;
      box-shadow: 0 4px 14px rgba(16, 185, 129, 0.28);
    }

    .btn-success:hover {
      background: linear-gradient(135deg, #059669 0%, #047857 100%);
      box-shadow: 0 6px 20px rgba(16, 185, 129, 0.42);
      color: #ffffff !important;
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--brand), var(--brand-2));
      color: var(--btn-primary-text) !important;
      box-shadow: 0 4px 14px var(--shadow-brand);
    }

    .btn-primary:hover {
      box-shadow: 0 6px 20px var(--shadow-brand);
      filter: brightness(1.08);
      color: var(--btn-primary-text) !important;
    }

    .btn-warning {
      background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
      color: #ffffff !important;
      box-shadow: 0 4px 14px rgba(245, 158, 11, 0.28);
    }

    .btn-warning:hover {
      background: linear-gradient(135deg, #d97706 0%, #b45309 100%);
      box-shadow: 0 6px 20px rgba(245, 158, 11, 0.4);
      color: #ffffff !important;
    }

    .btn-danger {
      background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
      color: white !important;
      box-shadow: 0 4px 14px rgba(239, 68, 68, 0.28);
    }

    .btn-danger:hover {
      background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);
      box-shadow: 0 6px 20px rgba(239, 68, 68, 0.4);
      color: white !important;
    }

    /* Tables */
    .table-responsive {
      border-radius: 16px;
      border: 1px solid var(--border);
      background: var(--surface);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      box-shadow: var(--shadow);
      overflow: hidden;
      margin-bottom: 24px;
    }

    .table {
      margin-bottom: 0;
      color: var(--text);
      background: transparent !important;
      border-collapse: separate;
    }

    .table thead {
      background: var(--surface-2);
    }

    .table th {
      border-bottom: 1px solid var(--border) !important;
      color: var(--muted);
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      padding: 16px 20px;
    }

    .table td {
      border-bottom: 1px solid var(--border) !important;
      padding: 16px 20px;
      color: var(--text);
      transition: background-color 0.2s ease;
    }

    .table tr:last-child td {
      border-bottom: none !important;
    }

    .table tbody tr:hover td {
      background-color: var(--surface-2) !important;
    }

    /* Forms */
    .form-control,
    .form-select,
    textarea {
      border-radius: 12px;
      min-height: 48px;
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--text);
      padding: 10px 16px;
      box-shadow: none !important;
      transition: border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
    }

    textarea {
      min-height: auto;
    }

    .form-control::placeholder,
    textarea::placeholder {
      color: var(--muted);
      opacity: 0.7;
    }

    .form-control:focus,
    .form-select:focus,
    textarea:focus {
      border-color: var(--brand);
      background: var(--card-solid);
      color: var(--text);
      box-shadow: 0 0 0 4px var(--shadow-brand) !important;
    }

    /* Dropdowns */
    .dropdown-menu {
      background: var(--surface);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid var(--border);
      border-radius: 14px;
      box-shadow: var(--shadow);
      padding: 6px;
    }

    .dropdown-item {
      color: var(--text);
      border-radius: 8px;
      padding: 8px 16px;
      font-weight: 500;
      transition: all 0.2s ease;
    }

    .dropdown-item:hover {
      background: var(--surface-2);
      color: var(--brand);
      transform: translateX(2px);
    }

    /* Modals */
    .modal-content {
      background: var(--surface);
      backdrop-filter: blur(25px);
      -webkit-backdrop-filter: blur(25px);
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 22px;
      box-shadow: var(--shadow);
    }

    .badge {
      border-radius: 10px;
      padding: 6px 12px;
      font-weight: 600;
      font-size: 11px;
      letter-spacing: 0.3px;
    }

    /* Custom Chips & Badges */
    .paid-chip {
      color: #065f46 !important;
      background: rgba(159, 213, 178, 0.2) !important;
      border: 1px solid rgba(159, 213, 178, 0.35) !important;
    }

    html[data-theme="dark"] .paid-chip {
      color: var(--green) !important;
      background: rgba(159, 213, 178, 0.1) !important;
      border: 1px solid rgba(159, 213, 178, 0.2) !important;
    }

    .unpaid-chip {
      color: var(--red) !important;
      background: rgba(239, 68, 68, 0.12) !important;
      border: 1px solid rgba(239, 68, 68, 0.2) !important;
    }

    /* Premium components styling */
    .search-box,
    .toolbar-card,
    .top-search input {
      background: var(--surface) !important;
      color: var(--text) !important;
      border: 1px solid var(--border) !important;
    }

    .search-box input,
    .top-search input::placeholder {
      color: var(--muted) !important;
    }

    .view-toggle button {
      background: var(--surface) !important;
      color: var(--muted) !important;
      border: 1px solid var(--border) !important;
      transition: all 0.2s ease;
    }

    .view-toggle button.active {
      background: linear-gradient(135deg, var(--brand), var(--brand-2)) !important;
      color: var(--btn-primary-text) !important;
      border: none !important;
      box-shadow: 0 4px 10px var(--shadow-brand) !important;
    }

    .course-chip,
    .meta-chip,
    .blue-chip {
      background: var(--surface-2) !important;
      color: var(--text) !important;
      border: 1px solid var(--border) !important;
    }

    .active-pill {
      background: rgba(159, 213, 178, 0.2) !important;
      color: #065f46 !important;
      border: 1px solid rgba(159, 213, 178, 0.35);
    }

    html[data-theme="dark"] .active-pill {
      background: rgba(159, 213, 178, 0.12) !important;
      color: var(--green) !important;
      border: 1px solid rgba(159, 213, 178, 0.2);
    }

    .blocked-pill {
      background: rgba(239, 68, 68, 0.12) !important;
      color: var(--red) !important;
      border: 1px solid rgba(239, 68, 68, 0.15);
    }

    .text-muted {
      color: var(--muted) !important;
    }

    /* Bootstrap overrides */
    .bg-white,
    .bg-light {
      background: var(--surface) !important;
      color: var(--text) !important;
    }

    .text-dark {
      color: var(--text) !important;
    }

    .border {
      border-color: var(--border) !important;
    }

    .alert {
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: 14px;
    }

    /* Scrollbars */
    ::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }

    ::-webkit-scrollbar-track {
      background: transparent;
    }

    ::-webkit-scrollbar-thumb {
      background: var(--border);
      border-radius: 10px;
    }

    ::-webkit-scrollbar-thumb:hover {
      background: var(--muted);
    }

    .page-fade {
      animation: fadeIn .3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(6px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Skeleton Loading Styles */
    .skeleton {
      background: linear-gradient(90deg, var(--surface-2) 25%, var(--card) 37%, var(--surface-2) 63%);
      background-size: 400% 100%;
      animation: skeletonShimmer 1.4s ease infinite;
      border-radius: 8px;
      display: inline-block;
    }
    @keyframes skeletonShimmer {
      0% { background-position: 100% 50%; }
      100% { background-position: 0 50%; }
    }
    .skeleton-text { height: 14px; margin-bottom: 8px; width: 100%; }
    .skeleton-title { height: 24px; margin-bottom: 12px; width: 60%; }
    .skeleton-card { height: 110px; border-radius: 18px; margin-bottom: 16px; }
    .skeleton-chart { height: 300px; border-radius: 18px; margin-bottom: 16px; }
    .skeleton-avatar { width: 44px; height: 44px; border-radius: 50%; }

    /* Micro-animations */
    @keyframes pulseGlow {
      0%, 100% { box-shadow: 0 0 15px rgba(159, 213, 178, 0.2); }
      50% { box-shadow: 0 0 30px rgba(159, 213, 178, 0.45); }
    }
    @keyframes floatSlow {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-4px); }
    }
    @keyframes subtlePulse {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.02); }
    }

    /* Global Command Palette */
    .cmd-overlay {
      position: fixed;
      inset: 0;
      background: rgba(10, 17, 26, 0.7);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      z-index: 9999;
      display: flex;
      align-items: flex-start;
      justify-content: center;
      padding-top: 10vh;
      animation: cmdFadeIn .2s ease-out;
    }
    @keyframes cmdFadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }
    .cmd-modal {
      width: 90%;
      max-width: 620px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: 0 25px 60px -10px rgba(0, 0, 0, 0.5), 0 0 25px var(--shadow-brand);
      overflow: hidden;
      animation: cmdSlideDown .25s cubic-bezier(0.16, 1, 0.3, 1);
      display: flex;
      flex-direction: column;
      max-height: 75vh;
    }
    @keyframes cmdSlideDown {
      from { transform: translateY(-20px) scale(0.97); opacity: 0; }
      to { transform: translateY(0) scale(1); opacity: 1; }
    }
    .cmd-header {
      display: flex;
      align-items: center;
      padding: 16px 20px;
      border-bottom: 1px solid var(--border);
      gap: 12px;
      background: var(--surface-2);
    }
    .cmd-search-icon {
      color: var(--brand);
      font-size: 18px;
    }
    .cmd-input {
      flex: 1;
      border: none;
      background: transparent;
      color: var(--text);
      font-size: 16px;
      font-weight: 500;
      outline: none;
      font-family: inherit;
    }
    .cmd-input::placeholder {
      color: var(--muted);
      opacity: 0.8;
    }
    .cmd-badge {
      font-size: 11px;
      font-weight: 700;
      padding: 3px 8px;
      background: var(--card);
      color: var(--muted);
      border-radius: 6px;
      border: 1px solid var(--border);
      letter-spacing: 0.5px;
    }
    .cmd-body {
      padding: 12px;
      overflow-y: auto;
      max-height: 420px;
    }
    .cmd-group-title {
      font-size: 11px;
      font-weight: 700;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 1px;
      padding: 8px 12px 4px;
    }
    .cmd-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 14px;
      border-radius: 12px;
      color: var(--text);
      text-decoration: none !important;
      cursor: pointer;
      transition: all 0.15s ease;
      font-size: 14px;
      font-weight: 500;
    }
    .cmd-item:hover, .cmd-item.selected {
      background: var(--surface-2);
      color: var(--brand);
      transform: translateX(4px);
    }
    .cmd-item-icon {
      width: 32px;
      height: 32px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 10px;
      background: var(--card);
      color: var(--brand);
      font-size: 14px;
      flex-shrink: 0;
      border: 1px solid var(--border);
    }
    .cmd-item-content {
      flex: 1;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    .cmd-item-title {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      font-weight: 600;
    }
    .cmd-item-sub {
      font-size: 12px;
      color: var(--muted);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .cmd-item-badge {
      font-size: 11px;
      padding: 2px 8px;
      border-radius: 6px;
      background: var(--card);
      color: var(--muted);
      border: 1px solid var(--border);
      flex-shrink: 0;
    }
    .cmd-empty {
      padding: 32px 16px;
      text-align: center;
      color: var(--muted);
      font-size: 14px;
    }
    .cmd-footer {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 10px 20px;
      border-top: 1px solid var(--border);
      background: var(--surface-2);
      font-size: 12px;
      color: var(--muted);
    }
    .cmd-footer kbd {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: 2px 5px;
      font-size: 10px;
      font-family: inherit;
      color: var(--text);
      margin: 0 2px;
    }
  </style>

  <script>
    (() => {
      const savedTheme = localStorage.getItem("zeitnah-theme") || "dark";
      document.documentElement.setAttribute("data-theme", savedTheme);

      window.addEventListener("DOMContentLoaded", () => {
        document.getElementById("themeMeta").content =
          savedTheme === "dark" ? "#0b1220" : "#f6f8fb";
      });
    })();

    function toggleTheme(){
      const current = document.documentElement.getAttribute("data-theme");
      const next = current === "dark" ? "light" : "dark";

      document.documentElement.setAttribute("data-theme", next);
      localStorage.setItem("zeitnah-theme", next);

      document.getElementById("themeMeta").content =
        next === "dark" ? "#0b1220" : "#f6f8fb";

      const switcher = document.getElementById("themeSwitch");
      if(switcher) switcher.checked = next === "light";
    }
  </script>
</head>

<body>

  {{#if admins}}
    {{>Admin-Header}}
  {{/if}}

  {{#if teacherPanel}}
    {{>Teacher-Header}}
  {{/if}}

  <main class="page-fade">
    {{{body}}}
  </main>

  <!-- GLOBAL COMMAND PALETTE (Ctrl+K / Cmd+K) -->
  <div id="cmdPaletteOverlay" class="cmd-overlay" style="display:none;" tabindex="-1">
    <div class="cmd-modal" role="dialog" aria-modal="true" aria-label="Command Palette">
      <div class="cmd-header">
        <i class="fa-solid fa-magnifying-glass cmd-search-icon"></i>
        <input type="text" id="cmdPaletteInput" class="cmd-input" placeholder="Type to search pages, actions, students, courses..." autocomplete="off">
        <span class="cmd-badge">ESC</span>
      </div>
      <div class="cmd-body" id="cmdPaletteBody">
        <!-- Results rendered dynamically -->
      </div>
      <div class="cmd-footer">
        <span><kbd>↑</kbd><kbd>↓</kbd> Navigate</span>
        <span><kbd>↵</kbd> Open</span>
        <span><kbd>ESC</kbd> Close</span>
      </div>
    </div>
  </div>

  <script src="/javascripts/jquery/jquery-2.2.4.min.js"></script>
  <script src="/javascripts/popper.min.js"></script>
  <script src="/javascripts/bootstrap.min.js"></script>

  <!-- Bootstrap 5 to Bootstrap 4 Compatibility Bridge -->
  <script>
    (function () {
      if (typeof window !== 'undefined') {
        window.bootstrap = window.bootstrap || {};
        if (!window.bootstrap.Modal) {
          window.bootstrap.Modal = class {
            constructor(element) {
              this.el = typeof element === 'string' ? document.querySelector(element) : element;
            }
            show() {
              if (window.jQuery && this.el) {
                window.jQuery(this.el).modal('show');
              }
            }
            hide() {
              if (window.jQuery && this.el) {
                window.jQuery(this.el).modal('hide');
              }
            }
            static getInstance(element) {
              return new window.bootstrap.Modal(element);
            }
            static getOrCreateInstance(element) {
              return new window.bootstrap.Modal(element);
            }
          };
        } else {
          // In Bootstrap 4, Modal constructor exists but lacks Bootstrap 5 static methods
          if (!window.bootstrap.Modal.getInstance) {
            window.bootstrap.Modal.getInstance = function (element) {
              var el = typeof element === 'string' ? document.querySelector(element) : element;
              return {
                el: el,
                show: function () { if (window.jQuery && el) window.jQuery(el).modal('show'); },
                hide: function () { if (window.jQuery && el) window.jQuery(el).modal('hide'); }
              };
            };
          }
          if (!window.bootstrap.Modal.getOrCreateInstance) {
            window.bootstrap.Modal.getOrCreateInstance = window.bootstrap.Modal.getInstance;
          }
        }

        if (window.jQuery) {
          window.jQuery(document).on('click', '[data-bs-toggle="modal"]', function (e) {
            e.preventDefault();
            var target = window.jQuery(this).attr('data-bs-target') || window.jQuery(this).attr('href');
            if (target) window.jQuery(target).modal('show');
          });

          window.jQuery(document).on('click', '[data-bs-dismiss="modal"]', function (e) {
            e.preventDefault();
            window.jQuery(this).closest('.modal').modal('hide');
          });

          window.jQuery(document).on('click', '[data-bs-toggle="tab"]', function (e) {
            e.preventDefault();
            window.jQuery(this).tab('show');
          });

          window.jQuery(document).on('click', '[data-bs-toggle="dropdown"]', function (e) {
            e.preventDefault();
            window.jQuery(this).dropdown('toggle');
          });
        }
      }
    })();
  </script>

  <!-- Admin View Toggle & Interaction Script -->
  <script src="/javascripts/admin-view-toggle.js"></script>

  <script>
    (function () {
      const blockShortcut = (e) => {
        const key = e.key?.toLowerCase();
        if (e.key === 'F12') return true;
        if ((e.ctrlKey || e.metaKey) && e.shiftKey && ['i', 'j', 'c', 'p'].includes(key)) return true;
        if ((e.ctrlKey || e.metaKey) && ['u', 's'].includes(key)) return true;
        return false;
      };

      document.addEventListener('keydown', function (e) {
        if (blockShortcut(e)) {
          e.preventDefault();
          e.stopPropagation();
          return false;
        }
      }, true);
    })();
  </script>

  <script>
    (function () {
      // Mark page as loaded to dismiss skeleton loaders
      window.addEventListener('DOMContentLoaded', () => {
        document.body.classList.add('page-loaded');
      });

      const overlay = document.getElementById('cmdPaletteOverlay');
      const input = document.getElementById('cmdPaletteInput');
      const body = document.getElementById('cmdPaletteBody');
      if (!overlay || !input || !body) return;

      const staticItems = [
        { title: 'Dashboard', sub: 'Overview & analytics', url: '/', icon: 'fa-solid fa-chart-line', group: 'Navigation', badge: 'Page' },
        { title: 'Students', sub: 'Manage enrolled learners', url: '/students', icon: 'fa-solid fa-user-graduate', group: 'Navigation', badge: 'Page' },
        { title: 'Add Student', sub: 'Register a new learner', url: '/add-students', icon: 'fa-solid fa-user-plus', group: 'Quick Actions', badge: 'Action' },
        { title: 'Registered Users', sub: 'Self-registered accounts', url: '/registered-users', icon: 'fa-solid fa-users', group: 'Navigation', badge: 'Page' },
        { title: 'Usernames', sub: 'Handle management & identity', url: '/usernames', icon: 'fa-solid fa-at', group: 'Navigation', badge: 'Page' },
        { title: 'Courses', sub: 'Course catalog & curriculum', url: '/courses', icon: 'fa-solid fa-layer-group', group: 'Navigation', badge: 'Page' },
        { title: 'Add Course', sub: 'Create a new course', url: '/add-courses', icon: 'fa-solid fa-plus', group: 'Quick Actions', badge: 'Action' },
        { title: 'Add Chapter', sub: 'Create a new chapter', url: '/add-chapters', icon: 'fa-solid fa-book-open', group: 'Quick Actions', badge: 'Action' },
        { title: 'Add Video Class', sub: 'Upload video lesson', url: '/add-class', icon: 'fa-solid fa-video', group: 'Quick Actions', badge: 'Action' },
        { title: 'Teachers', sub: 'Faculty & instructor directory', url: '/teachers', icon: 'fa-solid fa-chalkboard-user', group: 'Navigation', badge: 'Page' },
        { title: 'Learning Spaces', sub: 'Virtual study spaces', url: '/learning-spaces', icon: 'fa-solid fa-shapes', group: 'Navigation', badge: 'Page' },
        { title: 'Announcements', sub: 'Broadcast notifications', url: '/announcements', icon: 'fa-solid fa-bullhorn', group: 'Navigation', badge: 'Page' },
        { title: 'Network / People', sub: 'Student directory & connections', url: '/network', icon: 'fa-solid fa-users-rays', group: 'Navigation', badge: 'Page' },
        { title: 'Leaderboard', sub: 'Gamification rankings', url: '/admin/leaderboard', icon: 'fa-solid fa-trophy', group: 'Gamification', badge: 'Page' },
        { title: 'Settings', sub: 'Platform & admin preferences', url: '/settings', icon: 'fa-solid fa-gear', group: 'Navigation', badge: 'Page' },
        { title: 'Audit Logs', sub: 'System security & action logs', url: '/audit-logs', icon: 'fa-solid fa-clock-rotate-left', group: 'Navigation', badge: 'Page' }
      ];

      let selectedIndex = 0;
      let currentItems = [];
      let searchTimeout = null;

      function renderItems(items, query = '') {
        currentItems = items;
        if (items.length === 0) {
          body.innerHTML = '<div class="cmd-empty"><i class="fa-regular fa-folder-open mb-2" style="font-size:24px;display:block;"></i>No matching actions or results found for "' + String(query).replace(/"/g, '&quot;') + '"</div>';
          return;
        }

        const groups = {};
        items.forEach((item, index) => {
          const g = item.group || 'Results';
          if (!groups[g]) groups[g] = [];
          groups[g].push({ ...item, originalIndex: index });
        });

        let html = '';
        let itemIndex = 0;
        for (const [groupName, groupItems] of Object.entries(groups)) {
          html += '<div class="cmd-group-title">' + groupName + '</div>';
          groupItems.forEach(item => {
            const isSel = itemIndex === selectedIndex;
            html += `
              <div class="cmd-item ${isSel ? 'selected' : ''}" data-index="${itemIndex}" data-url="${item.url}">
                <div class="cmd-item-icon"><i class="${item.icon || 'fa-solid fa-arrow-right'}"></i></div>
                <div class="cmd-item-content">
                  <span class="cmd-item-title">${item.title}</span>
                  ${item.sub ? `<span class="cmd-item-sub">${item.sub}</span>` : ''}
                </div>
                ${item.badge ? `<span class="cmd-item-badge">${item.badge}</span>` : ''}
              </div>
            `;
            itemIndex++;
          });
        }

        body.innerHTML = html;

        // Ensure selected item is visible
        const selEl = body.querySelector('.cmd-item.selected');
        if (selEl) {
          selEl.scrollIntoView({ block: 'nearest' });
        }

        // Attach click handlers
        body.querySelectorAll('.cmd-item').forEach(el => {
          el.addEventListener('click', () => {
            const url = el.getAttribute('data-url');
            if (url) window.location.href = url;
          });
          el.addEventListener('mouseenter', () => {
            body.querySelectorAll('.cmd-item').forEach(i => i.classList.remove('selected'));
            el.classList.add('selected');
            selectedIndex = parseInt(el.getAttribute('data-index') || '0', 10);
          });
        });
      }

      function openPalette() {
        overlay.style.display = 'flex';
        input.value = '';
        selectedIndex = 0;
        renderItems(staticItems);
        setTimeout(() => input.focus(), 50);
      }

      function closePalette() {
        overlay.style.display = 'none';
        input.blur();
      }

      window.openCommandPalette = openPalette;
      window.closeCommandPalette = closePalette;

      // Global keyboard shortcut: Cmd+K / Ctrl+K
      document.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          if (overlay.style.display === 'none') {
            openPalette();
          } else {
            closePalette();
          }
        } else if (e.key === 'Escape' && overlay.style.display !== 'none') {
          closePalette();
        } else if (overlay.style.display !== 'none') {
          const items = body.querySelectorAll('.cmd-item');
          if (e.key === 'ArrowDown') {
            e.preventDefault();
            if (items.length > 0) {
              selectedIndex = (selectedIndex + 1) % items.length;
              items.forEach((item, idx) => item.classList.toggle('selected', idx === selectedIndex));
              items[selectedIndex]?.scrollIntoView({ block: 'nearest' });
            }
          } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            if (items.length > 0) {
              selectedIndex = (selectedIndex - 1 + items.length) % items.length;
              items.forEach((item, idx) => item.classList.toggle('selected', idx === selectedIndex));
              items[selectedIndex]?.scrollIntoView({ block: 'nearest' });
            }
          } else if (e.key === 'Enter') {
            e.preventDefault();
            const selEl = items[selectedIndex];
            if (selEl) {
              const url = selEl.getAttribute('data-url');
              if (url) window.location.href = url;
            }
          }
        }
      });

      overlay.addEventListener('click', (e) => {
        if (e.target === overlay) closePalette();
      });

      // Filter as you type
      input.addEventListener('input', () => {
        const q = input.value.trim().toLowerCase();
        selectedIndex = 0;
        clearTimeout(searchTimeout);

        if (!q) {
          renderItems(staticItems);
          return;
        }

        // Static matching
        const matched = staticItems.filter(item =>
          item.title.toLowerCase().includes(q) || (item.sub && item.sub.toLowerCase().includes(q))
        );

        renderItems(matched, q);

        // Dynamic backend search for students/courses
        if (q.length >= 2) {
          searchTimeout = setTimeout(async () => {
            try {
              const res = await fetch('/api/search?q=' + encodeURIComponent(q));
              if (!res.ok) return;
              const data = await res.json();
              if (data.success && Array.isArray(data.results) && data.results.length > 0) {
                const apiItems = data.results.map(r => ({
                  title: r.title,
                  sub: r.subtitle,
                  url: r.url,
                  icon: r.icon,
                  group: r.badge || 'Search Results',
                  badge: r.type
                }));
                // Combine without duplicate URLs
                const combined = [...matched, ...apiItems];
                renderItems(combined, q);
              }
            } catch (err) {
              // Ignore network abort
            }
          }, 200);
        }
      });
    })();
  </script>

</body>
</html>