    </nav>

    <!-- FOOTER -->
    <div class="sidebar-footer">
        <a href="/logout" class="logout-btn">
            <i class="fa-solid fa-right-from-bracket"></i>
            Logout
        </a>
    </div>

</aside>


<!-- TOPBAR -->
<header class="admin-topbar">

    <!-- LEFT -->
    <div class="topbar-left">

        <button class="menu-btn" onclick="toggleSidebar()">
            <i class="fa-solid fa-bars"></i>
        </button>

        <div class="top-search" onclick="if(window.openCommandPalette) window.openCommandPalette();" role="button" tabindex="0" title="Press ⌘K or Ctrl+K to search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" placeholder="Search anything... (⌘K)" readonly style="cursor:pointer;">
            <span class="top-search-kbd">⌘K</span>
        </div>

    </div>


    <!-- RIGHT -->
    <div class="topbar-right">

        <!-- Notification Center -->
        <div class="notif-dropdown-wrap" id="notifDropdownWrap">
            <button class="top-icon notif-bell-btn" id="notifBellBtn" aria-label="Notifications" onclick="toggleNotifications(event)">
                <i class="fa-regular fa-bell"></i>
                <span class="notif-badge" id="notifBadge" style="display:none;">0</span>
            </button>

            <div class="notif-panel" id="notifPanel" style="display:none;">
                <div class="notif-panel-header">
                    <div class="d-flex align-items-center gap-2">
                        <strong style="font-size:14px;letter-spacing:-0.2px;">Activity Notifications</strong>
                        <span class="notif-count-pill" id="notifHeaderCount">0 new</span>
                    </div>
                    <button type="button" class="notif-mark-read-btn" onclick="markAllNotificationsRead(event)" title="Mark all read">
                        <i class="fa-solid fa-check-double"></i> Mark read
                    </button>
                </div>

                <div class="notif-list" id="notifList">
                    <div class="notif-loading">
                        <i class="fa-solid fa-circle-notch fa-spin"></i> Loading notifications...
                    </div>
                </div>

                <div class="notif-panel-footer">
                    <a href="/audit-logs" class="notif-all-link">
                        View complete audit log <i class="fa-solid fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- theme switch -->
        <label class="theme-toggle-wrap">
            <span>🌙</span>

            <input type="checkbox" id="themeSwitch" onchange="toggleTheme()">

            <div class="theme-toggle-slider"></div>

            <span>☀️</span>
        </label>

        <!-- profile -->
        <div class="profile-box">
            <div class="profile-avatar-wrap">
                <img src="/images/logo.png" alt="Admin">
                <span class="status-indicator online" title="Active Administrator"></span>
            </div>

            <div>
                <strong>{{#if sessionAdmin}}{{sessionAdmin.Name}}{{else}}Admin{{/if}}</strong>
                <small>{{#if isSuperuser}}Superuser{{else}}Administrator{{/if}}</small>
            </div>
        </div>

    </div>

</header>

<!-- BREADCRUMB BAR (Conditional) -->
{{#if breadcrumb}}
<nav class="admin-breadcrumb-bar" aria-label="Breadcrumb navigation">
    <ol class="admin-breadcrumb-list">
        <li class="admin-breadcrumb-item">
            <a href="/" title="Dashboard"><i class="fa-solid fa-house"></i></a>
        </li>
        {{#each breadcrumb}}
        <li class="admin-breadcrumb-separator"><i class="fa-solid fa-chevron-right"></i></li>
        <li class="admin-breadcrumb-item {{#unless this.url}}active{{/unless}}">
            {{#if this.url}}
            <a href="{{this.url}}">{{this.label}}</a>
            {{else}}
            <span>{{this.label}}</span>
            {{/if}}
        </li>
        {{/each}}
    </ol>
</nav>
{{/if}}


<style>
    :root {
        --sidebar-width: 280px;
    }

    /* SIDEBAR Overlay & Base */
    .admin-sidebar {
        position: fixed;
        left: 0;
        top: 0;
        width: var(--sidebar-width);
        height: 100vh;
        z-index: 1100;
        display: flex;
        flex-direction: column;
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        background: var(--surface);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-right: 1px solid var(--border);
        box-shadow: var(--shadow);
    }

    .brand-area {
        padding: 24px 22px;
        border-bottom: 1px solid var(--border);
    }

    .brand-link {
        display: flex;
        align-items: center;
        gap: 15px;
        color: var(--text);
    }

    .brand-logo {
        width: 50px;
        height: 50px;
        object-fit: contain;
        border-radius: 12px;
        background: var(--surface-2);
        padding: 5px;
        border: 1px solid var(--border);
        box-shadow: 0 4px 12px rgba(0, 0, 0, .04);
        transition: transform 0.2s ease;
    }

    .brand-link:hover .brand-logo {
        transform: rotate(-5deg) scale(1.05);
    }

    .brand-text h5 {
        margin: 0;
        font-size: 18px;
        font-weight: 850;
        letter-spacing: 0.8px;
        color: var(--text);
        background: linear-gradient(135deg, var(--brand), var(--brand-2));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .brand-text small {
        color: var(--muted);
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.5px;
    }

    /* NAVIGATION */
    .sidebar-nav {
        padding: 20px 0;
        flex: 1;
        overflow-y: auto;
    }

    .sidebar-nav a {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 12px 18px;
        margin: 5px 14px;
        border-radius: 12px;
        color: var(--muted);
        font-weight: 600;
        font-size: 14px;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        border: 1px solid transparent;
    }

    .sidebar-nav a i {
        width: 22px;
        text-align: center;
        font-size: 16px;
        transition: transform 0.25s ease;
    }

    .sidebar-nav a:hover {
        background: var(--surface-2);
        color: var(--brand);
        border-color: var(--border);
    }

    .sidebar-nav a:hover i {
        transform: scale(1.15);
    }

    .sidebar-nav a.active {
        background: linear-gradient(135deg, var(--brand), var(--brand-2));
        color: var(--btn-primary-text) !important;
        border-color: transparent;
        box-shadow: 0 8px 20px var(--shadow-brand);
    }

    /* Superuser Link */
    .superuser-nav-item {
        position: relative;
        border: 1px solid rgba(245, 158, 11, .15) !important;
        background: rgba(245, 158, 11, .04) !important;
        color: var(--text) !important;
    }

    .superuser-nav-item:hover {
        background: rgba(245, 158, 11, .08) !important;
        border-color: rgba(245, 158, 11, .3) !important;
    }

    .superuser-nav-item.active {
        background: linear-gradient(135deg, #d97706, #b45309) !important;
        border-color: transparent !important;
        color: white !important;
        box-shadow: 0 8px 20px rgba(217, 119, 6, 0.25) !important;
    }

    .su-badge {
        margin-left: auto;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: .5px;
        padding: 2px 6px;
        border-radius: 6px;
        background: rgba(245, 158, 11, .15);
        color: #f59e0b;
        border: 1px solid rgba(245, 158, 11, .25);
    }

    /* FOOTER */
    .sidebar-footer {
        padding: 20px;
        border-top: 1px solid var(--border);
    }

    .logout-btn {
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
        padding: 12px;
        border-radius: 12px;
        background: var(--surface-2);
        color: var(--text);
        font-weight: 700;
        font-size: 14px;
        border: 1px solid var(--border);
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .logout-btn:hover {
        background: var(--red);
        color: white !important;
        border-color: transparent;
        box-shadow: 0 4px 12px rgba(239, 68, 68, 0.2);
    }

    /* TOPBAR */
    .admin-topbar {
        position: fixed;
        left: 280px;
        right: 0;
        top: 0;
        height: 80px;
        padding: 0 28px;
        z-index: 1000;
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: rgba(255, 255, 255, 0.01);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-bottom: 1px solid var(--border);
    }

    .topbar-left,
    .topbar-right {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .menu-btn,
    .top-icon {
        width: 44px;
        height: 44px;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: var(--surface);
        color: var(--text);
        font-size: 16px;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .menu-btn:hover,
    .top-icon:hover {
        transform: translateY(-2px);
        background: var(--surface-2);
        color: var(--brand);
        box-shadow: var(--shadow);
    }

    /* search */
    .top-search {
        width: 320px;
        position: relative;
    }

    .top-search i {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--muted);
        font-size: 14px;
    }

    .top-search input {
        width: 100%;
        height: 44px;
        padding-left: 40px;
        border: 1px solid var(--border);
        border-radius: 12px;
        outline: none;
        background: var(--surface-2);
        color: var(--text);
        font-size: 14px;
        transition: all 0.25s ease;
    }

    .top-search input:focus {
        border-color: var(--brand);
        background: var(--surface);
        box-shadow: 0 0 0 4px var(--shadow-brand) !important;
    }

    /* THEME TOGGLE */
    .theme-toggle-wrap {
        display: flex;
        align-items: center;
        gap: 10px;
        cursor: pointer;
        user-select: none;
        color: var(--text);
        font-size: 13px;
        font-weight: 700;
    }

    .theme-toggle-wrap input {
        display: none;
    }

    .theme-toggle-slider {
        width: 52px;
        height: 28px;
        border-radius: 50px;
        position: relative;
        background: var(--surface-2);
        border: 1px solid var(--border);
        transition: .25s;
    }

    .theme-toggle-slider::after {
        content: '';
        width: 20px;
        height: 20px;
        border-radius: 50%;
        position: absolute;
        left: 3px;
        top: 3px;
        background: linear-gradient(135deg, var(--brand), var(--brand-2));
        transition: .25s;
    }

    #themeSwitch:checked+.theme-toggle-slider::after {
        left: 27px;
    }

    /* PROFILE */
    .profile-box {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 6px 14px;
        border-radius: 12px;
        background: var(--surface);
        border: 1px solid var(--border);
        box-shadow: 0 4px 10px rgba(0,0,0,0.02);
    }

    .profile-box img {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        object-fit: cover;
        background: var(--surface-2);
        padding: 3px;
        border: 1px solid var(--border);
    }

    .profile-box strong {
        display: block;
        font-size: 13px;
        font-weight: 700;
        color: var(--text);
    }

    .profile-box small {
        color: var(--muted);
        font-size: 11px;
        font-weight: 500;
    }

    /* CONTENT */
    main {
        margin-left: 280px;
        padding-top: 100px;
        padding-left: 28px;
        padding-right: 28px;
        padding-bottom: 30px;
    }

    /* MOBILE Overlay */
    .sidebar-overlay {
        display: none;
    }

    @media(max-width:991px) {
        .admin-sidebar {
            left: -300px;
        }

        .admin-sidebar.show {
            left: 0;
        }

        .sidebar-overlay.show {
            display: block;
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, .4);
            z-index: 1090;
            backdrop-filter: blur(4px);
            -webkit-backdrop-filter: blur(4px);
        }

        .admin-topbar {
            left: 0;
            padding: 0 16px;
        }

        main {
            margin-left: 0;
            padding-left: 16px;
            padding-right: 16px;
        }

        .top-search {
            width: 160px;
        }

        .profile-box div {
            display: none;
        }
    }

    /* Top Search Shortcut */
    .top-search-kbd {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: 2px 7px;
        font-size: 11px;
        font-weight: 700;
        color: var(--muted);
        margin-left: 6px;
        pointer-events: none;
        letter-spacing: 0.5px;
    }

    /* Notification Center */
    .notif-dropdown-wrap {
        position: relative;
        display: inline-flex;
    }
    .notif-bell-btn {
        position: relative;
    }
    .notif-badge {
        position: absolute;
        top: -4px;
        right: -4px;
        min-width: 18px;
        height: 18px;
        border-radius: 9px;
        background: var(--red);
        color: #ffffff;
        font-size: 10px;
        font-weight: 800;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0 4px;
        border: 2px solid var(--surface);
        box-shadow: 0 2px 6px rgba(220, 53, 69, 0.4);
        animation: subtlePulse 2s infinite;
    }
    .notif-panel {
        position: absolute;
        top: calc(100% + 12px);
        right: 0;
        width: 380px;
        max-width: calc(100vw - 32px);
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.35), 0 0 20px var(--shadow-brand);
        z-index: 1200;
        overflow: hidden;
        animation: notifDropIn .2s cubic-bezier(0.16, 1, 0.3, 1);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
    }
    @keyframes notifDropIn {
        from { transform: translateY(-10px) scale(0.96); opacity: 0; }
        to { transform: translateY(0) scale(1); opacity: 1; }
    }
    .notif-panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 18px;
        border-bottom: 1px solid var(--border);
        background: var(--surface-2);
    }
    .notif-count-pill {
        font-size: 11px;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 12px;
        background: rgba(159, 213, 178, 0.2);
        color: var(--brand);
    }
    .notif-mark-read-btn {
        background: none;
        border: none;
        color: var(--muted);
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        padding: 4px 8px;
        border-radius: 6px;
        transition: all 0.15s ease;
    }
    .notif-mark-read-btn:hover {
        color: var(--brand);
        background: var(--card);
    }
    .notif-list {
        max-height: 340px;
        overflow-y: auto;
    }
    .notif-item {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 12px 18px;
        border-bottom: 1px solid var(--border);
        transition: background 0.15s ease;
        text-decoration: none !important;
        color: var(--text);
    }
    .notif-item:last-child {
        border-bottom: none;
    }
    .notif-item:hover {
        background: var(--surface-2);
    }
    .notif-item-icon {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        flex-shrink: 0;
    }
    .notif-item-body {
        flex: 1;
        min-width: 0;
    }
    .notif-item-msg {
        font-size: 13px;
        font-weight: 600;
        color: var(--text);
        line-height: 1.35;
        margin-bottom: 3px;
        word-break: break-word;
    }
    .notif-item-meta {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 11px;
        color: var(--muted);
    }
    .notif-panel-footer {
        padding: 10px 18px;
        border-top: 1px solid var(--border);
        background: var(--surface-2);
        text-align: center;
    }
    .notif-all-link {
        font-size: 12px;
        font-weight: 600;
        color: var(--brand);
        text-decoration: none !important;
    }
    .notif-all-link:hover {
        text-decoration: underline !important;
    }
    .notif-loading, .notif-empty {
        padding: 30px 20px;
        text-align: center;
        color: var(--muted);
        font-size: 13px;
    }

    /* Profile online indicator */
    .profile-avatar-wrap {
        position: relative;
        display: inline-block;
    }
    .status-indicator.online {
        position: absolute;
        bottom: -1px;
        right: -1px;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: #10b981;
        border: 2px solid var(--surface);
        box-shadow: 0 0 8px rgba(16, 185, 129, 0.6);
        animation: pulseGlow 2.5s infinite;
    }

    /* Breadcrumb Bar */
    .admin-breadcrumb-bar {
        position: relative;
        margin-left: var(--sidebar-width);
        padding: 86px 28px 0;
        z-index: 1000;
        animation: fadeIn .3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .admin-breadcrumb-bar ~ main,
    body:has(.admin-breadcrumb-bar) main {
        padding-top: 16px !important;
    }
    .admin-breadcrumb-list {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 6px;
        list-style: none;
        padding: 8px 16px;
        margin: 0;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        box-shadow: 0 2px 8px -2px rgba(0, 0, 0, 0.05);
        font-size: 13px;
    }
    .admin-breadcrumb-item a {
        color: var(--muted);
        text-decoration: none !important;
        font-weight: 500;
        transition: color 0.15s ease;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }
    .admin-breadcrumb-item a:hover {
        color: var(--brand);
    }
    .admin-breadcrumb-item.active span {
        color: var(--text);
        font-weight: 700;
    }
    .admin-breadcrumb-separator {
        color: var(--muted);
        font-size: 10px;
        opacity: 0.6;
        display: inline-flex;
        align-items: center;
    }
    @media(max-width:991px) {
        .admin-breadcrumb-bar {
            margin-left: 0;
            padding: 80px 16px 0;
        }
        .notif-panel {
            width: calc(100vw - 32px);
            right: -10px;
        }
    }
</style>

<script>
    function toggleSidebar() {
        document
            .getElementById("adminSidebar")
            .classList
            .toggle("show");

        document
            .querySelector(".sidebar-overlay")
            .classList
            .toggle("show");
    }

    let notifIsOpen = false;

    function escapeNotifHtml(str) {
        if (!str) return '';
        return String(str).replace(/[&<>"']/g, m => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[m]);
    }

    async function fetchNotifications() {
        try {
            const res = await fetch('/api/notifications');
            if (!res.ok) return;
            const data = await res.json();
            if (!data.success) return;

            const badge = document.getElementById('notifBadge');
            const countHeader = document.getElementById('notifHeaderCount');
            const list = document.getElementById('notifList');

            if (data.unreadCount > 0) {
                if (badge) {
                    badge.innerText = data.unreadCount > 9 ? '9+' : data.unreadCount;
                    badge.style.display = 'flex';
                }
                if (countHeader) countHeader.innerText = data.unreadCount + ' new';
            } else {
                if (badge) badge.style.display = 'none';
                if (countHeader) countHeader.innerText = '0 new';
            }

            if (list && Array.isArray(data.notifications)) {
                if (data.notifications.length === 0) {
                    list.innerHTML = '<div class="notif-empty"><i class="fa-regular fa-bell-slash mb-2" style="font-size:22px;display:block;"></i>No recent notifications</div>';
                    return;
                }

                list.innerHTML = data.notifications.map(n => `
                    <div class="notif-item">
                        <div class="notif-item-icon" style="background:${n.bg || 'rgba(18,49,76,0.1)'}; color:${n.color || 'var(--brand)'};">
                            <i class="${n.icon || 'fa-solid fa-bell'}"></i>
                        </div>
                        <div class="notif-item-body">
                            <div class="notif-item-msg">${escapeNotifHtml(n.message)}</div>
                            <div class="notif-item-meta">
                                <span><i class="fa-regular fa-user me-1"></i>${escapeNotifHtml(n.actor)}</span>
                                <span>•</span>
                                <span><i class="fa-regular fa-clock me-1"></i>${n.relativeTime}</span>
                            </div>
                        </div>
                    </div>
                `).join('');
            }
        } catch (e) {
            // Silently fail network error
        }
    }

    function toggleNotifications(e) {
        if (e) e.stopPropagation();
        const panel = document.getElementById('notifPanel');
        if (!panel) return;
        notifIsOpen = !notifIsOpen;
        panel.style.display = notifIsOpen ? 'block' : 'none';
        if (notifIsOpen) {
            fetchNotifications();
        }
    }

    async function markAllNotificationsRead(e) {
        if (e) e.stopPropagation();
        try {
            await fetch('/api/notifications/mark-read', { method: 'POST' });
            const badge = document.getElementById('notifBadge');
            const countHeader = document.getElementById('notifHeaderCount');
            if (badge) badge.style.display = 'none';
            if (countHeader) countHeader.innerText = '0 new';
        } catch (err) {}
    }

    document.addEventListener('click', (e) => {
        const wrap = document.getElementById('notifDropdownWrap');
        if (wrap && !wrap.contains(e.target) && notifIsOpen) {
            const panel = document.getElementById('notifPanel');
            if (panel) panel.style.display = 'none';
            notifIsOpen = false;
        }
    });

    window.addEventListener("DOMContentLoaded", () => {
        let theme =
            localStorage.getItem("zeitnah-theme") || "dark";
            
        if (theme === "auto") {
            theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? "dark" : "light";
        }

        const switcher =
            document.getElementById("themeSwitch");

        if (switcher) {
            switcher.checked = theme === "light";
        }

        // Initialize notifications & poll every 30s
        fetchNotifications();
        setInterval(fetchNotifications, 30000);
    });
</script>