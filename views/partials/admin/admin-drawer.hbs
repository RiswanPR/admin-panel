{{!-- Reusable Admin Drawer (Slide-out panel) Component --}}
<div class="admin-drawer-backdrop" id="{{id}}" role="dialog" aria-modal="true" aria-labelledby="{{id}}-title" style="display: none;">
  <div class="admin-drawer-panel admin-drawer-{{#if side}}{{side}}{{else}}right{{/if}}">
    <div class="admin-drawer-header">
      <div class="admin-drawer-title-group">
        {{#if icon}}<i class="{{icon}} drawer-title-icon"></i>{{/if}}
        <div>
          <h3 class="admin-drawer-title" id="{{id}}-title">{{title}}</h3>
          {{#if subtitle}}<p class="admin-drawer-subtitle">{{subtitle}}</p>{{/if}}
        </div>
      </div>
      <button type="button" class="admin-drawer-close-btn" data-drawer-close="{{id}}" aria-label="Close drawer">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>
    <div class="admin-drawer-body">
      {{{bodyHtml}}}
    </div>
    {{#if footerHtml}}
    <div class="admin-drawer-footer">
      {{{footerHtml}}}
    </div>
    {{/if}}
  </div>
</div>
