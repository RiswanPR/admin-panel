{{!-- Reusable Admin Pagination Component --}}
{{#ifGt totalPages 1}}
<div class="admin-pagination-wrapper">
  <div class="pagination-info">
    <span>Showing Page <strong>{{page}}</strong> of <strong>{{totalPages}}</strong> ({{total}} total records)</span>
  </div>
  <nav class="pagination-controls" aria-label="Administrative pagination">
    {{#ifGt page 1}}
    <a href="?page={{dec page}}{{#if viewMode}}&view={{viewMode}}{{/if}}{{#if filters.search}}&search={{filters.search}}{{/if}}{{#if filters.q}}&q={{filters.q}}{{/if}}{{#if filters.status}}&status={{filters.status}}{{/if}}{{#if filters.role}}&role={{filters.role}}{{/if}}{{#if filters.category}}&category={{filters.category}}{{/if}}{{#if filters.discipline}}&discipline={{filters.discipline}}{{/if}}{{#if filters.sector}}&sector={{filters.sector}}{{/if}}{{#if filters.entityType}}&entityType={{filters.entityType}}{{/if}}{{#if filters.reason}}&reason={{filters.reason}}{{/if}}{{#if filters.audience}}&audience={{filters.audience}}{{/if}}{{#if filters.postType}}&postType={{filters.postType}}{{/if}}{{#if filters.type}}&type={{filters.type}}{{/if}}{{#if filters.sort}}&sort={{filters.sort}}{{/if}}{{#if filters.authorId}}&authorId={{filters.authorId}}{{/if}}{{#if filters.postId}}&postId={{filters.postId}}{{/if}}{{#if filters.courseId}}&courseId={{filters.courseId}}{{/if}}{{#if filters.courseTag}}&courseTag={{filters.courseTag}}{{/if}}{{#if filters.startDate}}&startDate={{filters.startDate}}{{/if}}{{#if filters.endDate}}&endDate={{filters.endDate}}{{/if}}{{#if filters.hasReports}}&hasReports={{filters.hasReports}}{{/if}}"
       class="pagination-btn pagination-prev" aria-label="Previous Page">
      <i class="fa-solid fa-chevron-left"></i>
      <span>Previous</span>
    </a>
    {{else}}
    <button class="pagination-btn pagination-prev disabled" disabled aria-label="Previous Page">
      <i class="fa-solid fa-chevron-left"></i>
      <span>Previous</span>
    </button>
    {{/ifGt}}

    <div class="pagination-pages">
      <span class="pagination-current">{{page}}</span>
      <span class="pagination-separator">/</span>
      <span class="pagination-total">{{totalPages}}</span>
    </div>

    {{#ifLt page totalPages}}
    <a href="?page={{inc page}}{{#if viewMode}}&view={{viewMode}}{{/if}}{{#if filters.search}}&search={{filters.search}}{{/if}}{{#if filters.q}}&q={{filters.q}}{{/if}}{{#if filters.status}}&status={{filters.status}}{{/if}}{{#if filters.role}}&role={{filters.role}}{{/if}}{{#if filters.category}}&category={{filters.category}}{{/if}}{{#if filters.discipline}}&discipline={{filters.discipline}}{{/if}}{{#if filters.sector}}&sector={{filters.sector}}{{/if}}{{#if filters.entityType}}&entityType={{filters.entityType}}{{/if}}{{#if filters.reason}}&reason={{filters.reason}}{{/if}}{{#if filters.audience}}&audience={{filters.audience}}{{/if}}{{#if filters.postType}}&postType={{filters.postType}}{{/if}}{{#if filters.type}}&type={{filters.type}}{{/if}}{{#if filters.sort}}&sort={{filters.sort}}{{/if}}{{#if filters.authorId}}&authorId={{filters.authorId}}{{/if}}{{#if filters.postId}}&postId={{filters.postId}}{{/if}}{{#if filters.courseId}}&courseId={{filters.courseId}}{{/if}}{{#if filters.courseTag}}&courseTag={{filters.courseTag}}{{/if}}{{#if filters.startDate}}&startDate={{filters.startDate}}{{/if}}{{#if filters.endDate}}&endDate={{filters.endDate}}{{/if}}{{#if filters.hasReports}}&hasReports={{filters.hasReports}}{{/if}}"
       class="pagination-btn pagination-next" aria-label="Next Page">
      <span>Next</span>
      <i class="fa-solid fa-chevron-right"></i>
    </a>
    {{else}}
    <button class="pagination-btn pagination-next disabled" disabled aria-label="Next Page">
      <span>Next</span>
      <i class="fa-solid fa-chevron-right"></i>
    </button>
    {{/ifLt}}
  </nav>
</div>
{{/ifGt}}
