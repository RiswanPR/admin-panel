<!-- AWARD / ADJUST POINTS MODAL -->
<div class="modal fade gamification-modal" id="awardPointsModal" tabindex="-1" aria-labelledby="awardModalTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">

      <!-- MODAL HEADER -->
      <div class="modal-header d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-2">
          <div class="kpi-icon icon-gold" style="width:36px;height:36px;font-size:16px;border-radius:10px;">
            <i class="fa-solid fa-coins"></i>
          </div>
          <h5 class="modal-title fw-bold m-0" id="awardModalTitle">Award XP / Points</h5>
        </div>
        <button type="button" class="close btn-close" data-dismiss="modal" data-bs-dismiss="modal" aria-label="Close">&times;</button>
      </div>

      <!-- MODAL BODY -->
      <div class="modal-body">

        <!-- STUDENT SELECTOR -->
        <div class="mb-3">
          <label class="form-label fw-semibold" style="font-size:13px;">Student</label>

          <!-- Search Input for unselected state -->
          <div class="position-relative">
            <input type="text" id="studentSearchInput" class="form-control"
                   placeholder="Type student name, @username or email..."
                   onkeyup="searchStudentsInModal(this.value)" autocomplete="off">
            <div id="studentSearchResults" class="search-results-dropdown shadow-lg bg-body rounded-3 mt-1 p-1 position-absolute w-100"
                 style="display:none; z-index:1050; max-height:220px; overflow-y:auto; border:1px solid var(--border);">
            </div>
          </div>

          <!-- Selected Student Card -->
          <div id="selectedStudentCard" class="align-items-center justify-content-between p-2 rounded-3 border mt-1"
               style="display:none; background:var(--surface-2); border-color:var(--border);">
            <div class="d-flex align-items-center gap-2">
              <div class="avatar-sm rounded bg-dark text-white d-flex align-items-center justify-content-center"
                   style="width:36px;height:36px;font-size:13px;font-weight:bold;">
                <i class="fa-solid fa-user-graduate"></i>
              </div>
              <div>
                <strong id="selectedStudentName" class="d-block" style="font-size:14px;">Student Name</strong>
                <small id="selectedStudentUsername" class="text-muted font-monospace" style="font-size:11px;">@username</small>
              </div>
            </div>
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="clearSelectedStudent()" title="Change student">
              <i class="fa-solid fa-xmark"></i>
            </button>
          </div>
        </div>

        <!-- SCOPE TOGGLE (GLOBAL vs COURSE) -->
        <div class="mb-3">
          <label class="form-label fw-semibold" style="font-size:13px;">Point Scope</label>
          <div class="scope-toggle-group">
            <button type="button" id="scopeGlobalBtn" class="scope-btn active" onclick="setPointScope('global')">
              <i class="fa-solid fa-earth-americas me-1"></i> Global XP
            </button>
            <button type="button" id="scopeCourseBtn" class="scope-btn" onclick="setPointScope('course')">
              <i class="fa-solid fa-book-open me-1"></i> Course XP
            </button>
          </div>
        </div>

        <!-- COURSE SELECTOR (Visible when Scope = Course) -->
        <div class="mb-3" id="courseSelectGroup" style="display:none;">
          <label class="form-label fw-semibold" style="font-size:13px;">Select Course</label>
          <select id="courseSelectInput" class="form-select" style="font-size:13px;">
            <option value="">Select student first...</option>
          </select>
          <small class="text-muted" style="font-size:11px;">Only courses the student is currently enrolled in are eligible.</small>
        </div>

        <!-- POINTS INPUT -->
        <div class="mb-3">
          <label class="form-label fw-semibold" style="font-size:13px;">Points (XP)</label>
          <div class="input-group">
            <span class="input-group-text"><i class="fa-solid fa-star text-warning"></i></span>
            <input type="number" id="awardPointsInput" class="form-control" placeholder="e.g. 100"
                   min="1" step="1" oninput="updateBalancePreview()">
          </div>
        </div>

        <!-- REASON INPUT -->
        <div class="mb-3">
          <label class="form-label fw-semibold" style="font-size:13px;">Reason / Justification</label>
          <textarea id="awardReasonInput" class="form-control" rows="2"
                    placeholder="e.g. Outstanding assignment submission, capstone bonus..." style="font-size:13px;"></textarea>
          <small class="text-muted" style="font-size:11px;">Audit logging requires a valid reason for all manual actions.</small>
        </div>

        <!-- LIVE BALANCE PREVIEW -->
        <div class="balance-preview-box">
          <div class="preview-col">
            <small>Current</small>
            <span id="previewCurrentBalance">0 XP</span>
          </div>
          <div class="preview-col">
            <small>Adjustment</small>
            <span id="previewChangeAmount">+0 XP</span>
          </div>
          <div class="preview-col after-award">
            <small>After Action</small>
            <span id="previewAfterBalance">0 XP</span>
          </div>
        </div>

      </div>

      <!-- MODAL FOOTER -->
      <div class="modal-footer d-flex align-items-center justify-content-between">
        <button type="button" class="btn btn-outline-secondary px-3" data-dismiss="modal" data-bs-dismiss="modal">Cancel</button>
        <button type="button" id="submitAwardBtn" class="btn btn-success px-4" onclick="submitPointTransaction()">
          Award XP
        </button>
      </div>

    </div>
  </div>
</div>
