<div class="container-fluid mt-4 mb-5">

    <!-- HERO HEADER -->
    <div class="hero-card mb-4" style="background: linear-gradient(135deg, rgba(18, 49, 76, 0.95), rgba(29, 78, 137, 0.9)), url('/images/banner.jpg') center/cover; padding: 32px 36px; border-radius: 24px; position: relative; overflow: hidden; box-shadow: 0 12px 32px rgba(18, 49, 76, 0.15);">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 position-relative" style="z-index: 2;">
            <div>
                <span class="badge mb-2 px-3 py-2" style="background: rgba(255, 193, 7, 0.2); color: #ffc107; border: 1px solid rgba(255, 193, 7, 0.35); border-radius: 30px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px;">
                    <i class="fa-solid fa-shield-halved me-1"></i> Data Governance Diagnostic
                </span>
                <h2 class="text-white fw-bold m-0" style="font-size: 28px; letter-spacing: -0.5px;">Multi-Role &amp; Capability Architecture Audit</h2>
                <p class="text-light opacity-75 mt-2 mb-0" style="font-size: 14px;">Diagnostic inspection of user roles, capabilities, business access, and course independence across the ecosystem.</p>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <a href="/admin/network/users" class="btn btn-outline-light px-3 py-2">
                    <i class="fa-solid fa-arrow-left me-1"></i> Back to Users Directory
                </a>
                <button type="button" class="btn btn-light px-3 py-2" onclick="window.location.reload()">
                    <i class="fa-solid fa-rotate me-1"></i> Re-Scan Data
                </button>
            </div>
        </div>
    </div>

    <!-- METRICS -->
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card p-3 border-0 shadow-sm" style="border-radius: 16px; border-left: 4px solid #1d4ed8 !important;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted text-uppercase fw-bold" style="font-size: 11px;">Total Accounts Scanned</small>
                        <h2 class="fw-bold m-0 mt-1 text-dark">{{totalScanned}}</h2>
                    </div>
                    <div class="rounded-circle p-3 bg-primary-subtle text-primary">
                        <i class="fa-solid fa-users fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card p-3 border-0 shadow-sm" style="border-radius: 16px; border-left: 4px solid #16a34a !important;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted text-uppercase fw-bold" style="font-size: 11px;">Consistent Profiles</small>
                        <h2 class="fw-bold m-0 mt-1 text-success">{{consistentCount}}</h2>
                    </div>
                    <div class="rounded-circle p-3 bg-success-subtle text-success">
                        <i class="fa-solid fa-circle-check fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card p-3 border-0 shadow-sm" style="border-radius: 16px; border-left: 4px solid #f59e0b !important;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted text-uppercase fw-bold" style="font-size: 11px;">Inconsistent / Pending Normalization</small>
                        <h2 class="fw-bold m-0 mt-1 text-warning">{{inconsistentCount}}</h2>
                    </div>
                    <div class="rounded-circle p-3 bg-warning-subtle text-warning">
                        <i class="fa-solid fa-triangle-exclamation fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ARCHITECTURAL PRINCIPLES BANNER -->
    <div class="alert alert-info border-0 shadow-sm p-4 mb-4" style="border-radius: 16px;">
        <h5 class="fw-bold text-info-emphasis mb-2"><i class="fa-solid fa-circle-info me-2"></i> Authority &amp; Semantic Invariants</h5>
        <div class="row g-3 small text-muted">
            <div class="col-md-4">
                <strong>Primary Role &ne; Capabilities:</strong> Primary role represents preferred ecosystem identity. Capabilities are computed action permissions (e.g., <code>ACCESS_COURSES</code>, <code>MANAGE_BUSINESS</code>), not role strings.
            </div>
            <div class="col-md-4">
                <strong>Business Authorization Gating:</strong> <code>FOUNDER</code> and <code>RECRUITER</code> roles do not confer automatic business management without an approved organization ownership or active membership.
            </div>
            <div class="col-md-4">
                <strong>Course Independence:</strong> Course enrollments represent learning and never force <code>primaryRole = 'STUDENT'</code>. A Founder or Professional who studies remains Founder/Professional.
            </div>
        </div>
    </div>

    <!-- AUDIT REPORTS TABLE -->
    <div class="card border-0 shadow-sm" style="border-radius: 16px; overflow: hidden;">
        <div class="card-header bg-white py-3 px-4 border-0 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold m-0" style="color:var(--brand);">
                <i class="fa-solid fa-clipboard-check text-primary me-2"></i> Diagnostic Findings
            </h5>
            <span class="badge bg-light text-muted border">Strict Dry-Run Diagnostics</span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px;">
                    <tr>
                        <th class="ps-4">User</th>
                        <th>Current State</th>
                        <th>Semantic Inconsistencies</th>
                        <th>Proposed Normalization</th>
                        <th>Confidence</th>
                        <th class="text-end pe-4">Governance Action</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each reports}}
                    <tr>
                        <td class="ps-4">
                            <div class="fw-bold text-dark">{{this.displayName}}</div>
                            <div class="text-muted small">@{{this.username}}</div>
                            <div class="text-muted" style="font-size: 10px;">ID: <code>{{this.userId}}</code></div>
                        </td>
                        <td>
                            <div class="d-flex flex-column gap-1">
                                <div><small class="text-muted">Primary:</small> <span class="badge bg-light text-dark border">{{this.currentPrimaryRole}}</span></div>
                                <div><small class="text-muted">Roles:</small> <code class="small">{{json this.currentRoles}}</code></div>
                                <div><small class="text-muted">Caps:</small> <code class="small">{{json this.currentCapabilities}}</code></div>
                            </div>
                        </td>
                        <td>
                            {{#if this.inconsistencies.length}}
                            <div class="d-flex flex-column gap-1">
                                {{#each this.inconsistencies}}
                                <div class="badge {{#ifEquals this.severity 'ERROR'}}bg-danger-subtle text-danger border border-danger-subtle{{else}}bg-warning-subtle text-warning-emphasis border border-warning-subtle{{/ifEquals}} text-start p-1.5" style="font-size: 11px; white-space: normal;">
                                    <strong>{{this.code}}:</strong> {{this.message}}
                                </div>
                                {{/each}}
                            </div>
                            {{else}}
                            <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="fa-solid fa-check me-1"></i> Consistent</span>
                            {{/if}}
                        </td>
                        <td>
                            <div class="p-2 rounded bg-light border" style="font-size: 11px; line-height: 1.4;">
                                <div><strong>primaryRole:</strong> <span class="text-primary">{{this.normalizedProposal.primaryRole}}</span></div>
                                <div><strong>roles:</strong> {{json this.normalizedProposal.roles}}</div>
                                <div><strong>capabilities:</strong> {{json this.normalizedProposal.capabilities}}</div>
                            </div>
                        </td>
                        <td>
                            <span class="badge {{#ifEquals this.confidence 'HIGH'}}bg-success{{else}}bg-warning text-dark{{/ifEquals}}">
                                {{this.confidence}}
                            </span>
                        </td>
                        <td class="text-end pe-4">
                            <a href="/admin/network/users/{{this.userId}}" class="btn btn-sm btn-outline-primary" title="Govern Profile in User Dossier">
                                <i class="fa-solid fa-user-gear me-1"></i> Manage
                            </a>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>

</div>
