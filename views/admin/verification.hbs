<div class="container-fluid dashboard-wrapper">

  <!-- PAGE HEADER -->
  <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
    <div>
      <div class="d-flex align-items-center gap-2 mb-1">
        <span class="badge bg-primary-subtle text-primary border px-2.5 py-1 rounded-pill" style="font-size: 11px; font-weight: 700;">
          <i class="fa-solid fa-shield-check me-1"></i> Governance Tier
        </span>
        <h2 class="fw-bold m-0" style="color: var(--text); font-size: 24px; letter-spacing: -0.5px;">Verification Review Center</h2>
      </div>
      <p class="text-muted m-0" style="font-size: 13.5px;">
        Multi-category credential and identity verification triage with zero-trust evidence isolation.
      </p>
    </div>

    <div class="d-flex align-items-center gap-2">
      {{> admin/view-toggle section="verification" total=total itemLabel="requests" viewMode=viewMode}}
    </div>
  </div>

  <!-- KPI SUMMARY STATS -->
  <div class="row g-3 mb-4">
    <div class="col-xl-2 col-md-4 col-6">
      <div class="p-3 bg-surface border rounded-3 h-100 shadow-xs">
        <span class="text-muted small d-block">Total Requests</span>
        <h4 class="fw-bold m-0 mt-1" style="color: var(--text);">{{stats.total}}</h4>
      </div>
    </div>
    <div class="col-xl-2 col-md-4 col-6">
      <div class="p-3 bg-surface border rounded-3 h-100 shadow-xs">
        <span class="text-warning small d-block"><i class="fa-solid fa-clock me-1"></i> Pending Review</span>
        <h4 class="fw-bold m-0 mt-1 text-warning">{{stats.pending}}</h4>
      </div>
    </div>
    <div class="col-xl-2 col-md-4 col-6">
      <div class="p-3 bg-surface border rounded-3 h-100 shadow-xs">
        <span class="text-success small d-block"><i class="fa-solid fa-circle-check me-1"></i> Verified</span>
        <h4 class="fw-bold m-0 mt-1 text-success">{{stats.verified}}</h4>
      </div>
    </div>
    <div class="col-xl-2 col-md-4 col-6">
      <div class="p-3 bg-surface border rounded-3 h-100 shadow-xs">
        <span class="text-danger small d-block"><i class="fa-solid fa-circle-xmark me-1"></i> Rejected</span>
        <h4 class="fw-bold m-0 mt-1 text-danger">{{stats.rejected}}</h4>
      </div>
    </div>
    <div class="col-xl-2 col-md-4 col-6">
      <div class="p-3 bg-surface border rounded-3 h-100 shadow-xs">
        <span class="text-muted small d-block"><i class="fa-solid fa-hourglass-end me-1"></i> Expired</span>
        <h4 class="fw-bold m-0 mt-1 text-muted">{{stats.expired}}</h4>
      </div>
    </div>
    <div class="col-xl-2 col-md-4 col-6">
      <div class="p-3 bg-surface border rounded-3 h-100 shadow-xs">
        <span class="text-info small d-block"><i class="fa-solid fa-graduation-cap me-1"></i> Educators</span>
        <h4 class="fw-bold m-0 mt-1 text-info">{{stats.educator}}</h4>
      </div>
    </div>
  </div>

  <!-- TOOLBAR & FILTERS -->
  <div class="admin-toolbar-container">
    <div class="toolbar-left">
      <form action="/admin/verification" method="GET" class="toolbar-search-form" role="search">
        {{#if viewMode}}<input type="hidden" name="view" value="{{viewMode}}">{{/if}}
        {{#if filters.category}}<input type="hidden" name="category" value="{{filters.category}}">{{/if}}
        {{#if filters.status}}<input type="hidden" name="status" value="{{filters.status}}">{{/if}}
        <div class="toolbar-search-box">
          <i class="fa-solid fa-magnifying-glass search-icon"></i>
          <input type="text" name="search" value="{{filters.search}}" class="toolbar-search-input" placeholder="Search applicant, email, reference ID..." aria-label="Search verification requests">
          {{#if filters.search}}
          <a href="/admin/verification{{#if viewMode}}?view={{viewMode}}{{/if}}" class="search-clear-btn" title="Clear search">
            <i class="fa-solid fa-xmark"></i>
          </a>
          {{/if}}
        </div>
        <button type="submit" class="admin-btn admin-btn-secondary">Search</button>
      </form>
    </div>

    <div class="toolbar-right">
      <!-- Status Pills Filter -->
      <div class="d-flex align-items-center gap-1.5 flex-wrap">
        <a href="?status=all{{#if viewMode}}&view={{viewMode}}{{/if}}{{#if filters.category}}&category={{filters.category}}{{/if}}{{#if filters.search}}&search={{filters.search}}{{/if}}" 
           class="admin-btn admin-btn-sm {{#ifEquals filters.status 'all'}}admin-btn-primary{{else}}admin-btn-outline{{/ifEquals}}" style="min-height: 34px; padding: 4px 10px; font-size: 12px;">All</a>
        <a href="?status=PENDING{{#if viewMode}}&view={{viewMode}}{{/if}}{{#if filters.category}}&category={{filters.category}}{{/if}}{{#if filters.search}}&search={{filters.search}}{{/if}}" 
           class="admin-btn admin-btn-sm {{#ifEquals filters.status 'PENDING'}}admin-btn-primary{{else}}admin-btn-outline{{/ifEquals}}" style="min-height: 34px; padding: 4px 10px; font-size: 12px;">Pending</a>
        <a href="?status=VERIFIED{{#if viewMode}}&view={{viewMode}}{{/if}}{{#if filters.category}}&category={{filters.category}}{{/if}}{{#if filters.search}}&search={{filters.search}}{{/if}}" 
           class="admin-btn admin-btn-sm {{#ifEquals filters.status 'VERIFIED'}}admin-btn-primary{{else}}admin-btn-outline{{/ifEquals}}" style="min-height: 34px; padding: 4px 10px; font-size: 12px;">Verified</a>
        <a href="?status=REJECTED{{#if viewMode}}&view={{viewMode}}{{/if}}{{#if filters.category}}&category={{filters.category}}{{/if}}{{#if filters.search}}&search={{filters.search}}{{/if}}" 
           class="admin-btn admin-btn-sm {{#ifEquals filters.status 'REJECTED'}}admin-btn-primary{{else}}admin-btn-outline{{/ifEquals}}" style="min-height: 34px; padding: 4px 10px; font-size: 12px;">Rejected</a>
      </div>

      <!-- Category Filter Dropdown -->
      <form action="/admin/verification" method="GET" class="d-inline-flex align-items-center">
        {{#if viewMode}}<input type="hidden" name="view" value="{{viewMode}}">{{/if}}
        {{#if filters.status}}<input type="hidden" name="status" value="{{filters.status}}">{{/if}}
        <select name="category" class="form-select form-select-sm" onchange="this.form.submit()" style="background: var(--surface-2); border-color: var(--border); color: var(--text); min-height: 36px; border-radius: 9px; font-size: 12.5px;">
          <option value="all" {{#ifEquals filters.category 'all'}}selected{{/ifEquals}}>All Categories</option>
          <option value="IDENTITY" {{#ifEquals filters.category 'IDENTITY'}}selected{{/ifEquals}}>Identity</option>
          <option value="PROFESSIONAL" {{#ifEquals filters.category 'PROFESSIONAL'}}selected{{/ifEquals}}>Professional</option>
          <option value="BUSINESS_AFFILIATION" {{#ifEquals filters.category 'BUSINESS_AFFILIATION'}}selected{{/ifEquals}}>Business Affiliation</option>
          <option value="CERTIFICATION" {{#ifEquals filters.category 'CERTIFICATION'}}selected{{/ifEquals}}>Certification</option>
          <option value="EDUCATOR" {{#ifEquals filters.category 'EDUCATOR'}}selected{{/ifEquals}}>Educator</option>
        </select>
      </form>
    </div>
  </div>

  {{#if records.length}}

    {{!-- 1. CARD VIEW (DEFAULT) --}}
    <div id="view-card-verification" class="admin-view-panel {{#ifEquals viewMode 'table'}}d-none{{/ifEquals}}">
      <div class="admin-card-grid">
        {{#each records}}
        <div class="admin-governance-card">
          <div class="admin-card-header">
            <div class="d-flex align-items-center gap-3">
              <div class="user-avatar-badge" style="width: 44px; height: 44px; font-size: 16px; border-radius: 12px;">
                {{#if this.targetName}}{{this.targetName.[0]}}{{else}}V{{/if}}
              </div>
              <div>
                <h4 class="m-0 fw-bold" style="font-size: 15px; color: var(--text);">{{this.targetName}}</h4>
                <span class="text-muted" style="font-size: 12px;">{{this.targetEmail}}</span>
              </div>
            </div>
            <div>
              {{> admin/admin-status-badge status=this.status}}
            </div>
          </div>

          <div class="admin-card-body p-3 flex-grow-1">
            <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
              <span class="badge bg-surface-2 text-primary border" style="font-size: 11px; font-weight: 600;">
                <i class="fa-solid fa-tag me-1"></i> {{this.category}}
              </span>
              {{#if this.referenceNumber}}
              <span class="badge bg-surface-2 text-muted border" style="font-size: 11px;">
                Ref: {{this.referenceNumber}}
              </span>
              {{/if}}
            </div>

            <div class="bg-surface-2 p-2.5 rounded-2 mb-3 border" style="font-size: 12.5px;">
              <div class="d-flex justify-content-between mb-1">
                <span class="text-muted">Target Entity:</span>
                <strong style="color: var(--text);">{{this.targetType}}</strong>
              </div>
              <div class="d-flex justify-content-between mb-1">
                <span class="text-muted">Submitted:</span>
                <span style="color: var(--text);">{{formatDateTime this.createdAt}}</span>
              </div>
              <div class="d-flex justify-content-between">
                <span class="text-muted">Evidence Status:</span>
                {{#if this.evidenceRedacted}}
                <span class="text-warning"><i class="fa-solid fa-lock me-1"></i> Protected / Redacted</span>
                {{else}}
                <span class="text-success"><i class="fa-solid fa-unlock me-1"></i> Authorized Access</span>
                {{/if}}
              </div>
            </div>

            {{#if this.notes}}
            <p class="text-muted mb-0" style="font-size: 12px; line-height: 1.4;">
              <strong>Notes:</strong> {{truncate this.notes 80}}
            </p>
            {{/if}}
          </div>

          <div class="admin-card-footer p-3 border-top d-flex align-items-center justify-content-between gap-2">
            <button type="button" class="admin-btn admin-btn-outline" style="min-height: 36px; padding: 6px 12px; font-size: 12px;" onclick="inspectVerification('{{this._id}}')">
              <i class="fa-solid fa-magnifying-glass"></i>
              <span>Inspect</span>
            </button>

            {{#if (or @root.canManageVerification @root.isSuperuser)}}
            <div class="d-flex align-items-center gap-1.5">
              {{#ifEquals this.status 'PENDING'}}
              <button type="button" class="admin-btn admin-btn-primary" style="min-height: 36px; padding: 6px 12px; font-size: 12px;" onclick="openReviewModal('{{this._id}}', '{{this.targetName}}', 'VERIFIED')">
                <i class="fa-solid fa-check"></i>
                <span>Approve</span>
              </button>
              <button type="button" class="admin-btn admin-btn-danger" style="min-height: 36px; padding: 6px 12px; font-size: 12px;" onclick="openReviewModal('{{this._id}}', '{{this.targetName}}', 'REJECTED')">
                <i class="fa-solid fa-xmark"></i>
                <span>Reject</span>
              </button>
              {{else}}
              <button type="button" class="admin-btn admin-btn-secondary" style="min-height: 36px; padding: 6px 12px; font-size: 12px;" onclick="openReviewModal('{{this._id}}', '{{this.targetName}}', '{{this.status}}')">
                <i class="fa-solid fa-pen"></i>
                <span>Re-evaluate</span>
              </button>
              {{/ifEquals}}
            </div>
            {{/if}}
          </div>
        </div>
        {{/each}}
      </div>
    </div>

    {{!-- 2. TABLE VIEW --}}
    <div id="view-table-verification" class="admin-view-panel {{#unless (eq viewMode 'table')}}d-none{{/unless}}">
      <div class="admin-table-container">
        <div class="admin-table-responsive">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Applicant</th>
                <th>Category</th>
                <th>Target Type</th>
                <th>Evidence Isolation</th>
                <th>Status</th>
                <th>Submitted</th>
                <th>Reviewer</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              {{#each records}}
              <tr>
                <td>
                  <div class="d-flex align-items-center gap-2.5">
                    <div class="user-avatar-badge" style="width: 34px; height: 34px; font-size: 13px;">
                      {{#if this.targetName}}{{this.targetName.[0]}}{{else}}V{{/if}}
                    </div>
                    <div>
                      <strong class="d-block text-dark" style="font-size: 13.5px;">{{this.targetName}}</strong>
                      <span class="text-muted" style="font-size: 12px;">{{this.targetEmail}}</span>
                    </div>
                  </div>
                </td>
                <td>
                  <span class="badge bg-surface-2 text-primary border" style="font-size: 11px;">{{this.category}}</span>
                </td>
                <td>
                  <span style="font-size: 13px;">{{this.targetType}}</span>
                </td>
                <td>
                  {{#if this.evidenceRedacted}}
                  <span class="badge bg-warning-subtle text-warning border" style="font-size: 11px;">
                    <i class="fa-solid fa-shield me-1"></i> Redacted
                  </span>
                  {{else}}
                  <span class="badge bg-success-subtle text-success border" style="font-size: 11px;">
                    <i class="fa-solid fa-shield-check me-1"></i> Authorized
                  </span>
                  {{/if}}
                </td>
                <td>
                  {{> admin/admin-status-badge status=this.status}}
                </td>
                <td class="text-muted" style="font-size: 12.5px;">
                  {{formatDateTime this.createdAt}}
                </td>
                <td style="font-size: 12.5px;">
                  {{#if this.reviewedBy.name}}
                  <span class="text-dark">{{this.reviewedBy.name}}</span>
                  {{else}}
                  <span class="text-muted">—</span>
                  {{/if}}
                </td>
                <td class="text-end">
                  <div class="d-inline-flex align-items-center gap-1.5">
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="inspectVerification('{{this._id}}')" title="Inspect evidence">
                      <i class="fa-solid fa-eye"></i>
                    </button>
                    {{#if (or @root.canManageVerification @root.isSuperuser)}}
                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="openReviewModal('{{this._id}}', '{{this.targetName}}', '{{this.status}}')" title="Review request">
                      <i class="fa-solid fa-gavel"></i>
                    </button>
                    {{/if}}
                  </div>
                </td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- PAGINATION -->
    {{> admin/admin-pagination totalPages=totalPages page=page total=total viewMode=viewMode filters=filters}}

  {{else}}
    {{> admin/admin-empty-state icon="fa-solid fa-id-card" title="No verification requests" message="No pending or historical verification items match the selected category or status criteria." actionUrl="/admin/verification" actionLabel="Clear Filters"}}
  {{/if}}

</div>

<!-- REVIEW ACTION MODAL -->
<div class="admin-modal-backdrop" id="reviewModal" style="display: none;">
  <div class="admin-modal-container admin-modal-md">
    <div class="admin-modal-header">
      <div class="admin-modal-title-group">
        <i class="fa-solid fa-shield-check modal-title-icon"></i>
        <div>
          <h3 class="admin-modal-title" id="reviewModalTitle">Review Verification Request</h3>
          <p class="admin-modal-subtitle" id="reviewModalApplicant"></p>
        </div>
      </div>
      <button type="button" class="admin-modal-close-btn" onclick="closeReviewModal()">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <form id="reviewActionForm" method="POST">
      <div class="admin-modal-body">
        <div class="mb-3">
          <label class="form-label fw-bold" style="font-size: 13px;">Decision Status</label>
          <select name="status" id="reviewStatusSelect" class="form-select" required style="background: var(--surface-2); border-color: var(--border); color: var(--text);">
            <option value="VERIFIED">VERIFIED (Approve Credentials)</option>
            <option value="REJECTED">REJECTED (Deny Credentials)</option>
            <option value="EXPIRED">EXPIRED (Mark Expired)</option>
            <option value="UNDER_REVIEW">UNDER_REVIEW (Triage / Request Info)</option>
          </select>
        </div>

        <div class="mb-3" id="rejectionReasonWrap" style="display: none;">
          <label class="form-label fw-bold text-danger" style="font-size: 13px;">Reason for Rejection *</label>
          <textarea name="rejectionReason" id="rejectionReasonInput" class="form-control" rows="2" placeholder="Specify reason for credential rejection..." style="background: var(--surface-2); border-color: var(--border); color: var(--text); font-size: 13px;"></textarea>
        </div>

        <div class="mb-3">
          <label class="form-label fw-bold" style="font-size: 13px;">Administrative Audit Notes</label>
          <textarea name="notes" id="reviewNotesInput" class="form-control" rows="3" placeholder="Add governance notes, reviewed credentials, or validation timestamps..." style="background: var(--surface-2); border-color: var(--border); color: var(--text); font-size: 13px;"></textarea>
          <small class="text-muted">Recorded into the permanent zero-trust audit trail.</small>
        </div>
      </div>

      <div class="admin-modal-footer">
        <button type="button" class="admin-btn admin-btn-secondary" onclick="closeReviewModal()">Cancel</button>
        <button type="submit" class="admin-btn admin-btn-primary" id="btnSubmitReview">
          <i class="fa-solid fa-check"></i>
          <span>Save Decision</span>
        </button>
      </div>
    </form>
  </div>
</div>

<!-- INSPECT EVIDENCE MODAL -->
<div class="admin-modal-backdrop" id="inspectModal" style="display: none;">
  <div class="admin-modal-container admin-modal-lg">
    <div class="admin-modal-header">
      <div class="admin-modal-title-group">
        <i class="fa-solid fa-magnifying-glass modal-title-icon"></i>
        <div>
          <h3 class="admin-modal-title">Verification Request Evidence</h3>
          <p class="admin-modal-subtitle" id="inspectApplicantSubtitle"></p>
        </div>
      </div>
      <button type="button" class="admin-modal-close-btn" onclick="closeInspectModal()">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <div class="admin-modal-body" id="inspectModalBody">
      <div class="text-center py-4">
        <i class="fa-solid fa-circle-notch fa-spin fs-4 text-primary"></i>
        <p class="text-muted mt-2" style="font-size: 13px;">Loading protected verification record...</p>
      </div>
    </div>

    <div class="admin-modal-footer">
      <button type="button" class="admin-btn admin-btn-secondary" onclick="closeInspectModal()">Close</button>
    </div>
  </div>
</div>

<script>
  function openReviewModal(id, applicantName, defaultStatus) {
    const modal = document.getElementById('reviewModal');
    const form = document.getElementById('reviewActionForm');
    const applicantEl = document.getElementById('reviewModalApplicant');
    const statusSelect = document.getElementById('reviewStatusSelect');
    const rejectWrap = document.getElementById('rejectionReasonWrap');

    form.action = '/admin/verification/' + id + '/review';
    applicantEl.textContent = 'Applicant: ' + applicantName;
    if (defaultStatus && statusSelect.querySelector('option[value="' + defaultStatus + '"]')) {
      statusSelect.value = defaultStatus;
    }
    
    rejectWrap.style.display = statusSelect.value === 'REJECTED' ? 'block' : 'none';
    statusSelect.onchange = function() {
      rejectWrap.style.display = this.value === 'REJECTED' ? 'block' : 'none';
      if (this.value === 'REJECTED') {
        document.getElementById('rejectionReasonInput').setAttribute('required', 'required');
      } else {
        document.getElementById('rejectionReasonInput').removeAttribute('required');
      }
    };

    modal.style.display = 'flex';
  }

  function closeReviewModal() {
    document.getElementById('reviewModal').style.display = 'none';
  }

  async function inspectVerification(id) {
    const modal = document.getElementById('inspectModal');
    const body = document.getElementById('inspectModalBody');
    const sub = document.getElementById('inspectApplicantSubtitle');
    modal.style.display = 'flex';
    body.innerHTML = '<div class="text-center py-4"><i class="fa-solid fa-circle-notch fa-spin fs-4 text-primary"></i><p class="text-muted mt-2">Loading protected verification record...</p></div>';

    try {
      const res = await fetch('/admin/verification/' + id, {
        headers: { 'Accept': 'application/json' }
      });
      const data = await res.json();
      if (!data.success || !data.details) {
        body.innerHTML = '<div class="alert alert-danger">Failed to load request: ' + (data.message || 'Unknown error') + '</div>';
        return;
      }

      const d = data.details;
      sub.textContent = d.targetName + ' (' + d.category + ')';

      let html = '<div class="row g-3">';
      html += '<div class="col-md-6"><div class="p-3 bg-surface-2 rounded-2 border"><small class="text-muted d-block">Target Name</small><strong>' + (d.targetName || '—') + '</strong></div></div>';
      html += '<div class="col-md-6"><div class="p-3 bg-surface-2 rounded-2 border"><small class="text-muted d-block">Target Email</small><strong>' + (d.targetEmail || '—') + '</strong></div></div>';
      html += '<div class="col-md-6"><div class="p-3 bg-surface-2 rounded-2 border"><small class="text-muted d-block">Category</small><strong>' + (d.category || '—') + '</strong></div></div>';
      html += '<div class="col-md-6"><div class="p-3 bg-surface-2 rounded-2 border"><small class="text-muted d-block">Status</small><strong>' + (d.status || '—') + '</strong></div></div>';
      
      html += '<div class="col-12"><div class="p-3 bg-surface-2 rounded-2 border"><h6 class="fw-bold mb-2">Evidence & Documentation</h6>';
      if (d.evidenceRedacted) {
        html += '<div class="alert alert-warning mb-0"><i class="fa-solid fa-lock me-2"></i><strong>Evidence Protected:</strong> You do not possess the <code>view_verification_evidence</code> capability required to inspect raw identification documents.</div>';
      } else {
        if (d.evidenceUrl) {
          html += '<p class="mb-2"><a href="' + d.evidenceUrl + '" target="_blank" class="admin-btn admin-btn-sm admin-btn-primary"><i class="fa-solid fa-file-arrow-down me-1"></i> Open Evidence File</a></p>';
        }
        if (d.attachments && d.attachments.length) {
          html += '<ul class="list-unstyled mb-0">';
          d.attachments.forEach(function(att) {
            html += '<li class="mb-1"><i class="fa-solid fa-paperclip text-muted me-2"></i>' + att.name + '</li>';
          });
          html += '</ul>';
        }
        if (!d.evidenceUrl && (!d.attachments || !d.attachments.length)) {
          html += '<p class="text-muted mb-0">No direct document URL attached.</p>';
        }
      }
      html += '</div></div>';

      if (d.notes) {
        html += '<div class="col-12"><div class="p-3 bg-surface-2 rounded-2 border"><small class="text-muted d-block">Notes</small><p class="m-0">' + d.notes + '</p></div></div>';
      }

      html += '</div>';
      body.innerHTML = html;
    } catch (err) {
      body.innerHTML = '<div class="alert alert-danger">Error fetching verification record: ' + err.message + '</div>';
    }
  }

  function closeInspectModal() {
    document.getElementById('inspectModal').style.display = 'none';
  }
</script>
