<link rel="stylesheet" href="/stylesheets/gamification.css">

<div class="container-fluid mt-3 mb-5">

  <!-- HERO HEADER -->
  <div class="gamification-hero">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
      <div>
        <div class="hero-tag">
          <i class="fa-solid fa-layer-group"></i> Course Performance
        </div>
        <h1>Course Leaderboards</h1>
        <p>
          Explore learner achievement, engagement, and rankings across each individual Zeitnah course.
        </p>
      </div>

      <div class="d-flex align-items-center gap-2">
        <a href="/admin/leaderboard" class="btn btn-outline-secondary px-3 py-2" style="font-size:13px; font-weight:600;">
          <i class="fa-solid fa-earth-americas me-1"></i> Global Leaderboard
        </a>
      </div>
    </div>
  </div>

  <!-- TOOLBAR: SEARCH COURSES -->
  <div class="gamification-toolbar">
    <div class="search-field" style="max-width: 380px;">
      <i class="fa-solid fa-magnifying-glass"></i>
      <input type="text" id="courseSearchInput" placeholder="Search course name..." onkeyup="filterCourseCards(this.value)">
    </div>

    <div class="d-flex align-items-center gap-2">
      <span style="font-size:13px; color:var(--muted); font-weight:600;">
        Showing {{courses.length}} Courses
      </span>
    </div>
  </div>

  <!-- COURSES GRID -->
  {{#if courses.length}}
  <div class="row g-4" id="coursesGrid">
    {{#each courses}}
    <div class="col-xl-3 col-lg-4 col-md-6 course-item-wrap" data-title="{{this.name}}">
      <div class="course-perf-card h-100 d-flex flex-column">

        <div class="d-flex align-items-center gap-3 mb-3">
          <img src="{{this.imageUrl}}" alt="{{this.name}}" class="rounded-3"
               style="width: 52px; height: 52px; object-fit: cover; border: 1px solid var(--border);"
               onerror="this.onerror=null;this.src='/img/placeholders/course-cover.svg';">
          <div class="min-w-0">
            <h5 class="fw-bold mb-1 text-truncate" title="{{this.name}}" style="font-size:15px;">
              {{this.name}}
            </h5>
            <small class="text-muted d-block" style="font-size:12px;">
              {{#if this.type}}{{this.type}}{{else}}Comprehensive Course{{/if}}
            </small>
          </div>
        </div>

        <div class="d-flex align-items-center justify-content-between p-3 rounded-3 mb-3" style="background:var(--card-solid); border:1px solid var(--border);">
          <div>
            <small class="text-muted d-block text-uppercase" style="font-size:10px; font-weight:700; letter-spacing:0.5px;">Enrolled</small>
            <strong style="font-size:16px;">{{this.studentCount}} Learners</strong>
          </div>
          <div class="text-end">
            <small class="text-muted d-block text-uppercase" style="font-size:10px; font-weight:700; letter-spacing:0.5px;">Avg XP</small>
            <strong class="text-warning" style="font-size:16px;">{{this.averageXP}} XP</strong>
          </div>
        </div>

        <div class="mt-auto">
          <a href="/admin/leaderboard/course/{{this._id}}" class="btn btn-outline-success w-100 py-2 d-flex align-items-center justify-content-center gap-2" style="font-size:13px; font-weight:700;">
            <i class="fa-solid fa-ranking-star"></i> View Course Leaderboard
          </a>
        </div>

      </div>
    </div>
    {{/each}}
  </div>
  {{else}}
  <!-- EMPTY STATE -->
  <div class="text-center py-5">
    <i class="fa-solid fa-book-open text-muted mb-3" style="font-size:48px; opacity:0.3;"></i>
    <h5 class="fw-bold text-muted mb-2">No courses found</h5>
    <p class="text-muted" style="font-size:14px;">Once courses are created, their leaderboards will appear here.</p>
  </div>
  {{/if}}

</div>

<script>
function filterCourseCards(query) {
  const term = String(query || '').trim().toLowerCase();
  const items = document.querySelectorAll('.course-item-wrap');
  items.forEach(el => {
    const title = el.getAttribute('data-title').toLowerCase();
    el.style.display = title.includes(term) ? '' : 'none';
  });
}
</script>
