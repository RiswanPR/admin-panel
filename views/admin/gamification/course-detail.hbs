<link rel="stylesheet" href="/stylesheets/gamification.css">

<div class="container-fluid mt-3 mb-5">

  <!-- BREADCRUMB & HEADER -->
  <div class="gamification-hero">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
      <div>
        <div class="d-flex align-items-center gap-2 mb-2">
          <a href="/admin/leaderboard/courses" class="text-decoration-none text-muted" style="font-size:13px; font-weight:600;">
            <i class="fa-solid fa-arrow-left me-1"></i> All Courses
          </a>
          <span class="text-muted">&bull;</span>
          <span class="badge bg-success" style="font-size:11px;">Course Leaderboard</span>
        </div>
        <h1>{{course.name}}</h1>
        <p>
          Learner performance, rankings, and completion momentum for this specific course.
        </p>
      </div>

      <div class="d-flex align-items-center gap-2">
        <button type="button" class="btn btn-success px-4 py-2" style="font-size:13px; font-weight:700;"
                onclick="openAwardPointsModal({ mode: 'award', scope: 'course', courseId: '{{course._id}}' })">
          <i class="fa-solid fa-plus me-1"></i> Award Course XP
        </button>
      </div>
    </div>
  </div>

  <!-- COURSE KPIS -->
  {{> gamification/kpi-cards kpis=kpis isCourseLeaderboard=true}}

  <!-- COURSE PODIUM -->
  {{> gamification/podium podium=podium teacherPanel=false}}

  <!-- TOOLBAR -->
  <div class="gamification-toolbar">
    <div class="search-field">
      <i class="fa-solid fa-magnifying-glass"></i>
      <input type="text" placeholder="Search enrolled student..." value="{{filters.search}}"
             oninput="onSearchInputChange(this)">
    </div>

    <div class="d-flex align-items-center gap-2">
      <span style="font-size:12px; color:var(--muted); font-weight:600;">Show:</span>
      <select class="filter-select" onchange="updateLeaderboardFilter('limit', this.value)">
        <option value="25" {{selected pagination.limit '25'}}>25</option>
        <option value="50" {{selected pagination.limit '50'}}>50</option>
        <option value="100" {{selected pagination.limit '100'}}>100</option>
      </select>
    </div>
  </div>

  <!-- LEADERBOARD TABLE -->
  <div class="leaderboard-table-card">
    {{#if students.length}}
    <table class="leaderboard-table">
      <thead>
        <tr>
          <th style="width: 70px; text-align: center;">Rank</th>
          <th>Student</th>
          <th>Level</th>
          <th>Course XP</th>
          <th>Course Completion</th>
          <th>Classes</th>
          <th>Streak</th>
          <th>Last Active</th>
          <th style="text-align: right;">Actions</th>
        </tr>
      </thead>
      <tbody>
        {{#each students}}
        <tr class="leaderboard-row" id="row-{{this._id}}">
          <!-- Rank -->
          <td class="rank-badge-cell" data-label="Rank">
            {{#ifEquals this.rank 1}}
              <span class="rank-pill rank-1-pill"><i class="fa-solid fa-crown" style="font-size:10px; margin-right:2px;"></i>1</span>
            {{else}}
              {{#ifEquals this.rank 2}}
                <span class="rank-pill rank-2-pill">2</span>
              {{else}}
                {{#ifEquals this.rank 3}}
                  <span class="rank-pill rank-3-pill">3</span>
                {{else}}
                  <span class="rank-pill rank-other-pill">#{{this.rank}}</span>
                {{/ifEquals}}
              {{/ifEquals}}
            {{/ifEquals}}
          </td>

          <!-- Student -->
          <td data-label="Student">
            <div class="student-cell">
              {{#if this.imageUrl}}
              <img src="{{this.imageUrl}}" alt="{{this.displayName}}" class="student-table-avatar"
                   onerror="this.onerror=null;this.src='/img/placeholders/profile.svg';">
              {{else}}
              <div class="student-table-initials">{{this.initials}}</div>
              {{/if}}
              <div class="student-meta-info">
                <a href="/admin/leaderboard/student/{{this._id}}" class="student-cell-name">
                  {{this.displayName}}
                </a>
                <span class="student-cell-username">{{this.username}}</span>
              </div>
            </div>
          </td>

          <!-- Level -->
          <td data-label="Level">
            <span class="level-badge">
              <i class="fa-solid fa-bolt"></i> Lvl {{this.level}}
            </span>
          </td>

          <!-- Course XP -->
          <td data-label="Course XP">
            <div class="points-cell">
              {{this.courseXP}}<span>XP</span>
            </div>
            <small class="text-muted" style="font-size:11px;">Global: {{this.globalXP}} XP</small>
          </td>

          <!-- Completion % -->
          <td data-label="Completion">
            <div style="min-width: 130px;">
              <div class="d-flex justify-content-between mb-1" style="font-size:12px; font-weight:700;">
                <span>{{this.completionPercent}}%</span>
              </div>
              <div class="progress" style="height: 6px; border-radius: 6px; background: var(--progress-bg);">
                <div class="progress-bar bg-success" role="progressbar" style="width: {{this.completionPercent}}%; border-radius: 6px;"
                     aria-valuenow="{{this.completionPercent}}" aria-valuemin="0" aria-valuemax="100"></div>
              </div>
            </div>
          </td>

          <!-- Classes -->
          <td data-label="Classes">
            <span class="fw-semibold">{{this.completedClasses}}</span> / {{this.totalClasses}}
          </td>

          <!-- Streak -->
          <td data-label="Streak">
            {{#if this.streak}}
            <span class="streak-pill">
              <i class="fa-solid fa-fire"></i> {{this.streak}}d
            </span>
            {{else}}
            <span class="text-muted" style="font-size:12px;">—</span>
            {{/if}}
          </td>

          <!-- Last Active -->
          <td data-label="Last Active">
            <span class="text-muted" style="font-size:12px;">
              {{formatDate this.lastActive}}
            </span>
          </td>

          <!-- Actions -->
          <td data-label="Actions" style="text-align: right;">
            <div class="dropdown d-inline-block">
              <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="font-size:12px;">
                Actions
              </button>
              <ul class="dropdown-menu dropdown-menu-end shadow-sm" style="font-size:13px;">
                <li>
                  <a class="dropdown-item" href="/admin/leaderboard/student/{{this._id}}">
                    <i class="fa-solid fa-id-badge me-2 text-primary"></i> View Gamification
                  </a>
                </li>
                <li>
                  <button class="dropdown-item text-success" type="button"
                          onclick="openAwardPointsModal({ studentId: '{{this._id}}', studentName: '{{this.displayName}}', studentUsername: '{{this.username}}', currentBalance: {{this.globalXP}}, scope: 'course', courseId: '{{../course._id}}', mode: 'award' })">
                    <i class="fa-solid fa-plus me-2"></i> Award Course XP
                  </button>
                </li>
                <li>
                  <button class="dropdown-item text-danger" type="button"
                          onclick="openAwardPointsModal({ studentId: '{{this._id}}', studentName: '{{this.displayName}}', studentUsername: '{{this.username}}', currentBalance: {{this.globalXP}}, scope: 'course', courseId: '{{../course._id}}', mode: 'adjust' })">
                    <i class="fa-solid fa-minus me-2"></i> Deduct Course XP
                  </button>
                </li>
              </ul>
            </div>
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>

    <!-- PAGINATION -->
    <div class="gamification-pagination">
      <small class="text-muted" style="font-size:13px;">
        Showing {{students.length}} of {{pagination.total}} enrolled students &bull; Page {{pagination.page}} of {{pagination.totalPages}}
      </small>

      <div class="pagination-controls">
        <button class="page-btn" {{#unless pagination.hasPrev}}disabled{{/unless}}
                onclick="updateLeaderboardFilter('page', {{pagination.prevPage}})" title="Previous Page">
          <i class="fa-solid fa-chevron-left"></i>
        </button>

        <span style="font-size:13px; font-weight:700; padding: 0 10px;">
          {{pagination.page}}
        </span>

        <button class="page-btn" {{#unless pagination.hasNext}}disabled{{/unless}}
                onclick="updateLeaderboardFilter('page', {{pagination.nextPage}})" title="Next Page">
          <i class="fa-solid fa-chevron-right"></i>
        </button>
      </div>
    </div>

    {{else}}
    <!-- EMPTY STATE -->
    <div class="text-center py-5">
      <i class="fa-solid fa-user-graduate text-muted mb-3" style="font-size:48px; opacity:0.3;"></i>
      <h5 class="fw-bold text-muted mb-2">No enrolled learners in this course</h5>
      <p class="text-muted" style="font-size:14px;">Students enrolled in this course will automatically be ranked on this leaderboard.</p>
    </div>
    {{/if}}
  </div>

</div>

<!-- AWARD / ADJUST POINTS MODAL -->
{{> gamification/award-modal}}

<script src="/javascripts/gamification.js"></script>
