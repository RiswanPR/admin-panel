<section class="container-fluid mt-4 mb-5">

    <div class="row justify-content-center">
        <div class="col-xl-9 col-lg-10">

            <div class="card border-0 shadow-lg edit-student-card">

                <!-- HEADER -->
                <div class="card-header student-header border-0">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                        <div>
                            <h2 class="m-0 fw-bold text-var(--surface)">
                                Edit Student
                            </h2>
                            <small class="text-light opacity-75">
                                Update learner details
                            </small>
                        </div>

                        <a href="/students" class="btn btn-light">
                            <i class="fa-solid fa-arrow-left me-2"></i>
                            Back
                        </a>

                    </div>
                </div>

                <div class="card-body p-4 p-lg-5">

                    <form action="/edit-student/{{student._id}}" method="POST" enctype="multipart/form-data"
                        id="editStudentForm">

                        <div class="row">

                            <!-- LEFT -->
                            <div class="col-lg-8">

                                <!-- NAME -->
                                <div class="mb-4">
                                    <label class="form-label fw-semibold">
                                        Full Name
                                    </label>

                                    <input type="text" class="form-control custom-input" name="name"
                                        value="{{student.name}}" required>
                                </div>

                                <!-- USERNAME IDENTITY CARD -->
                                <div class="card p-3 mb-4" style="background:rgba(18,49,76,0.18);border:1px solid rgba(159,213,178,0.35);border-radius:16px;">
                                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                                        <div>
                                            <span class="text-muted small text-uppercase fw-bold" style="letter-spacing:0.5px;">Username Identity</span>
                                            <div class="d-flex align-items-center gap-2 mt-1">
                                                <h4 class="mb-0 fw-bold text-white font-monospace">
                                                    {{#if student.username}}@{{student.username}}{{else}}<span class="text-danger small">No username assigned</span>{{/if}}
                                                </h4>
                                                {{#if student.isClaimed}}
                                                <span class="badge bg-success" style="font-size:11px;">✓ Claimed</span>
                                                {{else}}
                                                <span class="badge bg-warning text-dark" style="font-size:11px;">○ Unclaimed</span>
                                                {{/if}}
                                            </div>
                                        </div>

                                        <button type="button" class="btn btn-outline-success btn-sm px-3" onclick="openEditStudentUsernameModal()">
                                            <i class="fa-solid fa-pen-to-square me-1"></i> Change Username
                                        </button>
                                    </div>

                                    <div class="d-flex align-items-center gap-3 text-muted small mt-2 pt-2 border-top border-secondary">
                                        <span><i class="fa-regular fa-clock me-1"></i> Last changed: <strong>{{student.lastChangedDate}}</strong></span>
                                        {{#if student.isCooldownActive}}
                                        <span class="text-warning"><i class="fa-solid fa-triangle-exclamation me-1"></i> Normal user cooldown: {{student.cooldownDaysRemaining}} days left (Admin override active)</span>
                                        {{/if}}
                                    </div>

                                    {{#if usernameHistory.length}}
                                    <div class="mt-3 pt-2 border-top border-secondary">
                                        <small class="text-muted fw-bold d-block mb-1">Recent Identity History:</small>
                                        <ul class="list-unstyled mb-0" style="font-size:11px;">
                                            {{#each usernameHistory}}
                                            <li class="mb-1 text-light">
                                                <span class="badge bg-secondary me-1">{{this.formattedDate}}</span>
                                                <span>{{this.message}}</span>
                                                <span class="text-muted">({{this.reason}})</span>
                                            </li>
                                            {{/each}}
                                        </ul>
                                    </div>
                                    {{/if}}
                                </div>

                                <!-- EMAIL + PHONE -->
                                <div class="row">

                                    <div class="col-md-6">
                                        <div class="mb-4">
                                            <label class="form-label fw-semibold">
                                                Email Address
                                            </label>

                                            <input type="email" class="form-control custom-input" name="email"
                                                value="{{student.email}}" required>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="mb-4">
                                            <label class="form-label fw-semibold">
                                                Phone Number
                                            </label>

                                            <input type="text" class="form-control custom-input" name="Phone_Number"
                                                value="{{student.Phone_Number}}" pattern="[0-9]{10}" maxlength="10"
                                                required>
                                        </div>
                                    </div>

                                </div>

                                <!-- COURSE -->
                                <div class="mb-4">
                                    <label class="form-label fw-semibold">
                                        Course
                                    </label>

                                    <select class="form-control custom-input" name="package" id="courseSelect" multiple
                                        required>
                                        {{#each courses}}
                                        <option value="{{this._id}}" data-fee="{{this.Total_Fees}}" {{includesCourse
                                            this._id ../student.course}}>
                                            {{this.name}}
                                        </option>
                                        {{/each}}
                                    </select>
                                </div>

                                <!-- PAID -->
                                <div class="mb-4">
                                    <label class="form-label fw-semibold">
                                        Amount Paid
                                    </label>

                                    <input type="number" class="form-control custom-input" name="Paid_Amount"
                                        id="paidAmount" value="{{student.Paid_Amount}}" required>
                                </div>

                            </div>


                            <!-- RIGHT -->
                            <div class="col-lg-4">

                                <!-- IMAGE -->
                                <div class="profile-box text-center mb-4">

                                    <img id="preview" src="{{student.imageUrl}}" class="student-preview"
                                        onerror="this.onerror=null;this.src='/img/placeholders/profile.svg';">

                                    <label class="upload-btn mt-3">
                                        <i class="fa-solid fa-camera me-2"></i>
                                        Change Photo
                                        <input type="file" name="image" hidden accept="image/*"
                                            onchange="previewImage(event)">
                                    </label>

                                </div>

                                <!-- SUMMARY -->
                                <div class="summary-card">
                                    <h6 class="fw-bold mb-3">
                                        Fee Summary
                                    </h6>

                                    <p class="mb-2">
                                        Course Fee:
                                        <strong id="courseFee">₹0</strong>
                                    </p>

                                    <p class="mb-2">
                                        Paid:
                                        <strong id="paidPreview">₹0</strong>
                                    </p>

                                    <p class="mb-0">
                                        Balance:
                                        <strong id="balancePreview" class="text-danger">
                                            ₹0
                                        </strong>
                                    </p>
                                </div>

                            </div>

                        </div>


                        <!-- DATES -->
                        <div class="row mt-2">

                            <div class="col-md-4">
                                <label class="form-label fw-semibold">
                                    Start Date
                                </label>

                                <input id="startDate" class="form-control custom-input" type="date" name="Start_Date"
                                    value="{{formatDate student.Start_Date}}" required>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-semibold">
                                    End Date
                                </label>

                                <input id="endDate" class="form-control custom-input" type="date" name="End_Date"
                                    value="{{formatDate student.End_Date}}" required>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-semibold">
                                    Duration
                                </label>

                                <input type="text" class="form-control custom-input bg-light" id="duration"
                                    name="Duration" value="{{student.Duration}}" readonly>
                            </div>

                        </div>


                        <!-- BUTTON -->
                        <div class="text-center mt-5">
                            <button type="submit" class="btn btn-success px-5 py-2">
                                <i class="fa-solid fa-floppy-disk me-2"></i>
                                Update Student
                            </button>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</section>


<style>
    .edit-student-card {
        border-radius: 24px;
        overflow: hidden;
    }

    .student-header {
        background: linear-gradient(135deg, var(--brand), var(--brand-2));
        padding: 28px 32px;
    }

    .student-header h2 {
        color: white !important;
    }

    .custom-input {
        border-radius: 12px;
        min-height: 50px;
        border: 1px solid var(--border);
        background: var(--surface);
        color: var(--text);
        padding: 12px 16px;
        transition: all 0.25s ease;
    }

    .custom-input:focus {
        border-color: var(--brand);
        background: var(--card-solid);
        box-shadow: 0 0 0 4px var(--shadow-brand) !important;
    }

    .profile-box,
    .summary-card {
        background: var(--surface-2);
        border: 1px solid var(--border);
        padding: 24px;
        border-radius: 20px;
    }

    .student-preview {
        width: 130px;
        height: 130px;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid var(--surface);
        box-shadow: var(--shadow);
    }

    .upload-btn {
        display: inline-block;
        padding: 10px 20px;
        border-radius: 12px;
        background: linear-gradient(135deg, var(--brand), var(--brand-2));
        color: var(--btn-primary-text) !important;
        cursor: pointer;
        font-weight: 600;
        transition: all 0.2s ease;
        box-shadow: 0 4px 12px var(--shadow-brand);
    }

    .upload-btn:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 16px rgba(79, 70, 229, 0.3);
    }

    @media(max-width:768px) {
        .student-header {
            padding: 22px;
        }
    }
</style>


<script>
    const startDate = document.getElementById("startDate");
    const endDate = document.getElementById("endDate");
    const duration = document.getElementById("duration");
    const courseSelect = document.getElementById("courseSelect");
    const paidAmount = document.getElementById("paidAmount");

    function previewImage(e) {
        const file = e.target.files[0];

        if (file) {
            document.getElementById("preview").src =
                URL.createObjectURL(file);
        }
    }

    function calculateDuration() {

        if (startDate.value && endDate.value) {

            const start = new Date(startDate.value);
            const end = new Date(endDate.value);

            const diff = end - start;

            const days =
                Math.floor(diff / (1000 * 60 * 60 * 24)) + 1;

            duration.value =
                days > 0 ? days + " days" : "";
        }
    }

    function updateFeePreview() {

        let fee = 0;
        for (let i = 0; i < courseSelect.options.length; i++) {
            const option = courseSelect.options[i];
            if (option.selected && option.value) {
                fee += Number(option.dataset.fee || 0);
            }
        }

        let paid = Number(paidAmount.value || 0);
        if (paid > fee) {
            paid = fee;
            paidAmount.value = fee;
        }
        if (paid < 0) {
            paid = 0;
            paidAmount.value = 0;
        }

        const balance = fee - paid;

        document.getElementById("courseFee").innerText =
            "₹" + fee.toLocaleString('en-IN');

        document.getElementById("paidPreview").innerText =
            "₹" + paid.toLocaleString('en-IN');

        document.getElementById("balancePreview").innerText =
            "₹" + balance.toLocaleString('en-IN');
    }

    startDate.addEventListener("change", function () {
        endDate.min = this.value;

        if (endDate.value < this.value) {
            endDate.value = "";
        }

        calculateDuration();
    });

    endDate.addEventListener("change", calculateDuration);
    courseSelect.addEventListener("change", updateFeePreview);
    paidAmount.addEventListener("input", updateFeePreview);
    paidAmount.addEventListener("keyup", updateFeePreview);
    paidAmount.addEventListener("change", updateFeePreview);

    document.getElementById("editStudentForm").addEventListener("submit", function (e) {
        let fee = 0;
        for (let i = 0; i < courseSelect.options.length; i++) {
            const option = courseSelect.options[i];
            if (option.selected && option.value) {
                fee += Number(option.dataset.fee || 0);
            }
        }
        let paid = Number(paidAmount.value || 0);
        if (paid > fee) {
            paidAmount.value = fee;
        }
        if (paid < 0) {
            paidAmount.value = 0;
        }
    });

    window.onload = function () {
        calculateDuration();
        updateFeePreview();
    };

    // USERNAME MANAGEMENT
    let studentManageUserId = '{{student._id}}';
    let usernameDebounceTimer = null;

    function openEditStudentUsernameModal() {
        document.getElementById('editStudentModalUserName').innerText = '{{student.name}}';
        document.getElementById('editStudentModalUserEmail').innerText = '{{#if student.email}}{{student.email}}{{else}}{{student.Email}}{{/if}}';
        document.getElementById('editStudentModalCurrentUsername').innerText = '{{student.username}}' ? '@{{student.username}}' : '@none';
        document.getElementById('editStudentModalNewInput').value = '{{student.username}}';
        document.getElementById('editStudentModalAvailabilityBadge').innerHTML = '';
        document.getElementById('editStudentModalSaveBtn').disabled = true;

        const inCooldown = {{#if student.isCooldownActive}}true{{else}}false{{/if}};
        const warn = document.getElementById('editStudentModalCooldownWarn');
        if (warn) {
            warn.style.display = inCooldown ? 'block' : 'none';
        }

        const modal = new bootstrap.Modal(document.getElementById('editStudentUsernameModal'));
        modal.show();
    }

    function onStudentUsernameInputChanged() {
        clearTimeout(usernameDebounceTimer);
        const input = document.getElementById('editStudentModalNewInput');
        const saveBtn = document.getElementById('editStudentModalSaveBtn');
        const badge = document.getElementById('editStudentModalAvailabilityBadge');
        const rawVal = input.value.trim().replace(/^@/, '');

        if (!rawVal) {
            badge.innerHTML = '';
            saveBtn.disabled = true;
            return;
        }

        badge.innerHTML = '<span class="text-muted"><i class="fa-solid fa-spinner fa-spin me-1"></i> Checking availability...</span>';
        saveBtn.disabled = true;

        usernameDebounceTimer = setTimeout(() => {
            fetch(`/usernames/api/check-availability?username=${encodeURIComponent(rawVal)}&excludeUserId=${studentManageUserId}`)
                .then(res => res.json())
                .then(data => {
                    if (data.available) {
                        badge.innerHTML = `<span class="text-success fw-bold"><i class="fa-solid fa-circle-check me-1"></i> @${data.username} is available</span>`;
                        saveBtn.disabled = false;
                    } else {
                        badge.innerHTML = `<span class="text-danger fw-semibold"><i class="fa-solid fa-circle-xmark me-1"></i> ${data.reason || 'Unavailable'}</span>`;
                        saveBtn.disabled = true;
                    }
                })
                .catch(err => {
                    badge.innerHTML = `<span class="text-danger">Error checking availability</span>`;
                    saveBtn.disabled = true;
                });
        }, 300);
    }

    function requestStudentSuggestion() {
        const name = '{{student.name}}';
        const email = '{{student.Email}}';

        fetch('/usernames/api/generate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ userId: studentManageUserId, name, email })
        })
        .then(res => res.json())
        .then(data => {
            if (data.success && data.suggestion) {
                document.getElementById('editStudentModalNewInput').value = data.suggestion;
                onStudentUsernameInputChanged();
            }
        });
    }

    function submitStudentUsernameChange() {
        const newUsername = document.getElementById('editStudentModalNewInput').value.trim();
        const reason = document.getElementById('editStudentModalReasonSelect').value;

        if (typeof Swal !== 'undefined') {
            Swal.fire({
                title: 'Confirm Username Change',
                html: `Change learner handle to <strong>@${newUsername.replace(/^@/, '')}</strong>?<br><small class="text-muted">Reason: ${reason}</small>`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#12314c',
                confirmButtonText: 'Yes, Update Handle'
            }).then((result) => {
                if (!result.isConfirmed) return;
                performStudentUsernameChange(newUsername, reason);
            });
        } else {
            if (confirm(`Change username to @${newUsername.replace(/^@/, '')}?`)) {
                performStudentUsernameChange(newUsername, reason);
            }
        }
    }

    function performStudentUsernameChange(newUsername, reason) {
        fetch(`/usernames/api/change/${studentManageUserId}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ newUsername, reason })
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                if (typeof Swal !== 'undefined') {
                    Swal.fire('Updated!', `Username updated to @${data.newUsername}`, 'success').then(() => {
                        location.reload();
                    });
                } else {
                    alert(`Username updated to @${data.newUsername}`);
                    location.reload();
                }
            } else {
                if (typeof Swal !== 'undefined') {
                    Swal.fire('Error', data.message || 'Failed to update username.', 'error');
                } else {
                    alert(data.message || 'Failed to update username.');
                }
            }
        })
        .catch(err => {
            if (typeof Swal !== 'undefined') {
                Swal.fire('Error', err.message, 'error');
            } else {
                alert('Error: ' + err.message);
            }
        });
    }
</script>

<!-- MODAL: CHANGE STUDENT USERNAME -->
<div class="modal fade" id="editStudentUsernameModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background:var(--card-solid, #12314c);border:1px solid rgba(159,213,178,0.3);border-radius:20px;color:#fff;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-white">
                    <i class="fa-solid fa-id-badge text-success me-2"></i> Change Student Handle
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" data-bs-dismiss="modal" aria-label="Close" style="font-size:24px;background:none;border:none;opacity:0.8;">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body p-4">
                <div class="p-3 mb-3" style="background:rgba(0,0,0,0.25);border-radius:14px;border:1px solid rgba(255,255,255,0.08);">
                    <strong class="text-white d-block" id="editStudentModalUserName">{{student.name}}</strong>
                    <small class="text-muted d-block" id="editStudentModalUserEmail">{{#if student.email}}{{student.email}}{{else}}{{student.Email}}{{/if}}</small>
                    <div class="d-flex align-items-center gap-2 mt-2">
                        <small class="text-muted">Current Handle:</small>
                        <span class="badge bg-dark border border-secondary" id="editStudentModalCurrentUsername">@{{student.username}}</span>
                    </div>
                </div>

                <div id="editStudentModalCooldownWarn" class="alert alert-warning py-2 px-3 mb-3 small" style="display:none;">
                    <i class="fa-solid fa-triangle-exclamation me-1"></i>
                    <strong>Admin Override:</strong> This user has changed their username recently. 14-day user cooldown will be bypassed and logged.
                </div>

                <div class="mb-3">
                    <label class="form-label text-white fw-semibold small">New Username</label>
                    <div class="input-group">
                        <span class="input-group-text" style="background:rgba(0,0,0,0.3);border-color:rgba(255,255,255,0.15);color:#9fd5b2;font-weight:700;">@</span>
                        <input type="text" class="form-control" id="editStudentModalNewInput" placeholder="username" onkeyup="onStudentUsernameInputChanged()" style="background:rgba(0,0,0,0.25);border-color:rgba(255,255,255,0.15);color:#fff;">
                        <button class="btn btn-outline-secondary" type="button" onclick="requestStudentSuggestion()" title="Generate Suggestion">
                            <i class="fa-solid fa-wand-magic-sparkles text-warning"></i>
                        </button>
                    </div>
                    <div id="editStudentModalAvailabilityBadge" class="mt-2 small"></div>
                </div>

                <div class="mb-3">
                    <label class="form-label text-white fw-semibold small">Reason for Change (Audited)</label>
                    <select class="form-select" id="editStudentModalReasonSelect" style="background:rgba(0,0,0,0.25);border-color:rgba(255,255,255,0.15);color:#fff;">
                        <option value="Student requested correction">Student requested correction</option>
                        <option value="Typo correction">Typo correction</option>
                        <option value="Duplicate handle resolution">Duplicate handle resolution</option>
                        <option value="Inappropriate name policy violation">Inappropriate name policy violation</option>
                        <option value="Privacy request">Privacy request</option>
                        <option value="Admin correction">Admin correction</option>
                    </select>
                </div>
            </div>

            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary" data-dismiss="modal" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success px-4" id="editStudentModalSaveBtn" onclick="submitStudentUsernameChange()" disabled>
                    Save Username
                </button>
            </div>
        </div>
    </div>
</div>
