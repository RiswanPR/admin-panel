<div class="container-fluid mt-4 mb-5">

    <!-- HERO HEADER -->
    <div class="hero-card mb-4" style="background: linear-gradient(135deg, rgba(18, 49, 76, 0.95), rgba(29, 78, 137, 0.9)), url('/images/banner.jpg') center/cover; padding: 32px 36px; border-radius: 24px; position: relative; overflow: hidden; box-shadow: 0 12px 32px rgba(18, 49, 76, 0.15);">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 position-relative" style="z-index: 2;">
            <div>
                <span class="badge mb-2 px-3 py-2" style="background: rgba(159, 213, 178, 0.2); color: #9fd5b2; border: 1px solid rgba(159, 213, 178, 0.35); border-radius: 30px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px;">
                    <i class="fa-solid fa-circle-play me-1"></i> Ephemeral Media
                </span>
                <h2 class="text-white fw-bold m-0" style="font-size: 28px; letter-spacing: -0.5px;">Community Stories</h2>
                <p class="text-light opacity-75 mt-2 mb-0" style="font-size: 14px;">Review 24-hour ephemeral stories, audit active versus expired broadcasts, and moderate inappropriate media.</p>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <a href="/admin/community/posts" class="btn btn-outline-light px-3 py-2">
                    <i class="fa-solid fa-signs-post me-1"></i> Posts
                </a>
                <a href="/admin/community/comments" class="btn btn-outline-light px-3 py-2">
                    <i class="fa-solid fa-comments me-1"></i> Comments
                </a>
            </div>
        </div>
    </div>

    <!-- STATS -->
    <div class="row g-4 mb-4">
        <div class="col-xl-3 col-md-6 col-6">
            <div class="stat-card stat-dark">
                <div>
                    <small>Total Stories</small>
                    <h2>{{stats.totalStories}}</h2>
                </div>
                <i class="fa-solid fa-circle-play stat-icon"></i>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 col-6">
            <div class="stat-card stat-green">
                <div>
                    <small>Active Stories (Live)</small>
                    <h2>{{stats.activeStories}}</h2>
                </div>
                <i class="fa-solid fa-bolt stat-icon"></i>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 col-6">
            <div class="stat-card stat-yellow">
                <div>
                    <small>Expired Stories</small>
                    <h2>{{stats.expiredStories}}</h2>
                </div>
                <i class="fa-solid fa-hourglass-end stat-icon"></i>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 col-6">
            <div class="stat-card stat-red">
                <div>
                    <small>Removed Stories</small>
                    <h2>{{stats.deletedStories}}</h2>
                </div>
                <i class="fa-solid fa-ban stat-icon"></i>
            </div>
        </div>
    </div>

    <!-- TABS -->
    <ul class="nav nav-tabs mb-4 border-bottom" style="font-size: 14px; font-weight: 600;">
        <li class="nav-item">
            <a class="nav-link {{#ifEquals filters.status 'all'}}active text-primary{{else}}text-muted{{/ifEquals}}" href="/admin/community/stories?status=all&type={{filters.type}}&view={{#ifEquals viewMode 'table'}}table{{else}}card{{/ifEquals}}">
                All Stories ({{stats.totalStories}})
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{#ifEquals filters.status 'active'}}active text-success{{else}}text-muted{{/ifEquals}}" href="/admin/community/stories?status=active&type={{filters.type}}&view={{#ifEquals viewMode 'table'}}table{{else}}card{{/ifEquals}}">
                Active (Live) ({{stats.activeStories}})
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{#ifEquals filters.status 'expired'}}active text-warning{{else}}text-muted{{/ifEquals}}" href="/admin/community/stories?status=expired&type={{filters.type}}&view={{#ifEquals viewMode 'table'}}table{{else}}card{{/ifEquals}}">
                Expired ({{stats.expiredStories}})
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{#ifEquals filters.status 'deleted'}}active text-danger{{else}}text-muted{{/ifEquals}}" href="/admin/community/stories?status=deleted&type={{filters.type}}&view={{#ifEquals viewMode 'table'}}table{{else}}card{{/ifEquals}}">
                Removed ({{stats.deletedStories}})
            </a>
        </li>
    </ul>

    <!-- FILTER TOOLBAR -->
    <form class="card p-3 mb-3 border-0 shadow-sm" method="GET" action="/admin/community/stories" id="storiesFilterForm" style="border-radius: 16px;">
        <input type="hidden" name="status" value="{{filters.status}}">
        <input type="hidden" name="view" value="{{#ifEquals viewMode 'table'}}table{{else}}card{{/ifEquals}}">
        <div class="row g-2 align-items-center">
            <div class="col-lg-5 col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                    <input type="text" class="form-control border-start-0" name="search" value="{{filters.search}}" placeholder="Search story text, author, ID...">
                </div>
            </div>
            <div class="col-lg-3 col-md-3 col-6">
                <select class="form-select" name="type" onchange="document.getElementById('storiesFilterForm').submit()">
                    <option value="ALL" {{#ifEquals filters.type 'ALL'}}selected{{/ifEquals}}>All Story Types</option>
                    <option value="IMAGE" {{#ifEquals filters.type 'IMAGE'}}selected{{/ifEquals}}>Image Stories</option>
                    <option value="VIDEO" {{#ifEquals filters.type 'VIDEO'}}selected{{/ifEquals}}>Video Stories</option>
                    <option value="TEXT" {{#ifEquals filters.type 'TEXT'}}selected{{/ifEquals}}>Text Stories</option>
                </select>
            </div>
            <div class="col-lg-2 col-md-2 col-6">
                <select class="form-select" name="sort" onchange="document.getElementById('storiesFilterForm').submit()">
                    <option value="newest" {{#ifEquals filters.sort 'newest'}}selected{{/ifEquals}}>Newest</option>
                    <option value="expiring_soon" {{#ifEquals filters.sort 'expiring_soon'}}selected{{/ifEquals}}>Expiring Soon</option>
                    <option value="views" {{#ifEquals filters.sort 'views'}}selected{{/ifEquals}}>Most Views</option>
                </select>
            </div>
            <div class="col-lg-2 col-md-2 text-end">
                <a href="/admin/community/stories" class="btn btn-outline-secondary w-100"><i class="fa-solid fa-rotate"></i> Reset</a>
            </div>
        </div>

        <div class="row g-2 align-items-center mt-2 pt-2 border-top">
            <div class="col-lg-3 col-md-4 col-sm-6">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light text-muted">From</span>
                    <input type="date" class="form-control" name="startDate" value="{{filters.startDate}}" onchange="document.getElementById('storiesFilterForm').submit()">
                </div>
            </div>
            <div class="col-lg-3 col-md-4 col-sm-6">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light text-muted">To</span>
                    <input type="date" class="form-control" name="endDate" value="{{filters.endDate}}" onchange="document.getElementById('storiesFilterForm').submit()">
                </div>
            </div>
            {{#if hasActiveFilters}}
            <div class="col-lg-6 col-md-4 col-sm-12 text-lg-end">
                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle py-2 px-3 small">
                    <i class="fa-solid fa-filter me-1"></i> Active Filters Applied
                </span>
            </div>
            {{/if}}
        </div>
    </form>

    <!-- BULK ACTIONS TOOLBAR -->
    <div id="storiesBulkToolbar" class="card shadow-lg border-0 mb-3 d-none" style="border-radius: 14px; background: #1e293b; color: white;">
        <div class="card-body py-2 px-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-primary" id="selectedStoriesCount">0</span>
                <span class="small fw-semibold">Stories selected (Max 50)</span>
                <button type="button" class="btn btn-link text-light btn-sm text-decoration-none p-0 ms-2" onclick="clearStoriesSelection()">Clear</button>
            </div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <button type="button" class="btn btn-sm btn-danger" onclick="executeStoriesBulk('remove')">
                    <i class="fa-solid fa-ban me-1"></i> Remove Selected
                </button>
                <button type="button" class="btn btn-sm btn-success" onclick="executeStoriesBulk('restore')">
                    <i class="fa-solid fa-trash-arrow-up me-1"></i> Restore Selected
                </button>
            </div>
        </div>
    </div>

    <!-- VIEW TOGGLE -->
    {{> admin/view-toggle section="community-stories" total=total itemLabel="stories" viewMode=viewMode}}

    <!-- CARD VIEW (DEFAULT) -->
    <div class="admin-cards-container {{#ifEquals viewMode 'table'}}d-none{{/ifEquals}}" id="community-storiesCardView" data-section="community-stories">
        <div class="row g-3">
            {{#if records.length}}
            {{#each records}}
            <div class="col-xl-3 col-md-6 col-12">
                <div class="admin-governance-card h-100">
                    <div class="admin-card-header">
                        <div class="d-flex align-items-center gap-1">
                            <input type="checkbox" class="form-check-input story-bulk-checkbox m-0 me-1" value="{{_id}}" onchange="updateStoriesBulkState()">
                            <span class="badge bg-secondary">{{type}}</span>
                            {{#if courseTag}}
                            <span class="badge bg-light text-dark border">{{courseTag}}</span>
                            {{/if}}
                        </div>
                        <div>
                            {{#ifEquals lifecycleStatus 'ACTIVE'}}
                            <span class="admin-badge admin-badge-active"><i class="fa-solid fa-circle text-success" style="font-size: 8px;"></i> Live</span>
                            {{/ifEquals}}
                            {{#ifEquals lifecycleStatus 'EXPIRED'}}
                            <span class="admin-badge admin-badge-neutral">Expired</span>
                            {{/ifEquals}}
                            {{#ifEquals lifecycleStatus 'REMOVED'}}
                            <span class="admin-badge admin-badge-danger">Removed</span>
                            {{/ifEquals}}
                        </div>
                    </div>

                    <div class="admin-card-body">
                        <!-- Story preview box -->
                        <div class="story-preview-box rounded p-3 mb-3 text-center d-flex flex-column justify-content-center align-items-center" style="min-height: 120px; background-color: {{#if backgroundColor}}{{backgroundColor}}{{else}}#12314c{{/if}}; color: #fff;">
                            {{#if text}}
                            <div class="fw-bold small text-truncate" style="max-width: 90%;">{{text}}</div>
                            {{else}}
                            <i class="fa-solid fa-photo-film fs-2 opacity-75"></i>
                            {{/if}}
                        </div>

                        <!-- Author -->
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center" style="width: 24px; height: 24px; font-size: 11px;">
                                <i class="fa-solid fa-user"></i>
                            </div>
                            <div class="text-truncate">
                                <span class="fw-bold small">{{author.name}}</span>
                                <small class="text-muted">@{{author.username}}</small>
                            </div>
                        </div>

                        <!-- Meta items -->
                        <div class="admin-card-meta-list">
                            <div class="admin-card-meta-item">
                                <i class="fa-regular fa-eye"></i>
                                <span>{{viewsCount}} views</span>
                            </div>
                            <div class="admin-card-meta-item">
                                <i class="fa-regular fa-clock"></i>
                                <span>Expires {{formatDateTime expiresAt}}</span>
                            </div>
                        </div>
                    </div>

                    <div class="admin-card-footer d-flex justify-content-between align-items-center">
                        <a href="/admin/community/stories/{{_id}}" class="btn btn-sm btn-outline-primary">
                            <i class="fa-solid fa-circle-info me-1"></i> Detail
                        </a>

                        <div>
                            {{#if isDeleted}}
                            <button type="button" class="btn btn-sm btn-outline-success" onclick="openRestoreStoryModal('{{_id}}')" title="Restore">
                                <i class="fa-solid fa-trash-arrow-up"></i>
                            </button>
                            {{else}}
                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="openRemoveStoryModal('{{_id}}')" title="Remove">
                                <i class="fa-solid fa-ban"></i> Remove
                            </button>
                            {{/if}}
                        </div>
                    </div>
                </div>
            </div>
            {{/each}}
            {{else}}
            <div class="col-12">
                <div class="admin-empty-state">
                    <div class="admin-empty-state-icon"><i class="fa-solid fa-circle-play"></i></div>
                    <div class="admin-empty-state-title">No Stories Found</div>
                    <p class="admin-empty-state-desc">There are no active or expired stories matching your current filters.</p>
                </div>
            </div>
            {{/if}}
        </div>
    </div>

    <!-- TABLE VIEW -->
    <div class="admin-table-container {{#ifEquals viewMode 'table'}}{{else}}d-none{{/ifEquals}}" id="community-storiesTableView" data-section="community-stories">
        <div class="card border-0 shadow-sm" style="border-radius: 16px; overflow: hidden;">
            <div class="table-responsive mb-0">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr style="font-size: 12px; text-transform: uppercase;">
                            <th class="ps-3" style="width: 40px;">
                                <input type="checkbox" id="selectAllStories" class="form-check-input" onchange="toggleSelectAllStories(this)">
                            </th>
                            <th>Author</th>
                            <th>Type</th>
                            <th>Text / Caption</th>
                            <th>Views</th>
                            <th>Lifecycle</th>
                            <th>Expires At</th>
                            <th>Created</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#if records.length}}
                        {{#each records}}
                        <tr>
                            <td class="ps-3">
                                <input type="checkbox" class="form-check-input story-bulk-checkbox" value="{{_id}}" onchange="updateStoriesBulkState()">
                            </td>
                            <td>
                                <div class="fw-bold small">{{author.name}}</div>
                                <small class="text-muted">@{{author.username}}</small>
                            </td>
                            <td><span class="badge bg-secondary">{{type}}</span></td>
                            <td>
                                <div class="text-truncate" style="max-width: 220px;">
                                    {{#if text}}{{text}}{{else}}<em class="text-muted">Media story</em>{{/if}}
                                </div>
                            </td>
                            <td><small>{{viewsCount}} views</small></td>
                            <td>
                                {{#ifEquals lifecycleStatus 'ACTIVE'}}
                                <span class="badge bg-success">Live</span>
                                {{/ifEquals}}
                                {{#ifEquals lifecycleStatus 'EXPIRED'}}
                                <span class="badge bg-secondary">Expired</span>
                                {{/ifEquals}}
                                {{#ifEquals lifecycleStatus 'REMOVED'}}
                                <span class="badge bg-danger">Removed</span>
                                {{/ifEquals}}
                            </td>
                            <td><small class="text-muted">{{formatDateTime expiresAt}}</small></td>
                            <td><small class="text-muted">{{formatDate createdAt}}</small></td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm">
                                    <a href="/admin/community/stories/{{_id}}" class="btn btn-outline-primary" title="Inspect story">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>
                                    {{#if isDeleted}}
                                    <button type="button" class="btn btn-outline-success" onclick="openRestoreStoryModal('{{_id}}')" title="Restore story">
                                        <i class="fa-solid fa-trash-arrow-up"></i>
                                    </button>
                                    {{else}}
                                    <button type="button" class="btn btn-outline-danger" onclick="openRemoveStoryModal('{{_id}}')" title="Remove story">
                                        <i class="fa-solid fa-ban"></i>
                                    </button>
                                    {{/if}}
                                </div>
                            </td>
                        </tr>
                        {{/each}}
                        {{else}}
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-circle-play fs-3 mb-2 d-block opacity-50"></i>
                                No community stories found.
                            </td>
                        </tr>
                        {{/if}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- PAGINATION -->
    <div class="mt-4">
        {{> admin/admin-pagination total=total page=page limit=limit totalPages=totalPages filters=filters}}
    </div>

</div>

<!-- MODAL: REMOVE STORY -->
<div class="modal fade" id="removeStoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="fa-solid fa-ban me-2"></i> Remove Community Story</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>This action soft-deletes the story and removes it from the public story feed. Media files in storage remain preserved as evidence.</p>
                <div class="mb-3">
                    <label class="form-label fw-bold">Moderation Reason <span class="text-danger">*</span></label>
                    <textarea class="form-control" id="removeStoryReason" rows="3" placeholder="Provide moderation justification..." required></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" onclick="submitRemoveStory()">Confirm Removal</button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL: RESTORE STORY -->
<div class="modal fade" id="restoreStoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title"><i class="fa-solid fa-trash-arrow-up me-2"></i> Restore Story</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Restore this story record. Note: If the 24-hour expiration window has elapsed, the story will appear in the expired archive.</p>
                <div class="mb-3">
                    <label class="form-label fw-bold">Reason for Restoration</label>
                    <textarea class="form-control" id="restoreStoryReason" rows="2" placeholder="e.g. Cleared after review"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" onclick="submitRestoreStory()">Confirm Restore</button>
            </div>
        </div>
    </div>
</div>

<script>
let currentStoryId = null;

function openRemoveStoryModal(storyId) {
    currentStoryId = storyId;
    document.getElementById('removeStoryReason').value = '';
    new bootstrap.Modal(document.getElementById('removeStoryModal')).show();
}

function openRestoreStoryModal(storyId) {
    currentStoryId = storyId;
    document.getElementById('restoreStoryReason').value = '';
    new bootstrap.Modal(document.getElementById('restoreStoryModal')).show();
}

async function submitRemoveStory() {
    if (!currentStoryId) return;
    const reason = document.getElementById('removeStoryReason').value.trim() || 'Violated community guidelines';
    try {
        const res = await fetch(`/admin/community/stories/${currentStoryId}/remove`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ reason })
        });
        const data = await res.json();
        if (data.success) window.location.reload();
        else alert(data.message || 'Error removing story.');
    } catch(e) {
        alert('Network error.');
    }
}

async function submitRestoreStory() {
    if (!currentStoryId) return;
    const reason = document.getElementById('restoreStoryReason').value.trim() || 'Restored by admin';
    try {
        const res = await fetch(`/admin/community/stories/${currentStoryId}/restore`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ reason })
        });
        const data = await res.json();
        if (data.success) window.location.reload();
        else alert(data.message || 'Error restoring story.');
    } catch(e) {
        alert('Network error.');
    }
}

// Bulk Actions Logic for Stories
let selectedStoryIds = new Set();

function updateStoriesBulkState() {
    const checkboxes = document.querySelectorAll('.story-bulk-checkbox');
    selectedStoryIds.clear();
    checkboxes.forEach(cb => {
        if (cb.checked) selectedStoryIds.add(cb.value);
    });

    const count = selectedStoryIds.size;
    const toolbar = document.getElementById('storiesBulkToolbar');
    const countEl = document.getElementById('selectedStoriesCount');
    const selectAllCb = document.getElementById('selectAllStories');

    if (countEl) countEl.textContent = count;
    if (toolbar) {
        if (count > 0) toolbar.classList.remove('d-none');
        else toolbar.classList.add('d-none');
    }
    if (selectAllCb) {
        selectAllCb.checked = checkboxes.length > 0 && count === checkboxes.length;
        selectAllCb.indeterminate = count > 0 && count < checkboxes.length;
    }
}

function toggleSelectAllStories(masterCb) {
    const checkboxes = document.querySelectorAll('.story-bulk-checkbox');
    checkboxes.forEach(cb => {
        cb.checked = masterCb.checked;
    });
    updateStoriesBulkState();
}

function clearStoriesSelection() {
    const checkboxes = document.querySelectorAll('.story-bulk-checkbox');
    checkboxes.forEach(cb => cb.checked = false);
    const selectAllCb = document.getElementById('selectAllStories');
    if (selectAllCb) {
        selectAllCb.checked = false;
        selectAllCb.indeterminate = false;
    }
    updateStoriesBulkState();
}

async function executeStoriesBulk(action) {
    const ids = Array.from(selectedStoryIds);
    if (!ids.length) {
        if (typeof Swal !== 'undefined') {
            Swal.fire({ icon: 'warning', title: 'No Selection', text: 'Please select at least one story.' });
        } else {
            alert('Please select at least one story.');
        }
        return;
    }
    if (ids.length > 50) {
        if (typeof Swal !== 'undefined') {
            Swal.fire({ icon: 'error', title: 'Batch Limit Exceeded', text: 'Maximum 50 stories can be processed in a single bulk action.' });
        } else {
            alert('Maximum 50 stories can be processed in a single bulk action.');
        }
        return;
    }

    const isDestructive = action === 'remove';
    let reason = '';

    if (typeof Swal !== 'undefined') {
        const result = await Swal.fire({
            title: `Confirm Bulk ${action === 'remove' ? 'Removal' : 'Restoration'}`,
            html: `Are you sure you want to execute <strong>${action.toUpperCase()}</strong> on <strong>${ids.length}</strong> selected stories?<br><br>
                   <input id="swalBulkReason" class="swal2-input" placeholder="Moderation reason (optional)">`,
            icon: isDestructive ? 'warning' : 'question',
            showCancelButton: true,
            confirmButtonColor: isDestructive ? '#dc2626' : '#2563eb',
            cancelButtonColor: '#64748b',
            confirmButtonText: `Yes, ${action} ${ids.length} stories`,
            cancelButtonText: 'Cancel',
            preConfirm: () => {
                return document.getElementById('swalBulkReason')?.value || '';
            }
        });

        if (!result.isConfirmed) return;
        reason = result.value || '';
    } else {
        if (!confirm(`Are you sure you want to execute ${action} on ${ids.length} stories?`)) return;
        reason = prompt('Enter moderation reason (optional):') || '';
    }

    try {
        if (typeof Swal !== 'undefined') {
            Swal.fire({
                title: 'Processing Bulk Action...',
                text: `Executing ${action} on ${ids.length} stories. Please wait.`,
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });
        }

        const res = await fetch('/admin/community/stories/bulk', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ action, ids, reason })
        });
        const data = await res.json();
        if (data.success) {
            if (typeof Swal !== 'undefined') {
                await Swal.fire({
                    icon: 'success',
                    title: 'Bulk Action Completed',
                    html: `<strong>${data.succeeded}</strong> succeeded, <strong>${data.skipped}</strong> skipped, <strong>${data.failed}</strong> failed.<br><small class="text-muted">Operation ID: ${data.bulkOperationId}</small>`,
                    timer: 2000,
                    showConfirmButton: true
                });
            } else {
                alert(`Bulk action completed: ${data.succeeded} succeeded, ${data.skipped} skipped, ${data.failed} failed.`);
            }
            window.location.reload();
        } else {
            if (typeof Swal !== 'undefined') {
                Swal.fire({ icon: 'error', title: 'Action Failed', text: data.message || 'Bulk operation failed.' });
            } else {
                alert(data.message || 'Bulk operation failed.');
            }
        }
    } catch (err) {
        if (typeof Swal !== 'undefined') {
            Swal.fire({ icon: 'error', title: 'Network Error', text: 'Failed to communicate with server.' });
        } else {
            alert('Network error while processing bulk action.');
        }
    }
}
</script>
