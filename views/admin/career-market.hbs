<div class="container-fluid mt-4 mb-5">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="/admin/career-intelligence/roles">Career Intelligence</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Market Data</li>
                </ol>
            </nav>
            <h2 class="fw-bold m-0" style="color:var(--brand);">
                <i class="fa-solid fa-chart-pie me-2"></i> Infrastructure Market Intelligence
            </h2>
            <small class="text-muted">Observation telemetry of infrastructure talent demand, software prerequisites, and hiring density.</small>
        </div>

        <div class="d-flex gap-2">
            <a href="/admin/career-intelligence/assistant" class="btn btn-outline-primary px-3">
                <i class="fa-solid fa-comments me-1"></i> Assistant Telemetry
            </a>
            <a href="/admin/career-intelligence/roles" class="btn btn-outline-secondary px-3">
                <i class="fa-solid fa-id-card-clip me-1"></i> Role Taxonomy
            </a>
        </div>
    </div>

    <!-- MANDATORY METADATA DISCLOSURE CARD (REQ 21) -->
    <div class="card p-4 border-0 shadow-sm mb-4" style="border-radius: 16px; background: rgba(18, 49, 76, 0.03);">
        <h6 class="fw-bold mb-3 small text-uppercase" style="letter-spacing: 0.5px;">
            <i class="fa-solid fa-database text-primary me-2"></i> Dataset Provenance &amp; Methodology Specification
        </h6>
        <div class="row g-3 small">
            <div class="col-md-3">
                <span class="text-muted d-block">Data Source</span>
                <strong class="text-dark">{{market.metadata.source}}</strong>
            </div>
            <div class="col-md-3">
                <span class="text-muted d-block">Target Population</span>
                <strong class="text-dark">{{market.metadata.population}}</strong>
            </div>
            <div class="col-md-3">
                <span class="text-muted d-block">Observation Window</span>
                <strong class="text-dark">{{market.metadata.observationPeriod}}</strong>
            </div>
            <div class="col-md-3">
                <span class="text-muted d-block">Calculation Method</span>
                <strong class="text-dark">{{market.metadata.calculationMethod}}</strong>
            </div>
        </div>
        <div class="mt-3 pt-2 border-top text-muted small" style="font-size: 11px;">
            <i class="fa-solid fa-circle-exclamation text-warning me-1"></i>
            {{market.metadata.disclaimer}}
        </div>
    </div>

    <!-- DEMAND CARDS ROW -->
    <div class="row g-4 mb-4">

        <!-- ROLE DEMAND -->
        <div class="col-lg-6">
            <div class="card p-4 border-0 shadow-sm h-100" style="border-radius: 16px;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold m-0"><i class="fa-solid fa-id-card text-primary me-2"></i> Infrastructure Role Demand</h5>
                    <span class="badge bg-light text-dark border">{{market.totalActiveJobs}} Active Postings</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle small mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Role Title</th>
                                <th>Active Openings</th>
                                <th class="text-end">Hiring Velocity</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each market.roleDemand}}
                            <tr>
                                <td class="fw-bold" style="color:var(--text);">{{roleTitle}}</td>
                                <td>{{activeJobCount}} openings</td>
                                <td class="text-end">
                                    {{#ifEquals trend 'UP'}}
                                    <span class="badge bg-success-subtle text-success"><i class="fa-solid fa-arrow-trend-up me-1"></i> High Demand</span>
                                    {{else}}
                                    {{#ifEquals trend 'EMERGING'}}
                                    <span class="badge bg-primary-subtle text-primary"><i class="fa-solid fa-bolt me-1"></i> Emerging</span>
                                    {{else}}
                                    <span class="badge bg-light text-secondary border">Stable</span>
                                    {{/ifEquals}}
                                    {{/ifEquals}}
                                </td>
                            </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- SOFTWARE DEMAND -->
        <div class="col-lg-6">
            <div class="card p-4 border-0 shadow-sm h-100" style="border-radius: 16px;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold m-0"><i class="fa-solid fa-laptop-code text-info me-2"></i> Software Frequency in Job Requirements</h5>
                    <span class="badge bg-light text-dark border">Prerequisite Density</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle small mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Software Suite</th>
                                <th>Requirement Ratio</th>
                                <th class="text-end">Market Trend</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each market.softwareDemand}}
                            <tr>
                                <td class="fw-bold" style="color:var(--text);">{{softwareName}}</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height: 6px;">
                                            <div class="progress-bar bg-info" style="width: {{percentage}}%;"></div>
                                        </div>
                                        <span class="text-muted" style="font-size: 11px;">{{percentage}}%</span>
                                    </div>
                                </td>
                                <td class="text-end">
                                    <span class="badge bg-light text-dark border">{{trend}}</span>
                                </td>
                            </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- SKILLS DEMAND -->
        <div class="col-lg-6">
            <div class="card p-4 border-0 shadow-sm h-100" style="border-radius: 16px;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold m-0"><i class="fa-solid fa-gears text-warning me-2"></i> Technical Competency Demand</h5>
                    <span class="badge bg-light text-dark border">Skill Frequency</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle small mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Competency</th>
                                <th>Frequency Ratio</th>
                                <th class="text-end">Trend</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each market.skillDemand}}
                            <tr>
                                <td class="fw-bold" style="color:var(--text);">{{skillName}}</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height: 6px;">
                                            <div class="progress-bar bg-warning" style="width: {{percentage}}%;"></div>
                                        </div>
                                        <span class="text-muted" style="font-size: 11px;">{{percentage}}%</span>
                                    </div>
                                </td>
                                <td class="text-end">
                                    <span class="badge bg-light text-dark border">{{trend}}</span>
                                </td>
                            </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- SECTOR & LOCATION DEMAND -->
        <div class="col-lg-6">
            <div class="card p-4 border-0 shadow-sm h-100" style="border-radius: 16px;">
                <h5 class="fw-bold mb-3"><i class="fa-solid fa-map-location-dot text-success me-2"></i> Sector &amp; Geographic Concentration</h5>
                <div class="row g-3">
                    <div class="col-6">
                        <strong class="small text-muted d-block mb-2">Top Sectors:</strong>
                        <div class="d-flex flex-column gap-2 small">
                            {{#each market.sectorDemand}}
                            <div class="d-flex justify-content-between p-2 rounded bg-light">
                                <span>{{sectorName}}</span>
                                <strong class="text-primary">{{count}}</strong>
                            </div>
                            {{/each}}
                        </div>
                    </div>
                    <div class="col-6">
                        <strong class="small text-muted d-block mb-2">Top Hiring Hubs:</strong>
                        <div class="d-flex flex-column gap-2 small">
                            {{#each market.locationDemand}}
                            <div class="d-flex justify-content-between p-2 rounded bg-light">
                                <span>{{location}}</span>
                                <strong class="text-success">{{count}}</strong>
                            </div>
                            {{/each}}
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

</div>
