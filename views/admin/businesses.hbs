<div class="container-fluid mt-4 mb-5">

    <!-- HERO HEADER -->
    <div class="hero-card mb-4" style="background: linear-gradient(135deg, rgba(18, 49, 76, 0.95), rgba(29, 78, 137, 0.9)), url('/images/banner.jpg') center/cover; padding: 32px 36px; border-radius: 24px; position: relative; overflow: hidden; box-shadow: 0 12px 32px rgba(18, 49, 76, 0.15);">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 position-relative" style="z-index: 2;">
            <div>
                <span class="badge mb-2 px-3 py-2" style="background: rgba(159, 213, 178, 0.2); color: #9fd5b2; border: 1px solid rgba(159, 213, 178, 0.35); border-radius: 30px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px;">
                    <i class="fa-solid fa-building-shield me-1"></i> Phase 3 Enterprise Governance
                </span>
                <h2 class="text-white fw-bold m-0" style="font-size: 28px; letter-spacing: -0.5px;">Business Governance Center</h2>
                <p class="text-light opacity-75 mt-2 mb-0" style="font-size: 14px;">Govern, verify, approve, reject, or suspend infrastructure employers and corporate organizations.</p>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <a href="/admin/jobs" class="btn btn-light px-3 py-2">
                    <i class="fa-solid fa-briefcase me-1"></i> Jobs Governance
                </a>
            </div>
        </div>
    </div>

    <!-- STATS -->
    <div class="row g-4 mb-4">
        <div class="col-xl-2 col-md-4 col-6">
            <div class="stat-card stat-dark">
                <div>
                    <small>Total Businesses</small>
                    <h2>{{stats.total}}</h2>
                </div>
                <i class="fa-solid fa-building stat-icon"></i>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-6">
            <div class="stat-card stat-yellow">
                <div>
                    <small>Pending Review</small>
                    <h2>{{stats.pending}}</h2>
                </div>
                <i class="fa-solid fa-hourglass-half stat-icon"></i>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-6">
            <div class="stat-card stat-green">
                <div>
                    <small>Approved</small>
                    <h2>{{stats.approved}}</h2>
                </div>
                <i class="fa-solid fa-circle-check stat-icon"></i>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-6">
            <div class="stat-card stat-red">
                <div>
                    <small>Rejected</small>
                    <h2>{{stats.rejected}}</h2>
                </div>
                <i class="fa-solid fa-circle-xmark stat-icon"></i>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-6">
            <div class="stat-card stat-dark">
                <div>
                    <small>Suspended</small>
                    <h2>{{stats.suspended}}</h2>
                </div>
                <i class="fa-solid fa-ban stat-icon"></i>
            </div>
        </div>
    </div>

    <!-- TABS -->
    <ul class="nav nav-tabs mb-4 border-bottom" style="font-size: 14px; font-weight: 600;">
        <li class="nav-item">
            <a class="nav-link {{#ifEquals tab 'all'}}active text-primary{{else}}text-muted{{/ifEquals}}" href="/admin/businesses?tab=all&view={{#ifEquals viewMode 'table'}}table{{else}}card{{/ifEquals}}">
                All ({{stats.total}})
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{#ifEquals tab 'pending'}}active text-warning{{else}}text-muted{{/ifEquals}}" href="/admin/businesses?tab=pending&view={{#ifEquals viewMode 'table'}}table{{else}}card{{/ifEquals}}">
                Pending Review ({{stats.pending}})
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{#ifEquals tab 'approved'}}active text-success{{else}}text-muted{{/ifEquals}}" href="/admin/businesses?tab=approved&view={{#ifEquals viewMode 'table'}}table{{else}}card{{/ifEquals}}">
                Approved ({{stats.approved}})
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{#ifEquals tab 'rejected'}}active text-danger{{else}}text-muted{{/ifEquals}}" href="/admin/businesses?tab=rejected&view={{#ifEquals viewMode 'table'}}table{{else}}card{{/ifEquals}}">
                Rejected ({{stats.rejected}})
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{#ifEquals tab 'suspended'}}active text-danger{{else}}text-muted{{/ifEquals}}" href="/admin/businesses?tab=suspended&view={{#ifEquals viewMode 'table'}}table{{else}}card{{/ifEquals}}">
                Suspended ({{stats.suspended}})
            </a>
        </li>
    </ul>

    <!-- FILTER TOOLBAR -->
    <form class="card p-3 mb-4 border-0 shadow-sm" method="GET" action="/admin/businesses" id="businessFilterForm" style="border-radius: 16px;">
        <input type="hidden" name="tab" value="{{tab}}">
        <input type="hidden" name="view" value="{{#ifEquals viewMode 'table'}}table{{else}}card{{/ifEquals}}" class="admin-view-input">
        <div class="row g-2 align-items-center">
            <div class="col-lg-5 col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                    <input type="text" class="form-control border-start-0" name="search" value="{{filters.search}}" placeholder="Search by business name, slug, owner, recruiter, location...">
                </div>
            </div>
            <div class="col-lg-3 col-md-3 col-6">
                <input type="text" class="form-control" name="industry" value="{{#ifEquals filters.industry 'all'}}{{else}}{{filters.industry}}{{/ifEquals}}" placeholder="Industry (e.g. EPC, Energy)...">
            </div>
            <div class="col-lg-2 col-md-3 col-6">
                <select class="form-select" name="verification" onchange="document.getElementById('businessFilterForm').submit()">
                    <option value="all">All Verifications</option>
                    <option value="VERIFIED" {{#ifEquals filters.verification 'VERIFIED'}}selected{{/ifEquals}}>Verified</option>
                    <option value="PENDING" {{#ifEquals filters.verification 'PENDING'}}selected{{/ifEquals}}>Pending</option>
                    <option value="REJECTED" {{#ifEquals filters.verification 'REJECTED'}}selected{{/ifEquals}}>Rejected</option>
                    <option value="REVOKED" {{#ifEquals filters.verification 'REVOKED'}}selected{{/ifEquals}}>Revoked</option>
                </select>
            </div>
            <div class="col-lg-2 col-md-12 text-end">
                <button type="submit" class="btn btn-primary w-100"><i class="fa-solid fa-filter me-1"></i> Filter</button>
            </div>
        </div>
    </form>

    <!-- REUSABLE VIEW TOGGLE -->
    {{> admin/view-toggle section="businesses" itemLabel="businesses"}}

    <!-- CARD VIEW (DEFAULT) -->
    <div class="admin-cards-container {{#ifEquals viewMode 'table'}}d-none{{/ifEquals}}" id="businessesCardView" data-section="businesses">
        <div class="row g-4 mb-4">
            {{#if records.length}}
            {{#each records}}
            <div class="col-xl-4 col-md-6">
                <div class="admin-governance-card">
                    <div class="admin-card-header">
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            {{#ifEquals statusNormalized 'APPROVED'}}
                            <span class="admin-badge admin-badge-success"><i class="fa-solid fa-circle-check"></i> Approved</span>
                            {{else ifEquals statusNormalized 'PENDING'}}
                            <span class="admin-badge admin-badge-warning"><i class="fa-solid fa-clock"></i> Pending Review</span>
                            {{else ifEquals statusNormalized 'REJECTED'}}
                            <span class="admin-badge admin-badge-danger"><i class="fa-solid fa-circle-xmark"></i> Rejected</span>
                            {{else}}
                            <span class="admin-badge admin-badge-danger"><i class="fa-solid fa-ban"></i> Suspended</span>
                            {{/ifEquals}}

                            {{#ifEquals verificationStatusNormalized 'VERIFIED'}}
                            <span class="admin-badge admin-badge-success"><i class="fa-solid fa-shield-check"></i> Verified</span>
                            {{else ifEquals verificationStatusNormalized 'PENDING'}}
                            <span class="admin-badge admin-badge-warning"><i class="fa-solid fa-shield-halved"></i> Verif. Pending</span>
                            {{else ifEquals verificationStatusNormalized 'REJECTED'}}
                            <span class="admin-badge admin-badge-danger"><i class="fa-solid fa-shield-xmark"></i> Verif. Rejected</span>
                            {{/ifEquals}}
                        </div>
                        <span class="badge bg-light text-muted border small">{{#if industry}}{{industry}}{{else}}Infrastructure{{/if}}</span>
                    </div>

                    <div class="admin-card-body">
                        <div class="d-flex align-items-start gap-3">
                            <div class="rounded-3 p-2 d-flex align-items-center justify-content-center border shadow-xs" style="width: 48px; height: 48px; background: var(--surface);">
                                {{#if logo}}
                                <img src="{{logo}}" class="img-fluid rounded" alt="{{name}}" style="max-height: 36px; object-fit: contain;">
                                {{else}}
                                <i class="fa-solid fa-building text-primary fs-5"></i>
                                {{/if}}
                            </div>
                            <div class="overflow-hidden">
                                <h4 class="admin-card-title text-truncate">
                                    <a href="/admin/businesses/{{_id}}" class="text-decoration-none" style="color:var(--text);">{{name}}</a>
                                </h4>
                                <div class="admin-card-subtitle text-truncate">@{{slug}}</div>
                            </div>
                        </div>

                        <!-- GOVERNANCE METRICS RIBBON -->
                        <div class="d-flex justify-content-between p-2 rounded bg-light border my-3 text-center small">
                            <div>
                                <span class="d-block text-muted" style="font-size: 10px; text-transform: uppercase;">Members</span>
                                <strong class="text-dark">{{membersCount}}</strong>
                            </div>
                            <div class="border-start ps-2">
                                <span class="d-block text-muted" style="font-size: 10px; text-transform: uppercase;">Open Jobs</span>
                                <strong class="text-primary">{{openJobsCount}}</strong>
                            </div>
                            <div class="border-start ps-2">
                                <span class="d-block text-muted" style="font-size: 10px; text-transform: uppercase;">Reports</span>
                                <strong class="{{#if reportsCount}}text-danger{{else}}text-muted{{/if}}">{{reportsCount}}</strong>
                            </div>
                        </div>

                        <div class="admin-card-meta-list">
                            <div class="admin-card-meta-item">
                                <i class="fa-solid fa-user-tie"></i>
                                <span class="text-truncate">Owner: <strong>{{ownerName}}</strong> ({{ownerRole}})</span>
                            </div>
                            <div class="admin-card-meta-item">
                                <i class="fa-regular fa-envelope"></i>
                                <span class="text-truncate">{{ownerEmail}}</span>
                            </div>
                            <div class="admin-card-meta-item">
                                <i class="fa-solid fa-location-dot"></i>
                                <span class="text-truncate">{{#if location}}{{location}}{{else}}Location not specified{{/if}}</span>
                            </div>
                            {{#if infrastructureSpecializations.length}}
                            <div class="admin-card-meta-item">
                                <i class="fa-solid fa-screwdriver-wrench"></i>
                                <div class="d-flex flex-wrap gap-1">
                                    {{#each infrastructureSpecializations}}
                                    <span class="badge bg-light text-secondary border small" style="font-size: 10px;">{{this}}</span>
                                    {{/each}}
                                </div>
                            </div>
                            {{/if}}
                            <div class="admin-card-meta-item">
                                <i class="fa-regular fa-calendar"></i>
                                <span>Submitted {{formatDate createdAt}}</span>
                            </div>
                        </div>
                    </div>

                    <div class="admin-card-footer">
                        <a href="/admin/businesses/{{_id}}" class="btn btn-sm btn-outline-secondary" title="Review Detail">
                            <i class="fa-solid fa-eye me-1"></i> Review
                        </a>
                        {{#ifEquals statusNormalized 'PENDING'}}
                        <button type="button" class="btn btn-sm btn-outline-success" onclick="approveBusiness('{{_id}}', '{{name}}', this)" title="Approve Business">
                            <i class="fa-solid fa-check me-1"></i> Approve
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="openRejectModal('{{_id}}', '{{name}}')" title="Reject Application">
                            <i class="fa-solid fa-xmark me-1"></i> Reject
                        </button>
                        {{/ifEquals}}
                        {{#ifEquals statusNormalized 'APPROVED'}}
                        <button type="button" class="btn btn-sm btn-outline-warning" onclick="openSuspendModal('{{_id}}', '{{name}}')" title="Suspend Entity">
                            <i class="fa-solid fa-pause me-1"></i> Suspend
                        </button>
                        {{/ifEquals}}
                        {{#ifEquals statusNormalized 'SUSPENDED'}}
                        <button type="button" class="btn btn-sm btn-outline-success" onclick="restoreBusiness('{{_id}}', '{{name}}', this)" title="Restore Entity">
                            <i class="fa-solid fa-rotate-left me-1"></i> Restore
                        </button>
                        {{/ifEquals}}
                    </div>
                </div>
            </div>
            {{/each}}
            {{else}}
            <div class="col-12">
                <div class="admin-empty-state">
                    <div class="admin-empty-state-icon">
                        <i class="fa-solid fa-building-circle-check"></i>
                    </div>
                    <div class="admin-empty-state-title">No Businesses In This Queue</div>
                    <p class="admin-empty-state-desc">There are currently no infrastructure business entities matching the selected criteria.</p>
                </div>
            </div>
            {{/if}}
        </div>
    </div>

    <!-- TABLE VIEW -->
    <div class="admin-table-container {{#ifEquals viewMode 'table'}}{{else}}d-none{{/ifEquals}}" id="businessesTableView" data-section="businesses">
        <div class="card border-0 shadow-sm" style="border-radius: 16px; overflow: hidden;">
            <div class="table-responsive mb-0">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr style="font-size: 12px; text-transform: uppercase;">
                            <th class="ps-4">Business</th>
                            <th>Owner</th>
                            <th>Verification</th>
                            <th>Status</th>
                            <th>Members</th>
                            <th>Open Jobs</th>
                            <th>Reports</th>
                            <th>Submitted</th>
                            <th class="text-end pe-4" style="min-width: 140px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#if records.length}}
                        {{#each records}}
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded p-2 d-flex align-items-center justify-content-center border shadow-xs" style="width: 44px; height: 44px; background: var(--surface);">
                                        {{#if logo}}
                                        <img src="{{logo}}" class="img-fluid rounded" alt="{{name}}" style="max-height: 28px; object-fit: contain;">
                                        {{else}}
                                        <i class="fa-solid fa-building text-primary"></i>
                                        {{/if}}
                                    </div>
                                    <div>
                                        <a href="/admin/businesses/{{_id}}" class="fw-bold text-decoration-none" style="color:var(--text);">
                                            {{name}}
                                        </a>
                                        <div class="text-muted small">@{{slug}} &bull; {{#if industry}}{{industry}}{{else}}Infrastructure{{/if}}</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="small fw-semibold">{{ownerName}}</div>
                                <span class="badge bg-light text-dark border small" style="font-size: 10px;">{{ownerRole}}</span>
                            </td>
                            <td>
                                {{#ifEquals verificationStatusNormalized 'VERIFIED'}}
                                <span class="admin-badge admin-badge-success"><i class="fa-solid fa-shield-check me-1"></i> Verified</span>
                                {{else ifEquals verificationStatusNormalized 'PENDING'}}
                                <span class="admin-badge admin-badge-warning"><i class="fa-solid fa-shield-halved me-1"></i> Pending</span>
                                {{else ifEquals verificationStatusNormalized 'REJECTED'}}
                                <span class="admin-badge admin-badge-danger"><i class="fa-solid fa-shield-xmark me-1"></i> Rejected</span>
                                {{else}}
                                <span class="admin-badge admin-badge-secondary"><i class="fa-solid fa-shield me-1"></i> Unverified</span>
                                {{/ifEquals}}
                            </td>
                            <td>
                                {{#ifEquals statusNormalized 'APPROVED'}}
                                <span class="admin-badge admin-badge-success"><i class="fa-solid fa-check-circle me-1"></i> Approved</span>
                                {{else ifEquals statusNormalized 'PENDING'}}
                                <span class="admin-badge admin-badge-warning"><i class="fa-solid fa-clock me-1"></i> Pending</span>
                                {{else ifEquals statusNormalized 'REJECTED'}}
                                <span class="admin-badge admin-badge-danger"><i class="fa-solid fa-circle-xmark me-1"></i> Rejected</span>
                                {{else}}
                                <span class="admin-badge admin-badge-danger"><i class="fa-solid fa-ban me-1"></i> Suspended</span>
                                {{/ifEquals}}
                            </td>
                            <td>
                                <span class="fw-semibold text-dark">{{membersCount}}</span>
                            </td>
                            <td>
                                <span class="fw-semibold text-primary">{{openJobsCount}}</span>
                            </td>
                            <td>
                                <span class="fw-semibold {{#if reportsCount}}text-danger{{else}}text-muted{{/if}}">{{reportsCount}}</span>
                            </td>
                            <td class="small text-muted">{{formatDate createdAt}}</td>
                            <td class="text-end pe-4">
                                <div class="table-actions">
                                    <a href="/admin/businesses/{{_id}}" class="btn btn-sm btn-outline-secondary" title="Review Detail">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>
                                    {{#ifEquals statusNormalized 'PENDING'}}
                                    <button type="button" class="btn btn-sm btn-outline-success" onclick="approveBusiness('{{_id}}', '{{name}}', this)" title="Approve">
                                        <i class="fa-solid fa-check"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="openRejectModal('{{_id}}', '{{name}}')" title="Reject">
                                        <i class="fa-solid fa-xmark"></i>
                                    </button>
                                    {{/ifEquals}}
                                    {{#ifEquals statusNormalized 'APPROVED'}}
                                    <button type="button" class="btn btn-sm btn-outline-warning" onclick="openSuspendModal('{{_id}}', '{{name}}')" title="Suspend">
                                        <i class="fa-solid fa-pause"></i>
                                    </button>
                                    {{/ifEquals}}
                                    {{#ifEquals statusNormalized 'SUSPENDED'}}
                                    <button type="button" class="btn btn-sm btn-outline-success" onclick="restoreBusiness('{{_id}}', '{{name}}', this)" title="Restore">
                                        <i class="fa-solid fa-rotate-left"></i>
                                    </button>
                                    {{/ifEquals}}
                                </div>
                            </td>
                        </tr>
                        {{/each}}
                        {{else}}
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-building-circle-check fa-3x mb-3 text-secondary opacity-50"></i>
                                <p class="m-0">No business entities found in this status view.</p>
                            </td>
                        </tr>
                        {{/if}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- PAGINATION (PRESERVES VIEW STATE) -->
    {{#if (gt totalPages 1)}}
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 py-3 px-1 mt-3">
        <span class="small text-muted">Page {{page}} of {{totalPages}} ({{total}} total businesses)</span>
        <div class="d-flex gap-2">
            {{#if (gt page 1)}}
            <a href="/admin/businesses?tab={{tab}}&page={{dec page}}&search={{filters.search}}&view={{#ifEquals viewMode 'table'}}table{{else}}card{{/ifEquals}}" class="btn btn-sm btn-outline-secondary">
                <i class="fa-solid fa-chevron-left me-1"></i> Previous
            </a>
            {{/if}}
            {{#if (lt page totalPages)}}
            <a href="/admin/businesses?tab={{tab}}&page={{inc page}}&search={{filters.search}}&view={{#ifEquals viewMode 'table'}}table{{else}}card{{/ifEquals}}" class="btn btn-sm btn-outline-secondary">
                Next <i class="fa-solid fa-chevron-right ms-1"></i>
            </a>
            {{/if}}
        </div>
    </div>
    {{/if}}

</div>

<!-- REJECT MODAL -->
<div class="modal fade" id="rejectBusinessModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 16px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-danger"><i class="fa-solid fa-circle-xmark me-2"></i> Reject Business Application</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="rejectBusinessForm" onsubmit="submitRejectBusiness(event)">
                <div class="modal-body py-3">
                    <p class="small text-muted">Rejecting verification for <strong id="rejectBusinessName" class="text-dark"></strong>.</p>
                    <input type="hidden" id="rejectBusinessId">
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Reason for Rejection (Mandatory)</label>
                        <textarea class="form-control" id="rejectReason" rows="3" placeholder="Provide specific feedback (e.g. Unverified corporate domain, missing GST/company credentials)..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Confirm Rejection</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- SUSPEND MODAL -->
<div class="modal fade" id="suspendBusinessModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 16px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-warning"><i class="fa-solid fa-pause me-2"></i> Suspend Business Entity</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="suspendBusinessForm" onsubmit="submitSuspendBusiness(event)">
                <div class="modal-body py-3">
                    <p class="small text-muted">Suspending <strong id="suspendBusinessName" class="text-dark"></strong>. All published jobs will be paused automatically.</p>
                    <input type="hidden" id="suspendBusinessId">
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Suspension Reason (Mandatory)</label>
                        <textarea class="form-control" id="suspendReason" rows="3" placeholder="State operational or integrity reason for suspension..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning text-dark">Confirm Suspension</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
let rejectModal, suspendModal;

document.addEventListener('DOMContentLoaded', () => {
    if (window.bootstrap) {
        rejectModal = new bootstrap.Modal(document.getElementById('rejectBusinessModal'));
        suspendModal = new bootstrap.Modal(document.getElementById('suspendBusinessModal'));
    }
});

async function approveBusiness(id, name, btn) {
    const confirmRes = await Swal.fire({
        title: 'Approve Business?',
        text: `Approve and verify ${name} on Zeitnah Network?`,
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#198754',
        confirmButtonText: 'Yes, Approve'
    });
    if (!confirmRes.isConfirmed) return;

    const resetBtn = (window.zeitnahSetSubmitting && btn) ? window.zeitnahSetSubmitting(btn, 'Approving...') : () => {};

    try {
        const res = await fetch(`/admin/businesses/${id}/approve`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }
        });
        const json = await res.json();
        if (json.success) {
            Swal.fire({ icon: 'success', title: 'Approved', text: json.message, timer: 1500, showConfirmButton: false });
            setTimeout(() => window.location.reload(), 1500);
        } else {
            resetBtn();
            Swal.fire({ icon: 'error', title: 'Failed', text: json.message });
        }
    } catch (e) {
        resetBtn();
        Swal.fire({ icon: 'error', title: 'Error', text: e.message });
    }
}

async function restoreBusiness(id, name, btn) {
    const confirmRes = await Swal.fire({
        title: 'Restore Business?',
        text: `Restore active governance status for "${name}"?`,
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#10b981',
        cancelButtonColor: '#6c757d',
        confirmButtonText: 'Yes, Restore'
    });
    if (!confirmRes.isConfirmed) return;

    const resetBtn = (window.zeitnahSetSubmitting && btn) ? window.zeitnahSetSubmitting(btn, 'Restoring...') : () => {};

    try {
        const res = await fetch(`/admin/businesses/${id}/restore`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }
        });
        const json = await res.json();
        if (json.success) {
            Swal.fire({ icon: 'success', title: 'Restored', text: json.message, timer: 1500, showConfirmButton: false });
            setTimeout(() => window.location.reload(), 1500);
        } else {
            resetBtn();
            Swal.fire({ icon: 'error', title: 'Failed', text: json.message });
        }
    } catch (e) {
        resetBtn();
        Swal.fire({ icon: 'error', title: 'Error', text: e.message });
    }
}

