<div class="container-fluid mt-4 mb-5">

    <!-- HERO HEADER -->
    <div class="hero-card mb-4" style="background: linear-gradient(135deg, rgba(18, 49, 76, 0.95), rgba(29, 78, 137, 0.9)), url('/images/banner.jpg') center/cover; padding: 32px 36px; border-radius: 24px; position: relative; overflow: hidden; box-shadow: 0 12px 32px rgba(18, 49, 76, 0.15);">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 position-relative" style="z-index: 2;">
            <div>
                <span class="badge mb-2 px-3 py-2" style="background: rgba(159, 213, 178, 0.2); color: #9fd5b2; border: 1px solid rgba(159, 213, 178, 0.35); border-radius: 30px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px;">
                    <i class="fa-solid fa-building-shield me-1"></i> Phase 2 Governance
                </span>
                <h2 class="text-white fw-bold m-0" style="font-size: 28px; letter-spacing: -0.5px;">Business Review Center</h2>
                <p class="text-light opacity-75 mt-2 mb-0" style="font-size: 14px;">Review, verify, approve, reject, or suspend infrastructure employers and corporate entities.</p>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <a href="/admin/jobs" class="btn btn-light px-3 py-2">
                    <i class="fa-solid fa-briefcase me-1"></i> Jobs Governance
                </a>
            </div>
        </div>
    </div>

    <!-- STATS -->
    <div class="row g-4 mb-4">
        <div class="col-xl-2 col-md-4 col-6">
            <div class="stat-card stat-dark">
                <div>
                    <small>Total Businesses</small>
                    <h2>{{stats.total}}</h2>
                </div>
                <i class="fa-solid fa-building stat-icon"></i>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-6">
            <div class="stat-card stat-yellow">
                <div>
                    <small>Pending Review</small>
                    <h2>{{stats.pending}}</h2>
                </div>
                <i class="fa-solid fa-hourglass-half stat-icon"></i>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-6">
            <div class="stat-card stat-green">
                <div>
                    <small>Approved</small>
                    <h2>{{stats.approved}}</h2>
                </div>
                <i class="fa-solid fa-circle-check stat-icon"></i>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-6">
            <div class="stat-card stat-red">
                <div>
                    <small>Rejected</small>
                    <h2>{{stats.rejected}}</h2>
                </div>
                <i class="fa-solid fa-circle-xmark stat-icon"></i>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-6">
            <div class="stat-card stat-dark">
                <div>
                    <small>Suspended</small>
                    <h2>{{stats.suspended}}</h2>
                </div>
                <i class="fa-solid fa-ban stat-icon"></i>
            </div>
        </div>
    </div>

    <!-- TABS -->
    <ul class="nav nav-tabs mb-4 border-bottom" style="font-size: 14px; font-weight: 600;">
        <li class="nav-item">
            <a class="nav-link {{#ifEquals tab 'all'}}active text-primary{{else}}text-muted{{/ifEquals}}" href="/admin/businesses?tab=all">
                All ({{stats.total}})
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{#ifEquals tab 'pending'}}active text-warning{{else}}text-muted{{/ifEquals}}" href="/admin/businesses?tab=pending">
                Pending Review ({{stats.pending}})
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{#ifEquals tab 'approved'}}active text-success{{else}}text-muted{{/ifEquals}}" href="/admin/businesses?tab=approved">
                Approved ({{stats.approved}})
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{#ifEquals tab 'rejected'}}active text-danger{{else}}text-muted{{/ifEquals}}" href="/admin/businesses?tab=rejected">
                Rejected ({{stats.rejected}})
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{#ifEquals tab 'suspended'}}active text-danger{{else}}text-muted{{/ifEquals}}" href="/admin/businesses?tab=suspended">
                Suspended ({{stats.suspended}})
            </a>
        </li>
    </ul>

    <!-- FILTER TOOLBAR -->
    <form class="card p-3 mb-4 border-0 shadow-sm" method="GET" action="/admin/businesses" id="businessFilterForm" style="border-radius: 16px;">
        <input type="hidden" name="tab" value="{{tab}}">
        <div class="row g-2 align-items-center">
            <div class="col-lg-6 col-md-8">
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                    <input type="text" class="form-control border-start-0" name="search" value="{{filters.search}}" placeholder="Search by business name, slug, industry, location...">
                </div>
            </div>
            <div class="col-lg-4 col-md-3">
                <input type="text" class="form-control" name="industry" value="{{#ifEquals filters.industry 'all'}}{{else}}{{filters.industry}}{{/ifEquals}}" placeholder="Filter by industry (e.g. EPC, Highways)...">
            </div>
            <div class="col-lg-2 col-md-1 text-end">
                <button type="submit" class="btn btn-primary w-100"><i class="fa-solid fa-filter me-1"></i> Filter</button>
            </div>
        </div>
    </form>

    <!-- BUSINESSES TABLE -->
    <div class="card border-0 shadow-sm" style="border-radius: 16px; overflow: hidden;">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr style="font-size: 12px; text-transform: uppercase;">
                        <th class="ps-4">Business</th>
                        <th>Owner</th>
                        <th>Role</th>
                        <th>Industry</th>
                        <th>Specialization</th>
                        <th>Location</th>
                        <th>Submitted</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {{#if records.length}}
                    {{#each records}}
                    <tr>
                        <td class="ps-4">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded p-2 d-flex align-items-center justify-content-center border" style="width: 44px; height: 44px; background: #fff;">
                                    <i class="fa-solid fa-building text-primary"></i>
                                </div>
                                <div>
                                    <a href="/admin/businesses/{{_id}}" class="fw-bold text-decoration-none" style="color:var(--text);">
                                        {{name}}
                                    </a>
                                    <div class="text-muted small">@{{slug}}</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="small fw-semibold">{{ownerName}}</div>
                            <div class="text-muted" style="font-size: 11px;">{{ownerEmail}}</div>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">{{ownerRole}}</span>
                        </td>
                        <td class="small text-muted">{{#if industry}}{{industry}}{{else}}Infrastructure{{/if}}</td>
                        <td>
                            {{#if infrastructureSpecializations.length}}
                            <span class="badge bg-light text-secondary border">{{infrastructureSpecializations.[0]}}</span>
                            {{else}}
                            <span class="text-muted small">—</span>
                            {{/if}}
                        </td>
                        <td class="small text-muted">{{#if location}}{{location}}{{else}}—{{/if}}</td>
                        <td class="small text-muted">{{formatDate createdAt}}</td>
                        <td>
                            {{#ifEquals statusNormalized 'APPROVED'}}
                            <span class="badge bg-success"><i class="fa-solid fa-check-circle me-1"></i> Approved</span>
                            {{else}}
                            {{#ifEquals statusNormalized 'PENDING'}}
                            <span class="badge bg-warning text-dark"><i class="fa-solid fa-clock me-1"></i> Pending</span>
                            {{else}}
                            {{#ifEquals statusNormalized 'REJECTED'}}
                            <span class="badge bg-danger"><i class="fa-solid fa-circle-xmark me-1"></i> Rejected</span>
                            {{else}}
                            <span class="badge bg-dark"><i class="fa-solid fa-ban me-1"></i> Suspended</span>
                            {{/ifEquals}}
                            {{/ifEquals}}
                            {{/ifEquals}}
                        </td>
                        <td class="text-end pe-4">
                            <div class="btn-group btn-group-sm">
                                <a href="/admin/businesses/{{_id}}" class="btn btn-outline-secondary" title="Review Detail">
                                    <i class="fa-solid fa-eye"></i>
                                </a>
                                {{#ifEquals statusNormalized 'PENDING'}}
                                <button type="button" class="btn btn-outline-success" onclick="approveBusiness('{{_id}}', '{{name}}')" title="Approve">
                                    <i class="fa-solid fa-check"></i>
                                </button>
                                <button type="button" class="btn btn-outline-danger" onclick="openRejectModal('{{_id}}', '{{name}}')" title="Reject">
                                    <i class="fa-solid fa-xmark"></i>
                                </button>
                                {{/ifEquals}}
                                {{#ifEquals statusNormalized 'APPROVED'}}
                                <button type="button" class="btn btn-outline-warning" onclick="openSuspendModal('{{_id}}', '{{name}}')" title="Suspend">
                                    <i class="fa-solid fa-pause"></i>
                                </button>
                                {{/ifEquals}}
                            </div>
                        </td>
                    </tr>
                    {{/each}}
                    {{else}}
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-building-circle-check fa-3x mb-3 text-secondary opacity-50"></i>
                            <p class="m-0">No business entities found in this status view.</p>
                        </td>
                    </tr>
                    {{/if}}
                </tbody>
            </table>
        </div>

        {{#if (gt totalPages 1)}}
        <div class="card-footer bg-transparent d-flex justify-content-between align-items-center py-3 px-4">
            <span class="small text-muted">Page {{page}} of {{totalPages}} ({{total}} total businesses)</span>
            <div class="d-flex gap-2">
                {{#if (gt page 1)}}
                <a href="/admin/businesses?tab={{tab}}&page={{dec page}}&search={{filters.search}}" class="btn btn-sm btn-outline-secondary">
                    <i class="fa-solid fa-chevron-left me-1"></i> Previous
                </a>
                {{/if}}
                {{#if (lt page totalPages)}}
                <a href="/admin/businesses?tab={{tab}}&page={{inc page}}&search={{filters.search}}" class="btn btn-sm btn-outline-secondary">
                    Next <i class="fa-solid fa-chevron-right ms-1"></i>
                </a>
                {{/if}}
            </div>
        </div>
        {{/if}}
    </div>

</div>

<!-- REJECT MODAL -->
<div class="modal fade" id="rejectBusinessModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 16px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-danger"><i class="fa-solid fa-circle-xmark me-2"></i> Reject Business Application</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="rejectBusinessForm" onsubmit="submitRejectBusiness(event)">
                <div class="modal-body py-3">
                    <p class="small text-muted">Rejecting verification for <strong id="rejectBusinessName" class="text-dark"></strong>.</p>
                    <input type="hidden" id="rejectBusinessId">
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Reason for Rejection (Mandatory)</label>
                        <textarea class="form-control" id="rejectReason" rows="3" placeholder="Provide specific feedback (e.g. Unverified corporate domain, missing GST/company credentials)..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Confirm Rejection</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- SUSPEND MODAL -->
<div class="modal fade" id="suspendBusinessModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 16px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-warning"><i class="fa-solid fa-pause me-2"></i> Suspend Business Entity</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="suspendBusinessForm" onsubmit="submitSuspendBusiness(event)">
                <div class="modal-body py-3">
                    <p class="small text-muted">Suspending <strong id="suspendBusinessName" class="text-dark"></strong>. All published jobs will be paused automatically.</p>
                    <input type="hidden" id="suspendBusinessId">
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Suspension Reason (Mandatory)</label>
                        <textarea class="form-control" id="suspendReason" rows="3" placeholder="State operational or integrity reason for suspension..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning text-dark">Confirm Suspension</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
let rejectModal, suspendModal;

document.addEventListener('DOMContentLoaded', () => {
    if (window.bootstrap) {
        rejectModal = new bootstrap.Modal(document.getElementById('rejectBusinessModal'));
        suspendModal = new bootstrap.Modal(document.getElementById('suspendBusinessModal'));
    }
});

async function approveBusiness(id, name) {
    const confirmRes = await Swal.fire({
        title: 'Approve Business?',
        text: `Approve and verify ${name} on Zeitnah Network?`,
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#198754',
        confirmButtonText: 'Yes, Approve'
    });
    if (!confirmRes.isConfirmed) return;

    try {
        const res = await fetch(`/admin/businesses/${id}/approve`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }
        });
        const json = await res.json();
        if (json.success) {
            Swal.fire({ icon: 'success', title: 'Approved', text: json.message, timer: 1500, showConfirmButton: false });
            setTimeout(() => window.location.reload(), 1500);
        } else {
            Swal.fire({ icon: 'error', title: 'Failed', text: json.message });
        }
    } catch (e) {
        Swal.fire({ icon: 'error', title: 'Error', text: e.message });
    }
}

function openRejectModal(id, name) {
    document.getElementById('rejectBusinessId').value = id;
    document.getElementById('rejectBusinessName').innerText = name;
    document.getElementById('rejectReason').value = '';
    rejectModal.show();
}

async function submitRejectBusiness(e) {
    e.preventDefault();
    const id = document.getElementById('rejectBusinessId').value;
    const reason = document.getElementById('rejectReason').value;

    try {
        const res = await fetch(`/admin/businesses/${id}/reject`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ reason })
        });
        const json = await res.json();
        if (json.success) {
            Swal.fire({ icon: 'success', title: 'Rejected', text: json.message, timer: 1500, showConfirmButton: false });
            setTimeout(() => window.location.reload(), 1500);
        } else {
            Swal.fire({ icon: 'error', title: 'Failed', text: json.message });
        }
    } catch(err) {
        Swal.fire({ icon: 'error', title: 'Error', text: err.message });
    }
}

function openSuspendModal(id, name) {
    document.getElementById('suspendBusinessId').value = id;
    document.getElementById('suspendBusinessName').innerText = name;
    document.getElementById('suspendReason').value = '';
    suspendModal.show();
}

async function submitSuspendBusiness(e) {
    e.preventDefault();
    const id = document.getElementById('suspendBusinessId').value;
    const reason = document.getElementById('suspendReason').value;

    try {
        const res = await fetch(`/admin/businesses/${id}/suspend`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ reason })
        });
        const json = await res.json();
        if (json.success) {
            Swal.fire({ icon: 'success', title: 'Suspended', text: json.message, timer: 1500, showConfirmButton: false });
            setTimeout(() => window.location.reload(), 1500);
        } else {
            Swal.fire({ icon: 'error', title: 'Failed', text: json.message });
        }
    } catch(err) {
        Swal.fire({ icon: 'error', title: 'Error', text: err.message });
    }
}
</script>
