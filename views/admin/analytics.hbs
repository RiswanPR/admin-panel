<div class="container-fluid mt-4 mb-5">

    <!-- HERO HEADER -->
    <div class="hero-card mb-4" style="background: linear-gradient(135deg, rgba(18, 49, 76, 0.95), rgba(29, 78, 137, 0.9)), url('/images/banner.jpg') center/cover; padding: 32px 36px; border-radius: 24px; position: relative; overflow: hidden; box-shadow: 0 12px 32px rgba(18, 49, 76, 0.15);">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 position-relative" style="z-index: 2;">
            <div>
                <span class="badge mb-2 px-3 py-2" style="background: rgba(159, 213, 178, 0.2); color: #9fd5b2; border: 1px solid rgba(159, 213, 178, 0.35); border-radius: 30px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px;">
                    <i class="fa-solid fa-chart-column me-1"></i> Multi-Domain Analytics
                </span>
                <h2 class="text-white fw-bold m-0" style="font-size: 28px; letter-spacing: -0.5px;">Platform Intelligence &amp; Analytics</h2>
                <p class="text-light opacity-75 mt-2 mb-0" style="font-size: 14px;">Cross-domain telemetry across Network, Businesses, Jobs, and AI Matching subsystems.</p>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <a href="/admin/ai/matching" class="btn btn-light px-3 py-2">
                    <i class="fa-solid fa-brain me-1"></i> AI Matching Health
                </a>
            </div>
        </div>
    </div>

    <!-- 1. NETWORK ANALYTICS ROW (REQ 23) -->
    <div class="card p-4 border-0 shadow-sm mb-4" style="border-radius: 16px;">
        <h5 class="fw-bold mb-3"><i class="fa-solid fa-users-rays text-primary me-2"></i> Network &amp; Talent Ecosystem</h5>
        <div class="row g-4 mb-3">
            <div class="col-xl-3 col-md-6">
                <div class="p-3 bg-light rounded border">
                    <span class="text-muted small d-block">Total Profiles</span>
                    <h3 class="fw-bold m-0 text-dark">{{analytics.network.totalUsers}}</h3>
                    <span class="small text-success">{{analytics.network.activeUsers}} active</span>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="p-3 bg-light rounded border">
                    <span class="text-muted small d-block">Network Connections</span>
                    <h3 class="fw-bold m-0 text-primary">{{analytics.network.connections}}</h3>
                    <span class="small text-muted">Verified relationships</span>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="p-3 bg-light rounded border">
                    <span class="text-muted small d-block">Public Profiles</span>
                    <h3 class="fw-bold m-0 text-success">{{analytics.network.publicProfiles}}</h3>
                    <span class="small text-muted">Discoverable to recruiters</span>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="p-3 bg-light rounded border">
                    <span class="text-muted small d-block">Completed CV Profiles</span>
                    <h3 class="fw-bold m-0 text-info">{{analytics.network.profilesCompleted}}</h3>
                    <span class="small text-muted">With skills &amp; experience</span>
                </div>
            </div>
        </div>

        <!-- ROLE DISTRIBUTION TABLE -->
        <h6 class="fw-bold small text-muted text-uppercase mb-2" style="letter-spacing: 0.5px;">Role Breakdown</h6>
        <div class="row g-2 text-center small">
            <div class="col-md-2 col-4">
                <div class="p-2 rounded bg-light border">
                    <span class="text-muted d-block">Students</span>
                    <strong class="fs-6 text-primary">{{analytics.network.roles.STUDENT}}</strong>
                </div>
            </div>
            <div class="col-md-2 col-4">
                <div class="p-2 rounded bg-light border">
                    <span class="text-muted d-block">Educators</span>
                    <strong class="fs-6 text-warning">{{analytics.network.roles.EDUCATOR}}</strong>
                </div>
            </div>
            <div class="col-md-2 col-4">
                <div class="p-2 rounded bg-light border">
                    <span class="text-muted d-block">Professionals</span>
                    <strong class="fs-6 text-dark">{{analytics.network.roles.PROFESSIONAL}}</strong>
                </div>
            </div>
            <div class="col-md-2 col-4">
                <div class="p-2 rounded bg-light border">
                    <span class="text-muted d-block">Mentors</span>
                    <strong class="fs-6 text-info">{{analytics.network.roles.MENTOR}}</strong>
                </div>
            </div>
            <div class="col-md-2 col-4">
                <div class="p-2 rounded bg-light border">
                    <span class="text-muted d-block">Recruiters</span>
                    <strong class="fs-6 text-success">{{analytics.network.roles.RECRUITER}}</strong>
                </div>
            </div>
            <div class="col-md-2 col-4">
                <div class="p-2 rounded bg-light border">
                    <span class="text-muted d-block">Founders</span>
                    <strong class="fs-6 text-secondary">{{analytics.network.roles.FOUNDER}}</strong>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. BUSINESSES & JOBS ANALYTICS ROW (REQ 24 & 25) -->
    <div class="row g-4 mb-4">

        <!-- BUSINESS ANALYTICS -->
        <div class="col-lg-6">
            <div class="card p-4 border-0 shadow-sm h-100" style="border-radius: 16px;">
                <h5 class="fw-bold mb-3"><i class="fa-solid fa-building text-primary me-2"></i> Business Ecosystem</h5>
                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <div class="p-3 bg-light rounded border">
                            <span class="text-muted small d-block">Total Organizations</span>
                            <h3 class="fw-bold m-0 text-dark">{{analytics.businesses.total}}</h3>
                            <span class="small text-muted">{{analytics.businesses.jobsPerBusiness}} jobs / business</span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 bg-light rounded border">
                            <span class="text-muted small d-block">Approved Employers</span>
                            <h3 class="fw-bold m-0 text-success">{{analytics.businesses.approved}}</h3>
                            <span class="small text-warning">{{analytics.businesses.pending}} pending review</span>
                        </div>
                    </div>
                </div>

                <strong class="small text-muted d-block mb-2">Organizations by Industry Sector:</strong>
                <div class="d-flex flex-column gap-2 small">
                    {{#each analytics.businesses.byIndustry}}
                    <div class="d-flex justify-content-between p-2 rounded bg-light">
                        <span>{{name}}</span>
                        <strong class="text-primary">{{count}}</strong>
                    </div>
                    {{/each}}
                </div>
            </div>
        </div>

        <!-- JOBS ANALYTICS -->
        <div class="col-lg-6">
            <div class="card p-4 border-0 shadow-sm h-100" style="border-radius: 16px;">
                <h5 class="fw-bold mb-3"><i class="fa-solid fa-briefcase text-primary me-2"></i> Opportunities &amp; Jobs</h5>
                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <div class="p-3 bg-light rounded border">
                            <span class="text-muted small d-block">Total Opportunities</span>
                            <h3 class="fw-bold m-0 text-dark">{{analytics.jobs.total}}</h3>
                            <span class="small text-success">{{analytics.jobs.active}} published</span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 bg-light rounded border">
                            <span class="text-muted small d-block">Closed / Archived</span>
                            <h3 class="fw-bold m-0 text-secondary">{{analytics.jobs.closed}}</h3>
                            <span class="small text-muted">{{analytics.jobs.drafts}} in draft</span>
                        </div>
                    </div>
                </div>

                <strong class="small text-muted d-block mb-2">Openings by Discipline:</strong>
                <div class="d-flex flex-column gap-2 small">
                    {{#each analytics.jobs.byDiscipline}}
                    <div class="d-flex justify-content-between p-2 rounded bg-light">
                        <span>{{name}}</span>
                        <strong class="text-primary">{{count}}</strong>
                    </div>
                    {{/each}}
                </div>
            </div>
        </div>

    </div>

    <!-- 3. AI MATCHING ANALYTICS ROW (REQ 26) -->
    <div class="card p-4 border-0 shadow-sm" style="border-radius: 16px;">
        <h5 class="fw-bold mb-3"><i class="fa-solid fa-brain text-primary me-2"></i> AI Matching &amp; Recommendation Intelligence</h5>
        <div class="row g-4 text-center">
            <div class="col-md-3 col-6">
                <div class="p-3 bg-light rounded border">
                    <span class="text-muted small d-block">Job → Talent Matches</span>
                    <h3 class="fw-bold m-0 text-primary">{{analytics.matching.totalJobMatches}}</h3>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="p-3 bg-light rounded border">
                    <span class="text-muted small d-block">Talent → Job Recommendations</span>
                    <h3 class="fw-bold m-0 text-success">{{analytics.matching.totalTalentRecommendations}}</h3>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="p-3 bg-light rounded border">
                    <span class="text-muted small d-block">Mean Compatibility Score</span>
                    <h3 class="fw-bold m-0 text-info">{{analytics.matching.averageCompatibility}}%</h3>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="p-3 bg-light rounded border">
                    <span class="text-muted small d-block">Fallback Frequency</span>
                    <h3 class="fw-bold m-0 text-warning">{{analytics.matching.fallbackFrequencyPercent}}%</h3>
                </div>
            </div>
        </div>
    </div>

</div>
