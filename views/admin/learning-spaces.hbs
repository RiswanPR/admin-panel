<div class="container-fluid mt-4 mb-5">

    <!-- HERO HEADER -->
    <div class="hero-card mb-4" style="background: linear-gradient(135deg, rgba(18, 49, 76, 0.95), rgba(29, 78, 137, 0.9)), url('/images/banner.jpg') center/cover; padding: 32px 36px; border-radius: 24px; position: relative; overflow: hidden; box-shadow: 0 12px 32px rgba(18, 49, 76, 0.15);">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 position-relative" style="z-index: 2;">
            <div>
                <span class="badge mb-2 px-3 py-2" style="background: rgba(159, 213, 178, 0.2); color: #9fd5b2; border: 1px solid rgba(159, 213, 178, 0.35); border-radius: 30px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px;">
                    <i class="fa-solid fa-shapes me-1"></i> Cohorts &amp; Groups
                </span>
                <h2 class="text-white fw-bold m-0" style="font-size: 28px; letter-spacing: -0.5px;">Learning Spaces</h2>
                <p class="text-light opacity-75 mt-2 mb-0" style="font-size: 14px;">Manage study groups, student batches, departmental cohorts, and assigned educators.</p>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <a href="/learning-spaces/create" class="btn btn-success px-4 py-2" id="btnCreateSpace">
                    <i class="fa-solid fa-plus me-2"></i> Create Learning Space
                </a>
            </div>
        </div>
    </div>

    <!-- STATS -->
    <div class="row g-4 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="stat-card stat-dark">
                <div>
                    <small>Total Spaces</small>
                    <h2>{{total}}</h2>
                </div>
                <i class="fa-solid fa-shapes stat-icon"></i>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="stat-card stat-green">
                <div>
                    <small>Current Page Spaces</small>
                    <h2>{{#if spaces}}{{spaces.length}}{{else}}0{{/if}}</h2>
                </div>
                <i class="fa-solid fa-circle-check stat-icon"></i>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="stat-card stat-blue">
                <div>
                    <small>Page</small>
                    <h2>{{page}} / {{totalPages}}</h2>
                </div>
                <i class="fa-solid fa-file-lines stat-icon"></i>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="stat-card stat-yellow">
                <div>
                    <small>Access Mode</small>
                    <h2>Controlled</h2>
                </div>
                <i class="fa-solid fa-lock stat-icon"></i>
            </div>
        </div>
    </div>

    <!-- TOOLBAR & FILTERS -->
    <form class="toolbar-card mb-4" method="GET" action="/learning-spaces" id="spacesFilterForm">
        <div class="search-box">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" name="search" id="spaceSearchInput" value="{{filters.search}}" placeholder="Search by name, code, or category...">
        </div>

        <select class="form-select filter-select" name="status" onchange="document.getElementById('spacesFilterForm').submit()">
            <option value="all" {{#ifEquals filters.status 'all'}}selected{{/ifEquals}}>All Statuses</option>
            <option value="active" {{#ifEquals filters.status 'active'}}selected{{/ifEquals}}>Active</option>
            <option value="draft" {{#ifEquals filters.status 'draft'}}selected{{/ifEquals}}>Draft</option>
            <option value="archived" {{#ifEquals filters.status 'archived'}}selected{{/ifEquals}}>Archived</option>
        </select>

        <select class="form-select filter-select" name="category" onchange="document.getElementById('spacesFilterForm').submit()">
            <option value="all" {{#ifEquals filters.category 'all'}}selected{{/ifEquals}}>All Categories</option>
            <option value="Batch" {{#ifEquals filters.category 'Batch'}}selected{{/ifEquals}}>Batch</option>
            <option value="Study Group" {{#ifEquals filters.category 'Study Group'}}selected{{/ifEquals}}>Study Group</option>
            <option value="Department" {{#ifEquals filters.category 'Department'}}selected{{/ifEquals}}>Department</option>
            <option value="Program" {{#ifEquals filters.category 'Program'}}selected{{/ifEquals}}>Program</option>
            <option value="Training Group" {{#ifEquals filters.category 'Training Group'}}selected{{/ifEquals}}>Training Group</option>
        </select>

        <button class="btn btn-primary filter-btn" type="submit" title="Apply Filters">
            <i class="fa-solid fa-filter"></i>
        </button>
    </form>

    <!-- SPACES GRID -->
    {{#if spaces.length}}
    <div class="row g-4 mb-4">
        {{#each spaces}}
        <div class="col-xl-4 col-md-6">
            <div class="card h-100 p-4 position-relative d-flex flex-column justify-content-between" style="border-radius: 20px; transition: transform 0.25s ease, box-shadow 0.25s ease;">
                <div>
                    <!-- TOP BADGES -->
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="badge bg-light text-dark border px-2 py-1">
                            <code>{{this.code}}</code>
                        </span>

                        <span class="badge {{#ifEquals this.status 'active'}}bg-success{{else}}{{#ifEquals this.status 'draft'}}bg-warning text-dark{{else}}bg-secondary{{/ifEquals}}{{/ifEquals}} px-2 py-1 text-capitalize">
                            {{this.status}}
                        </span>
                    </div>

                    <!-- NAME & CATEGORY -->
                    <h5 class="fw-bold mb-1" style="color:var(--text);">
                        <a href="/learning-spaces/{{this._id}}" class="text-decoration-none" style="color:inherit;">
                            {{this.name}}
                        </a>
                    </h5>
                    <small class="badge bg-secondary mb-3">{{this.category}}</small>

                    <p class="text-muted small mb-4" style="line-height: 1.5; min-height: 42px;">
                        {{truncate this.description 110}}
                    </p>

                    <!-- METRICS -->
                    <div class="d-flex justify-content-between align-items-center p-3 rounded-3 mb-3" style="background: var(--surface-2); border: 1px solid var(--border);">
                        <div>
                            <small class="text-muted d-block" style="font-size: 11px;">MEMBERS</small>
                            <span class="fw-bold fs-6"><i class="fa-solid fa-users me-1 text-primary"></i> {{this.memberCount}}</span>
                        </div>
                        <div>
                            <small class="text-muted d-block" style="font-size: 11px;">TEACHERS</small>
                            <span class="fw-bold fs-6"><i class="fa-solid fa-chalkboard-user me-1 text-warning"></i> {{#if this.teachers}}{{this.teachers.length}}{{else}}0{{/if}}</span>
                        </div>
                        <div>
                            <small class="text-muted d-block" style="font-size: 11px;">ACCESS</small>
                            <span class="fw-bold fs-6 text-capitalize">{{this.accessMode}}</span>
                        </div>
                    </div>

                    <!-- TEACHERS CHIPS -->
                    {{#if this.teacherDocs.length}}
                    <div class="mb-3">
                        <small class="text-muted d-block mb-1" style="font-size: 11px;">ASSIGNED EDUCATORS</small>
                        <div class="d-flex flex-wrap gap-1">
                            {{#each this.teacherDocs}}
                            <span class="badge bg-light text-dark border">
                                <i class="fa-solid fa-user-tie me-1 text-warning"></i> {{this.name}}
                            </span>
                            {{/each}}
                        </div>
                    </div>
                    {{/if}}
                </div>

                <!-- FOOTER ACTIONS -->
                <div class="pt-3 border-top d-flex justify-content-between align-items-center">
                    <a href="/learning-spaces/{{this._id}}/members" class="btn btn-sm btn-outline-primary">
                        <i class="fa-solid fa-user-gear me-1"></i> Members ({{this.memberCount}})
                    </a>

                    <div class="d-flex gap-1">
                        <a href="/learning-spaces/{{this._id}}" class="btn btn-sm btn-light" title="View Dashboard">
                            <i class="fa-solid fa-eye"></i>
                        </a>
                        <a href="/learning-spaces/{{this._id}}/edit" class="btn btn-sm btn-light" title="Edit Space">
                            <i class="fa-solid fa-pen-to-square"></i>
                        </a>
                        <button class="btn btn-sm btn-outline-danger" onclick="deleteSpace('{{this._id}}', '{{this.name}}')" title="Delete Space">
                            <i class="fa-solid fa-trash-can"></i>
                        </button>
                    </div>
                </div>

            </div>
        </div>
        {{/each}}
    </div>
    {{else}}
    <div class="card p-5 text-center text-muted">
        <i class="fa-solid fa-shapes fa-3x mb-3 opacity-50"></i>
        <h5>No Learning Spaces Found</h5>
        <p class="mb-4">Create your first cohort, study group, or batch to begin organizing learners.</p>
        <div>
            <a href="/learning-spaces/create" class="btn btn-primary px-4">
                <i class="fa-solid fa-plus me-2"></i> Create Learning Space
            </a>
        </div>
    </div>
    {{/if}}

    <!-- PAGINATION -->
    {{#ifGt totalPages 1}}
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mt-4">
        <div class="text-muted small">
            Showing page <strong>{{page}}</strong> of <strong>{{totalPages}}</strong> (Total: {{total}})
        </div>

        <nav>
            <ul class="pagination mb-0">
                <li class="page-item {{#ifEquals page 1}}disabled{{/ifEquals}}">
                    <a class="page-link" href="/learning-spaces?page={{dec page}}&search={{filters.search}}&status={{filters.status}}&category={{filters.category}}">Previous</a>
                </li>
                <li class="page-item active">
                    <span class="page-link">{{page}}</span>
                </li>
                <li class="page-item {{#ifEquals page totalPages}}disabled{{/ifEquals}}">
                    <a class="page-link" href="/learning-spaces?page={{inc page}}&search={{filters.search}}&status={{filters.status}}&category={{filters.category}}">Next</a>
                </li>
            </ul>
        </nav>
    </div>
    {{/ifGt}}

</div>

<script>
function deleteSpace(spaceId, name) {
    Swal.fire({
        title: 'Delete Learning Space?',
        text: `Are you sure you want to permanently delete "${name}" and all its membership records? This action cannot be undone.`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#dc3545',
        confirmButtonText: 'Yes, Delete Space'
    }).then((result) => {
        if (result.isConfirmed) {
            fetch(`/learning-spaces/${spaceId}/delete`, {
                method: 'POST',
                headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' }
            })
            .then(r => r.json())
            .then(d => {
                if (d.success) {
                    Swal.fire('Deleted!', d.message, 'success').then(() => location.reload());
                } else {
                    Swal.fire('Error', d.message, 'error');
                }
            });
        }
    });
}
</script>
