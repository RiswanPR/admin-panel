<div class="container-fluid mt-4 mb-5">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="/admin/career-intelligence/roles">Career Intelligence</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Roles</li>
                </ol>
            </nav>
            <h2 class="fw-bold m-0" style="color:var(--brand);">
                <i class="fa-solid fa-id-card-clip me-2"></i> Infrastructure Role Taxonomy
            </h2>
            <small class="text-muted">Canonical infrastructure engineering role definitions, discipline hierarchy, and competency requirements.</small>
        </div>

        <div class="d-flex gap-2">
            <a href="/admin/career-intelligence/skills" class="btn btn-outline-primary px-3">
                <i class="fa-solid fa-diagram-project me-1"></i> Skill Graph
            </a>
            <a href="/admin/career-intelligence/pathways" class="btn btn-outline-success px-3">
                <i class="fa-solid fa-route me-1"></i> Career Pathways
            </a>
            <a href="/admin/career-intelligence/market" class="btn btn-outline-info px-3">
                <i class="fa-solid fa-chart-pie me-1"></i> Market Intelligence
            </a>
        </div>
    </div>

    <!-- FILTER TOOLBAR -->
    <form class="card p-3 mb-3 border-0 shadow-sm" method="GET" action="/admin/career-intelligence/roles" style="border-radius: 16px;">
        <input type="hidden" name="view" value="{{#ifEquals viewMode 'table'}}table{{else}}card{{/ifEquals}}">
        <div class="row g-2 align-items-center">
            <div class="col-lg-5 col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                    <input type="text" class="form-control border-start-0" name="search" value="{{filters.search}}" placeholder="Search roles by title, skill, or keyword...">
                </div>
            </div>
            <div class="col-lg-4 col-md-3 col-6">
                <select class="form-select" name="discipline" onchange="this.form.submit()">
                    <option value="all">All Disciplines</option>
                    {{#each disciplines}}
                    <option value="{{this}}" {{#ifEquals ../filters.discipline this}}selected{{/ifEquals}}>{{this}}</option>
                    {{/each}}
                </select>
            </div>
            <div class="col-lg-2 col-md-3 col-6">
                <select class="form-select" name="tier" onchange="this.form.submit()">
                    <option value="all">All Experience Tiers</option>
                    <option value="ENTRY_LEVEL" {{#ifEquals filters.tier 'ENTRY_LEVEL'}}selected{{/ifEquals}}>Entry Level</option>
                    <option value="MID_LEVEL" {{#ifEquals filters.tier 'MID_LEVEL'}}selected{{/ifEquals}}>Mid Level</option>
                    <option value="SENIOR_LEVEL" {{#ifEquals filters.tier 'SENIOR_LEVEL'}}selected{{/ifEquals}}>Senior Level</option>
                    <option value="EXECUTIVE" {{#ifEquals filters.tier 'EXECUTIVE'}}selected{{/ifEquals}}>Executive</option>
                </select>
            </div>
            <div class="col-lg-1 text-end">
                <a href="/admin/career-intelligence/roles" class="btn btn-outline-secondary w-100"><i class="fa-solid fa-rotate"></i></a>
            </div>
        </div>
    </form>

    <!-- VIEW TOGGLE -->
    {{> admin/view-toggle section="career-roles" total=roles.length itemLabel="roles" viewMode=viewMode}}

    <!-- CARD VIEW (DEFAULT) -->
    <div class="admin-cards-container {{#ifEquals viewMode 'table'}}d-none{{/ifEquals}}" id="career-rolesCardView" data-section="career-roles">
        <div class="row g-4">
            {{#if roles.length}}
            {{#each roles}}
            <div class="col-lg-6 col-12">
                <div class="admin-governance-card h-100">
                    <div class="admin-card-header">
                        <span class="badge bg-light text-dark border">{{tier}}</span>
                        <span class="text-primary small fw-semibold">{{discipline}} &bull; {{experienceRange}}</span>
                    </div>

                    <div class="admin-card-body">
                        <h4 class="admin-card-title mb-2">{{title}}</h4>

                        <div class="mb-3">
                            <strong class="small text-muted d-block mb-1" style="font-size: 11px;">Target Sectors:</strong>
                            <div class="d-flex flex-wrap gap-1">
                                {{#each sectors}}
                                <span class="badge bg-success-subtle text-success small">{{this}}</span>
                                {{/each}}
                            </div>
                        </div>

                        <div class="mb-3">
                            <strong class="small text-muted d-block mb-1" style="font-size: 11px;">Required Competencies:</strong>
                            <div class="d-flex flex-wrap gap-1">
                                {{#each requiredSkills}}
                                <span class="badge bg-light text-primary border small">{{this}}</span>
                                {{/each}}
                            </div>
                        </div>

                        <div class="mb-3">
                            <strong class="small text-muted d-block mb-1" style="font-size: 11px;">Required Software:</strong>
                            <div class="d-flex flex-wrap gap-1">
                                {{#each requiredSoftware}}
                                <span class="badge bg-info bg-opacity-10 text-info border small">{{this}}</span>
                                {{/each}}
                            </div>
                        </div>

                        {{#if pathway}}
                        <div class="p-2 rounded bg-light border mt-auto small">
                            <span class="text-muted d-block" style="font-size: 11px;">Progression Predecessors &rarr; Successors:</span>
                            <span class="text-secondary">{{#each pathway.predecessors}}{{this}}, {{/each}}</span>
                            <strong class="text-dark">&rarr; {{title}} &rarr;</strong>
                            <span class="text-primary">{{#each pathway.successors}}{{this}} {{/each}}</span>
                        </div>
                        {{/if}}
                    </div>

                    <div class="admin-card-footer">
                        <a href="/admin/jobs?discipline={{discipline}}" class="btn btn-sm btn-outline-secondary">
                            <i class="fa-solid fa-briefcase me-1"></i> View Related Jobs
                        </a>
                        <span class="badge bg-light text-secondary border small ms-auto">{{experienceRange}}</span>
                    </div>
                </div>
            </div>
            {{/each}}
            {{else}}
            <div class="col-12">
                <div class="admin-empty-state">
                    <div class="admin-empty-state-icon"><i class="fa-solid fa-id-card-clip"></i></div>
                    <div class="admin-empty-state-title">No Roles Found</div>
                    <p class="admin-empty-state-desc">No infrastructure role definitions match the selected criteria.</p>
                </div>
            </div>
            {{/if}}
        </div>
    </div>

    <!-- TABLE VIEW -->
    <div class="admin-table-container {{#ifEquals viewMode 'table'}}{{else}}d-none{{/ifEquals}}" id="career-rolesTableView" data-section="career-roles">
        <div class="card border-0 shadow-sm" style="border-radius: 16px; overflow: hidden;">
            <div class="table-responsive mb-0">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr style="font-size: 12px; text-transform: uppercase;">
                            <th class="ps-4">Role Title</th>
                            <th>Discipline</th>
                            <th>Experience Tier</th>
                            <th>Experience Range</th>
                            <th>Target Sectors</th>
                            <th>Key Software</th>
                            <th class="pe-4 text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#if roles.length}}
                        {{#each roles}}
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold" style="color:var(--text);">{{title}}</div>
                            </td>
                            <td>
                                <span class="badge bg-light text-primary border">{{discipline}}</span>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">{{tier}}</span>
                            </td>
                            <td class="small text-muted">{{experienceRange}}</td>
                            <td>
                                <div class="d-flex flex-wrap gap-1" style="max-width: 200px;">
                                    {{#each sectors}}
                                    <span class="badge bg-success-subtle text-success small" style="font-size: 10px;">{{this}}</span>
                                    {{/each}}
                                </div>
                            </td>
                            <td>
                                <div class="d-flex flex-wrap gap-1" style="max-width: 200px;">
                                    {{#each requiredSoftware}}
                                    <span class="badge bg-info bg-opacity-10 text-info border small" style="font-size: 10px;">{{this}}</span>
                                    {{/each}}
                                </div>
                            </td>
                            <td class="pe-4 text-end">
                                <div class="table-actions">
                                    <a href="/admin/jobs?discipline={{discipline}}" class="btn btn-sm btn-outline-secondary" title="View Related Jobs">
                                        <i class="fa-solid fa-briefcase"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                        {{/each}}
                        {{else}}
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">No roles found matching query.</td>
                        </tr>
                        {{/if}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
