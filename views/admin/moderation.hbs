<div class="container-fluid mt-4 mb-5">

    <!-- HERO HEADER -->
    <div class="hero-card mb-4" style="background: linear-gradient(135deg, rgba(18, 49, 76, 0.95), rgba(29, 78, 137, 0.9)), url('/images/banner.jpg') center/cover; padding: 32px 36px; border-radius: 24px; position: relative; overflow: hidden; box-shadow: 0 12px 32px rgba(18, 49, 76, 0.15);">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 position-relative" style="z-index: 2;">
            <div>
                <span class="badge mb-2 px-3 py-2" style="background: rgba(159, 213, 178, 0.2); color: #9fd5b2; border: 1px solid rgba(159, 213, 178, 0.35); border-radius: 30px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px;">
                    <i class="fa-solid fa-shield-halved me-1"></i> Phase 5 Operations
                </span>
                <h2 class="text-white fw-bold m-0" style="font-size: 28px; letter-spacing: -0.5px;">Platform Moderation Center</h2>
                <p class="text-light opacity-75 mt-2 mb-0" style="font-size: 14px;">Review community reports, triage flagged content, investigate violations, and enforce governance actions.</p>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <a href="/admin/audit-logs" class="btn btn-light px-3 py-2">
                    <i class="fa-solid fa-clock-rotate-left me-1"></i> Audit Logs
                </a>
            </div>
        </div>
    </div>

    <!-- STATS -->
    <div class="row g-4 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="stat-card stat-dark">
                <div>
                    <small>Total Reports</small>
                    <h2>{{stats.total}}</h2>
                </div>
                <i class="fa-solid fa-flag stat-icon"></i>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="stat-card stat-red">
                <div>
                    <small>Open / Pending</small>
                    <h2>{{stats.open}}</h2>
                </div>
                <i class="fa-solid fa-triangle-exclamation stat-icon"></i>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="stat-card stat-yellow">
                <div>
                    <small>Under Review</small>
                    <h2>{{stats.underReview}}</h2>
                </div>
                <i class="fa-solid fa-magnifying-glass stat-icon"></i>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="stat-card stat-green">
                <div>
                    <small>Resolved Cases</small>
                    <h2>{{stats.resolved}}</h2>
                </div>
                <i class="fa-solid fa-circle-check stat-icon"></i>
            </div>
        </div>
    </div>

    <!-- TABS -->
    <ul class="nav nav-tabs mb-4 border-bottom" style="font-size: 14px; font-weight: 600;">
        <li class="nav-item">
            <a class="nav-link {{#ifEquals tab 'open'}}active text-danger{{else}}text-muted{{/ifEquals}}" href="/admin/moderation?tab=open&targetType={{targetType}}">
                Open Reports ({{stats.open}})
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{#ifEquals tab 'under_review'}}active text-warning{{else}}text-muted{{/ifEquals}}" href="/admin/moderation?tab=under_review&targetType={{targetType}}">
                Under Review ({{stats.underReview}})
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{#ifEquals tab 'resolved'}}active text-success{{else}}text-muted{{/ifEquals}}" href="/admin/moderation?tab=resolved&targetType={{targetType}}">
                Resolved ({{stats.resolved}})
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{#ifEquals tab 'dismissed'}}active text-secondary{{else}}text-muted{{/ifEquals}}" href="/admin/moderation?tab=dismissed&targetType={{targetType}}">
                Dismissed ({{stats.dismissed}})
            </a>
        </li>
    </ul>

    <!-- FILTER TOOLBAR -->
    <form class="card p-3 mb-4 border-0 shadow-sm" method="GET" action="/admin/moderation" id="moderationFilterForm" style="border-radius: 16px;">
        <input type="hidden" name="tab" value="{{tab}}">
        <div class="row g-2 align-items-center">
            <div class="col-lg-6 col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                    <input type="text" class="form-control border-start-0" name="search" value="{{filters.search}}" placeholder="Search reason, details, target ID...">
                </div>
            </div>
            <div class="col-lg-4 col-md-4">
                <select class="form-select" name="targetType" onchange="document.getElementById('moderationFilterForm').submit()">
                    <option value="all" {{#ifEquals targetType 'ALL'}}selected{{/ifEquals}}>All Entity Types</option>
                    <option value="USER" {{#ifEquals targetType 'USER'}}selected{{/ifEquals}}>Reported Users</option>
                    <option value="OPPORTUNITY" {{#ifEquals targetType 'OPPORTUNITY'}}selected{{/ifEquals}}>Reported Jobs</option>
                    <option value="ORGANIZATION" {{#ifEquals targetType 'ORGANIZATION'}}selected{{/ifEquals}}>Reported Businesses</option>
                    <option value="DISCUSSION" {{#ifEquals targetType 'DISCUSSION'}}selected{{/ifEquals}}>Reported Discussions</option>
                </select>
            </div>
            <div class="col-lg-2 col-md-2 text-end">
                <a href="/admin/moderation" class="btn btn-outline-secondary w-100"><i class="fa-solid fa-rotate"></i> Reset</a>
            </div>
        </div>
    </form>

    <!-- REPORTS TABLE -->
    <div class="card border-0 shadow-sm" style="border-radius: 16px; overflow: hidden;">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr style="font-size: 12px; text-transform: uppercase;">
                        <th class="ps-4">Entity Type</th>
                        <th>Target Subject</th>
                        <th>Reporter</th>
                        <th>Violation Reason</th>
                        <th>Status</th>
                        <th>Reported Date</th>
                        <th class="pe-4 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {{#if records.length}}
                    {{#each records}}
                    <tr>
                        <td class="ps-4">
                            <span class="badge {{#ifEquals targetType 'USER'}}bg-primary{{else}}{{#ifEquals targetType 'OPPORTUNITY'}}bg-info{{else}}{{#ifEquals targetType 'ORGANIZATION'}}bg-warning text-dark{{else}}bg-secondary{{/ifEquals}}{{/ifEquals}}{{/ifEquals}}">
                                {{targetType}}
                            </span>
                        </td>
                        <td>
                            <strong class="text-dark">{{targetName}}</strong>
                            <div class="text-muted" style="font-size: 11px;">ID: {{targetId}}</div>
                        </td>
                        <td>
                            <div class="small fw-semibold">{{reporterName}}</div>
                            <div class="text-muted" style="font-size: 11px;">{{reporterEmail}}</div>
                        </td>
                        <td>
                            <div class="fw-semibold small text-danger">{{reason}}</div>
                            {{#if details}}
                            <div class="text-muted small text-truncate" style="max-width: 250px;">{{details}}</div>
                            {{/if}}
                        </td>
                        <td>
                            {{#ifEquals statusNormalized 'PENDING'}}
                            <span class="badge bg-danger">Pending</span>
                            {{else}}
                            {{#ifEquals statusNormalized 'REVIEWED'}}
                            <span class="badge bg-warning text-dark">Under Review</span>
                            {{else}}
                            {{#ifEquals statusNormalized 'RESOLVED'}}
                            <span class="badge bg-success">Resolved</span>
                            {{else}}
                            <span class="badge bg-secondary">Dismissed</span>
                            {{/ifEquals}}
                            {{/ifEquals}}
                            {{/ifEquals}}
                        </td>
                        <td class="small text-muted">{{formatDate createdAt}}</td>
                        <td class="pe-4 text-end">
                            <button type="button" class="btn btn-sm btn-outline-primary" onclick="openResolveModal('{{_id}}', '{{targetType}}', '{{targetName}}', '{{reason}}')">
                                <i class="fa-solid fa-gavel me-1"></i> Adjudicate
                            </button>
                        </td>
                    </tr>
                    {{/each}}
                    {{else}}
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-shield-check fa-3x mb-3 text-secondary opacity-50"></i>
                            <p class="m-0">No moderation reports found in this status queue.</p>
                        </td>
                    </tr>
                    {{/if}}
                </tbody>
            </table>
        </div>

        {{#if (gt totalPages 1)}}
        <div class="card-footer bg-transparent d-flex justify-content-between align-items-center py-3 px-4">
            <span class="small text-muted">Page {{page}} of {{totalPages}} ({{total}} total reports)</span>
            <div class="d-flex gap-2">
                {{#if (gt page 1)}}
                <a href="/admin/moderation?tab={{tab}}&targetType={{targetType}}&page={{dec page}}" class="btn btn-sm btn-outline-secondary">Previous</a>
                {{/if}}
                {{#if (lt page totalPages)}}
                <a href="/admin/moderation?tab={{tab}}&targetType={{targetType}}&page={{inc page}}" class="btn btn-sm btn-outline-secondary">Next</a>
                {{/if}}
            </div>
        </div>
        {{/if}}
    </div>

</div>

<!-- ADJUDICATE MODAL -->
<div class="modal fade" id="resolveModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 16px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-gavel text-primary me-2"></i> Adjudicate Moderation Report</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="resolveForm" onsubmit="submitResolveReport(event)">
                <div class="modal-body py-3">
                    <p class="small text-muted">Resolving incident on <strong id="modalTargetType" class="text-primary"></strong>: <strong id="modalTargetName" class="text-dark"></strong>.</p>
                    <div class="p-2 mb-3 bg-light rounded border small">
                        <strong>Reported Reason:</strong> <span id="modalReason"></span>
                    </div>

                    <input type="hidden" id="modalReportId">

                    <div class="mb-3">
                        <label class="form-label fw-bold small">Resolution Decision</label>
                        <select class="form-select" id="resolutionStatus" required>
                            <option value="RESOLVED">Resolved (Violation Addressed / Enforced)</option>
                            <option value="UNDER_REVIEW">Under Further Review</option>
                            <option value="DISMISSED">Dismissed (No Violation Found / False Report)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small">Action Taken</label>
                        <input type="text" class="form-control" id="actionTaken" placeholder="e.g. Warning issued, job unpublished, content removed, profile unverified...">
                    </div>

                    <div class="mb-2">
                        <label class="form-label fw-bold small">Moderator Investigation Notes</label>
                        <textarea class="form-control" id="moderatorNotes" rows="3" placeholder="Provide investigation details for audit log..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Submit Adjudication</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
let resolveModalInstance;

document.addEventListener('DOMContentLoaded', () => {
    if (window.bootstrap) {
        resolveModalInstance = new bootstrap.Modal(document.getElementById('resolveModal'));
    }
});

function openResolveModal(reportId, targetType, targetName, reason) {
    document.getElementById('modalReportId').value = reportId;
    document.getElementById('modalTargetType').innerText = targetType;
    document.getElementById('modalTargetName').innerText = targetName;
    document.getElementById('modalReason').innerText = reason;
    document.getElementById('actionTaken').value = '';
    document.getElementById('moderatorNotes').value = '';
    resolveModalInstance.show();
}

async function submitResolveReport(e) {
    e.preventDefault();
    const id = document.getElementById('modalReportId').value;
    const status = document.getElementById('resolutionStatus').value;
    const actionTaken = document.getElementById('actionTaken').value;
    const moderatorNotes = document.getElementById('moderatorNotes').value;

    try {
        const res = await fetch(`/admin/moderation/reports/${id}/resolve`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ status, actionTaken, moderatorNotes })
        });
        const json = await res.json();
        if (json.success) {
            Swal.fire({ icon: 'success', title: 'Incident Adjudicated', text: json.message, timer: 1500, showConfirmButton: false });
            setTimeout(() => window.location.reload(), 1500);
        } else {
            Swal.fire({ icon: 'error', title: 'Failed', text: json.message });
        }
    } catch (err) {
        Swal.fire({ icon: 'error', title: 'Error', text: err.message });
    }
}
</script>
