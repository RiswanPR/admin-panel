<div class="container-fluid dashboard-wrapper">

    <!-- HERO SECTION -->
    <div class="hero-section mb-4">
        <div class="hero-content">
            <div class="hero-badge">
                <span class="pulse-dot"></span>
                <span>Academy Live Control Panel</span>
            </div>
            <h1 class="hero-title">
                Welcome back, <span>{{#if admin}}{{admin}}{{else}}Admin{{/if}}</span> 👋
            </h1>
            <p class="hero-subtitle">
                Real-time academy performance, learner activity, and analytics overview.
            </p>
            <div class="hero-date" id="heroLiveDate">
                <i class="fa-regular fa-calendar-days me-2"></i>
                <span id="currentDateDisplay">Loading date...</span>
            </div>
        </div>

        <div class="hero-actions">
            <a href="/add-students" class="btn-hero-primary">
                <i class="fa-solid fa-user-plus"></i>
                <span>Add Student</span>
            </a>
            <a href="/add-courses" class="btn-hero-secondary">
                <i class="fa-solid fa-plus"></i>
                <span>New Course</span>
            </a>
            <button type="button" class="btn-hero-ghost" onclick="if(window.openCommandPalette) window.openCommandPalette();" title="Open Quick Command (⌘K)">
                <i class="fa-solid fa-bolt"></i>
                <span>Actions <kbd class="hero-kbd">⌘K</kbd></span>
            </button>
        </div>
    </div>


    <!-- SKELETON PLACEHOLDERS (Hidden once page loads) -->
    <div class="skeleton-placeholder mb-4">
        <div class="row">
            <div class="col-xl-3 col-md-6 mb-3"><div class="skeleton skeleton-card"></div></div>
            <div class="col-xl-3 col-md-6 mb-3"><div class="skeleton skeleton-card"></div></div>
            <div class="col-xl-3 col-md-6 mb-3"><div class="skeleton skeleton-card"></div></div>
            <div class="col-xl-3 col-md-6 mb-3"><div class="skeleton skeleton-card"></div></div>
        </div>
        <div class="row">
            <div class="col-lg-8 mb-4"><div class="skeleton skeleton-chart"></div></div>
            <div class="col-lg-4 mb-4"><div class="skeleton skeleton-chart"></div></div>
        </div>
    </div>


    <!-- STAT CARDS ROW -->
    <div class="real-content">
        <div class="row mb-4">

            <!-- Total Students -->
            <div class="col-xl-3 col-md-6 mb-3">
                <div class="stat-card stat-card-students">
                    <div class="stat-card-header">
                        <span class="stat-label">Total Learners</span>
                        <div class="stat-icon-wrap icon-students">
                            <i class="fa-solid fa-user-graduate"></i>
                        </div>
                    </div>
                    <div class="stat-card-body">
                        <h2 class="stat-value">
                            <span class="counter" data-target="{{dashboard.totalStudents}}">0</span>
                        </h2>
                        <div class="stat-trend trend-neutral">
                            <i class="fa-solid fa-users me-1"></i>
                            <span>All registered learners</span>
                        </div>
                    </div>
                    <div class="stat-card-footer">
                        <div class="stat-bar-track">
                            <div class="stat-bar-fill fill-students" style="width: 100%;"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Active Students -->
            <div class="col-xl-3 col-md-6 mb-3">
                <div class="stat-card stat-card-active">
                    <div class="stat-card-header">
                        <span class="stat-label">Active Learners</span>
                        <div class="stat-icon-wrap icon-active">
                            <i class="fa-solid fa-circle-check"></i>
                        </div>
                    </div>
                    <div class="stat-card-body">
                        <h2 class="stat-value">
                            <span class="counter" data-target="{{dashboard.activeStudents}}">0</span>
                        </h2>
                        <div class="stat-trend trend-positive">
                            <i class="fa-solid fa-arrow-trend-up me-1"></i>
                            <span>{{dashboard.activePercentage}}% active ratio</span>
                        </div>
                    </div>
                    <div class="stat-card-footer">
                        <div class="stat-bar-track">
                            <div class="stat-bar-fill fill-active" style="width: {{dashboard.activePercentage}}%;"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Total Courses -->
            <div class="col-xl-3 col-md-6 mb-3">
                <div class="stat-card stat-card-courses">
                    <div class="stat-card-header">
                        <span class="stat-label">Total Courses</span>
                        <div class="stat-icon-wrap icon-courses">
                            <i class="fa-solid fa-layer-group"></i>
                        </div>
                    </div>
                    <div class="stat-card-body">
                        <h2 class="stat-value">
                            <span class="counter" data-target="{{dashboard.totalCourses}}">0</span>
                        </h2>
                        <div class="stat-trend trend-info">
                            <i class="fa-solid fa-book-open me-1"></i>
                            <span>{{dashboard.totalChapters}} learning chapters</span>
                        </div>
                    </div>
                    <div class="stat-card-footer">
                        <div class="stat-bar-track">
                            <div class="stat-bar-fill fill-courses" style="width: 85%;"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Total Revenue -->
            <div class="col-xl-3 col-md-6 mb-3">
                <div class="stat-card stat-card-revenue">
                    <div class="stat-card-header">
                        <span class="stat-label">Total Revenue</span>
                        <div class="stat-icon-wrap icon-revenue">
                            <i class="fa-solid fa-indian-rupee-sign"></i>
                        </div>
                    </div>
                    <div class="stat-card-body">
                        <h2 class="stat-value">
                            ₹<span class="counter" data-target="{{dashboard.totalRevenue}}">0</span>
                        </h2>
                        <div class="stat-trend trend-positive">
                            <i class="fa-solid fa-shield-halved me-1"></i>
                            <span>Verified collections</span>
                        </div>
                    </div>
                    <div class="stat-card-footer">
                        <div class="stat-bar-track">
                            <div class="stat-bar-fill fill-revenue" style="width: 100%;"></div>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- ZEITNAH NETWORK GOVERNANCE & ECOSYSTEM CONTROL HUB -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="panel-card p-4 border-0 shadow-sm" style="border-radius: 20px; background: linear-gradient(135deg, rgba(18, 49, 76, 0.04), rgba(29, 78, 137, 0.03));">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge px-3 py-2" style="background: rgba(18, 49, 76, 0.9); color: #fff; border-radius: 20px; font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px;">
                                <i class="fa-solid fa-network-wired me-1"></i> Ecosystem Governance
                            </span>
                            <h5 class="fw-bold m-0" style="color:var(--text);">Network &amp; Operations Control</h5>
                        </div>
                        <a href="/admin/analytics" class="btn btn-sm btn-outline-primary px-3">
                            <i class="fa-solid fa-chart-column me-1"></i> Multi-Domain Analytics
                        </a>
                    </div>

                    <div class="row g-3">
                        <!-- Network Users & Profiles -->
                        <div class="col-xl-2 col-md-4 col-6">
                            <a href="/admin/network/users" class="text-decoration-none">
                                <div class="p-3 bg-white rounded-3 border h-100 shadow-xs hover-elevate transition">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <i class="fa-solid fa-users-rays text-primary fs-5"></i>
                                        <i class="fa-solid fa-arrow-right text-muted small"></i>
                                    </div>
                                    <span class="text-muted small d-block">Network Users</span>
                                    <strong class="text-dark fs-6">Directory &amp; Roles</strong>
                                </div>
                            </a>
                        </div>

                        <!-- Businesses Review -->
                        <div class="col-xl-2 col-md-4 col-6">
                            <a href="/admin/businesses" class="text-decoration-none">
                                <div class="p-3 bg-white rounded-3 border h-100 shadow-xs hover-elevate transition">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <i class="fa-solid fa-building-shield text-warning fs-5"></i>
                                        {{#if dashboard.governance.pendingBusinesses}}
                                        <span class="badge bg-danger rounded-pill" style="font-size: 10px;">{{dashboard.governance.pendingBusinesses}} Pending</span>
                                        {{else}}
                                        <i class="fa-solid fa-arrow-right text-muted small"></i>
                                        {{/if}}
                                    </div>
                                    <span class="text-muted small d-block">Businesses</span>
                                    <strong class="text-dark fs-6">Review &amp; Verify</strong>
                                </div>
                            </a>
                        </div>

                        <!-- Jobs Governance -->
                        <div class="col-xl-2 col-md-4 col-6">
                            <a href="/admin/jobs" class="text-decoration-none">
                                <div class="p-3 bg-white rounded-3 border h-100 shadow-xs hover-elevate transition">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <i class="fa-solid fa-briefcase text-success fs-5"></i>
                                        <span class="badge bg-light text-dark border small" style="font-size: 10px;">{{dashboard.governance.activeJobs}} Active</span>
                                    </div>
                                    <span class="text-muted small d-block">Job Governance</span>
                                    <strong class="text-dark fs-6">Postings &amp; Flags</strong>
                                </div>
                            </a>
                        </div>

                        <!-- AI Matching Engine -->
                        <div class="col-xl-2 col-md-4 col-6">
                            <a href="/admin/ai/matching" class="text-decoration-none">
                                <div class="p-3 bg-white rounded-3 border h-100 shadow-xs hover-elevate transition">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <i class="fa-solid fa-brain text-info fs-5"></i>
                                        <span class="badge bg-success-subtle text-success small" style="font-size: 10px;">Live</span>
                                    </div>
                                    <span class="text-muted small d-block">AI Matching</span>
                                    <strong class="text-dark fs-6">Health &amp; Telemetry</strong>
                                </div>
                            </a>
                        </div>

                        <!-- Career Intelligence -->
                        <div class="col-xl-2 col-md-4 col-6">
                            <a href="/admin/career-intelligence/roles" class="text-decoration-none">
                                <div class="p-3 bg-white rounded-3 border h-100 shadow-xs hover-elevate transition">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <i class="fa-solid fa-route text-primary fs-5"></i>
                                        <i class="fa-solid fa-arrow-right text-muted small"></i>
                                    </div>
                                    <span class="text-muted small d-block">Career Intel</span>
                                    <strong class="text-dark fs-6">Taxonomy &amp; Market</strong>
                                </div>
                            </a>
                        </div>

                        <!-- Moderation Queue -->
                        <div class="col-xl-2 col-md-4 col-6">
                            <a href="/admin/moderation" class="text-decoration-none">
                                <div class="p-3 bg-white rounded-3 border h-100 shadow-xs hover-elevate transition">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <i class="fa-solid fa-shield-halved text-danger fs-5"></i>
                                        {{#if dashboard.governance.openModeration}}
                                        <span class="badge bg-danger rounded-pill" style="font-size: 10px;">{{dashboard.governance.openModeration}} Open</span>
                                        {{else}}
                                        <span class="badge bg-success-subtle text-success small" style="font-size: 10px;">Clean</span>
                                        {{/if}}
                                    </div>
                                    <span class="text-muted small d-block">Moderation</span>
                                    <strong class="text-dark fs-6">Incident Reports</strong>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ANALYTICS CHARTS SECTION -->
        <div class="row mb-4">

            <!-- Primary Chart (Enrollment & Revenue Trends) -->
            <div class="col-lg-8 mb-4 mb-lg-0">
                <div class="panel-card h-100">
                    <div class="panel-card-header">
                        <div class="panel-title-wrap">
                            <div class="panel-icon"><i class="fa-solid fa-chart-line"></i></div>
                            <div>
                                <h5 class="panel-title">Growth & Performance Trends</h5>
                                <span class="panel-subtitle">Monthly enrollment and collection activity (last 6 months)</span>
                            </div>
                        </div>
                        <div class="chart-tab-controls">
                            <button type="button" class="chart-tab-btn active" id="btnTrendEnrollment" onclick="switchMainChart('enrollment')">
                                <i class="fa-solid fa-user-graduate me-1"></i> Learners
                            </button>
                            <button type="button" class="chart-tab-btn" id="btnTrendRevenue" onclick="switchMainChart('revenue')">
                                <i class="fa-solid fa-indian-rupee-sign me-1"></i> Revenue
                            </button>
                        </div>
                    </div>

                    <div class="panel-card-body">
                        <div class="chart-container" style="position: relative; height: 310px; width: 100%;">
                            <canvas id="mainTrendsChart"></canvas>
                        </div>
                    </div>

                    <div class="panel-card-footer">
                        <div class="chart-summary-pills">
                            <div class="chart-summary-item">
                                <span class="summary-label">Active Ratio</span>
                                <strong class="summary-val text-success">{{dashboard.activePercentage}}%</strong>
                            </div>
                            <div class="chart-summary-item">
                                <span class="summary-label">Expired Learners</span>
                                <strong class="summary-val text-warning">{{dashboard.expiredStudents}}</strong>
                            </div>
                            <div class="chart-summary-item">
                                <span class="summary-label">Faculty Staff</span>
                                <strong class="summary-val text-info">{{dashboard.totalTeachers}}</strong>
                            </div>
                            <div class="chart-summary-item">
                                <span class="summary-label">Virtual Spaces</span>
                                <strong class="summary-val text-primary">{{dashboard.totalLearningSpaces}}</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Doughnut Chart (Course Distribution) -->
            <div class="col-lg-4">
                <div class="panel-card h-100">
                    <div class="panel-card-header">
                        <div class="panel-title-wrap">
                            <div class="panel-icon"><i class="fa-solid fa-chart-pie"></i></div>
                            <div>
                                <h5 class="panel-title">Course Distribution</h5>
                                <span class="panel-subtitle">Learner enrollment breakdown</span>
                            </div>
                        </div>
                    </div>

                    <div class="panel-card-body d-flex flex-column align-items-center justify-content-center">
                        <div class="chart-doughnut-container" style="position: relative; height: 230px; width: 230px;">
                            <canvas id="courseDistributionChart"></canvas>
                            <div class="doughnut-center-info">
                                <span class="doughnut-center-count">{{dashboard.totalStudents}}</span>
                                <span class="doughnut-center-label">Learners</span>
                            </div>
                        </div>

                        <div class="course-legend-wrap" id="courseLegendWrap">
                            <!-- Populated by JS -->
                        </div>
                    </div>

                    <div class="panel-card-footer text-center">
                        <span class="text-muted" style="font-size: 12px;">
                            Top Course: <strong>{{dashboard.popularCourse}}</strong>
                        </span>
                    </div>
                </div>
            </div>

        </div>


        <!-- LOWER GRID: STUDENTS & ACTIVITY / ACTIONS -->
        <div class="row">

            <!-- LEFT: Recent Students Table -->
            <div class="col-lg-7 mb-4">
                <div class="panel-card h-100">
                    <div class="panel-card-header">
                        <div class="panel-title-wrap">
                            <div class="panel-icon"><i class="fa-solid fa-users"></i></div>
                            <div>
                                <h5 class="panel-title">Recently Enrolled Learners</h5>
                                <span class="panel-subtitle">Latest registered student profiles</span>
                            </div>
                        </div>
                        <a href="/students" class="btn-panel-action">
                            View All <i class="fa-solid fa-arrow-right ms-1"></i>
                        </a>
                    </div>

                    <div class="panel-card-body p-0">
                        {{#if dashboard.recentStudents.length}}
                        <div class="table-responsive">
                            <table class="table modern-table mb-0">
                                <thead>
                                    <tr>
                                        <th>Learner</th>
                                        <th>Enrolled Courses</th>
                                        <th>Status</th>
                                        <th class="text-end">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {{#each dashboard.recentStudents}}
                                    <tr>
                                        <td>
                                            <div class="student-profile-cell">
                                                <div class="student-avatar-badge">
                                                    {{#if this.Name}}{{this.Name.[0]}}{{else}}U{{/if}}
                                                </div>
                                                <div class="student-info">
                                                    <span class="student-name">{{this.Name}}</span>
                                                    <span class="student-sub">{{this.Email}}</span>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="courses-pills-cell">
                                                {{#if this.course.length}}
                                                    {{#each this.course}}
                                                        <span class="course-mini-pill" title="{{this.courseName}}">
                                                            {{this.courseName}}
                                                        </span>
                                                    {{/each}}
                                                {{else}}
                                                    <span class="text-muted" style="font-size: 12px;">No courses</span>
                                                {{/if}}
                                            </div>
                                        </td>
                                        <td>
                                            {{#if this.account_Status.isActive}}
                                                <span class="status-chip chip-active">
                                                    <span class="status-dot"></span> Active
                                                </span>
                                            {{else}}
                                                {{#if this.course.length}}
                                                    <span class="status-chip chip-expired">
                                                        <span class="status-dot"></span> Expired
                                                    </span>
                                                {{else}}
                                                    <span class="status-chip chip-pending">
                                                        <span class="status-dot"></span> Registered
                                                    </span>
                                                {{/if}}
                                            {{/if}}
                                        </td>
                                        <td class="text-end">
                                            <a href="/edit-student/{{this._id}}" class="btn-table-action" title="Edit Student">
                                                <i class="fa-solid fa-pen-to-square"></i>
                                            </a>
                                        </td>
                                    </tr>
                                    {{/each}}
                                </tbody>
                            </table>
                        </div>
                        {{else}}
                        <div class="empty-state py-5">
                            <i class="fa-regular fa-user-slash empty-icon"></i>
                            <h6>No student records found</h6>
                            <p class="text-muted">New student registrations will appear here.</p>
                            <a href="/add-students" class="btn btn-sm btn-primary">Add First Student</a>
                        </div>
                        {{/if}}
                    </div>
                </div>
            </div>


            <!-- RIGHT: Timeline & Quick Tools -->
            <div class="col-lg-5 mb-4">

                <!-- Quick Actions Grid -->
                <div class="panel-card mb-4">
                    <div class="panel-card-header">
                        <div class="panel-title-wrap">
                            <div class="panel-icon"><i class="fa-solid fa-wand-magic-sparkles"></i></div>
                            <div>
                                <h5 class="panel-title">Quick Administrative Tools</h5>
                                <span class="panel-subtitle">Instant shortcuts for daily tasks</span>
                            </div>
                        </div>
                    </div>

                    <div class="panel-card-body">
                        <div class="quick-tools-grid">
                            <a href="/add-students" class="quick-tool-card">
                                <div class="quick-tool-icon bg-tool-blue"><i class="fa-solid fa-user-plus"></i></div>
                                <span class="quick-tool-label">Add Student</span>
                            </a>
                            <a href="/add-courses" class="quick-tool-card">
                                <div class="quick-tool-icon bg-tool-green"><i class="fa-solid fa-plus"></i></div>
                                <span class="quick-tool-label">New Course</span>
                            </a>
                            <a href="/add-chapters" class="quick-tool-card">
                                <div class="quick-tool-icon bg-tool-amber"><i class="fa-solid fa-book-open"></i></div>
                                <span class="quick-tool-label">Add Chapter</span>
                            </a>
                            <a href="/add-class" class="quick-tool-card">
                                <div class="quick-tool-icon bg-tool-purple"><i class="fa-solid fa-video"></i></div>
                                <span class="quick-tool-label">Upload Video</span>
                            </a>
                            <a href="/learning-spaces" class="quick-tool-card">
                                <div class="quick-tool-icon bg-tool-teal"><i class="fa-solid fa-shapes"></i></div>
                                <span class="quick-tool-label">Spaces</span>
                            </a>
                            <a href="/announcements" class="quick-tool-card">
                                <div class="quick-tool-icon bg-tool-rose"><i class="fa-solid fa-bullhorn"></i></div>
                                <span class="quick-tool-label">Broadcast</span>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Recent Activity Timeline -->
                <div class="panel-card">
                    <div class="panel-card-header">
                        <div class="panel-title-wrap">
                            <div class="panel-icon"><i class="fa-solid fa-clock-rotate-left"></i></div>
                            <div>
                                <h5 class="panel-title">Recent Activity Log</h5>
                                <span class="panel-subtitle">Live administrative actions</span>
                            </div>
                        </div>
                        <a href="/audit-logs" class="btn-panel-action" title="View Full Audit Log">
                            All Logs <i class="fa-solid fa-chevron-right ms-1"></i>
                        </a>
                    </div>

                    <div class="panel-card-body">
                        {{#if dashboard.recentActivity.length}}
                        <div class="activity-timeline">
                            {{#each dashboard.recentActivity}}
                            <div class="timeline-item">
                                <div class="timeline-indicator {{this.colorClass}}">
                                    <i class="{{this.icon}}"></i>
                                </div>
                                <div class="timeline-content">
                                    <div class="timeline-header">
                                        <span class="timeline-action">{{this.action}}</span>
                                        <span class="timeline-time">{{this.relativeTime}}</span>
                                    </div>
                                    <p class="timeline-message">{{this.message}}</p>
                                    <span class="timeline-actor"><i class="fa-regular fa-user me-1"></i>{{this.actorName}}</span>
                                </div>
                            </div>
                            {{/each}}
                        </div>
                        {{else}}
                        <div class="empty-state py-4 text-center">
                            <i class="fa-regular fa-clock empty-icon mb-2"></i>
                            <p class="text-muted mb-0" style="font-size: 13px;">No audit events recorded yet.</p>
                        </div>
                        {{/if}}
                    </div>
                </div>

            </div>

        </div>
    </div>

</div>


<!-- EMBEDDED DASHBOARD DATA FOR CHART.JS -->
<script id="dashboardAnalyticsData" type="application/json">
{
    "enrollmentChart": {{{json dashboard.enrollmentChart}}},
    "revenueChart": {{{json dashboard.revenueChart}}},
    "courseDistribution": {{{json dashboard.courseDistribution}}}
}
</script>


<style>
    /* =========================================
       DASHBOARD STYLING & PREMIUM DESIGN SYSTEM
       ========================================= */

    .dashboard-wrapper {
        padding-top: 10px;
        padding-bottom: 30px;
    }

    /* Hero Section */
    .hero-section {
        background: linear-gradient(135deg, var(--brand) 0%, var(--brand-2) 60%, rgba(29, 78, 137, 0.95) 100%);
        color: #ffffff !important;
        border-radius: var(--radius);
        padding: 34px 38px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 16px 35px -8px rgba(18, 49, 76, 0.25), 0 0 20px var(--shadow-brand);
        border: 1px solid rgba(255, 255, 255, 0.12);
        position: relative;
        overflow: hidden;
    }

    .hero-section::before {
        content: '';
        position: absolute;
        top: -60%;
        right: -10%;
        width: 400px;
        height: 400px;
        background: radial-gradient(circle, rgba(159, 213, 178, 0.15) 0%, transparent 70%);
        border-radius: 50%;
        pointer-events: none;
    }

    .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255, 255, 255, 0.14);
