<script>
    // 1. Live Current Date Display
    (function () {
        const dateEl = document.getElementById('currentDateDisplay');
        if (dateEl) {
            const now = new Date();
            dateEl.innerText = now.toLocaleDateString('en-US', {
                weekday: 'long',
                year: 'numeric',
                month: 'long',
                day: 'numeric'
            });
        }
    })();

    // 2. Animated Number Counters
    (function () {
        document.querySelectorAll(".counter").forEach(counter => {
            const target = Number(counter.dataset.target || 0);
            if (isNaN(target)) return;
            let count = 0;
            const speed = Math.max(target / 60, 1);

            function updateCounter() {
                count += speed;
                if (count < target) {
                    counter.innerText = Math.floor(count).toLocaleString('en-IN');
                    requestAnimationFrame(updateCounter);
                } else {
                    counter.innerText = target.toLocaleString('en-IN');
                }
            }
            updateCounter();
        });
    })();

    // 3. Analytics Charts (Chart.js)
    let mainTrendsChartInstance = null;
    let courseDoughnutChartInstance = null;
    let currentChartMode = 'enrollment'; // or 'revenue'

    function getThemeColors() {
        const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        return {
            isDark,
            gridColor: isDark ? 'rgba(255, 255, 255, 0.06)' : 'rgba(18, 49, 76, 0.07)',
            textColor: isDark ? '#8fa5ba' : '#506e8b',
            titleColor: isDark ? '#ffffff' : '#12314c',
            tooltipBg: isDark ? 'rgba(18, 28, 41, 0.95)' : 'rgba(255, 255, 255, 0.95)',
            tooltipBorder: isDark ? 'rgba(159, 213, 178, 0.2)' : 'rgba(18, 49, 76, 0.12)',
            brandColor: isDark ? '#9fd5b2' : '#12314c',
            brandAltColor: isDark ? '#60a5fa' : '#1d4e89',
            brandFill: isDark ? 'rgba(159, 213, 178, 0.15)' : 'rgba(18, 49, 76, 0.08)',
            revenueColor: isDark ? '#a78bfa' : '#8b5cf6',
            revenueFill: isDark ? 'rgba(167, 139, 250, 0.15)' : 'rgba(139, 92, 246, 0.08)'
        };
    }

    function initMainTrendsChart(analytics) {
        const canvas = document.getElementById('mainTrendsChart');
        if (!canvas || typeof Chart === 'undefined') return;

        const ctx = canvas.getContext('2d');
        const colors = getThemeColors();

        const isEnrollment = currentChartMode === 'enrollment';
        const dataConfig = isEnrollment ? analytics.enrollmentChart : analytics.revenueChart;

        const labels = dataConfig?.labels || ['Month 1', 'Month 2', 'Month 3', 'Month 4', 'Month 5', 'Month 6'];
        const dataValues = dataConfig?.data || [0, 0, 0, 0, 0, 0];

        const lineColor = isEnrollment ? colors.brandAltColor : colors.revenueColor;
        const fillColor = isEnrollment ? colors.brandFill : colors.revenueFill;

        if (mainTrendsChartInstance) {
            mainTrendsChartInstance.destroy();
        }

        mainTrendsChartInstance = new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: isEnrollment ? 'Registered Learners' : 'Revenue (₹)',
                    data: dataValues,
                    borderColor: lineColor,
                    backgroundColor: fillColor,
                    borderWidth: 3,
                    fill: true,
                    tension: 0.38,
                    pointBackgroundColor: lineColor,
                    pointBorderColor: '#ffffff',
                    pointBorderWidth: 2,
                    pointRadius: 4,
                    pointHoverRadius: 7,
                    pointHoverBackgroundColor: lineColor,
                    pointHoverBorderColor: '#ffffff',
                    pointHoverBorderWidth: 3
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false
                    },
                    tooltip: {
                        backgroundColor: colors.tooltipBg,
                        titleColor: colors.titleColor,
                        bodyColor: colors.titleColor,
                        borderColor: colors.tooltipBorder,
                        borderWidth: 1,
                        padding: 12,
                        boxPadding: 6,
                        usePointStyle: true,
                        callbacks: {
                            label: function (context) {
                                const val = context.parsed.y || 0;
                                return isEnrollment
                                    ? ` Learners: ${val.toLocaleString('en-IN')}`
                                    : ` Collections: ₹${val.toLocaleString('en-IN')}`;
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        grid: {
                            color: colors.gridColor,
                            drawBorder: false
                        },
                        ticks: {
                            color: colors.textColor,
                            font: { family: 'Inter', size: 12, weight: '500' }
                        }
                    },
                    y: {
                        beginAtZero: true,
                        grid: {
                            color: colors.gridColor,
                            drawBorder: false
                        },
                        ticks: {
                            color: colors.textColor,
                            font: { family: 'Inter', size: 11, weight: '500' },
                            callback: function (val) {
                                return isEnrollment ? val : '₹' + Number(val).toLocaleString('en-IN');
                            }
                        }
                    }
                }
            }
        });
    }

    function initCourseDoughnutChart(analytics) {
        const canvas = document.getElementById('courseDistributionChart');
        const legendWrap = document.getElementById('courseLegendWrap');
        if (!canvas || typeof Chart === 'undefined') return;

        const ctx = canvas.getContext('2d');
        const colors = getThemeColors();

        const rawLabels = analytics.courseDistribution?.labels || ['No courses'];
        const rawData = analytics.courseDistribution?.data || [1];

        // High quality harmonious palette
        const palette = [
            '#1d4e89', '#10b981', '#f59e0b', '#8b5cf6', '#0dcaf0', '#ef4444'
        ];
        const darkPalette = [
            '#60a5fa', '#34d399', '#fbbf24', '#a78bfa', '#38bdf8', '#f87171'
        ];
        const chartColors = colors.isDark ? darkPalette : palette;

        if (courseDoughnutChartInstance) {
            courseDoughnutChartInstance.destroy();
        }

        courseDoughnutChartInstance = new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: rawLabels,
                datasets: [{
                    data: rawData,
                    backgroundColor: chartColors.slice(0, rawLabels.length),
                    borderColor: colors.isDark ? '#121c29' : '#ffffff',
                    borderWidth: 3,
                    hoverOffset: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '72%',
                plugins: {
                    legend: {
                        display: false
                    },
                    tooltip: {
                        backgroundColor: colors.tooltipBg,
                        titleColor: colors.titleColor,
                        bodyColor: colors.titleColor,
                        borderColor: colors.tooltipBorder,
                        borderWidth: 1,
                        padding: 10,
                        callbacks: {
                            label: function (ctx) {
                                const val = ctx.parsed || 0;
                                return ` ${ctx.label}: ${val} learners`;
                            }
                        }
                    }
                }
            }
        });

        // Build HTML legend pills
        if (legendWrap) {
            const total = rawData.reduce((a, b) => a + b, 0) || 1;
            legendWrap.innerHTML = rawLabels.map((lbl, idx) => {
                const count = rawData[idx] || 0;
                const pct = Math.round((count / total) * 100);
                const dotColor = chartColors[idx % chartColors.length];
                return `
                    <div class="course-legend-item">
                        <div class="legend-name-wrap" title="${lbl}">
                            <span class="legend-dot" style="background:${dotColor};"></span>
                            <span>${lbl}</span>
                        </div>
                        <span class="legend-count">${count} (${pct}%)</span>
                    </div>
                `;
            }).join('');
        }
    }

    function switchMainChart(mode) {
        currentChartMode = mode;
        const btnEnroll = document.getElementById('btnTrendEnrollment');
        const btnRev = document.getElementById('btnTrendRevenue');

        if (btnEnroll && btnRev) {
            btnEnroll.classList.toggle('active', mode === 'enrollment');
            btnRev.classList.toggle('active', mode === 'revenue');
        }

        const dataScript = document.getElementById('dashboardAnalyticsData');
        if (dataScript) {
            try {
                const analytics = JSON.parse(dataScript.textContent);
                initMainTrendsChart(analytics);
            } catch (e) {}
        }
    }

    // Initialize charts on DOMContentLoaded
    window.addEventListener('DOMContentLoaded', () => {
        const dataScript = document.getElementById('dashboardAnalyticsData');
        if (dataScript) {
            try {
                const analytics = JSON.parse(dataScript.textContent);
                initMainTrendsChart(analytics);
                initCourseDoughnutChart(analytics);

                // Listen for theme switch to update chart styles
                const themeObserver = new MutationObserver(() => {
                    initMainTrendsChart(analytics);
                    initCourseDoughnutChart(analytics);
                });
                themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
            } catch (err) {
                console.warn('Could not initialize dashboard charts:', err.message);
            }
        }
    });
</script>