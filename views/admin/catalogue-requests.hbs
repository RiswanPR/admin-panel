<div class="container-fluid mt-4 mb-5">

    <!-- BREADCRUMBS & HEADER -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="/admin/career-intelligence/roles">Career Intelligence</a></li>
                    <li class="breadcrumb-item"><a href="/admin/catalogue/departments">Identity Catalogue</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Custom Title Requests</li>
                </ol>
            </nav>
            <h2 class="fw-bold m-0" style="color:var(--brand);">
                <i class="fa-solid fa-inbox me-2"></i> Custom Title Requests
            </h2>
            <small class="text-muted">Review and moderate community-submitted professional titles. Approved titles become active in the official catalogue.</small>
        </div>

        <div class="d-flex gap-2">
            <a href="/admin/catalogue/departments" class="btn btn-outline-primary px-3">
                <i class="fa-solid fa-sitemap me-1"></i> Departments &amp; Titles
            </a>
            <a href="/admin/career-intelligence/roles" class="btn btn-outline-secondary px-3">
                <i class="fa-solid fa-id-card-clip me-1"></i> Career Roles
            </a>
        </div>
    </div>

    <!-- FLASH FEEDBACK ALERTS -->
    {{#if successMessage}}
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-4 shadow-sm" role="alert" style="border-radius: 12px;">
        <i class="fa-solid fa-circle-check fs-5"></i>
        <div class="fw-semibold">{{successMessage}}</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    {{/if}}

    {{#if errorMessage}}
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-4 shadow-sm" role="alert" style="border-radius: 12px;">
        <i class="fa-solid fa-triangle-exclamation fs-5"></i>
        <div class="fw-semibold">{{errorMessage}}</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    {{/if}}

    <!-- TOP KPI STATS -->
    <div class="row g-3 mb-4">
        <div class="col-lg-3 col-md-6">
            <div class="card p-3 border-0 shadow-sm h-100" style="border-radius: 16px; background: var(--surface);">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <small class="text-muted text-uppercase fw-bold" style="font-size: 11px;">Pending Review</small>
                        <h3 class="fw-bold m-0 mt-1 text-warning">{{pendingCount}}</h3>
                        <small class="text-muted">Awaiting decision</small>
                    </div>
                    <div class="rounded-circle p-3 d-flex align-items-center justify-content-center" style="background: rgba(245, 158, 11, 0.12); width: 50px; height: 50px;">
                        <i class="fa-solid fa-clock-rotate-left fs-5 text-warning"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="card p-3 border-0 shadow-sm h-100" style="border-radius: 16px; background: var(--surface);">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <small class="text-muted text-uppercase fw-bold" style="font-size: 11px;">Approved Titles</small>
                        <h3 class="fw-bold m-0 mt-1 text-success">{{approvedCount}}</h3>
                        <small class="text-success"><i class="fa-solid fa-check me-1"></i>In catalogue</small>
                    </div>
                    <div class="rounded-circle p-3 d-flex align-items-center justify-content-center" style="background: rgba(16, 185, 129, 0.12); width: 50px; height: 50px;">
                        <i class="fa-solid fa-circle-check fs-5 text-success"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="card p-3 border-0 shadow-sm h-100" style="border-radius: 16px; background: var(--surface);">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <small class="text-muted text-uppercase fw-bold" style="font-size: 11px;">Rejected Requests</small>
                        <h3 class="fw-bold m-0 mt-1 text-secondary">{{rejectedCount}}</h3>
                        <small class="text-muted">Catalogue preserved</small>
                    </div>
                    <div class="rounded-circle p-3 d-flex align-items-center justify-content-center" style="background: rgba(100, 116, 139, 0.12); width: 50px; height: 50px;">
                        <i class="fa-solid fa-ban fs-5 text-secondary"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="card p-3 border-0 shadow-sm h-100" style="border-radius: 16px; background: var(--surface);">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <small class="text-muted text-uppercase fw-bold" style="font-size: 11px;">Total Requests</small>
                        <h3 class="fw-bold m-0 mt-1 text-primary">{{total}}</h3>
                        <small class="text-muted">All-time submissions</small>
                    </div>
                    <div class="rounded-circle p-3 d-flex align-items-center justify-content-center" style="background: rgba(59, 130, 246, 0.12); width: 50px; height: 50px;">
                        <i class="fa-solid fa-list-check fs-5 text-primary"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- WORKFLOW INTEGRITY RULES BANNER -->
    <div class="card mb-4 border-0 shadow-sm" style="border-radius: 16px; background: linear-gradient(135deg, rgba(15, 23, 42, 0.03) 0%, rgba(59, 130, 246, 0.04) 100%); border-left: 5px solid var(--brand) !important;">
        <div class="card-body p-3">
            <div class="d-flex align-items-start gap-3">
                <i class="fa-solid fa-shield-halved text-primary fs-4 mt-1"></i>
                <div>
                    <h6 class="fw-bold m-0 text-dark">Catalogue Moderation &amp; Review Protocol</h6>
                    <p class="small text-muted mb-0 mt-1">
                        <strong>Approval Invariant:</strong> Approving a request generates an immutable department-scoped composite ID (<code>&lt;departmentId&gt;:&lt;slug&gt;</code>) and activates the title in the official database.
                        <br>
                        <strong>Rejection Invariant:</strong> Rejecting a request records audit history and reviewer notes without modifying or corrupting the official catalogue.
                        <br>
                        <strong>Concurrency Safety:</strong> Approvals are idempotent and protected against double-clicks, concurrent reviews, and duplicates.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- FILTER TOOLBAR -->
    <form class="card p-3 mb-4 border-0 shadow-sm" method="GET" action="/admin/catalogue/requests" style="border-radius: 16px;">
        <div class="row g-2 align-items-center">
            <div class="col-lg-4 col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                    <input type="text" class="form-control border-start-0" name="search" value="{{filters.search}}" placeholder="Search title, user, email, or department...">
                </div>
            </div>
            <div class="col-lg-3 col-md-3">
                <select class="form-select" name="departmentId">
                    <option value="">All Departments</option>
                    {{#each departments}}
                    <option value="{{this.id}}" {{#ifEquals this.id ../filters.departmentId}}selected{{/ifEquals}}>
                        {{this.name}}
                    </option>
                    {{/each}}
                </select>
            </div>
            <div class="col-lg-3 col-md-2">
                <select class="form-select" name="status">
                    <option value="pending" {{#ifEquals filters.status 'pending'}}selected{{/ifEquals}}>Pending Only</option>
                    <option value="approved" {{#ifEquals filters.status 'approved'}}selected{{/ifEquals}}>Approved</option>
                    <option value="rejected" {{#ifEquals filters.status 'rejected'}}selected{{/ifEquals}}>Rejected</option>
                    <option value="all" {{#ifEquals filters.status 'all'}}selected{{/ifEquals}}>All Statuses</option>
                </select>
            </div>
            <div class="col-lg-2 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fa-solid fa-filter me-1"></i> Filter
                </button>
                <a href="/admin/catalogue/requests" class="btn btn-outline-secondary" title="Reset Filters">
                    <i class="fa-solid fa-rotate-left"></i>
                </a>
            </div>
        </div>
    </form>

    <!-- REQUESTS LIST -->
    <div class="card border-0 shadow-sm" style="border-radius: 16px; overflow: hidden;">
        <div class="table-responsive">
            <table class="table align-middle mb-0 table-hover">
                <thead style="background: #f8fafc; border-bottom: 2px solid #e2e8f0;">
                    <tr>
                        <th class="py-3 px-3 text-uppercase text-muted fw-bold" style="font-size: 11px;">Status</th>
                        <th class="py-3 px-3 text-uppercase text-muted fw-bold" style="font-size: 11px;">Requested Title</th>
                        <th class="py-3 px-3 text-uppercase text-muted fw-bold" style="font-size: 11px;">Department</th>
                        <th class="py-3 px-3 text-uppercase text-muted fw-bold" style="font-size: 11px;">Requester</th>
                        <th class="py-3 px-3 text-uppercase text-muted fw-bold" style="font-size: 11px;">Submitted</th>
                        <th class="py-3 px-3 text-uppercase text-muted fw-bold" style="font-size: 11px;">Review Details</th>
                        <th class="py-3 px-3 text-end text-uppercase text-muted fw-bold" style="font-size: 11px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each requests}}
                    <tr>
                        <!-- Status Badge -->
                        <td class="px-3">
                            {{#ifEquals this.status 'pending'}}
                            <span class="badge bg-warning text-dark px-2.5 py-1.5" style="border-radius: 8px;">
                                <i class="fa-solid fa-clock me-1"></i> Pending
                            </span>
                            {{/ifEquals}}
                            {{#ifEquals this.status 'approved'}}
                            <span class="badge bg-success px-2.5 py-1.5" style="border-radius: 8px;">
                                <i class="fa-solid fa-check me-1"></i> Approved
                            </span>
                            {{/ifEquals}}
                            {{#ifEquals this.status 'rejected'}}
                            <span class="badge bg-secondary px-2.5 py-1.5" style="border-radius: 8px;">
                                <i class="fa-solid fa-ban me-1"></i> Rejected
                            </span>
                            {{/ifEquals}}
                        </td>

                        <!-- Requested Title -->
                        <td class="px-3">
                            <a href="/admin/catalogue/requests/{{this.id}}" class="fw-bold text-dark text-decoration-none hover-primary fs-6" title="Inspect Request Details">
                                "{{this.requestedTitle}}"
                            </a>
                            {{#if this.createdTitleId}}
                            <div class="mt-1">
                                <span class="badge bg-light text-primary border font-monospace" style="font-size: 10px;">
                                    ID: {{this.createdTitleId}}
                                </span>
                            </div>
                            {{/if}}
                        </td>

                        <!-- Department -->
                        <td class="px-3">
                            <div class="d-flex align-items-center gap-1.5">
                                <i class="fa-solid fa-building text-muted" style="font-size: 12px;"></i>
                                <span class="fw-semibold text-dark">{{this.departmentName}}</span>
                            </div>
                            <small class="text-muted font-monospace" style="font-size: 10px;">{{this.departmentId}}</small>
                        </td>

                        <!-- Requester -->
                        <td class="px-3">
                            <div class="fw-semibold text-dark">
                                {{#if this.userName}}{{this.userName}}{{else}}User{{/if}}
                            </div>
                            <small class="text-muted" style="font-size: 11px;">
                                {{#if this.userEmail}}{{this.userEmail}}{{else}}<span class="font-monospace">{{this.userId}}</span>{{/if}}
                            </small>
                        </td>

                        <!-- Submitted Date -->
                        <td class="px-3 text-muted" style="font-size: 12px;">
                            {{this.submittedAt}}
                        </td>

                        <!-- Review Details -->
                        <td class="px-3">
                            {{#if this.reviewedAt}}
                            <div class="small text-dark">
                                <i class="fa-solid fa-user-shield text-muted me-1"></i>
                                {{#if this.reviewerName}}{{this.reviewerName}}{{else}}Administrator{{/if}}
                            </div>
                            {{#if this.reviewNote}}
                            <div class="text-muted small fst-italic mt-0.5">
                                "{{this.reviewNote}}"
                            </div>
                            {{/if}}
                            {{else}}
                            <span class="text-muted small fst-italic">Awaiting review</span>
                            {{/if}}
                        </td>

                        <!-- Action Buttons -->
                        <td class="px-3 text-end">
                            <div class="d-inline-flex gap-1.5">
                                <a href="/admin/catalogue/requests/{{this.id}}" class="btn btn-sm btn-outline-secondary px-2.5 py-1" title="Inspect Details">
                                    <i class="fa-solid fa-eye me-1"></i> Inspect
                                </a>
                                {{#ifEquals this.status 'pending'}}
                                <button type="button" class="btn btn-sm btn-success px-2.5 py-1" data-bs-toggle="modal" data-bs-target="#approveModal-{{this.id}}" title="Approve Title">
                                    <i class="fa-solid fa-check me-1"></i> Approve
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger px-2.5 py-1" data-bs-toggle="modal" data-bs-target="#rejectModal-{{this.id}}" title="Reject Title">
                                    <i class="fa-solid fa-xmark me-1"></i> Reject
                                </button>
                                {{/ifEquals}}
                            </div>

                            {{#ifEquals this.status 'pending'}}
                            <!-- APPROVE MODAL -->
                            <div class="modal fade text-start" id="approveModal-{{this.id}}" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
                                        <div class="modal-header bg-success text-white">
                                            <h5 class="modal-title fw-bold">
                                                <i class="fa-solid fa-circle-check me-2"></i> Approve Professional Title
                                            </h5>
                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <form method="POST" action="/admin/catalogue/requests/{{this.id}}/approve">
                                            <input type="hidden" name="_csrf" value="{{../csrfToken}}">
                                            <input type="hidden" name="returnTo" value="/admin/catalogue/requests">
                                            <div class="modal-body p-4 space-y-3">
                                                <p class="text-muted small mb-3">
                                                    Approving will insert this title into <strong>{{this.departmentName}}</strong> in the official catalogue with status <em>active</em>.
                                                </p>
                                                <div class="mb-3">
                                                    <label class="form-label fw-bold small text-muted text-uppercase">Title Label</label>
                                                    <input type="text" class="form-control" name="label" value="{{this.requestedTitle}}" required maxlength="100">
                                                    <small class="text-muted">You may adjust casing or punctuation before catalogue insertion.</small>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label fw-bold small text-muted text-uppercase">Admin Review Note (Optional)</label>
                                                    <input type="text" class="form-control" name="note" placeholder="e.g. Standard industry role verified" maxlength="500">
                                                </div>
                                                <div class="p-3 bg-light rounded-3 small text-muted">
                                                    <i class="fa-solid fa-shield-check text-success me-1"></i>
                                                    Stable ID will be generated as <code>{{this.departmentId}}:&lt;slug&gt;</code>.
                                                </div>
                                            </div>
                                            <div class="modal-footer border-0 p-3 pt-0">
                                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit" class="btn btn-success px-4 fw-bold" onclick="return confirm('Are you sure you want to approve this title?');">
                                                    <i class="fa-solid fa-check me-1"></i> Confirm &amp; Add to Catalogue
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>

                            <!-- REJECT MODAL -->
                            <div class="modal fade text-start" id="rejectModal-{{this.id}}" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
                                        <div class="modal-header bg-danger text-white">
                                            <h5 class="modal-title fw-bold">
                                                <i class="fa-solid fa-ban me-2"></i> Reject Title Request
                                            </h5>
                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <form method="POST" action="/admin/catalogue/requests/{{this.id}}/reject">
                                            <input type="hidden" name="_csrf" value="{{../csrfToken}}">
                                            <input type="hidden" name="returnTo" value="/admin/catalogue/requests">
                                            <div class="modal-body p-4">
                                                <p class="text-muted small mb-3">
                                                    Rejecting will preserve request history without modifying the official catalogue.
                                                </p>
                                                <div class="p-3 bg-light rounded-3 mb-3 small">
                                                    <strong>Requested Title:</strong> "{{this.requestedTitle}}"<br>
                                                    <strong>Department:</strong> {{this.departmentName}}
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label fw-bold small text-muted text-uppercase">Rejection Reason</label>
                                                    <textarea class="form-control" name="reason" rows="3" placeholder="e.g. Duplicate of existing catalogue title, or not standard infrastructure role..." required maxlength="500"></textarea>
                                                </div>
                                            </div>
                                            <div class="modal-footer border-0 p-3 pt-0">
                                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit" class="btn btn-danger px-4 fw-bold" onclick="return confirm('Are you sure you want to reject this request?');">
                                                    <i class="fa-solid fa-ban me-1"></i> Reject Request
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                            {{/ifEquals}}
                        </td>
                    </tr>
                    {{/each}}

                    {{#unless requests.length}}
                    <tr>
                        <td colspan="7" class="py-5 text-center text-muted">
                            <div class="py-4">
                                <i class="fa-solid fa-inbox fs-1 text-muted opacity-50 mb-3 d-block"></i>
                                <h6 class="fw-bold text-dark">No Title Requests Found</h6>
                                <p class="small text-muted mb-0">No custom title requests match your current filters.</p>
                            </div>
                        </td>
                    </tr>
                    {{/unless}}
                </tbody>
            </table>
        </div>

        <!-- PAGINATION -->
        {{#if totalPages}}
        {{#ifGt totalPages 1}}
        <div class="card-footer bg-transparent border-top p-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <small class="text-muted">
                Showing page <strong>{{page}}</strong> of <strong>{{totalPages}}</strong> ({{total}} total requests)
            </small>
            <div class="d-flex gap-2">
                {{#ifGt page 1}}
                <a href="/admin/catalogue/requests?page={{subtract page 1}}&status={{filters.status}}&departmentId={{filters.departmentId}}&search={{filters.search}}" class="btn btn-sm btn-outline-secondary">
                    <i class="fa-solid fa-chevron-left me-1"></i> Previous
                </a>
                {{/ifGt}}
                {{#ifLt page totalPages}}
                <a href="/admin/catalogue/requests?page={{add page 1}}&status={{filters.status}}&departmentId={{filters.departmentId}}&search={{filters.search}}" class="btn btn-sm btn-outline-secondary">
                    Next <i class="fa-solid fa-chevron-right ms-1"></i>
                </a>
                {{/ifLt}}
            </div>
        </div>
        {{/ifGt}}
        {{/if}}
    </div>
</div>
