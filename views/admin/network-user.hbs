async function openRoleHistoryModal(userId) {
    if (roleHistoryModalInstance) roleHistoryModalInstance.show();
    const loading = document.getElementById('roleHistoryLoading');
    const container = document.getElementById('roleHistoryTableContainer');
    const tbody = document.getElementById('roleHistoryTableBody');

    loading.style.display = 'block';
    container.style.display = 'none';
    tbody.innerHTML = '';

    try {
        const res = await fetch(`/admin/network/users/${userId}/role-history`);
        const json = await res.json();
        loading.style.display = 'none';

        if (json.success && Array.isArray(json.history) && json.history.length) {
            tbody.innerHTML = json.history.map(item => `
                <tr>
                    <td class="text-muted"><small>${new Date(item.timestamp).toLocaleString()}</small></td>
                    <td><span class="badge bg-light text-dark border font-monospace" style="font-size:10px;">${item.action}</span></td>
                    <td class="fw-semibold">${item.actor}</td>
                    <td class="text-muted"><small>${item.previousState || '—'}</small></td>
                    <td><span class="badge bg-primary-subtle text-primary border">${item.newState || '—'}</span></td>
                    <td class="text-dark small">${item.reason || '—'}</td>
                </tr>
            `).join('');
            container.style.display = 'block';
        } else {
            tbody.innerHTML = `<tr><td colspan="6" class="text-center py-3 text-muted fst-italic">No role mutations recorded in audit log.</td></tr>`;
            container.style.display = 'block';
        }
    } catch(err) {
        loading.style.display = 'none';
        tbody.innerHTML = `<tr><td colspan="6" class="text-center text-danger py-3">Error fetching audit trail: ${err.message}</td></tr>`;
        container.style.display = 'block';
    }
}

let lastContractData = null;
async function openContractPreviewModal(userId) {
    if (contractModalInstance) contractModalInstance.show();
    const loading = document.getElementById('contractLoading');
    const container = document.getElementById('contractBodyContainer');
    const code = document.getElementById('contractCode');

    loading.style.display = 'block';
    container.style.display = 'none';
    code.innerText = '';

    try {
        const res = await fetch(`/admin/network/users/${userId}/contract`);
        const json = await res.json();
        loading.style.display = 'none';

        if (json.success && json.contract) {
            lastContractData = json.contract;
            code.innerText = JSON.stringify(json.contract, null, 2);
            container.style.display = 'block';
        } else {
            code.innerText = `Error: ${json.message || 'Failed to retrieve contract'}`;
            container.style.display = 'block';
        }
    } catch(err) {
        loading.style.display = 'none';
        code.innerText = `Error fetching contract: ${err.message}`;
        container.style.display = 'block';
    }
}

function copyContractJson() {
    if (!lastContractData) return;
    navigator.clipboard.writeText(JSON.stringify(lastContractData, null, 2)).then(() => {
        Swal.fire({ icon: 'success', title: 'Copied', text: 'Contract JSON copied to clipboard', timer: 1200, showConfirmButton: false });
    });
}

