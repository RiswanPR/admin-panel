                            <label class="form-check-label small" for="restrMessaging">Block Direct Messaging (no_messaging)</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="restrJobs" value="no_applications" checked>
                            <label class="form-check-label small" for="restrJobs">Block Job Applications (no_applications)</label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger" id="confirmSuspendBtn">Suspend &amp; Terminate Sessions</button>
