            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-warning"><i class="fa-solid fa-shield-virus me-2"></i> Manage Account Restrictions</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="restrictionsForm" onsubmit="submitRestrictions(event)">
                <div class="modal-body py-3">
                    <p class="text-muted small">Configure fine-grained platform restrictions for <strong id="restrUserName" class="text-dark"></strong>.</p>
                    <input type="hidden" id="restrUserId" name="userId">

                    <div class="mb-3">
                        <label class="form-label fw-bold small">Active Feature Restrictions</label>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="manageRestrMessaging" value="no_messaging">
                            <label class="form-check-label small" for="manageRestrMessaging">Block Direct Messaging (no_messaging)</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="manageRestrJobs" value="no_applications">
                            <label class="form-check-label small" for="manageRestrJobs">Block Job Applications (no_applications)</label>
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label fw-bold small">Audit Reason</label>
                        <textarea class="form-control" id="manageRestrReason" rows="2" placeholder="e.g. Messaging spam warnings threshold reached..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning" id="saveRestrictionsBtn">Save Restrictions</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- CLIENT LOGIC -->
<script>
let roleModalInstance, suspendModalInstance, restoreModalInstance, usernameModalInstance, verificationModalInstance, restrictionsModalInstance;

document.addEventListener('DOMContentLoaded', () => {
    if (window.bootstrap) {
        roleModalInstance = new bootstrap.Modal(document.getElementById('roleModal'));
        suspendModalInstance = new bootstrap.Modal(document.getElementById('suspendModal'));
        restoreModalInstance = new bootstrap.Modal(document.getElementById('restoreModal'));
        usernameModalInstance = new bootstrap.Modal(document.getElementById('usernameModal'));
        verificationModalInstance = new bootstrap.Modal(document.getElementById('verificationModal'));
        restrictionsModalInstance = new bootstrap.Modal(document.getElementById('restrictionsModal'));
    }
});

function openRoleModal(userId, name, currentRole) {
    document.getElementById('modalUserId').value = userId;
    document.getElementById('modalUserName').innerText = name;
    const select = document.getElementById('newRoleSelect');
    select.value = (currentRole || 'STUDENT').toUpperCase();
    if (document.getElementById('roleReason')) {
        document.getElementById('roleReason').value = '';
    }
    checkEducatorWarning(select.value);
    roleModalInstance.show();
}

function checkEducatorWarning(role) {
    const notice = document.getElementById('educatorNotice');
    if (role === 'EDUCATOR') {
        notice.style.display = 'block';
    } else {
        notice.style.display = 'none';
    }
}

async function submitRoleChange(e) {
    e.preventDefault();
    const btn = document.getElementById('saveRoleBtn') || e.target.querySelector('button[type="submit"]');
    const userId = document.getElementById('modalUserId').value;
    const role = document.getElementById('newRoleSelect').value;
    const reason = (document.getElementById('roleReason')?.value || '').trim();

    if (role === 'EDUCATOR') {
        const confirmRes = await Swal.fire({
            title: 'Assign Educator Role?',
            text: 'You are about to assign the privileged Educator role. This grants verified educator status and is audit logged.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#198754',
            confirmButtonText: 'Yes, Assign Educator'
        });
        if (!confirmRes.isConfirmed) return;
    }

    if (window.zeitnahSetSubmitting) window.zeitnahSetSubmitting(btn, 'Auditing...');

    try {
        const res = await fetch(`/admin/network/users/${userId}/role`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ role, reason })
        });
        const json = await res.json();
        if (json.success) {
            Swal.fire({ icon: 'success', title: 'Role Updated', text: json.message, timer: 1500, showConfirmButton: false });
            setTimeout(() => window.location.reload(), 1500);
        } else {
            if (window.zeitnahResetSubmitting) window.zeitnahResetSubmitting(btn);
            Swal.fire({ icon: 'error', title: 'Update Failed', text: json.message || 'Could not update role' });
        }
    } catch(err) {
        if (window.zeitnahResetSubmitting) window.zeitnahResetSubmitting(btn);
        Swal.fire({ icon: 'error', title: 'Network Error', text: err.message });
    }
}

function openSuspendModal(userId, name) {
    document.getElementById('suspendUserId').value = userId;
    document.getElementById('suspendUserName').innerText = name;
    document.getElementById('suspendReason').value = '';
    suspendModalInstance.show();
}

async function submitSuspend(e) {
    e.preventDefault();
    const btn = document.getElementById('confirmSuspendBtn');
    const userId = document.getElementById('suspendUserId').value;
    const reason = document.getElementById('suspendReason').value.trim();
    const restrictions = [];
    if (document.getElementById('restrMessaging').checked) restrictions.push('no_messaging');
    if (document.getElementById('restrJobs').checked) restrictions.push('no_applications');

    if (window.zeitnahSetSubmitting) window.zeitnahSetSubmitting(btn, 'Suspending...');

    try {
        const res = await fetch(`/admin/network/users/${userId}/suspend`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ reason, restrictions })
        });
        const json = await res.json();
        if (json.success) {
            Swal.fire({ icon: 'success', title: 'User Suspended', text: json.message, timer: 1500, showConfirmButton: false });
