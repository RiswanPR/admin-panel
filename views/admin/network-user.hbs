<div class="container-fluid mt-4 mb-5">

    <!-- BREADCRUMB & DOSSIER HEADER -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="/admin/network/users" class="text-decoration-none">Network Directory</a></li>
                    <li class="breadcrumb-item active" aria-current="page">{{displayName}}</li>
                </ol>
            </nav>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <h2 class="fw-bold m-0" style="color:var(--brand); font-size: 26px;">
                    <i class="fa-solid fa-id-badge text-primary me-2"></i> User Governance Dossier
                </h2>
                <span class="badge {{#if isSuspended}}bg-danger{{else}}{{#if isRestricted}}bg-warning text-dark{{else}}bg-success{{/if}}{{/if}} px-2.5 py-1 text-uppercase" style="font-size: 11px; letter-spacing: 0.5px;">
                    {{accountState}}
                </span>
                {{#ifEquals primaryRole 'EDUCATOR'}}
                <span class="badge bg-purple text-white px-2.5 py-1" style="font-size: 11px; background-color: #6f42c1;">
                    <i class="fa-solid fa-graduation-cap me-1"></i> Protected Educator
                </span>
                {{/ifEquals}}
            </div>
            <small class="text-muted">Inspect identity, professional credentials, verification matrix, active sessions, and governance audit trail.</small>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <a href="/admin/network/users" class="btn btn-outline-secondary px-3">
                <i class="fa-solid fa-arrow-left me-1"></i> Back to Directory
            </a>
            <a href="/admin/verification" class="btn btn-outline-info px-3">
                <i class="fa-solid fa-shield-halved me-1"></i> Verification Queue
            </a>
            <a href="/admin/audit-logs?search={{user._id}}" class="btn btn-outline-dark px-3">
                <i class="fa-solid fa-clock-rotate-left me-1"></i> View Audit Trail
            </a>
        </div>
    </div>

    <!-- HERO IDENTITY DOSSIER CARD -->
    <div class="card p-4 mb-4" style="border-radius: 20px; border: 1px solid var(--border); box-shadow: 0 4px 20px rgba(0,0,0,0.04); background: linear-gradient(135deg, rgba(255,255,255,0.98), rgba(248,250,252,0.95));">
        <div class="row align-items-center g-3">
            <div class="col-auto">
                <div class="position-relative d-inline-block">
                    <img src="{{user.profileImageUrl}}" alt="{{displayName}}" class="rounded-circle shadow-sm" style="width: 90px; height: 90px; object-fit: cover; border: 3px solid #fff;" onerror="this.onerror=null;this.src='/img/placeholders/profile.svg'">
                    {{#if isSuspended}}
                    <span class="position-absolute bottom-0 end-0 badge bg-danger p-2 rounded-circle" title="Suspended / Blocked">
                        <i class="fa-solid fa-ban"></i>
                    </span>
                    {{else}}
                    <span class="position-absolute bottom-0 end-0 badge bg-success p-2 rounded-circle" title="Active">
                        <i class="fa-solid fa-check"></i>
                    </span>
                    {{/if}}
                </div>
            </div>

            <div class="col">
                <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                    <h3 class="fw-bold m-0" style="color:var(--text); font-size: 22px;">{{displayName}}</h3>
                    <span class="badge bg-light text-dark border px-2 py-1">
                        <i class="fa-solid fa-at text-muted me-0.5"></i>{{username}}
                        {{#if user.usernameClaimed}}<i class="fa-solid fa-circle-check text-success ms-1" title="Claimed Username"></i>{{/if}}
                    </span>

                    <!-- PRIMARY ROLE BADGE -->
                    <span class="badge {{#ifEquals primaryRole 'EDUCATOR'}}bg-warning text-dark{{else}}{{#ifEquals primaryRole 'FOUNDER'}}bg-dark text-white{{else}}{{#ifEquals primaryRole 'RECRUITER'}}bg-info text-dark{{else}}{{#ifEquals primaryRole 'MENTOR'}}bg-secondary text-white{{else}}{{#ifEquals primaryRole 'PROFESSIONAL'}}bg-primary text-white{{else}}bg-success-subtle text-success border{{/ifEquals}}{{/ifEquals}}{{/ifEquals}}{{/ifEquals}}{{/ifEquals}} px-2.5 py-1">
                        Primary: {{primaryRole}}
                    </span>

                    <!-- ADDITIONAL SECONDARY ROLES -->
                    {{#each secondaryRoles}}
                    <span class="badge bg-light text-dark border px-2 py-1 d-inline-flex align-items-center gap-1" title="Secondary Role">
                        <span>+ {{this}}</span>
                        <button type="button" class="btn btn-link btn-xs p-0 text-danger text-decoration-none" onclick="openRemoveSecondaryRoleModal('{{../user._id}}', '{{this}}')" title="Remove Secondary Role">
                            <i class="fa-solid fa-xmark" style="font-size: 10px;"></i>
                        </button>
                    </span>
                    {{/each}}

                    <!-- VERIFICATION BADGE (SEPARATE FROM ROLES) -->
                    {{#if user.account_Status.isVerified}}
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1"><i class="fa-solid fa-shield-check me-1"></i> Identity Verified</span>
                    {{else}}
                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1"><i class="fa-solid fa-shield me-1"></i> Identity Unverified</span>
                    {{/if}}

                    {{#if consistencyIssues.length}}
                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1" title="Semantic Inconsistencies Detected">
                        <i class="fa-solid fa-triangle-exclamation me-1"></i> {{consistencyIssues.length}} Notice{{#ifNotEquals consistencyIssues.length 1}}s{{/ifNotEquals}}
                    </span>
                    {{/if}}
                </div>

                <div class="d-flex align-items-center gap-3 flex-wrap text-muted small mt-2">
                    <div>
                        <i class="fa-solid fa-fingerprint me-1 text-primary"></i>
                        <span class="font-monospace user-select-all">{{user._id}}</span>
                        <button type="button" class="btn btn-link btn-sm p-0 ms-1 text-muted" onclick="navigator.clipboard.writeText('{{user._id}}')" title="Copy User ID">
                            <i class="fa-regular fa-copy"></i>
                        </button>
                    </div>
                    <div>
                        <i class="fa-solid fa-envelope me-1 text-muted"></i>
                        <span>{{user.email}}{{user.Email}}</span>
                    </div>
                    {{#if user.Phone_Number}}
                    <div>
                        <i class="fa-solid fa-phone me-1 text-muted"></i>
                        <span>{{user.Phone_Number}}</span>
                    </div>
                    {{/if}}
                    <div>
                        <i class="fa-solid fa-calendar me-1 text-muted"></i>
                        <span>Joined {{formatDate user.createdAt}}</span>
                    </div>
                    <div>
                        <i class="fa-solid fa-clock me-1 text-muted"></i>
                        <span>Last Active: {{#if user.account_Status.lastSeen}}{{formatDateTime user.account_Status.lastSeen}}{{else}}Never{{/if}}</span>
                    </div>
                </div>
            </div>

            <div class="col-lg-auto d-flex gap-2 flex-wrap">
                <button type="button" class="btn btn-primary btn-sm" onclick="openPrimaryRoleModal('{{user._id}}', '{{displayName}}', '{{primaryRole}}')">
                    <i class="fa-solid fa-user-tag me-1"></i> Change Primary Role
                </button>
                <button type="button" class="btn btn-outline-primary btn-sm" onclick="openAddSecondaryRoleModal('{{user._id}}', '{{displayName}}')">
                    <i class="fa-solid fa-plus me-1"></i> Add Secondary Role
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="openRoleHistoryModal('{{user._id}}')">
                    <i class="fa-solid fa-clock-rotate-left me-1"></i> Role History
                </button>
                <button type="button" class="btn btn-outline-info btn-sm" onclick="openContractPreviewModal('{{user._id}}')">
                    <i class="fa-solid fa-code me-1"></i> API Contract
                </button>
                {{#if isSuspended}}
                <button type="button" class="btn btn-success btn-sm" onclick="openRestoreModal('{{user._id}}', '{{displayName}}')">
                    <i class="fa-solid fa-unlock me-1"></i> Restore
                </button>
                {{else}}
                <button type="button" class="btn btn-outline-danger btn-sm" onclick="openSuspendModal('{{user._id}}', '{{displayName}}')">
                    <i class="fa-solid fa-ban me-1"></i> Suspend
                </button>
                {{/if}}
                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="openUsernameModal('{{user._id}}', '{{username}}')">
                    <i class="fa-solid fa-pen me-1"></i> Username
                </button>
            </div>
        </div>
    </div>

    <!-- MAIN 2-COLUMN ENTERPRISE DOSSIER LAYOUT -->
    <div class="row g-4">

        <!-- LEFT COLUMN: MULTI-ROLE IDENTITY, CAPABILITIES, BUSINESS, LEARNING, PROFESSIONAL, VERIFICATION -->
        <div class="col-lg-8">

            <!-- PANEL 1: MULTI-ROLE IDENTITY & CAPABILITY GOVERNANCE -->
            <div class="card p-4 mb-4" style="border-radius: 16px; border: 1px solid var(--border); box-shadow: 0 2px 12px rgba(0,0,0,0.03);">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h5 class="fw-bold m-0" style="color:var(--brand);">
                            <i class="fa-solid fa-users-viewfinder text-primary me-2"></i> Multi-Role Identity &amp; Capabilities Governance
                        </h5>
                        <small class="text-muted">Authoritative multi-role identity resolution and real-time capability evaluation.</small>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-sm btn-primary" onclick="openPrimaryRoleModal('{{user._id}}', '{{displayName}}', '{{primaryRole}}')">
                            <i class="fa-solid fa-user-tag me-1"></i> Change Primary
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="openAddSecondaryRoleModal('{{user._id}}', '{{displayName}}')">
                            <i class="fa-solid fa-plus me-1"></i> Add Secondary
                        </button>
                    </div>
                </div>

                <!-- ROLE RESOLUTION SUMMARY CARDS -->
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="p-3 rounded bg-light border h-100">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-bold small text-muted text-uppercase" style="font-size: 11px; letter-spacing: 0.5px;">
                                    <i class="fa-solid fa-crown text-warning me-1"></i> Primary Ecosystem Identity
                                </span>
                                <span class="badge {{#ifEquals primaryRole 'EDUCATOR'}}bg-warning text-dark{{else}}{{#ifEquals primaryRole 'FOUNDER'}}bg-dark text-white{{else}}{{#ifEquals primaryRole 'RECRUITER'}}bg-info text-dark{{else}}{{#ifEquals primaryRole 'MENTOR'}}bg-secondary text-white{{else}}{{#ifEquals primaryRole 'PROFESSIONAL'}}bg-primary text-white{{else}}bg-success-subtle text-success border{{/ifEquals}}{{/ifEquals}}{{/ifEquals}}{{/ifEquals}}{{/ifEquals}} px-2 py-1">
                                    {{primaryRole}}
                                </span>
                            </div>
                            <p class="small text-muted mb-0">The user's preferred ecosystem identity that defines their primary directory presentation and primary dashboard interface.</p>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="p-3 rounded bg-light border h-100">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-bold small text-muted text-uppercase" style="font-size: 11px; letter-spacing: 0.5px;">
                                    <i class="fa-solid fa-tags text-primary me-1"></i> Additional Held Roles ({{secondaryRoles.length}})
                                </span>
                                <span class="badge bg-secondary-subtle text-dark border">
                                    Total Roles: {{roles.length}}
                                </span>
                            </div>
                            {{#if secondaryRoles.length}}
                            <div class="d-flex flex-wrap gap-1">
                                {{#each secondaryRoles}}
                                <span class="badge bg-white text-dark border px-2 py-1 d-inline-flex align-items-center gap-1.5 shadow-sm" style="font-size: 12px;">
                                    <span>+ {{this}}</span>
                                    <button type="button" class="btn btn-link btn-xs p-0 text-danger text-decoration-none" onclick="openRemoveSecondaryRoleModal('{{../user._id}}', '{{this}}')" title="Remove Secondary Role">
                                        <i class="fa-solid fa-xmark"></i>
                                    </button>
                                </span>
                                {{/each}}
                            </div>
                            {{else}}
                            <p class="small text-muted mb-0 fst-italic">No secondary roles currently held. Click "Add Secondary" to grant additional legitimate identities.</p>
                            {{/if}}
                        </div>
                    </div>
                </div>

                <!-- COMPUTED CAPABILITY MATRIX TABLE -->
                <div class="mb-2">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="fw-bold m-0" style="font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; color: var(--brand);">
                            <i class="fa-solid fa-key text-success me-1"></i> Computed Platform Capabilities &amp; Permissions Matrix
                        </h6>
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-0.5" style="font-size: 11px;">
                            {{capabilities.length}} Active Capabilities
                        </span>
                    </div>
                    <div class="alert alert-light border small text-muted py-2 px-3 mb-3" style="border-radius: 10px;">
                        <i class="fa-solid fa-info-circle text-primary me-1"></i>
                        <strong>Architecture Law:</strong> Capabilities are fine-grained permission identifiers computed from held roles and verified business affiliations. Role names are never used as capabilities.
                    </div>

                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr style="font-size: 11px; text-transform: uppercase;">
                                    <th>Capability Identifier</th>
                                    <th>Domain Category</th>
                                    <th>Effective Status</th>
                                    <th>Source Roles / Authorization Rationale</th>
                                </tr>
                            </thead>
                            <tbody style="font-size: 12px;">
                                {{#each capabilityDetails}}
                                <tr>
                                    <td>
                                        <div class="fw-bold font-monospace text-dark">{{this.capability}}</div>
                                        <small class="text-muted">{{this.label}}</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-muted border font-monospace" style="font-size: 10px;">{{this.category}}</span>
                                    </td>
                                    <td>
                                        {{#if this.granted}}
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                            <i class="fa-solid fa-check me-1"></i> GRANTED
                                        </span>
                                        {{else}}{{#if this.businessGated}}
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1" title="User holds role but has no approved organization membership">
                                            <i class="fa-solid fa-lock me-1"></i> GATED (Needs Org)
                                        </span>
                                        {{else}}
                                        <span class="badge bg-secondary-subtle text-secondary px-2 py-1">
                                            <i class="fa-solid fa-minus me-1"></i> UNAVAILABLE
                                        </span>
                                        {{/if}}{{/if}}
                                    </td>
                                    <td>
                                        {{#if this.sourceRoles.length}}
                                        <div class="d-flex flex-wrap gap-1">
                                            {{#each this.sourceRoles}}
                                            <span class="badge bg-light text-dark border px-1.5 py-0.5" style="font-size: 10px;">{{this}}</span>
                                            {{/each}}
                                        </div>
                                        {{else}}
                                        <span class="text-muted small">—</span>
                                        {{/if}}
                                        {{#if this.requiresBusinessApproval}}
                                        <small class="text-muted d-block mt-0.5 fst-italic" style="font-size: 10px;">Requires approved organization</small>
                                        {{/if}}
                                    </td>
                                </tr>
                                {{/each}}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- PANEL 2: BUSINESS AUTHORIZATION & AFFILIATIONS -->
            <div class="card p-4 mb-4" style="border-radius: 16px; border: 1px solid var(--border); box-shadow: 0 2px 12px rgba(0,0,0,0.03);">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h5 class="fw-bold m-0" style="color:var(--brand);">
                            <i class="fa-solid fa-building text-info me-2"></i> Business Governance &amp; Organization Memberships
                        </h5>
                        <small class="text-muted">Evaluates organizational ownership, membership roles, and corporate governance.</small>
                    </div>
                    <a href="/admin/businesses" class="btn btn-sm btn-outline-secondary">
                        <i class="fa-solid fa-building-circle-check me-1"></i> Business Directory
                    </a>
                </div>

                <!-- BUSINESS AUTHORIZATION OVERVIEW BANNER -->
                <div class="alert alert-light border p-3 mb-3" style="border-radius: 12px;">
                    <div class="row align-items-center g-3">
                        <div class="col-md-4 col-6 border-end">
                            <small class="text-muted d-block" style="font-size: 11px; text-transform: uppercase;">Business Management</small>
                            {{#if businessAuthorization.canManageBusiness}}
                            <span class="fw-bold text-success"><i class="fa-solid fa-circle-check me-1"></i> Authorized</span>
                            {{else}}
                            <span class="fw-bold text-secondary"><i class="fa-solid fa-circle-xmark me-1"></i> Not Authorized</span>
                            {{/if}}
                        </div>
                        <div class="col-md-4 col-6 border-end">
                            <small class="text-muted d-block" style="font-size: 11px; text-transform: uppercase;">Post Job Opportunities</small>
                            {{#if businessAuthorization.canPostOpportunities}}
                            <span class="fw-bold text-success"><i class="fa-solid fa-circle-check me-1"></i> Authorized</span>
                            {{else}}
                            <span class="fw-bold text-secondary"><i class="fa-solid fa-circle-xmark me-1"></i> Not Authorized</span>
                            {{/if}}
                        </div>
                        <div class="col-md-4 col-12">
                            <small class="text-muted d-block" style="font-size: 11px; text-transform: uppercase;">Approved Organizations</small>
                            <span class="fw-bold text-dark fs-6">{{businessAuthorization.authorizedOrganizationsCount}} Active Organization{{#ifNotEquals businessAuthorization.authorizedOrganizationsCount 1}}s{{/ifNotEquals}}</span>
                        </div>
                    </div>
                </div>

                <div class="alert alert-info border-0 py-2 px-3 mb-3 small" style="border-radius: 10px; background-color: rgba(13, 202, 240, 0.08); color: #055160;">
                    <i class="fa-solid fa-shield-halved me-1"></i>
                    <strong>Requirement 10 Compliance:</strong> Holding FOUNDER or RECRUITER role does not grant automatic platform-wide business access; authorized organization ownership or active membership in an approved organization is strictly required.
                </div>

                <!-- BUSINESS AFFILIATIONS TABLE -->
                {{#if businessAffiliations.length}}
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr style="font-size: 11px; text-transform: uppercase;">
                                <th>Organization</th>
                                <th>Affiliation Role</th>
                                <th>Organization Status</th>
                                <th>Joined</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each businessAffiliations}}
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <img src="{{this.organizationLogo}}" alt="{{this.organizationName}}" class="rounded" style="width: 32px; height: 32px; object-fit: cover; border: 1px solid var(--border);" onerror="this.onerror=null;this.src='/img/placeholders/business.svg'">
                                        <span class="fw-bold text-dark">{{this.organizationName}}</span>
                                    </div>
                                </td>
                                <td><span class="badge bg-light text-dark border">{{this.membershipRole}}</span></td>
                                <td>
                                    {{#if this.isVerified}}
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1"><i class="fa-solid fa-check me-1"></i> Approved</span>
                                    {{else}}
                                    <span class="badge bg-warning-subtle text-warning-emphasis px-2 py-1">Pending Approval</span>
                                    {{/if}}
                                </td>
                                <td><small class="text-muted">{{formatDate this.joinedAt}}</small></td>
                                <td class="text-end">
                                    <a href="/admin/businesses/{{this.organizationId}}" class="btn btn-sm btn-outline-primary">
                                        Inspect Org
                                    </a>
                                </td>
                            </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>
                {{else}}
                <div class="text-center py-3 text-muted bg-light rounded small">
                    <i class="fa-solid fa-building-circle-xmark fa-2x mb-1 opacity-50"></i>
                    <p class="mb-0">No business affiliations or organizational memberships linked.</p>
                </div>
                {{/if}}
            </div>

            <!-- PANEL 3: LEARNING CONTEXT & COURSE PARTICIPATION -->
            <div class="card p-4 mb-4" style="border-radius: 16px; border: 1px solid var(--border); box-shadow: 0 2px 12px rgba(0,0,0,0.03);">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h5 class="fw-bold m-0" style="color:var(--brand);">
                            <i class="fa-solid fa-graduation-cap text-success me-2"></i> Learning Context &amp; Course Participation
                        </h5>
                        <small class="text-muted">Learning enrollments, curriculum relationships, and certifications.</small>
                    </div>
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1">
                        {{learningContext.coursesCount}} Enrolled Course{{#ifNotEquals learningContext.coursesCount 1}}s{{/ifNotEquals}}
                    </span>
                </div>

                <div class="alert alert-success border-0 py-2 px-3 mb-3 small" style="border-radius: 10px; background-color: rgba(25, 135, 84, 0.08); color: #0f5132;">
                    <i class="fa-solid fa-circle-check me-1"></i>
                    <strong>Requirement 11 Compliance:</strong> Course participation is independent of user role. Enrolling in courses does not alter Primary Role (e.g. a Founder who studies remains Founder) and does not force Student classification.
                </div>

                {{#if learningContext.enrolledCourses.length}}
                <div class="row g-3">
                    {{#each learningContext.enrolledCourses}}
                    <div class="col-md-6">
                        <div class="p-3 rounded border bg-light h-100 d-flex flex-column justify-content-between">
                            <div class="d-flex align-items-center gap-2.5 mb-2">
                                <img src="{{this.image}}" alt="{{this.title}}" class="rounded" style="width: 40px; height: 40px; object-fit: cover; border: 1px solid var(--border);" onerror="this.onerror=null;this.src='/img/placeholders/course-cover.svg'">
                                <div>
                                    <div class="fw-bold text-dark text-truncate" style="max-width: 200px;">{{this.title}}</div>
                                    <small class="badge bg-white text-muted border" style="font-size: 10px;">{{this.category}}</small>
                                </div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top">
                                <small class="text-muted">{{#if this.duration}}{{this.duration}}{{else}}Self-paced{{/if}}</small>
                                <a href="/admin/courses/{{this._id}}/chapters" class="btn btn-xs btn-outline-success py-0 px-2" style="font-size: 11px;">
                                    View Chapters
                                </a>
                            </div>
                        </div>
                    </div>
                    {{/each}}
                </div>
                {{else}}
                <div class="text-center py-3 text-muted bg-light rounded small">
                    <i class="fa-solid fa-book-open fa-2x mb-1 opacity-50"></i>
                    <p class="mb-0">No active course enrollments recorded.</p>
                </div>
                {{/if}}
            </div>

            <!-- PANEL 4: PROFESSIONAL PROFILE & TAXONOMY GOVERNANCE -->
            <div class="card p-4 mb-4" style="border-radius: 16px; border: 1px solid var(--border);">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold m-0" style="color:var(--brand);">
                        <i class="fa-solid fa-briefcase text-primary me-2"></i> Professional Profile &amp; Taxonomy
                    </h5>
                    <span class="badge bg-light text-muted border">Read &amp; Governed</span>
                </div>

                <!-- PROFILE TAXONOMY METADATA -->
                <div class="row g-3 mb-4">
                    <div class="col-md-3 col-6">
                        <div class="p-3 rounded bg-light border text-center">
                            <small class="text-muted d-block mb-1">Primary Role</small>
                            <span class="fw-bold text-dark">{{primaryRole}}</span>
                        </div>
                    </div>
                    <div class="col-md-3 col-6">
                        <div class="p-3 rounded bg-light border text-center">
                            <small class="text-muted d-block mb-1">Discipline</small>
                            <span class="fw-bold text-dark">{{#if discipline}}{{discipline}}{{else}}—{{/if}}</span>
                        </div>
                    </div>
                    <div class="col-md-3 col-6">
                        <div class="p-3 rounded bg-light border text-center">
                            <small class="text-muted d-block mb-1">Specialization</small>
                            <span class="fw-bold text-dark">{{#if specialization}}{{specialization}}{{else}}—{{/if}}</span>
                        </div>
                    </div>
                    <div class="col-md-3 col-6">
                        <div class="p-3 rounded bg-light border text-center">
                            <small class="text-muted d-block mb-1">Sector</small>
                            <span class="fw-bold text-dark">{{#if infrastructureSector}}{{infrastructureSector}}{{else}}—{{/if}}</span>
                        </div>
                    </div>
                </div>

                <!-- HEADLINE & BIO -->
                {{#if headline}}
                <div class="mb-3">
                    <label class="fw-bold small text-muted text-uppercase mb-1" style="font-size: 11px; letter-spacing: 0.5px;">Headline</label>
                    <p class="mb-0 fs-6 text-dark fw-semibold">{{headline}}</p>
                </div>
                {{/if}}

                {{#if bio}}
                <div class="mb-4">
                    <label class="fw-bold small text-muted text-uppercase mb-1" style="font-size: 11px; letter-spacing: 0.5px;">About / Biography</label>
                    <div class="p-3 rounded bg-light text-muted" style="font-size: 14px; line-height: 1.6;">
                        {{bio}}
                    </div>
                </div>
                {{/if}}

                <!-- SKILLS & SOFTWARE TOOLS -->
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="fw-bold small text-muted text-uppercase mb-2" style="font-size: 11px; letter-spacing: 0.5px;">
                            <i class="fa-solid fa-code me-1 text-primary"></i> Skills &amp; Competencies ({{skills.length}})
                        </label>
                        {{#if skills.length}}
                        <div class="d-flex flex-wrap gap-1">
                            {{#each skills}}
                            <span class="badge bg-light text-dark border px-2 py-1">{{this}}</span>
                            {{/each}}
                        </div>
                        {{else}}
                        <p class="text-muted small mb-0 fst-italic">No professional skills declared.</p>
                        {{/if}}
                    </div>

                    <div class="col-md-6">
                        <label class="fw-bold small text-muted text-uppercase mb-2" style="font-size: 11px; letter-spacing: 0.5px;">
                            <i class="fa-solid fa-wrench me-1 text-info"></i> Software &amp; Tools ({{software.length}})
                        </label>
                        {{#if software.length}}
                        <div class="d-flex flex-wrap gap-1">
                            {{#each software}}
                            <span class="badge bg-light text-dark border px-2 py-1">{{this}}</span>
                            {{/each}}
                        </div>
                        {{else}}
                        <p class="text-muted small mb-0 fst-italic">No software tools listed.</p>
                        {{/if}}
                    </div>
                </div>

                <!-- STRUCTURED EXPERIENCE & EDUCATION ACCORDION -->
                <div class="accordion" id="profileGovernanceAccordion">

                    <!-- EXPERIENCE -->
                    <div class="accordion-item border rounded mb-2 overflow-hidden">
                        <h2 class="accordion-header" id="headingExp">
                            <button class="accordion-button collapsed py-2.5 px-3 bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#collapseExp" aria-expanded="false" aria-controls="collapseExp">
                                <span class="fw-bold small text-dark"><i class="fa-solid fa-building-columns me-2 text-primary"></i> Work Experience ({{experience.length}})</span>
                            </button>
                        </h2>
                        <div id="collapseExp" class="accordion-collapse collapse" aria-labelledby="headingExp" data-bs-parent="#profileGovernanceAccordion">
                            <div class="accordion-body p-3">
                                {{#if experience.length}}
                                <div class="d-flex flex-column gap-3">
                                    {{#each experience}}
                                    <div class="border-start border-3 border-primary ps-3 py-1">
                                        <div class="fw-bold text-dark">{{this.title}} <span class="text-muted fw-normal">at {{this.company}}</span></div>
                                        <small class="text-muted">{{this.startDate}} - {{#if this.current}}Present{{else}}{{this.endDate}}{{/if}} {{#if this.location}}• {{this.location}}{{/if}}</small>
                                        {{#if this.description}}<p class="small text-muted mb-0 mt-1">{{this.description}}</p>{{/if}}
                                    </div>
                                    {{/each}}
                                </div>
                                {{else}}
                                <p class="text-muted small mb-0 fst-italic">No professional work history recorded.</p>
                                {{/if}}
                            </div>
                        </div>
                    </div>

                    <!-- EDUCATION -->
                    <div class="accordion-item border rounded mb-2 overflow-hidden">
                        <h2 class="accordion-header" id="headingEdu">
                            <button class="accordion-button collapsed py-2.5 px-3 bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#collapseEdu" aria-expanded="false" aria-controls="collapseEdu">
                                <span class="fw-bold small text-dark"><i class="fa-solid fa-graduation-cap me-2 text-success"></i> Education ({{education.length}})</span>
                            </button>
                        </h2>
                        <div id="collapseEdu" class="accordion-collapse collapse" aria-labelledby="headingEdu" data-bs-parent="#profileGovernanceAccordion">
                            <div class="accordion-body p-3">
                                {{#if education.length}}
                                <div class="d-flex flex-column gap-3">
                                    {{#each education}}
                                    <div class="border-start border-3 border-success ps-3 py-1">
                                        <div class="fw-bold text-dark">{{this.degree}} {{#if this.fieldOfStudy}}<span class="text-muted fw-normal">in {{this.fieldOfStudy}}</span>{{/if}}</div>
                                        <small class="text-muted">{{this.institution}} {{#if this.startYear}}({{this.startYear}} - {{#if this.endYear}}{{this.endYear}}{{else}}Present{{/if}}){{/if}}</small>
                                    </div>
                                    {{/each}}
                                </div>
                                {{else}}
                                <p class="text-muted small mb-0 fst-italic">No education records recorded.</p>
                                {{/if}}
                            </div>
                        </div>
                    </div>

                    <!-- CERTIFICATIONS & LICENSES -->
                    <div class="accordion-item border rounded mb-2 overflow-hidden">
                        <h2 class="accordion-header" id="headingCert">
                            <button class="accordion-button collapsed py-2.5 px-3 bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCert" aria-expanded="false" aria-controls="collapseCert">
                                <span class="fw-bold small text-dark"><i class="fa-solid fa-award me-2 text-warning"></i> Certifications &amp; Licenses ({{certifications.length}})</span>
                            </button>
                        </h2>
                        <div id="collapseCert" class="accordion-collapse collapse" aria-labelledby="headingCert" data-bs-parent="#profileGovernanceAccordion">
                            <div class="accordion-body p-3">
                                {{#if certifications.length}}
                                <div class="d-flex flex-column gap-3">
                                    {{#each certifications}}
                                    <div class="border-start border-3 border-warning ps-3 py-1">
                                        <div class="fw-bold text-dark">{{this.name}} <span class="text-muted fw-normal">by {{this.issuer}}</span></div>
                                        <small class="text-muted">Issued: {{this.issueDate}} {{#if this.credentialId}}• Credential ID: <code>{{this.credentialId}}</code>{{/if}}</small>
                                    </div>
                                    {{/each}}
                                </div>
                                {{else}}
                                <p class="text-muted small mb-0 fst-italic">No external certifications recorded.</p>
                                {{/if}}
                            </div>
                        </div>
                    </div>

                    <!-- PROJECTS -->
                    <div class="accordion-item border rounded overflow-hidden">
                        <h2 class="accordion-header" id="headingProj">
                            <button class="accordion-button collapsed py-2.5 px-3 bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#collapseProj" aria-expanded="false" aria-controls="collapseProj">
                                <span class="fw-bold small text-dark"><i class="fa-solid fa-diagram-project me-2 text-info"></i> Project Portfolio ({{projects.length}})</span>
                            </button>
                        </h2>
                        <div id="collapseProj" class="accordion-collapse collapse" aria-labelledby="headingProj" data-bs-parent="#profileGovernanceAccordion">
                            <div class="accordion-body p-3">
                                {{#if projects.length}}
                                <div class="d-flex flex-column gap-3">
                                    {{#each projects}}
                                    <div class="border-start border-3 border-info ps-3 py-1">
                                        <div class="fw-bold text-dark">{{this.title}} {{#if this.role}}<span class="text-muted fw-normal">({{this.role}})</span>{{/if}}</div>
                                        {{#if this.description}}<p class="small text-muted mb-1">{{this.description}}</p>{{/if}}
                                        {{#if this.url}}<a href="{{this.url}}" target="_blank" rel="noopener noreferrer" class="small text-primary text-decoration-none"><i class="fa-solid fa-arrow-up-right-from-square me-1"></i> View Project</a>{{/if}}
                                    </div>
                                    {{/each}}
                                </div>
                                {{else}}
                                <p class="text-muted small mb-0 fst-italic">No projects recorded in portfolio.</p>
                                {{/if}}
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- SECTION 2: VERIFICATION GOVERNANCE MATRIX -->
            <div class="card p-4 mb-4" style="border-radius: 16px; border: 1px solid var(--border);">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h5 class="fw-bold m-0" style="color:var(--brand);">
                            <i class="fa-solid fa-shield-halved text-success me-2"></i> Verification Governance Matrix
                        </h5>
                        <small class="text-muted">Independent verification categories governed under zero-trust RBAC.</small>
                    </div>
                    <div class="d-flex gap-2">
                        <a href="/admin/verification" class="btn btn-sm btn-outline-primary">
                            <i class="fa-solid fa-list-check me-1"></i> Review Queue
                        </a>
                        <button type="button" class="btn btn-sm btn-outline-success" onclick="openVerificationModal('{{user._id}}', '{{displayName}}', '{{#if user.account_Status.isVerified}}VERIFIED{{else}}UNVERIFIED{{/if}}')">
                            <i class="fa-solid fa-pen-to-square me-1"></i> Update State
                        </button>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table align-middle table-hover mb-0">
                        <thead class="table-light">
                            <tr style="font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;">
                                <th>Category</th>
                                <th>Status</th>
                                <th>Evidence Privacy State</th>
                                <th>Latest Review / Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each verificationBreakdown}}
                            <tr>
                                <td>
                                    <div class="fw-bold text-dark">{{this.label}}</div>
                                    <small class="text-muted font-monospace" style="font-size: 11px;">{{this.category}}</small>
                                </td>
                                <td>
                                    <span class="badge {{#ifEquals this.status 'VERIFIED'}}bg-success{{else}}{{#ifEquals this.status 'UNDER_REVIEW'}}bg-warning text-dark{{else}}{{#ifEquals this.status 'PENDING'}}bg-info text-dark{{else}}{{#ifEquals this.status 'REJECTED'}}bg-danger{{else}}bg-secondary{{/ifEquals}}{{/ifEquals}}{{/ifEquals}}{{/ifEquals}} px-2 py-1">
                                        {{this.status}}
                                    </span>
                                </td>
                                <td>
                                    {{#if this.latestRequest}}
                                        {{#if this.latestRequest.evidenceRedacted}}
                                        <span class="badge bg-light text-muted border" title="Redacted by Zero-Trust Privacy Layer">
                                            <i class="fa-solid fa-lock me-1 text-warning"></i> Redacted (Requires Capability)
                                        </span>
                                        {{else}}
                                            {{#if this.latestRequest.evidenceUrl}}
                                            <a href="{{this.latestRequest.evidenceUrl}}" target="_blank" rel="noopener noreferrer" class="btn btn-xs btn-outline-primary py-0 px-2" style="font-size: 11px;">
                                                <i class="fa-solid fa-file-shield me-1"></i> Inspect Document
                                            </a>
                                            {{else}}
                                            <span class="text-muted small">No document attached</span>
                                            {{/if}}
                                        {{/if}}
                                        {{#if this.latestRequest.idNumber}}
                                        <div class="small font-monospace text-muted mt-0.5">ID: {{this.latestRequest.idNumber}}</div>
                                        {{/if}}
                                    {{else}}
                                    <span class="text-muted small fst-italic">No requests submitted</span>
                                    {{/if}}
                                </td>
                                <td>
                                    {{#if this.latestRequest.notes}}
                                    <span class="small text-dark">{{this.latestRequest.notes}}</span>
                                    {{else}}
                                    <span class="text-muted small">—</span>
                                    {{/if}}
                                </td>
                            </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- PANEL 6: NETWORK CONNECTIONS & MODERATION STANDING -->
            <div class="card p-4" style="border-radius: 16px; border: 1px solid var(--border);">
                <h5 class="fw-bold mb-3" style="color:var(--brand);">
                    <i class="fa-solid fa-users-gear text-secondary me-2"></i> Network &amp; Platform Standing
                </h5>

                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="p-3 rounded bg-light border d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted d-block">Network Connections</small>
                                <span class="fw-bold fs-4 text-dark">{{connectionsCount}}</span>
                            </div>
                            <i class="fa-solid fa-handshake fs-2 text-primary opacity-50"></i>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="p-3 rounded bg-light border d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted d-block">Moderation Reports Filed Against</small>
                                <span class="fw-bold fs-4 {{#if reportsAgainstCount}}text-danger{{else}}text-success{{/if}}">{{reportsAgainstCount}}</span>
                            </div>
                            <i class="fa-solid fa-flag fs-2 {{#if reportsAgainstCount}}text-danger{{else}}text-success{{/if}} opacity-50"></i>
                        </div>
                    </div>
                </div>

                {{#if reportsAgainstCount}}
                <div class="alert alert-danger border-0 d-flex align-items-center gap-2 mt-3 mb-0 small" style="border-radius: 12px;">
                    <i class="fa-solid fa-triangle-exclamation text-danger fs-5"></i>
                    <div>
                        <strong>Flagged Account:</strong> This user has active moderation reports. Consider applying restrictions or inspecting moderation records.
                    </div>
                </div>
                {{/if}}
            </div>

        </div>

        <!-- RIGHT COLUMN: ACCOUNT GOVERNANCE CONTROLS, SESSIONS, AUDIT -->
        <div class="col-lg-4">

            <!-- CARD 1: ACCOUNT & MULTI-ROLE GOVERNANCE CONTROLS -->
            <div class="card p-4 mb-4" style="border-radius: 16px; border: 1px solid var(--border); box-shadow: 0 2px 12px rgba(0,0,0,0.03);">
                <h6 class="fw-bold mb-3" style="color:var(--brand);">
                    <i class="fa-solid fa-sliders text-primary me-2"></i> Account Governance Controls
                </h6>

                <div class="mb-3">
                    <label class="fw-bold small text-muted text-uppercase d-block mb-1" style="font-size: 11px;">Current Account State</label>
                    <span class="badge {{#if isSuspended}}bg-danger{{else}}{{#if isRestricted}}bg-warning text-dark{{else}}bg-success{{/if}}{{/if}} fs-6 px-3 py-1.5 w-100 text-center text-uppercase">
                        {{accountState}}
                    </span>
                </div>

                {{#if user.account_Status.restrictions.length}}
                <div class="mb-3">
                    <label class="fw-bold small text-muted text-uppercase d-block mb-1" style="font-size: 11px;">Active Restrictions</label>
                    <div class="d-flex flex-wrap gap-1">
                        {{#each user.account_Status.restrictions}}
                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1">
                            <i class="fa-solid fa-ban me-1"></i> {{this}}
                        </span>
                        {{/each}}
                    </div>
                </div>
                {{/if}}

                <hr class="my-3">

                <!-- ACTION BUTTONS -->
                <div class="d-flex flex-column gap-2">
                    <button type="button" class="btn btn-primary w-100 text-start" onclick="openPrimaryRoleModal('{{user._id}}', '{{displayName}}', '{{primaryRole}}')">
                        <i class="fa-solid fa-user-tag me-2 text-white"></i> Change Primary Role
                    </button>

                    <button type="button" class="btn btn-outline-primary w-100 text-start" onclick="openAddSecondaryRoleModal('{{user._id}}', '{{displayName}}')">
                        <i class="fa-solid fa-user-plus me-2 text-primary"></i> Add Secondary Role
                    </button>

                    <button type="button" class="btn btn-outline-secondary w-100 text-start" onclick="openRoleHistoryModal('{{user._id}}')">
                        <i class="fa-solid fa-clock-rotate-left me-2 text-secondary"></i> View Role History
                    </button>

                    <button type="button" class="btn btn-outline-info w-100 text-start" onclick="openContractPreviewModal('{{user._id}}')">
                        <i class="fa-solid fa-code me-2 text-info"></i> View API Contract Preview
                    </button>

                    <button type="button" class="btn btn-outline-success w-100 text-start" onclick="openVerificationModal('{{user._id}}', '{{displayName}}', '{{#if user.account_Status.isVerified}}VERIFIED{{else}}UNVERIFIED{{/if}}')">
                        <i class="fa-solid fa-shield-check me-2 text-success"></i> Update Verification State
                    </button>

                    <button type="button" class="btn btn-outline-warning w-100 text-start text-dark" onclick="openRestrictionsModal('{{user._id}}', '{{displayName}}')">
                        <i class="fa-solid fa-shield-virus me-2 text-warning"></i> Manage Restrictions
                    </button>

                    <button type="button" class="btn btn-outline-secondary w-100 text-start" onclick="openUsernameModal('{{user._id}}', '{{username}}')">
                        <i class="fa-solid fa-at me-2 text-secondary"></i> Adjust / Force Username
                    </button>

                    {{#if isSuspended}}
                    <button type="button" class="btn btn-success w-100 text-start" onclick="openRestoreModal('{{user._id}}', '{{displayName}}')">
                        <i class="fa-solid fa-unlock me-2"></i> Restore Account Suspension
                    </button>
                    {{else}}
                    <button type="button" class="btn btn-danger w-100 text-start" onclick="openSuspendModal('{{user._id}}', '{{displayName}}')">
                        <i class="fa-solid fa-ban me-2"></i> Suspend Account
                    </button>
                    {{/if}}
                </div>
            </div>

            <!-- CARD 1.5: SEMANTIC CONSISTENCY DIAGNOSTIC -->
            {{#if consistencyIssues.length}}
            <div class="card p-3 mb-4 border-warning" style="border-radius: 16px; background-color: #fffdf5;">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="fw-bold m-0 text-warning-emphasis" style="font-size: 13px;">
                        <i class="fa-solid fa-triangle-exclamation me-1.5 text-warning"></i> Data Consistency Notice ({{consistencyIssues.length}})
                    </h6>
                    <span class="badge bg-warning text-dark" style="font-size: 10px;">Action Recommended</span>
                </div>
                <p class="small text-muted mb-2" style="font-size: 12px;">This account contains semantic role/capability inconsistencies detected by the governance audit engine:</p>
                <div class="d-flex flex-column gap-2 mb-3">
                    {{#each consistencyIssues}}
                    <div class="p-2 rounded bg-white border border-warning-subtle" style="font-size: 11px;">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="badge bg-light text-dark border font-monospace">{{this.code}}</span>
                            <span class="badge {{#ifEquals this.severity 'ERROR'}}bg-danger{{else}}bg-warning text-dark{{/ifEquals}}">{{this.severity}}</span>
                        </div>
                        <div class="text-dark">{{this.message}}</div>
                        {{#if this.recommendedValue}}
                        <div class="text-muted mt-1">Recommended: <code>{{this.recommendedValue}}</code></div>
                        {{/if}}
                    </div>
                    {{/each}}
                </div>
                <a href="/admin/network/audit-roles" class="btn btn-sm btn-outline-warning text-dark w-100" style="font-size: 12px;">
                    <i class="fa-solid fa-wrench me-1"></i> Open Full Diagnostic Audit
                </a>
            </div>
            {{/if}}

            <!-- CARD 2: SESSION GOVERNANCE (SAFE METADATA) -->
            <div class="card p-4 mb-4" style="border-radius: 16px; border: 1px solid var(--border);">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold m-0" style="color:var(--brand);">
                        <i class="fa-solid fa-network-wired text-info me-2"></i> Active Sessions ({{sessions.length}})
                    </h6>
                    {{#if sessions.length}}
                    <button type="button" class="btn btn-xs btn-outline-danger py-0 px-2" style="font-size: 11px;" onclick="revokeAllSessions('{{user._id}}')">
                        <i class="fa-solid fa-trash me-1"></i> Revoke All
                    </button>
                    {{/if}}
                </div>

                {{#if sessions.length}}
                <div class="d-flex flex-column gap-2">
                    {{#each sessions}}
                    <div class="p-2.5 rounded bg-light border" style="font-size: 13px;">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <div>
                                <span class="fw-bold text-dark">
                                    {{#ifEquals this.deviceType 'Mobile'}}
                                    <i class="fa-solid fa-mobile-screen me-1 text-primary"></i>
                                    {{else}}{{#ifEquals this.deviceType 'Tablet'}}
                                    <i class="fa-solid fa-tablet-screen-button me-1 text-info"></i>
                                    {{else}}
                                    <i class="fa-solid fa-laptop me-1 text-secondary"></i>
                                    {{/ifEquals}}{{/ifEquals}}
                                    {{this.browser}} on {{this.os}}
                                </span>
                                {{#if this.isCurrentSession}}
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle ms-1" style="font-size: 10px;">Your Admin Session</span>
                                {{/if}}
                            </div>
                            {{#unless this.isCurrentSession}}
                            <button type="button" class="btn btn-link btn-sm text-danger p-0" onclick="revokeSingleSession('{{../user._id}}', '{{this.sessionId}}')" title="Revoke this session">
                                <i class="fa-solid fa-xmark"></i>
                            </button>
                            {{/unless}}
                        </div>

                        <div class="d-flex justify-content-between text-muted" style="font-size: 11px;">
                            <span>IP: <code>{{this.ipAddress}}</code></span>
                            <span>Session: <code class="text-muted">{{this.maskedSessionId}}</code></span>
                        </div>
                    </div>
                    {{/each}}
                </div>
                {{else}}
                <div class="text-center py-3 text-muted bg-light rounded small fst-italic">
                    No active sessions found for this user.
                </div>
                {{/if}}
            </div>

            <!-- CARD 3: RECENT ADMINISTRATIVE AUDIT TRAIL -->
            <div class="card p-4" style="border-radius: 16px; border: 1px solid var(--border);">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold m-0" style="color:var(--brand);">
                        <i class="fa-solid fa-clock-rotate-left text-warning me-2"></i> Audit Trail
                    </h6>
                    <a href="/admin/audit-logs?search={{user._id}}" class="btn btn-xs btn-outline-secondary py-0 px-2" style="font-size: 11px;">
                        Full History
                    </a>
                </div>

                {{#if recentAuditLogs.length}}
                <div class="d-flex flex-column gap-2">
                    {{#each recentAuditLogs}}
                    <div class="border-start border-2 border-warning ps-2 py-1" style="font-size: 12px;">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="badge bg-light text-dark border font-monospace" style="font-size: 10px;">{{this.action}}</span>
                            <small class="text-muted">{{formatDate this.timestamp}}</small>
                        </div>
                        <div class="text-muted small mt-1" style="line-height: 1.4;">{{this.message}}</div>
                        <div class="text-muted" style="font-size: 10px;">Actor: <strong>{{#if this.metadata.actor}}{{this.metadata.actor}}{{else}}Admin{{/if}}</strong></div>
                    </div>
                    {{/each}}
                </div>
                {{else}}
                <div class="text-center py-3 text-muted bg-light rounded small fst-italic">
                    No recent administrative actions recorded for this user.
                </div>
                {{/if}}
            </div>

        </div>

    </div>

</div>

