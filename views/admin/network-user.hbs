<!-- CLIENT LOGIC -->
<script>
let primaryRoleModalInstance, addSecondaryRoleModalInstance, removeSecondaryRoleModalInstance, roleHistoryModalInstance, contractModalInstance, suspendModalInstance, restoreModalInstance, usernameModalInstance, verificationModalInstance, restrictionsModalInstance;

document.addEventListener('DOMContentLoaded', () => {
    if (window.bootstrap) {
        const prEl = document.getElementById('primaryRoleModal');
        if (prEl) primaryRoleModalInstance = new bootstrap.Modal(prEl);

        const asrEl = document.getElementById('addSecondaryRoleModal');
        if (asrEl) addSecondaryRoleModalInstance = new bootstrap.Modal(asrEl);

        const rsrEl = document.getElementById('removeSecondaryRoleModal');
        if (rsrEl) removeSecondaryRoleModalInstance = new bootstrap.Modal(rsrEl);

        const rhEl = document.getElementById('roleHistoryModal');
        if (rhEl) roleHistoryModalInstance = new bootstrap.Modal(rhEl);

        const cEl = document.getElementById('contractModal');
        if (cEl) contractModalInstance = new bootstrap.Modal(cEl);

        suspendModalInstance = new bootstrap.Modal(document.getElementById('suspendModal'));
        restoreModalInstance = new bootstrap.Modal(document.getElementById('restoreModal'));
        usernameModalInstance = new bootstrap.Modal(document.getElementById('usernameModal'));
        verificationModalInstance = new bootstrap.Modal(document.getElementById('verificationModal'));
        restrictionsModalInstance = new bootstrap.Modal(document.getElementById('restrictionsModal'));
    }
});

function openPrimaryRoleModal(userId, name, currentRole) {
    document.getElementById('modalPrimaryUserId').value = userId;
    document.getElementById('modalPrimaryUserName').innerText = name;
    const select = document.getElementById('newPrimaryRoleSelect');
    select.value = (currentRole || 'STUDENT').toUpperCase();
    if (document.getElementById('primaryRoleReason')) {
        document.getElementById('primaryRoleReason').value = '';
    }
    checkEducatorWarningPrimary(select.value);
    if (primaryRoleModalInstance) primaryRoleModalInstance.show();
}

// Backward compatibility alias
function openRoleModal(userId, name, currentRole) {
    openPrimaryRoleModal(userId, name, currentRole);
}

function checkEducatorWarningPrimary(role) {
    const notice = document.getElementById('educatorNoticePrimary');
    if (notice) {
        notice.style.display = (role === 'EDUCATOR') ? 'block' : 'none';
    }
}

async function submitPrimaryRoleChange(e) {
    e.preventDefault();
    const btn = document.getElementById('savePrimaryRoleBtn') || e.target.querySelector('button[type="submit"]');
    const userId = document.getElementById('modalPrimaryUserId').value;
    const role = document.getElementById('newPrimaryRoleSelect').value;
    const reason = (document.getElementById('primaryRoleReason')?.value || '').trim();

    if (role === 'EDUCATOR') {
        const confirmRes = await Swal.fire({
            title: 'Assign Educator Role?',
            text: 'You are about to assign the privileged Educator role. This requires assign_educator administrative capability and is audit logged.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#198754',
            confirmButtonText: 'Yes, Assign Educator'
        });
        if (!confirmRes.isConfirmed) return;
    }

    if (window.zeitnahSetSubmitting) window.zeitnahSetSubmitting(btn, 'Auditing...');

    try {
        const res = await fetch(`/admin/network/users/${userId}/primary-role`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ role, reason })
        });
        const json = await res.json();
        if (json.success) {
            Swal.fire({ icon: 'success', title: 'Primary Role Updated', text: json.message, timer: 1500, showConfirmButton: false });
            setTimeout(() => window.location.reload(), 1500);
        } else {
            if (window.zeitnahResetSubmitting) window.zeitnahResetSubmitting(btn);
            Swal.fire({ icon: 'error', title: 'Update Failed', text: json.message || 'Could not update primary role' });
        }
    } catch(err) {
        if (window.zeitnahResetSubmitting) window.zeitnahResetSubmitting(btn);
        Swal.fire({ icon: 'error', title: 'Network Error', text: err.message });
    }
}

function openAddSecondaryRoleModal(userId, name) {
    document.getElementById('modalAddSecondaryUserId').value = userId;
    document.getElementById('modalAddSecondaryUserName').innerText = name;
    document.getElementById('newSecondaryRoleSelect').value = '';
    if (document.getElementById('addSecondaryRoleReason')) {
        document.getElementById('addSecondaryRoleReason').value = '';
    }
    checkEducatorWarningSecondary('');
    if (addSecondaryRoleModalInstance) addSecondaryRoleModalInstance.show();
}

function checkEducatorWarningSecondary(role) {
    const notice = document.getElementById('educatorNoticeSecondary');
    if (notice) {
        notice.style.display = (role === 'EDUCATOR') ? 'block' : 'none';
    }
}

async function submitAddSecondaryRole(e) {
    e.preventDefault();
    const btn = document.getElementById('saveSecondaryRoleBtn') || e.target.querySelector('button[type="submit"]');
    const userId = document.getElementById('modalAddSecondaryUserId').value;
    const role = document.getElementById('newSecondaryRoleSelect').value;
    const reason = (document.getElementById('addSecondaryRoleReason')?.value || '').trim();

    if (!role) {
        Swal.fire({ icon: 'warning', title: 'Role Required', text: 'Please select a secondary role to add.' });
        return;
    }

    if (role === 'EDUCATOR') {
        const confirmRes = await Swal.fire({
            title: 'Assign Secondary Educator?',
            text: 'Adding EDUCATOR requires assign_educator administrative capability and is audit logged.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#198754',
            confirmButtonText: 'Yes, Assign Educator'
        });
        if (!confirmRes.isConfirmed) return;
    }

    if (window.zeitnahSetSubmitting) window.zeitnahSetSubmitting(btn, 'Auditing...');

    try {
        const res = await fetch(`/admin/network/users/${userId}/secondary-roles/add`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ role, reason })
        });
        const json = await res.json();
        if (json.success) {
            Swal.fire({ icon: 'success', title: 'Secondary Role Added', text: json.message, timer: 1500, showConfirmButton: false });
            setTimeout(() => window.location.reload(), 1500);
        } else {
            if (window.zeitnahResetSubmitting) window.zeitnahResetSubmitting(btn);
            Swal.fire({ icon: 'error', title: 'Action Failed', text: json.message || 'Could not add secondary role' });
        }
    } catch(err) {
        if (window.zeitnahResetSubmitting) window.zeitnahResetSubmitting(btn);
        Swal.fire({ icon: 'error', title: 'Network Error', text: err.message });
    }
}

