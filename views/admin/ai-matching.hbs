<div class="container-fluid mt-4 mb-5">

    <!-- HERO HEADER -->
    <div class="hero-card mb-4" style="background: linear-gradient(135deg, rgba(18, 49, 76, 0.95), rgba(29, 78, 137, 0.9)), url('/images/banner.jpg') center/cover; padding: 32px 36px; border-radius: 24px; position: relative; overflow: hidden; box-shadow: 0 12px 32px rgba(18, 49, 76, 0.15);">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 position-relative" style="z-index: 2;">
            <div>
                <span class="badge mb-2 px-3 py-2" style="background: rgba(159, 213, 178, 0.2); color: #9fd5b2; border: 1px solid rgba(159, 213, 178, 0.35); border-radius: 30px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px;">
                    <i class="fa-solid fa-brain me-1"></i> Phase 3 &amp; 4 Subsystem
                </span>
                <h2 class="text-white fw-bold m-0" style="font-size: 28px; letter-spacing: -0.5px;">AI Matching &amp; Recommendation Control</h2>
                <p class="text-light opacity-75 mt-2 mb-0" style="font-size: 14px;">Operational monitoring, telemetry, deterministic fallback health, and versioned scoring configuration.</p>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <a href="/admin/ai/job-matches" class="btn btn-outline-light px-3 py-2">
                    <i class="fa-solid fa-user-check me-1"></i> Job → Talent
                </a>
                <a href="/admin/ai/talent-recommendations" class="btn btn-outline-light px-3 py-2">
                    <i class="fa-solid fa-wand-magic-sparkles me-1"></i> Talent → Jobs
                </a>
                <a href="/admin/ai/config" class="btn btn-light px-3 py-2">
                    <i class="fa-solid fa-sliders me-1"></i> Weights Config
                </a>
            </div>
        </div>
    </div>

    <!-- REAL METRICS -->
    <div class="row g-4 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="stat-card stat-dark">
                <div>
                    <small>Matches Generated</small>
                    <h2>{{metrics.totalMatches}}</h2>
                    <span class="small text-muted" style="font-size: 11px;">{{metrics.jobsProcessed}} Jobs &bull; {{metrics.candidatesEvaluated}} Talent</span>
                </div>
                <i class="fa-solid fa-code-compare stat-icon"></i>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="stat-card stat-green">
                <div>
                    <small>Average Compatibility</small>
                    <h2>{{metrics.averageCompatibility}}%</h2>
                    <span class="small text-success" style="font-size: 11px;">{{metrics.highTierMatches}} High Compatibility matches</span>
                </div>
                <i class="fa-solid fa-gauge-high stat-icon"></i>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="stat-card stat-blue">
                <div>
                    <small>Talent Recommendations</small>
                    <h2>{{metrics.totalRecommendations}}</h2>
                    <span class="small text-muted" style="font-size: 11px;">{{metrics.recommendationEngagement.saved}} Saved &bull; {{metrics.recommendationEngagement.dismissed}} Dismissed</span>
                </div>
                <i class="fa-solid fa-wand-magic-sparkles stat-icon"></i>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="stat-card stat-yellow">
                <div>
                    <small>AI Success Rate</small>
                    <h2>{{metrics.operational.aiSuccessRate}}%</h2>
                    <span class="small text-muted" style="font-size: 11px;">{{metrics.operational.averageLatencyMs}}ms avg latency</span>
                </div>
                <i class="fa-solid fa-bolt stat-icon"></i>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">

        <!-- OPERATIONAL HEALTH & FALLBACK MONITORING -->
        <div class="col-lg-6">
            <div class="card p-4 border-0 shadow-sm h-100" style="border-radius: 16px;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold m-0"><i class="fa-solid fa-heart-pulse text-danger me-2"></i> Engine Operational Telemetry</h5>
                    <span class="badge bg-success-subtle text-success">Online &amp; Stable</span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <div class="p-3 bg-light rounded border">
                            <span class="text-muted small d-block">Cache Hit Rate</span>
                            <h4 class="fw-bold m-0 text-primary">{{metrics.operational.cacheHitRate}}%</h4>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 bg-light rounded border">
                            <span class="text-muted small d-block">Hard Req Pass Rate</span>
                            <h4 class="fw-bold m-0 text-success">{{metrics.hardRequirementPassRate}}%</h4>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 bg-light rounded border">
                            <span class="text-muted small d-block">Fallback Rate</span>
                            <h4 class="fw-bold m-0 text-warning">{{metrics.operational.fallbackRate}}%</h4>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 bg-light rounded border">
                            <span class="text-muted small d-block">Engine Uptime</span>
                            <h4 class="fw-bold m-0 text-dark">{{failureStats.uptimePercentage}}%</h4>
                        </div>
                    </div>
                </div>

                <div class="alert alert-info border-0 small mb-0" style="border-radius: 12px;">
                    <i class="fa-solid fa-shield-halved me-1"></i>
                    <strong>Deterministic Fallback Protection:</strong> In the event of AI engine latency or remote rate limits, the system automatically falls back to rule-based qualification matching. Core jobs &amp; recommendations never fail.
                </div>
            </div>
        </div>

        <!-- AI FAILURE & ERROR CATEGORIZATION (REQ 16) -->
        <div class="col-lg-6">
            <div class="card p-4 border-0 shadow-sm h-100" style="border-radius: 16px;">
                <h5 class="fw-bold mb-3"><i class="fa-solid fa-triangle-exclamation text-warning me-2"></i> Failure &amp; Error Monitoring</h5>

                <div class="table-responsive">
                    <table class="table table-sm align-middle small mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Category</th>
                                <th>Occurrences</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Successful Evaluations</td>
                                <td><strong>{{failureStats.successful}}</strong></td>
                                <td><span class="badge bg-success">Nominal</span></td>
                            </tr>
                            <tr>
                                <td>Deterministic Fallback Invocations</td>
                                <td><strong>{{failureStats.deterministicFallback}}</strong></td>
                                <td><span class="badge bg-warning text-dark">Active Safeguard</span></td>
                            </tr>
                            <tr>
                                <td>Network Timeouts</td>
                                <td><strong>{{failureStats.timeout}}</strong></td>
                                <td><span class="badge bg-secondary">Handled</span></td>
                            </tr>
                            <tr>
                                <td>Invalid Output / Schema Retries</td>
                                <td><strong>{{failureStats.invalidOutput}}</strong></td>
                                <td><span class="badge bg-secondary">Recovered</span></td>
                            </tr>
                            <tr>
                                <td>Rate Limit Throttles</td>
                                <td><strong>{{failureStats.rateLimited}}</strong></td>
                                <td><span class="badge bg-info">Auto-Backoff</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="mt-3 text-end">
                    <span class="text-muted small">Total Requests Monitored: {{failureStats.requestsProcessed}}</span>
                </div>
            </div>
        </div>

    </div>

    <!-- MODEL & ARCHITECTURE VERSION REGISTRY (REQ 15) -->
    <div class="card p-4 border-0 shadow-sm mb-4" style="border-radius: 16px;">
        <h5 class="fw-bold mb-3"><i class="fa-solid fa-server text-primary me-2"></i> Model &amp; Engine Version Registry</h5>
        <div class="row g-3 small">
            <div class="col-md-3">
                <div class="p-3 bg-light rounded border">
                    <span class="text-muted d-block">Matching Engine</span>
                    <strong class="text-dark">{{modelVersions.matchingEngineVersion}}</strong>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 bg-light rounded border">
                    <span class="text-muted d-block">Career Engine</span>
                    <strong class="text-dark">{{modelVersions.careerEngineVersion}}</strong>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 bg-light rounded border">
                    <span class="text-muted d-block">Taxonomy Version</span>
                    <strong class="text-dark">{{modelVersions.taxonomyVersion}}</strong>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 bg-light rounded border">
                    <span class="text-muted d-block">Active Weights Profile</span>
                    <strong class="text-primary">{{config.version}} ({{config.updatedBy}})</strong>
                </div>
            </div>
        </div>
    </div>

</div>
