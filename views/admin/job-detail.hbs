<script>
let rejectModal, suspendModal, unpublishModal, closeModal, flagModal;

document.addEventListener('DOMContentLoaded', () => {
    if (window.bootstrap) {
        const rEl = document.getElementById('rejectJobModal');
        if (rEl) rejectModal = new bootstrap.Modal(rEl);
        const sEl = document.getElementById('suspendJobModal');
        if (sEl) suspendModal = new bootstrap.Modal(sEl);
        const uEl = document.getElementById('unpublishJobModal');
        if (uEl) unpublishModal = new bootstrap.Modal(uEl);
        const cEl = document.getElementById('closeJobModal');
        if (cEl) closeModal = new bootstrap.Modal(cEl);
        const fEl = document.getElementById('flagJobModal');
        if (fEl) flagModal = new bootstrap.Modal(fEl);
    }
});

async function approveJob(id, title, btn) {
    const confirmRes = await Swal.fire({
        title: 'Approve & Publish?',
        text: `Approve and publish job opportunity "${title}"?`,
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#198754',
        confirmButtonText: 'Yes, Approve'
    });
    if (!confirmRes.isConfirmed) return;

    const resetBtn = (window.zeitnahSetSubmitting && btn) ? window.zeitnahSetSubmitting(btn, 'Approving...') : () => {};

    try {
        const res = await fetch(`/admin/jobs/${id}/approve`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }
        });
        const json = await res.json();
        if (json.success) {
            Swal.fire({ icon: 'success', title: 'Job Approved', text: json.message, timer: 1500, showConfirmButton: false });
            setTimeout(() => window.location.reload(), 1500);
        } else {
            resetBtn();
            Swal.fire({ icon: 'error', title: 'Approval Failed', text: json.message });
        }
    } catch(err) {
        resetBtn();
        Swal.fire({ icon: 'error', title: 'Error', text: err.message });
    }
}

function openRejectModal(id, title) {
    document.getElementById('rejectJobId').value = id;
    document.getElementById('rejectJobTitle').innerText = title;
    document.getElementById('rejectReason').value = '';
    if (rejectModal) rejectModal.show();
}

async function submitReject(e) {
    e.preventDefault();
    const id = document.getElementById('rejectJobId').value;
    const reason = document.getElementById('rejectReason').value;
    const submitBtn = e.target.querySelector('button[type="submit"]');
    const resetBtn = window.zeitnahSetSubmitting ? window.zeitnahSetSubmitting(submitBtn, 'Rejecting...') : () => {};

    try {
        const res = await fetch(`/admin/jobs/${id}/reject`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ reason })
        });
        const json = await res.json();
        if (json.success) {
            Swal.fire({ icon: 'success', title: 'Job Rejected', text: json.message, timer: 1500, showConfirmButton: false });
            setTimeout(() => window.location.reload(), 1500);
        } else {
            resetBtn();
            Swal.fire({ icon: 'error', title: 'Rejection Failed', text: json.message });
        }
    } catch(err) {
        resetBtn();
        Swal.fire({ icon: 'error', title: 'Error', text: err.message });
    }
}

