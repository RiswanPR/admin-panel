<div class="container-fluid dashboard-wrapper">

  <!-- PAGE HEADER -->
  <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
    <div>
      <div class="d-flex align-items-center gap-2 mb-1">
        <span class="badge bg-danger-subtle text-danger border px-2.5 py-1 rounded-pill" style="font-size: 11px; font-weight: 700;">
          <i class="fa-solid fa-triangle-exclamation me-1"></i> Telemetry &amp; Diagnostics
        </span>
        <h2 class="fw-bold m-0" style="color: var(--text); font-size: 24px; letter-spacing: -0.5px;">System Error Reports</h2>
      </div>
      <p class="text-muted m-0" style="font-size: 13.5px;">
        Classified diagnostic exceptions with secret scrubbing, signature deduplication, and affected user tracking.
      </p>
    </div>

    <div class="d-flex align-items-center gap-2">
      {{> admin/view-toggle section="error-reports" total=total itemLabel="error signatures" viewMode=viewMode}}
    </div>
  </div>

  <!-- ERROR SUMMARY STATS -->
  <div class="row g-3 mb-4">
    <div class="col-xl-2 col-md-4 col-6">
      <div class="p-3 bg-surface border rounded-3 h-100 shadow-xs">
        <span class="text-muted small d-block">Total Signatures</span>
        <h4 class="fw-bold m-0 mt-1" style="color: var(--text);">{{stats.total}}</h4>
      </div>
    </div>
    <div class="col-xl-2 col-md-4 col-6">
      <div class="p-3 bg-surface border rounded-3 h-100 shadow-xs">
        <span class="text-danger small d-block"><i class="fa-solid fa-bug me-1"></i> Application Failures</span>
        <h4 class="fw-bold m-0 mt-1 text-danger">{{stats.application}}</h4>
      </div>
    </div>
    <div class="col-xl-2 col-md-4 col-6">
      <div class="p-3 bg-surface border rounded-3 h-100 shadow-xs">
        <span class="text-warning small d-block"><i class="fa-solid fa-wifi me-1"></i> Network &amp; API</span>
        <h4 class="fw-bold m-0 mt-1 text-warning">{{stats.network}}</h4>
      </div>
    </div>
    <div class="col-xl-2 col-md-4 col-6">
      <div class="p-3 bg-surface border rounded-3 h-100 shadow-xs">
        <span class="text-info small d-block"><i class="fa-solid fa-user-shield me-1"></i> User / Auth Actions</span>
        <h4 class="fw-bold m-0 mt-1 text-info">{{stats.userAction}}</h4>
      </div>
    </div>
    <div class="col-xl-2 col-md-4 col-6">
      <div class="p-3 bg-surface border rounded-3 h-100 shadow-xs">
        <span class="text-danger small d-block"><i class="fa-solid fa-circle-exclamation me-1"></i> Unresolved</span>
        <h4 class="fw-bold m-0 mt-1 text-danger">{{stats.unresolved}}</h4>
      </div>
    </div>
    <div class="col-xl-2 col-md-4 col-6">
      <div class="p-3 bg-surface border rounded-3 h-100 shadow-xs">
        <span class="text-success small d-block"><i class="fa-solid fa-circle-check me-1"></i> Resolved</span>
        <h4 class="fw-bold m-0 mt-1 text-success">{{stats.resolved}}</h4>
      </div>
    </div>
  </div>

  <!-- TOOLBAR & FILTERS -->
  <div class="admin-toolbar-container">
    <div class="toolbar-left">
      <form action="/admin/error-reports" method="GET" class="toolbar-search-form" role="search">
        {{#if viewMode}}<input type="hidden" name="view" value="{{viewMode}}">{{/if}}
        {{#if filters.category}}<input type="hidden" name="category" value="{{filters.category}}">{{/if}}
        {{#if filters.status}}<input type="hidden" name="status" value="{{filters.status}}">{{/if}}
        <div class="toolbar-search-box">
          <i class="fa-solid fa-magnifying-glass search-icon"></i>
          <input type="text" name="search" value="{{filters.search}}" class="toolbar-search-input" placeholder="Search error message, route, category..." aria-label="Search error reports">
          {{#if filters.search}}
          <a href="/admin/error-reports{{#if viewMode}}?view={{viewMode}}{{/if}}" class="search-clear-btn" title="Clear search">
            <i class="fa-solid fa-xmark"></i>
          </a>
          {{/if}}
        </div>
        <button type="submit" class="admin-btn admin-btn-secondary">Search</button>
      </form>
    </div>

    <div class="toolbar-right">
      <!-- Status Pills Filter -->
      <div class="d-flex align-items-center gap-1.5 flex-wrap">
        <a href="?status=all{{#if viewMode}}&view={{viewMode}}{{/if}}{{#if filters.category}}&category={{filters.category}}{{/if}}{{#if filters.search}}&search={{filters.search}}{{/if}}" 
           class="admin-btn admin-btn-sm {{#ifEquals filters.status 'all'}}admin-btn-primary{{else}}admin-btn-outline{{/ifEquals}}" style="min-height: 34px; padding: 4px 10px; font-size: 12px;">All</a>
        <a href="?status=UNRESOLVED{{#if viewMode}}&view={{viewMode}}{{/if}}{{#if filters.category}}&category={{filters.category}}{{/if}}{{#if filters.search}}&search={{filters.search}}{{/if}}" 
           class="admin-btn admin-btn-sm {{#ifEquals filters.status 'UNRESOLVED'}}admin-btn-primary{{else}}admin-btn-outline{{/ifEquals}}" style="min-height: 34px; padding: 4px 10px; font-size: 12px;">Unresolved</a>
        <a href="?status=INVESTIGATING{{#if viewMode}}&view={{viewMode}}{{/if}}{{#if filters.category}}&category={{filters.category}}{{/if}}{{#if filters.search}}&search={{filters.search}}{{/if}}" 
           class="admin-btn admin-btn-sm {{#ifEquals filters.status 'INVESTIGATING'}}admin-btn-primary{{else}}admin-btn-outline{{/ifEquals}}" style="min-height: 34px; padding: 4px 10px; font-size: 12px;">Investigating</a>
        <a href="?status=RESOLVED{{#if viewMode}}&view={{viewMode}}{{/if}}{{#if filters.category}}&category={{filters.category}}{{/if}}{{#if filters.search}}&search={{filters.search}}{{/if}}" 
           class="admin-btn admin-btn-sm {{#ifEquals filters.status 'RESOLVED'}}admin-btn-primary{{else}}admin-btn-outline{{/ifEquals}}" style="min-height: 34px; padding: 4px 10px; font-size: 12px;">Resolved</a>
      </div>

      <!-- Category Filter Dropdown -->
      <form action="/admin/error-reports" method="GET" class="d-inline-flex align-items-center">
        {{#if viewMode}}<input type="hidden" name="view" value="{{viewMode}}">{{/if}}
        {{#if filters.status}}<input type="hidden" name="status" value="{{filters.status}}">{{/if}}
        <select name="category" class="form-select form-select-sm" onchange="this.form.submit()" style="background: var(--surface-2); border-color: var(--border); color: var(--text); min-height: 36px; border-radius: 9px; font-size: 12.5px;">
          <option value="all" {{#ifEquals filters.category 'all'}}selected{{/ifEquals}}>All Categories</option>
          <option value="application" {{#ifEquals filters.category 'application'}}selected{{/ifEquals}}>Application</option>
          <option value="network" {{#ifEquals filters.category 'network'}}selected{{/ifEquals}}>Network</option>
          <option value="user action" {{#ifEquals filters.category 'user action'}}selected{{/ifEquals}}>User Action</option>
          <option value="recoverable" {{#ifEquals filters.category 'recoverable'}}selected{{/ifEquals}}>Recoverable</option>
          <option value="expected" {{#ifEquals filters.category 'expected'}}selected{{/ifEquals}}>Expected</option>
          <option value="websocket" {{#ifEquals filters.category 'websocket'}}selected{{/ifEquals}}>WebSocket</option>
        </select>
      </form>
    </div>
  </div>

  {{#if records.length}}

    {{!-- 1. CARD VIEW (DEFAULT) --}}
    <div id="view-card-error-reports" class="admin-view-panel {{#ifEquals viewMode 'table'}}d-none{{/ifEquals}}">
      <div class="admin-card-grid">
        {{#each records}}
        <div class="admin-governance-card {{#if this.isApplicationCritical}}border-danger{{/if}}">
          <div class="admin-card-header">
            <div class="d-flex align-items-center gap-2.5">
              <div class="p-2 rounded-2 {{#if this.isApplicationCritical}}bg-danger text-white{{else}}bg-surface-2 text-warning{{/if}}" style="font-size: 16px;">
                <i class="fa-solid fa-triangle-exclamation"></i>
              </div>
              <div>
                <span class="badge {{#if this.isApplicationCritical}}bg-danger-subtle text-danger{{else}}bg-surface-2 text-muted{{/if}} border" style="font-size: 10.5px; font-weight: 700;">
                  {{this.category}}
                </span>
                <span class="badge bg-surface-2 text-dark border ms-1" style="font-size: 10.5px;">
                  HTTP {{this.statusCode}}
                </span>
              </div>
            </div>
            <div>
              {{> admin/admin-status-badge status=this.status}}
            </div>
          </div>

          <div class="admin-card-body p-3 flex-grow-1">
            <div class="d-flex align-items-center gap-2 mb-2">
              <span class="badge bg-dark text-light" style="font-family: monospace; font-size: 11px;">{{this.method}}</span>
              <code style="font-size: 12px; color: var(--text); word-break: break-all;">{{this.route}}</code>
            </div>

            <p class="mb-3 text-dark fw-semibold" style="font-size: 13px; line-height: 1.45;">
              {{this.message}}
            </p>

            <div class="bg-surface-2 p-2.5 rounded-2 border" style="font-size: 12px;">
              <div class="d-flex justify-content-between mb-1">
                <span class="text-muted"><i class="fa-solid fa-repeat me-1"></i> Frequency:</span>
                <strong style="color: var(--text);">{{this.frequency}} occurrences</strong>
              </div>
              <div class="d-flex justify-content-between mb-1">
                <span class="text-muted"><i class="fa-solid fa-users me-1"></i> Affected Users:</span>
                <strong style="color: var(--text);">{{this.affectedUsersCount}} user(s)</strong>
              </div>
              <div class="d-flex justify-content-between">
                <span class="text-muted"><i class="fa-solid fa-clock me-1"></i> Last Seen:</span>
                <span style="color: var(--text);">{{this.relativeTime}}</span>
              </div>
            </div>
          </div>

          <div class="admin-card-footer p-3 border-top d-flex align-items-center justify-content-between gap-2">
            <button type="button" class="admin-btn admin-btn-outline" style="min-height: 36px; padding: 6px 12px; font-size: 12px;" onclick="viewErrorDetails('{{this._id}}', '{{this.method}}', '{{this.route}}', '{{this.category}}', '{{this.statusCode}}', '{{this.frequency}}', '{{this.relativeTime}}', '{{this.status}}', {{json this.stack}})">
              <i class="fa-solid fa-code"></i>
              <span>Stack Info</span>
            </button>

            <div class="d-flex align-items-center gap-1.5">
              <form action="/admin/error-reports/{{this._id}}/status" method="POST" class="d-inline">
                {{#ifEquals this.status 'UNRESOLVED'}}
                <input type="hidden" name="status" value="INVESTIGATING">
                <button type="submit" class="admin-btn admin-btn-sm admin-btn-secondary" style="min-height: 36px; font-size: 12px;">
                  <span>Investigate</span>
                </button>
                {{else ifEquals this.status 'INVESTIGATING'}}
                <input type="hidden" name="status" value="RESOLVED">
                <button type="submit" class="admin-btn admin-btn-sm admin-btn-primary" style="min-height: 36px; font-size: 12px;">
                  <i class="fa-solid fa-check"></i>
                  <span>Resolve</span>
                </button>
                {{else}}
                <input type="hidden" name="status" value="UNRESOLVED">
                <button type="submit" class="admin-btn admin-btn-sm admin-btn-outline" style="min-height: 36px; font-size: 12px;">
                  <span>Reopen</span>
                </button>
                {{/ifEquals}}
              </form>
            </div>
          </div>
        </div>
        {{/each}}
      </div>
    </div>

    {{!-- 2. TABLE VIEW --}}
    <div id="view-table-error-reports" class="admin-view-panel {{#unless (eq viewMode 'table')}}d-none{{/unless}}">
      <div class="admin-table-container">
        <div class="admin-table-responsive">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Category</th>
                <th>Status</th>
                <th>Route / Method</th>
                <th>Error Message</th>
                <th>Frequency</th>
                <th>Affected Users</th>
                <th>Last Seen</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              {{#each records}}
              <tr>
                <td>
                  <span class="badge {{#if this.isApplicationCritical}}bg-danger text-white{{else}}bg-surface-2 text-dark border{{/if}}" style="font-size: 11px;">
                    {{this.category}}
                  </span>
                </td>
                <td>
                  {{> admin/admin-status-badge status=this.status}}
                </td>
                <td>
                  <span class="badge bg-dark text-light me-1" style="font-family: monospace; font-size: 10px;">{{this.method}}</span>
                  <code style="font-size: 12px;">{{truncate this.route 30}}</code>
                </td>
                <td>
                  <span class="text-dark fw-semibold" style="font-size: 12.5px;">{{truncate this.message 60}}</span>
                </td>
                <td>
                  <span class="badge bg-surface-2 text-dark border" style="font-size: 11px;">{{this.frequency}}x</span>
                </td>
                <td>
                  <span style="font-size: 12.5px;">{{this.affectedUsersCount}}</span>
                </td>
                <td class="text-muted" style="font-size: 12px;">
                  {{this.relativeTime}}
                </td>
                <td class="text-end">
                  <div class="d-inline-flex align-items-center gap-1.5">
                    <button type="button" class="btn btn-sm btn-outline-secondary" title="View Stack Trace" onclick="viewErrorDetails('{{this._id}}', '{{this.method}}', '{{this.route}}', '{{this.category}}', '{{this.statusCode}}', '{{this.frequency}}', '{{this.relativeTime}}', '{{this.status}}', {{json this.stack}})">
                      <i class="fa-solid fa-code"></i>
                    </button>
                    <form action="/admin/error-reports/{{this._id}}/status" method="POST" class="d-inline">
                      {{#ifEquals this.status 'RESOLVED'}}
                      <input type="hidden" name="status" value="UNRESOLVED">
                      <button type="submit" class="btn btn-sm btn-outline-warning" title="Reopen Error">
                        <i class="fa-solid fa-rotate-left"></i>
                      </button>
                      {{else}}
                      <input type="hidden" name="status" value="RESOLVED">
                      <button type="submit" class="btn btn-sm btn-outline-success" title="Mark Resolved">
                        <i class="fa-solid fa-check"></i>
                      </button>
                      {{/ifEquals}}
                    </form>
                  </div>
                </td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- PAGINATION -->
    {{> admin/admin-pagination totalPages=totalPages page=page total=total viewMode=viewMode filters=filters}}

  {{else}}
    {{> admin/admin-empty-state icon="fa-solid fa-circle-check" title="No error reports found" message="All application and network telemetry is clear. No active error signatures match your filter criteria." actionUrl="/admin/error-reports" actionLabel="Clear Filters"}}
  {{/if}}

</div>

<!-- STACK TRACE & DIAGNOSTICS MODAL -->
<div class="admin-modal-backdrop" id="errorDetailModal" style="display: none;">
  <div class="admin-modal-container admin-modal-lg">
    <div class="admin-modal-header">
      <div class="admin-modal-title-group">
        <i class="fa-solid fa-bug modal-title-icon text-danger"></i>
        <div>
          <h3 class="admin-modal-title" id="errModalTitle">Diagnostic Error Details</h3>
          <p class="admin-modal-subtitle" id="errModalSubtitle"></p>
        </div>
      </div>
      <button type="button" class="admin-modal-close-btn" onclick="closeErrorModal()">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <div class="admin-modal-body">
      <div class="row g-2 mb-3">
        <div class="col-md-3">
          <div class="p-2 bg-surface-2 rounded border">
            <small class="text-muted d-block" style="font-size: 11px;">Category</small>
            <strong id="errModalCategory" style="font-size: 13px;"></strong>
          </div>
        </div>
        <div class="col-md-3">
          <div class="p-2 bg-surface-2 rounded border">
            <small class="text-muted d-block" style="font-size: 11px;">HTTP Status</small>
            <strong id="errModalStatusCode" style="font-size: 13px;"></strong>
          </div>
        </div>
        <div class="col-md-3">
          <div class="p-2 bg-surface-2 rounded border">
            <small class="text-muted d-block" style="font-size: 11px;">Occurrences</small>
            <strong id="errModalFrequency" style="font-size: 13px;"></strong>
          </div>
        </div>
        <div class="col-md-3">
          <div class="p-2 bg-surface-2 rounded border">
            <small class="text-muted d-block" style="font-size: 11px;">Status</small>
            <strong id="errModalStatus" style="font-size: 13px;"></strong>
          </div>
        </div>
      </div>

      <div class="mb-3">
        <label class="form-label fw-bold" style="font-size: 12.5px;">Endpoint Route</label>
        <div class="p-2 bg-surface-2 rounded border">
          <code id="errModalRoute" style="font-size: 12.5px; word-break: break-all;"></code>
        </div>
      </div>

      <div>
        <div class="d-flex align-items-center justify-content-between mb-1.5">
          <label class="form-label fw-bold m-0" style="font-size: 12.5px;">Scrubbed Stack Trace</label>
          <span class="badge bg-success-subtle text-success border" style="font-size: 10px;">
            <i class="fa-solid fa-shield-check me-1"></i> Secrets Scrubbed
          </span>
        </div>
        <pre id="errModalStack" class="p-3 bg-dark text-light rounded-3" style="font-size: 11.5px; font-family: monospace; max-height: 280px; overflow-y: auto; white-space: pre-wrap; line-height: 1.5;"></pre>
      </div>
    </div>

    <div class="admin-modal-footer">
      <form id="errModalActionForm" method="POST" class="me-auto">
        <input type="hidden" name="status" id="errModalNewStatus" value="RESOLVED">
        <button type="submit" class="admin-btn admin-btn-primary" id="errModalSubmitBtn">
          <i class="fa-solid fa-check"></i>
          <span>Mark Resolved</span>
        </button>
      </form>
      <button type="button" class="admin-btn admin-btn-secondary" onclick="closeErrorModal()">Close</button>
    </div>
  </div>
</div>

<script>
  function viewErrorDetails(id, method, route, category, statusCode, frequency, relativeTime, status, stack) {
    const modal = document.getElementById('errorDetailModal');
    document.getElementById('errModalTitle').textContent = method + ' ' + (route || '');
    document.getElementById('errModalSubtitle').textContent = 'Last seen ' + relativeTime + ' • ' + frequency + ' total event(s)';
    document.getElementById('errModalCategory').textContent = category;
    document.getElementById('errModalStatusCode').textContent = 'HTTP ' + statusCode;
    document.getElementById('errModalFrequency').textContent = frequency + 'x';
    document.getElementById('errModalStatus').textContent = status;
    document.getElementById('errModalRoute').textContent = method + ' ' + route;
    document.getElementById('errModalStack').textContent = stack || 'No detailed stack trace available for this event.';

    const form = document.getElementById('errModalActionForm');
    const newStatusInput = document.getElementById('errModalNewStatus');
    const submitBtn = document.getElementById('errModalSubmitBtn');

    form.action = '/admin/error-reports/' + id + '/status';
    if (status === 'RESOLVED') {
      newStatusInput.value = 'UNRESOLVED';
      submitBtn.className = 'admin-btn admin-btn-outline';
      submitBtn.innerHTML = '<i class="fa-solid fa-rotate-left"></i><span>Reopen Error</span>';
    } else {
      newStatusInput.value = 'RESOLVED';
      submitBtn.className = 'admin-btn admin-btn-primary';
      submitBtn.innerHTML = '<i class="fa-solid fa-check"></i><span>Mark Resolved</span>';
    }

    modal.style.display = 'flex';
  }

  function closeErrorModal() {
    document.getElementById('errorDetailModal').style.display = 'none';
  }
</script>
