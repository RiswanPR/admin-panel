<div class="admin-content-container">
    <!-- BREADCRUMBS & TOP BAR -->
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                {{#each breadcrumb}}
                {{#if url}}
                <li class="breadcrumb-item"><a href="{{url}}" class="text-decoration-none">{{label}}</a></li>
                {{else}}
                <li class="breadcrumb-item active" aria-current="page">{{label}}</li>
                {{/if}}
                {{/each}}
            </ol>
        </nav>
        <div class="d-flex gap-2">
            <a href="/admin/community/reports" class="btn btn-outline-secondary btn-sm">
                <i class="fa-solid fa-arrow-left me-1"></i> Back to Reports Center
            </a>
        </div>
    </div>

    <!-- REPORT TITLE HEADER -->
    <div class="admin-dossier-header mb-4 p-4 rounded-3 border bg-light d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-secondary text-uppercase" style="font-size: 12px;">{{report.entityType}}</span>
                <span class="badge bg-danger-subtle text-danger border border-danger-subtle text-uppercase fw-semibold" style="font-size: 12px;">
                    <i class="fa-solid fa-shield-halved me-1"></i>{{report.reason}}
                </span>
                {{#if report.isPending}}
                <span class="badge bg-warning text-dark"><i class="fa-regular fa-clock me-1"></i>PENDING REVIEW</span>
                {{else}}
                {{#if report.isResolved}}
                <span class="badge bg-success"><i class="fa-solid fa-check me-1"></i>RESOLVED</span>
                {{else}}
                {{#if report.isDismissed}}
                <span class="badge bg-secondary"><i class="fa-solid fa-ban me-1"></i>DISMISSED</span>
                {{else}}
                <span class="badge bg-info text-dark"><i class="fa-solid fa-magnifying-glass me-1"></i>REVIEWED</span>
                {{/if}}
                {{/if}}
                {{/if}}
            </div>
            <h1 class="h4 fw-bold mb-0">Report #{{report._id}}</h1>
            <div class="text-muted small mt-1">
                Filed on {{report.createdAt}} &bull; Last updated {{report.updatedAt}}
            </div>
        </div>

        <!-- TOP ACTIONS -->
        <div class="d-flex gap-2">
            {{#if report.isPending}}
            {{#if canModerateContent}}
            <button type="button" class="btn btn-success btn-sm" onclick="openResolveModal()">
                <i class="fa-solid fa-check me-1"></i> Mark Resolved
            </button>
            <button type="button" class="btn btn-outline-danger btn-sm" onclick="openDismissModal()">
                <i class="fa-solid fa-ban me-1"></i> Dismiss Report
            </button>
            {{/if}}
            {{/if}}
        </div>
    </div>

    <div class="row g-4">
        <!-- LEFT COLUMN: REPORT DETAILS & AUDIT -->
        <div class="col-lg-7 col-12">
            <!-- REPORT DESCRIPTION -->
            <div class="admin-governance-card mb-4">
                <div class="admin-card-header d-flex align-items-center">
                    <i class="fa-solid fa-comment-dots text-primary me-2"></i>
                    <h5 class="mb-0 fs-6 fw-bold">Report Narrative & Reason</h5>
                </div>
                <div class="admin-card-body">
                    <div class="mb-3">
                        <label class="text-muted small text-uppercase fw-bold d-block">Violation Category</label>
                        <div class="fs-6 fw-semibold text-danger text-uppercase">{{report.reason}}</div>
                    </div>

                    <div class="mb-3">
                        <label class="text-muted small text-uppercase fw-bold d-block">Reporter Explanation</label>
                        {{#if report.description}}
                        <div class="p-3 bg-light rounded border text-secondary" style="white-space: pre-wrap;">
                            {{report.description}}
                        </div>
                        {{else}}
                        <div class="text-muted fst-italic">No additional text description provided by reporter.</div>
                        {{/if}}
                    </div>
                </div>
            </div>

            <!-- REPORTER DOSSIER -->
            <div class="admin-governance-card mb-4">
                <div class="admin-card-header d-flex align-items-center">
                    <i class="fa-solid fa-user-shield text-info me-2"></i>
                    <h5 class="mb-0 fs-6 fw-bold">Reporter Profile</h5>
                </div>
                <div class="admin-card-body">
                    <div class="d-flex align-items-center gap-3">
                        <div class="admin-avatar-placeholder bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 48px; height: 48px; font-size: 18px;">
                            {{#if report.reporter.name}}{{report.reporter.name.[0]}}{{else}}U{{/if}}
                        </div>
                        <div>
                            <div class="fw-bold fs-6">{{report.reporter.name}}</div>
                            <div class="text-muted small">@{{report.reporter.username}} &bull; ID: <code>{{report.reporter._id}}</code></div>
                            <div class="text-muted small mt-1">
                                <span class="badge bg-light text-dark border">Role: {{report.reporter.role}}</span>
                                <span class="badge bg-secondary-subtle text-secondary ms-1">Total Reports Filed: {{report.reporterTotalReports}}</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- RESOLUTION & MODERATOR NOTES -->
            <div class="admin-governance-card mb-4">
                <div class="admin-card-header d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center">
                        <i class="fa-solid fa-clipboard-check text-success me-2"></i>
                        <h5 class="mb-0 fs-6 fw-bold">Resolution & Moderator Notes</h5>
                    </div>
                    {{#if report.moderatorName}}
                    <span class="badge bg-light text-dark border">Handled by: {{report.moderatorName}}</span>
                    {{/if}}
                </div>
                <div class="admin-card-body">
                    {{#if report.resolvedAt}}
                    <div class="row g-2 mb-3">
                        <div class="col-sm-6">
                            <label class="text-muted small text-uppercase fw-bold d-block">Resolution Date</label>
                            <div class="small fw-semibold">{{report.resolvedAt}}</div>
                        </div>
                        <div class="col-sm-6">
                            <label class="text-muted small text-uppercase fw-bold d-block">Action Recorded</label>
                            <div class="small fw-semibold text-uppercase">{{report.actionTaken}}</div>
                        </div>
                    </div>
                    {{/if}}

                    <div class="mb-3">
                        <label class="text-muted small text-uppercase fw-bold d-block">Moderator Notes Trail</label>
                        {{#if report.moderatorNotes}}
                        <div class="p-3 bg-warning-subtle rounded border border-warning-subtle text-dark small" style="white-space: pre-wrap;">
                            {{report.moderatorNotes}}
                        </div>
                        {{else}}
                        <div class="text-muted small fst-italic">No moderator notes recorded yet.</div>
                        {{/if}}
                    </div>

                    <!-- APPEND NOTE FORM -->
                    {{#if canModerateContent}}
                    <form onsubmit="submitAddNote(event)" class="mt-3 pt-3 border-top">
                        <label class="form-label small fw-semibold">Append Internal Moderator Note</label>
                        <div class="input-group">
                            <input type="text" id="appendNoteInput" class="form-control form-control-sm" placeholder="Add observation, escalation notes, or context..." required>
                            <button type="submit" class="btn btn-outline-primary btn-sm" id="appendNoteBtn">
                                <i class="fa-solid fa-plus me-1"></i> Add Note
                            </button>
                        </div>
                    </form>
                    {{/if}}
                </div>
            </div>

            <!-- MODERATION LOG HISTORY -->
            {{#if report.modHistory.length}}
            <div class="admin-governance-card mb-4">
                <div class="admin-card-header d-flex align-items-center">
                    <i class="fa-solid fa-clock-rotate-left text-secondary me-2"></i>
                    <h5 class="mb-0 fs-6 fw-bold">Moderation History on Target Entity</h5>
                </div>
                <div class="admin-card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0" style="font-size: 13px;">
                            <thead class="table-light">
                                <tr>
                                    <th>Action</th>
                                    <th>Moderator</th>
                                    <th>Reason / Notes</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#each report.modHistory}}
                                <tr>
                                    <td><span class="badge bg-secondary text-uppercase">{{action}}</span></td>
                                    <td><code>{{moderatorId}}</code></td>
                                    <td>{{reason}}</td>
                                    <td class="text-muted" title="{{createdAt}}">{{createdAt}}</td>
                                </tr>
                                {{/each}}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            {{/if}}
        </div>

        <!-- RIGHT COLUMN: REPORTED ENTITY & ACTIONS -->
        <div class="col-lg-5 col-12">
            <!-- REPORTED ENTITY CARD -->
            <div class="admin-governance-card mb-4 border-2 {{#if report.targetUnavailable}}border-danger{{else}}border-primary{{/if}}">
                <div class="admin-card-header d-flex justify-content-between align-items-center bg-light">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fa-solid fa-bullseye text-danger"></i>
                        <h5 class="mb-0 fs-6 fw-bold">Reported Target</h5>
                    </div>
                    <div>
                        {{#if report.targetUnavailable}}
                        <span class="badge bg-danger">CONTENT UNAVAILABLE</span>
                        {{else}}
                        <span class="badge {{#ifEquals report.targetEntity.statusLabel 'ACTIVE'}}bg-success{{else}}bg-danger{{/ifEquals}}">
                            {{report.targetEntity.statusLabel}}
                        </span>
                        {{/if}}
                    </div>
                </div>

                <div class="admin-card-body">
                    {{#if report.targetUnavailable}}
                    <div class="alert alert-danger mb-0">
                        <i class="fa-solid fa-triangle-exclamation me-2"></i>
                        <strong>Content is no longer available.</strong>
                        <p class="mb-0 small mt-1">This {{report.entityType}} may have been deleted or the ID does not exist in collection <code>community_{{report.entityType}}s</code>.</p>
                    </div>
                    {{else}}
                    <!-- ENTITY DETAILS -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-muted small text-uppercase fw-bold">{{report.entityType}} Author</span>
                            <span class="badge bg-light text-dark border">@{{report.targetEntity.author.username}}</span>
                        </div>
                        <div class="fw-semibold">{{report.targetEntity.author.name}}</div>
                    </div>

                    <div class="mb-3">
                        <label class="text-muted small text-uppercase fw-bold d-block">Content Snapshot</label>
                        <div class="p-3 bg-light rounded border text-dark" style="white-space: pre-wrap; font-size: 14px;">
                            {{#if report.targetEntity.content}}
                            {{report.targetEntity.content}}
                            {{else}}
                            {{#if report.targetEntity.text}}
                            {{report.targetEntity.text}}
                            {{else}}
                            <span class="text-muted fst-italic">No text payload.</span>
                            {{/if}}
                            {{/if}}
                        </div>
                    </div>

                    <!-- MEDIA IF PRESENT -->
                    {{#if report.targetEntity.media}}
                    <div class="mb-3">
                        <label class="text-muted small text-uppercase fw-bold d-block">Attached Media Evidence</label>
                        <div class="d-flex gap-2 flex-wrap">
                            {{#each report.targetEntity.media}}
                            <a href="{{this.url}}" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-secondary">
                                <i class="fa-solid fa-photo-film me-1"></i> View Media
                            </a>
                            {{/each}}
                        </div>
                    </div>
                    {{/if}}

                    <div class="pt-3 border-top d-flex justify-content-between align-items-center">
                        <span class="text-muted small">Target ID: <code>{{report.entityId}}</code></span>
                        <a href="{{report.targetEntity.url}}" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary btn-sm">
                            <i class="fa-solid fa-arrow-up-right-from-square me-1"></i> Open Full Content
                        </a>
                    </div>
                    {{/if}}
                </div>
            </div>

            <!-- DIRECT CONTENT MODERATION CONTROLS (PHASE 2 INTEGRATION) -->
            {{#if (and canModerateContent (not report.targetUnavailable))}}
            <div class="admin-governance-card mb-4 border-warning">
                <div class="admin-card-header bg-warning-subtle d-flex align-items-center">
                    <i class="fa-solid fa-gavel text-warning-emphasis me-2"></i>
                    <h5 class="mb-0 fs-6 fw-bold text-warning-emphasis">Take Action on Content</h5>
                </div>
                <div class="admin-card-body">
                    <p class="small text-muted mb-3">
                        Safely moderate the reported {{report.entityType}} directly using Phase 2 soft-delete controls. All actions write to canonical audit logs.
                    </p>

                    {{#ifEquals report.entityType 'post'}}
                    <div class="d-grid gap-2">
                        {{#if report.targetEntity.isDeleted}}
                        <button type="button" class="btn btn-outline-success btn-sm" onclick="executePostAction('restore')">
                            <i class="fa-solid fa-trash-arrow-up me-1"></i> Restore Post
                        </button>
                        {{else}}
                        <button type="button" class="btn btn-outline-danger btn-sm" onclick="executePostAction('hide')">
                            <i class="fa-solid fa-eye-slash me-1"></i> Hide / Soft-Delete Post
                        </button>
                        {{/if}}

                        {{#if report.targetEntity.isLocked}}
                        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="executePostLock(false)">
                            <i class="fa-solid fa-lock-open me-1"></i> Unlock Comments
                        </button>
                        {{else}}
                        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="executePostLock(true)">
                            <i class="fa-solid fa-lock me-1"></i> Lock Comments
                        </button>
                        {{/if}}
                    </div>
                    {{/ifEquals}}

                    {{#ifEquals report.entityType 'comment'}}
                    <div class="d-grid gap-2">
                        {{#if report.targetEntity.isDeleted}}
                        <button type="button" class="btn btn-outline-success btn-sm" onclick="executeCommentAction('restore')">
                            <i class="fa-solid fa-trash-arrow-up me-1"></i> Restore Comment
                        </button>
                        {{else}}
                        <button type="button" class="btn btn-outline-danger btn-sm" onclick="executeCommentAction('delete')">
                            <i class="fa-solid fa-trash me-1"></i> Soft-Delete Comment
                        </button>
                        {{/if}}
                    </div>
                    {{/ifEquals}}

                    {{#ifEquals report.entityType 'story'}}
                    <div class="d-grid gap-2">
                        {{#if report.targetEntity.isDeleted}}
                        <button type="button" class="btn btn-outline-success btn-sm" onclick="executeStoryAction('restore')">
                            <i class="fa-solid fa-trash-arrow-up me-1"></i> Restore Story
                        </button>
                        {{else}}
                        <button type="button" class="btn btn-outline-danger btn-sm" onclick="executeStoryAction('remove')">
                            <i class="fa-solid fa-trash me-1"></i> Remove Story
                        </button>
                        {{/if}}
                    </div>
                    {{/ifEquals}}
                </div>
            </div>
            {{/if}}

            <!-- OTHER REPORTS FOR THE SAME ENTITY -->
            {{#if report.otherReportsCount}}
            <div class="admin-governance-card mb-4">
                <div class="admin-card-header d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fa-solid fa-clone text-secondary"></i>
                        <h5 class="mb-0 fs-6 fw-bold">Other Reports for this Entity</h5>
                    </div>
                    <span class="badge bg-danger">{{report.otherReportsCount}} other</span>
                </div>
                <div class="admin-card-body p-0">
                    <div class="list-group list-group-flush small">
                        {{#each report.otherReports}}
                        <a href="/admin/community/reports/{{_id}}" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            <div>
                                <span class="fw-semibold text-danger">{{reason}}</span>
                                <span class="text-muted d-block" style="font-size: 11px;">Filed: {{createdAt}}</span>
                            </div>
                            <span class="badge {{#ifEquals statusUpper 'RESOLVED'}}bg-success{{else}}{{#ifEquals statusUpper 'PENDING'}}bg-warning text-dark{{else}}bg-secondary{{/ifEquals}}{{/ifEquals}}">
                                {{statusUpper}}
                            </span>
                        </a>
                        {{/each}}
                    </div>
                </div>
            </div>
            {{/if}}
        </div>
    </div>
</div>

<!-- DISMISS MODAL -->
<div class="modal fade" id="dismissDossierModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fa-solid fa-ban text-secondary me-2"></i>Dismiss Report #{{report._id}}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to dismiss this report? The reported content will remain untouched, and the report will be marked as dismissed.</p>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Moderator Note / Rationale</label>
                    <textarea class="form-control" id="dismissDossierNotes" rows="3" placeholder="Explain why this report was dismissed..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDismissDossierBtn" onclick="submitDossierDismiss()">Dismiss Report</button>
            </div>
        </div>
    </div>
</div>

<!-- RESOLVE MODAL -->
<div class="modal fade" id="resolveDossierModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fa-solid fa-check text-success me-2"></i>Resolve Report #{{report._id}}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Mark this report as resolved. Document the actions taken for platform audit records.</p>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Action Taken</label>
                    <select class="form-select" id="resolveDossierAction">
                        <option value="content_moderated">Content Moderated / Hidden</option>
                        <option value="user_warned">User Warned</option>
                        <option value="resolved_no_action">Resolved — No Further Action Needed</option>
                        <option value="duplicate_addressed">Duplicate of Already Resolved Report</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Moderator Notes</label>
                    <textarea class="form-control" id="resolveDossierNotes" rows="3" placeholder="Document the resolution rationale for audit logs..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" id="confirmResolveDossierBtn" onclick="submitDossierResolve()">Mark Resolved</button>
            </div>
        </div>
    </div>
</div>

<script>
const reportId = '{{report._id}}';
const entityId = '{{report.entityId}}';
const entityType = '{{report.entityType}}';

function openDismissModal() {
    document.getElementById('dismissDossierNotes').value = '';
    new bootstrap.Modal(document.getElementById('dismissDossierModal')).show();
}

function submitDossierDismiss() {
    const btn = document.getElementById('confirmDismissDossierBtn');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Dismissing...';
    const notes = document.getElementById('dismissDossierNotes').value.trim();

    fetch(`/admin/community/reports/${reportId}/dismiss`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ notes })
    })
    .then(res => res.json())
    .then(data => {
        if (data.success) window.location.reload();
        else {
            alert(data.message || 'Failed to dismiss report.');
            btn.disabled = false;
            btn.innerText = 'Dismiss Report';
        }
    })
    .catch(() => {
        alert('Network error. Please try again.');
        btn.disabled = false;
        btn.innerText = 'Dismiss Report';
    });
}

function openResolveModal() {
    document.getElementById('resolveDossierNotes').value = '';
    new bootstrap.Modal(document.getElementById('resolveDossierModal')).show();
}

function submitDossierResolve() {
    const btn = document.getElementById('confirmResolveDossierBtn');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Resolving...';
    const actionTaken = document.getElementById('resolveDossierAction').value;
    const notes = document.getElementById('resolveDossierNotes').value.trim();

    fetch(`/admin/community/reports/${reportId}/resolve`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ actionTaken, notes })
    })
    .then(res => res.json())
    .then(data => {
        if (data.success) window.location.reload();
        else {
            alert(data.message || 'Failed to resolve report.');
            btn.disabled = false;
            btn.innerText = 'Mark Resolved';
        }
    })
    .catch(() => {
        alert('Network error. Please try again.');
        btn.disabled = false;
        btn.innerText = 'Mark Resolved';
    });
}

function submitAddNote(e) {
    e.preventDefault();
    const input = document.getElementById('appendNoteInput');
    const btn = document.getElementById('appendNoteBtn');
    const notes = input.value.trim();
    if (!notes) return;

    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Adding...';

    fetch(`/admin/community/reports/${reportId}/note`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ notes })
    })
    .then(res => res.json())
    .then(data => {
        if (data.success) window.location.reload();
        else {
            alert(data.message || 'Failed to add note.');
            btn.disabled = false;
            btn.innerText = 'Add Note';
        }
    })
    .catch(() => {
        alert('Network error. Please try again.');
        btn.disabled = false;
        btn.innerText = 'Add Note';
    });
}

// ── Phase 2 Direct Content Action Integration ──
function executePostAction(action) {
    if (!confirm(`Are you sure you want to ${action} this reported post?`)) return;
    fetch(`/admin/community/posts/${entityId}/${action}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ reason: `Moderated via Report #${reportId}` })
    })
    .then(res => res.json())
    .then(data => {
        if (data.success) window.location.reload();
        else alert(data.message || 'Action failed.');
    })
    .catch(() => alert('Network error.'));
}

function executePostLock(isLocked) {
    fetch(`/admin/community/posts/${entityId}/lock`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ isLocked, reason: `Comments lock toggled via Report #${reportId}` })
    })
    .then(res => res.json())
    .then(data => {
        if (data.success) window.location.reload();
        else alert(data.message || 'Action failed.');
    })
    .catch(() => alert('Network error.'));
}

function executeCommentAction(action) {
    if (!confirm(`Are you sure you want to ${action} this reported comment?`)) return;
    fetch(`/admin/community/comments/${entityId}/${action}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ reason: `Moderated via Report #${reportId}` })
    })
    .then(res => res.json())
    .then(data => {
        if (data.success) window.location.reload();
        else alert(data.message || 'Action failed.');
    })
    .catch(() => alert('Network error.'));
}

function executeStoryAction(action) {
    if (!confirm(`Are you sure you want to ${action} this reported story?`)) return;
    fetch(`/admin/community/stories/${entityId}/${action}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ reason: `Moderated via Report #${reportId}` })
    })
    .then(res => res.json())
    .then(data => {
        if (data.success) window.location.reload();
        else alert(data.message || 'Action failed.');
    })
    .catch(() => alert('Network error.'));
}
</script>
