<div class="container-fluid mt-4 mb-5">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="/admin/ai/matching">AI Matching</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Talent → Job Recommendations</li>
                </ol>
            </nav>
            <h2 class="fw-bold m-0" style="color:var(--brand);">
                <i class="fa-solid fa-wand-magic-sparkles me-2"></i> Talent → Job Recommendations Telemetry
            </h2>
            <small class="text-muted">Diagnose recommendations surfaced to infrastructure candidates, compatibility algorithms, and surfaced opportunity reasons.</small>
        </div>

        <div class="d-flex gap-2">
            <a href="/admin/ai/matching" class="btn btn-outline-secondary px-3">
                <i class="fa-solid fa-arrow-left me-1"></i> Matching Dashboard
            </a>
            <a href="/admin/ai/job-matches" class="btn btn-outline-primary px-3">
                <i class="fa-solid fa-user-check me-1"></i> Job → Talent Matches
            </a>
        </div>
    </div>

    <!-- VIEW TOGGLE -->
    {{> admin/view-toggle section="ai-recommendations" total=total itemLabel="recommendations" viewMode=viewMode}}

    <!-- CARD VIEW (DEFAULT) -->
    <div class="admin-cards-container {{#ifEquals viewMode 'table'}}d-none{{/ifEquals}}" id="ai-recommendationsCardView" data-section="ai-recommendations">
        <div class="row g-3">
            {{#if records.length}}
            {{#each records}}
            <div class="col-xl-4 col-md-6 col-12">
                <div class="admin-governance-card">
                    <div class="admin-card-header">
                        <span class="badge bg-success fw-bold">
                            {{score}}% Compatibility
                        </span>
                        <span class="admin-badge admin-badge-neutral small" style="font-size: 10px;">{{category}}</span>
                    </div>

                    <div class="admin-card-body">
                        <h4 class="admin-card-title text-truncate">
                            <span class="text-primary">{{jobTitle}}</span>
                        </h4>
                        <div class="admin-card-subtitle text-truncate">
                            <i class="fa-solid fa-layer-group me-1"></i> {{jobSector}} • {{jobDiscipline}}
                        </div>

                        <div class="admin-card-meta-list">
                            <div class="admin-card-meta-item">
                                <i class="fa-solid fa-location-dot"></i>
                                <span class="text-truncate">{{jobLocation}}</span>
                            </div>
                            {{#if matchReasons.length}}
                            <div class="admin-card-meta-item">
                                <i class="fa-solid fa-circle-check text-success"></i>
                                <span class="text-truncate text-dark">{{matchReasons.[0]}}</span>
                            </div>
                            {{/if}}
                            {{#if gapReasons.length}}
                            <div class="admin-card-meta-item">
                                <i class="fa-solid fa-triangle-exclamation text-warning"></i>
                                <span class="text-truncate text-muted">{{gapReasons.[0]}}</span>
                            </div>
                            {{/if}}
                        </div>

                        {{#if recommendationTypes.length}}
                        <div class="d-flex flex-wrap gap-1 mt-2">
                            {{#each recommendationTypes}}
                            <span class="badge bg-light text-secondary border small" style="font-size: 10px;">{{this}}</span>
                            {{/each}}
                        </div>
                        {{/if}}
                    </div>

                    <div class="admin-card-footer">
                        <span class="small text-muted" style="font-size: 11px;">
                            Model: {{modelVersion}}
                        </span>
                        <span class="small text-muted ms-auto" style="font-size: 11px;">
                            {{formatDate calculatedAt}}
                        </span>
                    </div>
                </div>
            </div>
            {{/each}}
            {{else}}
            <div class="col-12">
                <div class="admin-empty-state">
                    <div class="admin-empty-state-icon">
                        <i class="fa-solid fa-wand-magic-sparkles"></i>
                    </div>
                    <div class="admin-empty-state-title">No Recommendations Surfaced</div>
                    <p class="admin-empty-state-desc">No candidate recommendation telemetry records located.</p>
                </div>
            </div>
            {{/if}}
        </div>
    </div>

    <!-- TABLE VIEW -->
    <div class="admin-table-container {{#ifEquals viewMode 'table'}}{{else}}d-none{{/ifEquals}}" id="ai-recommendationsTableView" data-section="ai-recommendations">
        <div class="card border-0 shadow-sm" style="border-radius: 16px; overflow: hidden;">
            <div class="table-responsive mb-0">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr style="font-size: 12px; text-transform: uppercase;">
                            <th class="ps-4">Recommended Job</th>
                            <th>Sector &amp; Discipline</th>
                            <th>Location</th>
                            <th>Score</th>
                            <th>Recommendation Basis &amp; Reasons</th>
                            <th>Identified Gaps</th>
                            <th>Engine</th>
                            <th class="pe-4 text-end">Generated</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#if records.length}}
                        {{#each records}}
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold text-primary">{{jobTitle}}</div>
                                <span class="badge bg-light text-dark border small" style="font-size: 10px;">{{category}}</span>
                            </td>
                            <td>
                                <div class="small fw-semibold">{{jobSector}}</div>
                                <div class="text-muted" style="font-size: 11px;">{{jobDiscipline}}</div>
                            </td>
                            <td class="small text-muted">{{jobLocation}}</td>
                            <td>
                                <h4 class="fw-bold m-0 text-success">{{score}}%</h4>
                            </td>
                            <td>
                                {{#if matchReasons.length}}
                                <div class="small text-dark mb-1">
                                    <i class="fa-solid fa-check text-success me-1"></i> {{matchReasons.[0]}}
                                </div>
                                {{/if}}
                                {{#if recommendationTypes.length}}
                                <div class="d-flex flex-wrap gap-1">
                                    {{#each recommendationTypes}}
                                    <span class="badge bg-light text-muted border small" style="font-size: 10px;">{{this}}</span>
                                    {{/each}}
                                </div>
                                {{/if}}
                            </td>
                            <td>
                                {{#if gapReasons.length}}
                                <div class="small text-muted">
                                    <i class="fa-solid fa-triangle-exclamation text-warning me-1"></i> {{gapReasons.[0]}}
                                </div>
                                {{else}}
                                <span class="text-success small"><i class="fa-solid fa-circle-check me-1"></i> No major gaps</span>
                                {{/if}}
                            </td>
                            <td class="small text-muted">{{modelVersion}}</td>
                            <td class="pe-4 text-end small text-muted">{{formatDate calculatedAt}}</td>
                        </tr>
                        {{/each}}
                        {{else}}
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-wand-magic fa-3x mb-3 text-secondary opacity-50"></i>
                                <p class="m-0">No candidate recommendation telemetry records found.</p>
                            </td>
                        </tr>
                        {{/if}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- PAGINATION (PRESERVES VIEW STATE) -->
    {{#if (gt totalPages 1)}}
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 py-3 px-1 mt-3">
        <span class="small text-muted">Page {{page}} of {{totalPages}} ({{total}} recommendations)</span>
        <div class="d-flex gap-2">
            {{#if (gt page 1)}}
            <a href="/admin/ai/talent-recommendations?page={{dec page}}&view={{#ifEquals viewMode 'table'}}table{{else}}card{{/ifEquals}}" class="btn btn-sm btn-outline-secondary">
                <i class="fa-solid fa-chevron-left me-1"></i> Previous
            </a>
            {{/if}}
            {{#if (lt page totalPages)}}
            <a href="/admin/ai/talent-recommendations?page={{inc page}}&view={{#ifEquals viewMode 'table'}}table{{else}}card{{/ifEquals}}" class="btn btn-sm btn-outline-secondary">
                Next <i class="fa-solid fa-chevron-right ms-1"></i>
            </a>
            {{/if}}
        </div>
    </div>
    {{/if}}

</div>
