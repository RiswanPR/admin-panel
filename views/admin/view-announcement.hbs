<div class="container-fluid mt-4 mb-5">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="/announcements">Announcements</a></li>
                    <li class="breadcrumb-item active" aria-current="page">{{announcement.title}}</li>
                </ol>
            </nav>
            <div class="d-flex align-items-center gap-2">
                {{#if announcement.isCritical}}
                <span class="badge bg-danger px-3 py-2 fs-6">
                    <i class="fa-solid fa-triangle-exclamation me-1"></i> CRITICAL
                </span>
                {{/if}}
                <h2 class="fw-bold m-0" style="color:var(--brand);">{{announcement.title}}</h2>
            </div>
            <small class="text-muted">Created by {{announcement.createdByName}} ({{announcement.createdByRole}}) on {{formatDateTime announcement.createdAt}}</small>
        </div>

        <div class="d-flex gap-2">
            <a href="/announcements/{{announcement._id}}/edit" class="btn btn-outline-primary px-3">
                <i class="fa-solid fa-pen-to-square me-1"></i> Edit
            </a>
            <a href="/announcements" class="btn btn-outline-secondary px-3">
                <i class="fa-solid fa-arrow-left me-1"></i> Back to List
            </a>
        </div>
    </div>

    <div class="row g-4">
        <!-- MAIN CONTENT CARD -->
        <div class="col-lg-8">
            <div class="card p-4 p-md-5 mb-4">
                <h5 class="fw-bold mb-3" style="color:var(--brand);">
                    <i class="fa-solid fa-envelope-open-text me-2"></i> Announcement Content
                </h5>

                <div class="p-4 rounded-3" style="background: var(--surface-2); border: 1px solid var(--border); min-height: 200px; font-size: 15px; line-height: 1.7;">
                    {{{announcement.message}}}
                </div>
            </div>

            <!-- AUDIT TRAIL FOR THIS ANNOUNCEMENT -->
            <div class="card p-4">
                <h5 class="fw-bold mb-3" style="color:var(--brand);">
                    <i class="fa-solid fa-clock-rotate-left me-2"></i> Audit Trail &amp; History
                </h5>

                {{#if auditLogs.length}}
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th>Timestamp</th>
                                <th>Action</th>
                                <th>Actor</th>
                                <th>Status</th>
                                <th>Message</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each auditLogs}}
                            <tr>
                                <td class="text-nowrap"><small>{{formatDateTime this.createdAt}}</small></td>
                                <td><span class="badge bg-secondary">{{this.action}}</span></td>
                                <td><small>{{this.admin.name}}</small></td>
                                <td>
                                    <span class="badge {{#ifEquals this.status 'success'}}bg-success{{else}}bg-danger{{/ifEquals}}">
                                        {{this.status}}
                                    </span>
                                </td>
                                <td><small class="text-muted">{{this.message}}</small></td>
                            </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>
                {{else}}
                <p class="text-muted mb-0">No audit log records for this announcement yet.</p>
                {{/if}}
            </div>
        </div>

        <!-- SIDEBAR METADATA -->
        <div class="col-lg-4">
            <div class="card p-4 mb-4">
                <h6 class="fw-bold mb-3" style="color:var(--brand);">
                    <i class="fa-solid fa-circle-info me-2"></i> Announcement Details
                </h6>

                <div class="d-flex flex-column gap-3">
                    <div>
                        <small class="text-muted d-block">Status</small>
                        {{#ifEquals announcement.status 'published'}}
                            <span class="badge bg-success"><i class="fa-solid fa-check me-1"></i> Published</span>
                        {{else}}{{#ifEquals announcement.status 'scheduled'}}
                            <span class="badge bg-warning text-dark"><i class="fa-solid fa-clock me-1"></i> Scheduled</span>
                        {{else}}{{#ifEquals announcement.status 'archived'}}
                            <span class="badge bg-secondary"><i class="fa-solid fa-box-archive me-1"></i> Archived</span>
                        {{else}}
                            <span class="badge bg-light text-dark border"><i class="fa-solid fa-pen-ruler me-1"></i> Draft</span>
                        {{/ifEquals}}{{/ifEquals}}{{/ifEquals}}
                    </div>

                    <div>
                        <small class="text-muted d-block">Type</small>
                        <span class="fw-bold text-capitalize">{{announcement.type}}</span>
                    </div>

                    <div>
                        <small class="text-muted d-block">Priority</small>
                        <span class="badge {{#ifEquals announcement.priority 'critical'}}bg-danger{{else}}{{#ifEquals announcement.priority 'important'}}bg-warning text-dark{{else}}bg-secondary{{/ifEquals}}{{/ifEquals}}">
                            {{announcement.priority}}
                        </span>
                    </div>

                    <div>
                        <small class="text-muted d-block">Target Audience</small>
                        {{#ifEquals announcement.targetType 'platform'}}
                            <span class="fw-bold"><i class="fa-solid fa-globe me-1 text-primary"></i> Platform-wide</span>
                        {{else}}{{#ifEquals announcement.targetType 'course'}}
                            <span class="fw-bold"><i class="fa-solid fa-book-open me-1 text-info"></i> Course: {{announcement.courseName}}</span>
                        {{else}}{{#ifEquals announcement.targetType 'learning_space'}}
                            <span class="fw-bold"><i class="fa-solid fa-shapes me-1 text-success"></i> Space: {{announcement.learningSpaceName}}</span>
                        {{else}}{{#ifEquals announcement.targetType 'role'}}
                            <span class="fw-bold"><i class="fa-solid fa-users me-1 text-secondary"></i> Role Target</span>
                        {{else}}
                            <span class="fw-bold">{{announcement.targetType}}</span>
                        {{/ifEquals}}{{/ifEquals}}{{/ifEquals}}{{/ifEquals}}
                    </div>

                    <div>
                        <small class="text-muted d-block">Published At</small>
                        <span class="small">{{#if announcement.publishedAt}}{{formatDateTime announcement.publishedAt}}{{else}}Not published yet{{/if}}</span>
                    </div>

                    <div>
                        <small class="text-muted d-block">Scheduled For</small>
                        <span class="small">{{#if announcement.scheduledAt}}{{formatDateTime announcement.scheduledAt}}{{else}}Immediate{{/if}}</span>
                    </div>

                    <div>
                        <small class="text-muted d-block">Expires At</small>
                        <span class="small">{{#if announcement.expiresAt}}{{formatDateTime announcement.expiresAt}}{{else}}Never (manual archive){{/if}}</span>
                    </div>
                </div>
            </div>

            <!-- ACTIONS CARD -->
            <div class="card p-4">
                <h6 class="fw-bold mb-3" style="color:var(--brand);">
                    <i class="fa-solid fa-sliders me-2"></i> Actions
                </h6>

                <div class="d-grid gap-2">
                    {{#ifEquals announcement.status 'published'}}
                    <button class="btn btn-warning" onclick="unpublishThis()">
                        <i class="fa-solid fa-eye-slash me-2"></i> Unpublish to Draft
                    </button>
                    {{else}}
                    <button class="btn btn-success" onclick="publishThis({{announcement.isCritical}})">
                        <i class="fa-solid fa-upload me-2"></i> Publish Now
                    </button>
                    {{/ifEquals}}

                    <a href="/announcements/{{announcement._id}}/edit" class="btn btn-primary">
                        <i class="fa-solid fa-pen-to-square me-2"></i> Edit Announcement
                    </a>

                    <button class="btn btn-outline-danger" onclick="deleteThis()">
                        <i class="fa-solid fa-trash-can me-2"></i> Delete Announcement
                    </button>
                </div>
            </div>
        </div>
    </div>

</div>

<script>
function publishThis(isCritical) {
    const confirmText = isCritical ? 'This is a CRITICAL announcement. Publish now?' : 'Publish this announcement now?';
    Swal.fire({
        title: 'Publish Announcement?',
        text: confirmText,
        icon: isCritical ? 'warning' : 'question',
        showCancelButton: true,
        confirmButtonColor: isCritical ? '#dc3545' : '#198754',
        confirmButtonText: 'Yes, Publish'
    }).then((result) => {
        if (result.isConfirmed) {
            fetch('/announcements/{{announcement._id}}/publish', {
                method: 'POST',
                headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' }
            })
            .then(r => r.json())
            .then(d => {
                if (d.success) location.reload();
                else Swal.fire('Error', d.message, 'error');
            });
        }
    });
}

function unpublishThis() {
    Swal.fire({
        title: 'Unpublish Announcement?',
        text: 'Move this announcement back to draft state?',
        icon: 'info',
        showCancelButton: true,
        confirmButtonColor: '#f6ed4a',
        confirmButtonText: 'Yes, Unpublish'
    }).then((result) => {
        if (result.isConfirmed) {
            fetch('/announcements/{{announcement._id}}/unpublish', {
                method: 'POST',
                headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' }
            })
            .then(r => r.json())
            .then(d => {
                if (d.success) location.reload();
                else Swal.fire('Error', d.message, 'error');
            });
        }
    });
}

function deleteThis() {
    Swal.fire({
        title: 'Delete Announcement?',
        text: 'This will permanently remove this announcement.',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#dc3545',
        confirmButtonText: 'Yes, Delete'
    }).then((result) => {
        if (result.isConfirmed) {
            fetch('/announcements/{{announcement._id}}/delete', {
                method: 'POST',
                headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' }
            })
            .then(r => r.json())
            .then(d => {
                if (d.success) window.location.href = '/announcements';
                else Swal.fire('Error', d.message, 'error');
            });
        }
    });
}
</script>
