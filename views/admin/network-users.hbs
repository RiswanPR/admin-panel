<div class="container-fluid mt-4 mb-5">

    <!-- HERO HEADER -->
    <div class="hero-card mb-4" style="background: linear-gradient(135deg, rgba(18, 49, 76, 0.95), rgba(29, 78, 137, 0.9)), url('/images/banner.jpg') center/cover; padding: 32px 36px; border-radius: 24px; position: relative; overflow: hidden; box-shadow: 0 12px 32px rgba(18, 49, 76, 0.15);">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 position-relative" style="z-index: 2;">
            <div>
                <span class="badge mb-2 px-3 py-2" style="background: rgba(159, 213, 178, 0.2); color: #9fd5b2; border: 1px solid rgba(159, 213, 178, 0.35); border-radius: 30px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px;">
                    <i class="fa-solid fa-users-rays me-1"></i> Network Administration
                </span>
                <h2 class="text-white fw-bold m-0" style="font-size: 28px; letter-spacing: -0.5px;">Network Users &amp; Profiles</h2>
                <p class="text-light opacity-75 mt-2 mb-0" style="font-size: 14px;">Central directory for managing infrastructure profiles, assigning protected roles (Educator), and verifying identities.</p>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <a href="/admin/network/audit-roles" class="btn btn-warning px-3 py-2 text-dark fw-semibold">
                    <i class="fa-solid fa-shield-halved me-1"></i> Role Consistency Audit
                </a>
                <a href="/admin/network/taxonomy" class="btn btn-outline-light px-3 py-2">
                    <i class="fa-solid fa-sitemap me-1"></i> View Taxonomy
                </a>
                <a href="/admin/analytics" class="btn btn-light px-3 py-2">
                    <i class="fa-solid fa-chart-column me-1"></i> Network Analytics
                </a>
            </div>
        </div>
    </div>

    <!-- METRICS -->
    <div class="row g-4 mb-4">
        <div class="col-xl-2 col-md-4 col-6">
            <div class="stat-card stat-dark">
                <div>
                    <small>Total People</small>
                    <h2>{{stats.totalPeople}}</h2>
                </div>
                <i class="fa-solid fa-users stat-icon"></i>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-6">
            <div class="stat-card stat-green">
                <div>
                    <small>Students</small>
                    <h2>{{stats.enrolledStudents}}</h2>
                </div>
                <i class="fa-solid fa-user-graduate stat-icon"></i>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-6">
            <div class="stat-card stat-blue">
                <div>
                    <small>Registered</small>
                    <h2>{{stats.registeredOnly}}</h2>
                </div>
                <i class="fa-solid fa-user-clock stat-icon"></i>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-6">
            <div class="stat-card stat-yellow">
                <div>
                    <small>Teachers</small>
                    <h2>{{stats.totalTeachers}}</h2>
                </div>
                <i class="fa-solid fa-chalkboard-user stat-icon"></i>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-6">
            <div class="stat-card stat-dark">
                <div>
                    <small>Admins</small>
                    <h2>{{stats.totalAdmins}}</h2>
                </div>
                <i class="fa-solid fa-user-shield stat-icon"></i>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-6">
            <div class="stat-card stat-red">
                <div>
                    <small>Blocked</small>
                    <h2>{{stats.blockedCount}}</h2>
                </div>
                <i class="fa-solid fa-ban stat-icon"></i>
            </div>
        </div>
    </div>

    <!-- FILTER TOOLBAR -->
    <form class="card p-3 mb-3 border-0 shadow-sm" method="GET" action="/admin/network/users" id="userFilterForm" style="border-radius: 16px;">
        <input type="hidden" name="view" value="{{#ifEquals viewMode 'table'}}table{{else}}card{{/ifEquals}}" class="admin-view-input">
        <div class="row g-2 align-items-center">
            <div class="col-lg-3 col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                    <input type="text" class="form-control border-start-0" name="search" value="{{filters.search}}" placeholder="Search by name, @username, email...">
                </div>
            </div>

            <div class="col-lg-2 col-md-3 col-6">
                <select class="form-select" name="role" onchange="document.getElementById('userFilterForm').submit()">
                    <option value="all" {{#ifEquals filters.role 'all'}}selected{{/ifEquals}}>All Roles</option>
                    <option value="student" {{#ifEquals filters.role 'student'}}selected{{/ifEquals}}>Student</option>
                    <option value="educator" {{#ifEquals filters.role 'educator'}}selected{{/ifEquals}}>Educator (Protected)</option>
                    <option value="professional" {{#ifEquals filters.role 'professional'}}selected{{/ifEquals}}>Professional</option>
                    <option value="mentor" {{#ifEquals filters.role 'mentor'}}selected{{/ifEquals}}>Mentor</option>
                    <option value="recruiter" {{#ifEquals filters.role 'recruiter'}}selected{{/ifEquals}}>Recruiter</option>
                    <option value="founder" {{#ifEquals filters.role 'founder'}}selected{{/ifEquals}}>Founder</option>
                    <option value="teacher" {{#ifEquals filters.role 'teacher'}}selected{{/ifEquals}}>Teacher</option>
                    <option value="admin" {{#ifEquals filters.role 'admin'}}selected{{/ifEquals}}>Admin</option>
                </select>
            </div>

            <div class="col-lg-2 col-md-3 col-6">
                <select class="form-select" name="status" onchange="document.getElementById('userFilterForm').submit()">
                    <option value="all" {{#ifEquals filters.status 'all'}}selected{{/ifEquals}}>All Statuses</option>
                    <option value="active" {{#ifEquals filters.status 'active'}}selected{{/ifEquals}}>Active</option>
                    <option value="suspended" {{#ifEquals filters.status 'suspended'}}selected{{/ifEquals}}>Suspended / Blocked</option>
                    <option value="restricted" {{#ifEquals filters.status 'restricted'}}selected{{/ifEquals}}>Restricted</option>
                </select>
            </div>

            <div class="col-lg-2 col-md-3 col-6">
                <select class="form-select" name="discipline" onchange="document.getElementById('userFilterForm').submit()">
                    <option value="all">All Disciplines</option>
                    {{#each disciplines}}
                    <option value="{{this}}" {{#ifEquals ../filters.discipline this}}selected{{/ifEquals}}>{{this}}</option>
                    {{/each}}
                </select>
            </div>

            <div class="col-lg-1 col-md-3 col-6">
                <select class="form-select" name="sector" onchange="document.getElementById('userFilterForm').submit()">
                    <option value="all">Sectors</option>
                    {{#each sectors}}
                    <option value="{{this}}" {{#ifEquals ../filters.sector this}}selected{{/ifEquals}}>{{this}}</option>
                    {{/each}}
                </select>
            </div>

            <div class="col-lg-1 col-md-3 col-6">
                <select class="form-select" name="verified" onchange="document.getElementById('userFilterForm').submit()">
                    <option value="all" {{#ifEquals filters.verified 'all'}}selected{{/ifEquals}}>All Verif</option>
                    <option value="verified" {{#ifEquals filters.verified 'verified'}}selected{{/ifEquals}}>Verified</option>
                    <option value="unverified" {{#ifEquals filters.verified 'unverified'}}selected{{/ifEquals}}>Unverified</option>
                </select>
            </div>

            <div class="col-lg-1 col-md-12 text-end">
                <a href="/admin/network/users" class="btn btn-outline-secondary w-100" title="Reset Filters"><i class="fa-solid fa-rotate"></i></a>
            </div>
        </div>
    </form>

    <!-- ACTIVE FILTER CHIPS -->
    {{#if hasActiveFilters}}
    <div class="d-flex align-items-center flex-wrap gap-2 mb-3 px-1">
        <span class="small text-muted fw-bold me-1"><i class="fa-solid fa-filter me-1"></i>Active:</span>
        {{#if filters.search}}<span class="badge bg-light text-dark border px-2 py-1">"{{filters.search}}"</span>{{/if}}
        {{#ifNotEquals filters.role 'all'}}<span class="badge bg-light text-dark border px-2 py-1">Role: {{filters.role}}</span>{{/ifNotEquals}}
        {{#ifNotEquals filters.status 'all'}}<span class="badge bg-light text-dark border px-2 py-1">Status: {{filters.status}}</span>{{/ifNotEquals}}
        {{#ifNotEquals filters.discipline 'all'}}<span class="badge bg-light text-dark border px-2 py-1">Discipline: {{filters.discipline}}</span>{{/ifNotEquals}}
        {{#ifNotEquals filters.sector 'all'}}<span class="badge bg-light text-dark border px-2 py-1">Sector: {{filters.sector}}</span>{{/ifNotEquals}}
        {{#ifNotEquals filters.verified 'all'}}<span class="badge bg-light text-dark border px-2 py-1">Verification: {{filters.verified}}</span>{{/ifNotEquals}}
        <a href="/admin/network/users?view={{#ifEquals viewMode 'table'}}table{{else}}card{{/ifEquals}}" class="badge bg-danger text-white text-decoration-none px-2 py-1">
            <i class="fa-solid fa-xmark me-1"></i>Clear All
        </a>
    </div>
    {{/if}}

    <!-- REUSABLE VIEW TOGGLE -->
    {{> admin/view-toggle section="network_users" itemLabel="users"}}

    <!-- CARD VIEW (DEFAULT) -->
    <div class="admin-cards-container {{#ifEquals viewMode 'table'}}d-none{{/ifEquals}}" id="network_usersCardView" data-section="network_users">
        <div class="row g-4 mb-4">
            {{#if records.length}}
            {{#each records}}
            <div class="col-xl-3 col-lg-4 col-md-6">
                <div class="admin-governance-card">
                    <div class="admin-card-header">
                        <div class="d-flex align-items-center gap-2">
                            {{#if isVerified}}
                            <span class="admin-badge admin-badge-success" title="Identity Verified">
                                <i class="fa-solid fa-check"></i> Verified
                            </span>
                            {{else}}
                            <span class="admin-badge admin-badge-neutral">
                                Unverified
                            </span>
                            {{/if}}
                        </div>
                        <div>
                            {{#if isBlocked}}
                            <span class="admin-badge admin-badge-danger" title="Account Suspended"><i class="fa-solid fa-ban me-1"></i> Suspended</span>
                            {{else}}
                            {{#if isRestricted}}
                            <span class="admin-badge admin-badge-warning" title="Account Restricted"><i class="fa-solid fa-triangle-exclamation me-1"></i> Restricted</span>
                            {{else}}
                            <span class="admin-badge admin-badge-success">Active</span>
                            {{/if}}
                            {{/if}}
                        </div>
                    </div>

                    <div class="admin-card-body">
                        <div class="d-flex align-items-center gap-3">
                            <img src="{{resolveImage profileImage 'student-images'}}" alt="{{name}}" class="rounded-circle shadow-xs" style="width: 52px; height: 52px; object-fit: cover; border: 2px solid var(--border);" onerror="this.onerror=null;this.src='/img/placeholders/profile.svg'">
                            <div class="overflow-hidden">
                                <h4 class="admin-card-title text-truncate">
                                    <a href="/admin/network/users/{{_id}}" class="text-decoration-none" style="color:var(--text);">{{name}}</a>
                                </h4>
                                <div class="admin-card-subtitle text-truncate">
                                    @{{username}}
                                    {{#if usernameClaimed}}
                                    <i class="fa-solid fa-circle-check text-primary ms-1" title="Claimed Handle" style="font-size: 11px;"></i>
                                    {{/if}}
                                </div>
                                <div class="text-muted small text-truncate" style="font-size: 11px;">{{email}}</div>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap gap-1 align-items-center">
                            {{#ifEquals primaryRole 'EDUCATOR'}}
                            <span class="badge badge-educator-protected px-2 py-1"><i class="fa-solid fa-graduation-cap me-1"></i> Educator</span>
                            {{else}}{{#ifEquals primaryRole 'FOUNDER'}}
                            <span class="badge bg-dark text-white px-2 py-1"><i class="fa-solid fa-rocket me-1"></i> Founder</span>
                            {{else}}{{#ifEquals primaryRole 'RECRUITER'}}
                            <span class="badge bg-info text-dark px-2 py-1"><i class="fa-solid fa-briefcase me-1"></i> Recruiter</span>
                            {{else}}{{#ifEquals primaryRole 'MENTOR'}}
                            <span class="badge bg-secondary text-white px-2 py-1"><i class="fa-solid fa-hands-holding-child me-1"></i> Mentor</span>
                            {{else}}{{#ifEquals primaryRole 'PROFESSIONAL'}}
                            <span class="badge bg-primary text-white px-2 py-1"><i class="fa-solid fa-user-tie me-1"></i> Professional</span>
                            {{else}}
                            <span class="badge bg-success-subtle text-success border px-2 py-1"><i class="fa-solid fa-user-graduate me-1"></i> Student</span>
                            {{/ifEquals}}{{/ifEquals}}{{/ifEquals}}{{/ifEquals}}{{/ifEquals}}

                            {{#each secondaryRoles}}
                            <span class="badge bg-light text-muted border px-1.5 py-0.5" style="font-size: 10px;" title="Secondary Role">+ {{this}}</span>
                            {{/each}}
                        </div>

                        <div class="mt-2 d-flex flex-wrap gap-1 align-items-center">
                            {{#if coursesCount}}
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-0.5" style="font-size: 11px;">
                                <i class="fa-solid fa-book-open me-1"></i> {{coursesCount}} Course{{#ifNotEquals coursesCount 1}}s{{/ifNotEquals}}
                            </span>
                            {{/if}}
                            <span class="badge bg-light text-dark border px-2 py-0.5" style="font-size: 11px;" title="Capabilities Count">
                                <i class="fa-solid fa-key me-1 text-muted"></i> {{capabilitiesCount}} Caps
                            </span>
                        </div>

                        <div class="admin-card-meta-list">
                            <div class="admin-card-meta-item">
                                <i class="fa-solid fa-layer-group"></i>
                                <span class="text-truncate">{{#if discipline}}{{discipline}}{{else}}Discipline not specified{{/if}}</span>
                            </div>
                            <div class="admin-card-meta-item">
                                <i class="fa-solid fa-mountain-city"></i>
                                <span class="text-truncate">{{#if infrastructureSector}}{{infrastructureSector}}{{else}}Sector not specified{{/if}}</span>
                            </div>
                            <div class="admin-card-meta-item">
                                <i class="fa-regular fa-calendar"></i>
                                <span>Joined {{formatDate createdAt}}</span>
                            </div>
                        </div>
                    </div>

                    <div class="admin-card-footer d-flex gap-1 flex-wrap">
                        <a href="/admin/network/users/{{_id}}" class="btn btn-sm btn-outline-secondary" title="Inspect Profile Dossier">
                            <i class="fa-solid fa-eye me-1"></i> View
                        </a>
                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="openRoleModal('{{_id}}', '{{name}}', '{{primaryRole}}')" title="Assign Role">
                            <i class="fa-solid fa-user-tag me-1"></i> Role
                        </button>
                        {{#if isBlocked}}
                        <button type="button" class="btn btn-sm btn-outline-success" onclick="quickRestoreUser('{{_id}}', '{{name}}')" title="Restore Account">
                            <i class="fa-solid fa-lock-open me-1"></i> Restore
                        </button>
                        {{else}}
                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="openSuspendModal('{{_id}}', '{{name}}')" title="Suspend Account">
                            <i class="fa-solid fa-ban me-1"></i> Suspend
                        </button>
                        {{/if}}
                    </div>
                </div>
            </div>
            {{/each}}
            {{else}}
            <div class="col-12">
                <div class="admin-empty-state">
                    <div class="admin-empty-state-icon">
                        <i class="fa-solid fa-users"></i>
                    </div>
                    <div class="admin-empty-state-title">No Users Found</div>
                    <p class="admin-empty-state-desc">There are no user profiles matching the current filter parameters.</p>
                </div>
            </div>
            {{/if}}
        </div>
    </div>

    <!-- TABLE VIEW -->
    <div class="admin-table-container {{#ifEquals viewMode 'table'}}{{else}}d-none{{/ifEquals}}" id="network_usersTableView" data-section="network_users">
        <div class="card border-0 shadow-sm" style="border-radius: 16px; overflow: hidden;">
            <div class="table-responsive mb-0">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr style="font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;">
                            <th class="ps-4">User</th>
                            <th>Role</th>
                            <th>Discipline</th>
                            <th>Sector</th>
                            <th>Status</th>
                            <th>Verification</th>
                            <th>Joined</th>
                            <th class="text-end pe-4" style="min-width: 140px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#if records.length}}
                        {{#each records}}
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-3">
                                    <img src="{{resolveImage profileImage 'student-images'}}" alt="{{name}}" class="rounded-circle shadow-xs" style="width: 42px; height: 42px; object-fit: cover; border: 1px solid var(--border);" onerror="this.onerror=null;this.src='/img/placeholders/profile.svg'">
                                    <div>
                                        <a href="/admin/network/users/{{_id}}" class="fw-bold text-decoration-none" style="color: var(--text);">
                                            {{name}}
                                        </a>
                                        <div class="text-muted small">@{{username}}</div>
                                        <div class="text-muted" style="font-size: 11px;">{{email}}</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="d-flex flex-column gap-1">
                                    <div>
                                        {{#ifEquals primaryRole 'EDUCATOR'}}
                                        <span class="badge badge-educator-protected px-2 py-0.5"><i class="fa-solid fa-graduation-cap me-1"></i> Educator</span>
                                        {{else}}{{#ifEquals primaryRole 'FOUNDER'}}
                                        <span class="badge bg-dark text-white px-2 py-0.5"><i class="fa-solid fa-rocket me-1"></i> Founder</span>
                                        {{else}}{{#ifEquals primaryRole 'RECRUITER'}}
                                        <span class="badge bg-info text-dark px-2 py-0.5"><i class="fa-solid fa-briefcase me-1"></i> Recruiter</span>
                                        {{else}}{{#ifEquals primaryRole 'MENTOR'}}
                                        <span class="badge bg-secondary text-white px-2 py-0.5"><i class="fa-solid fa-hands-holding-child me-1"></i> Mentor</span>
                                        {{else}}{{#ifEquals primaryRole 'PROFESSIONAL'}}
                                        <span class="badge bg-primary text-white px-2 py-0.5"><i class="fa-solid fa-user-tie me-1"></i> Professional</span>
                                        {{else}}
                                        <span class="badge bg-success-subtle text-success border px-2 py-0.5"><i class="fa-solid fa-user-graduate me-1"></i> Student</span>
                                        {{/ifEquals}}{{/ifEquals}}{{/ifEquals}}{{/ifEquals}}{{/ifEquals}}
                                    </div>
                                    {{#if secondaryRoles.length}}
                                    <div class="d-flex flex-wrap gap-1">
                                        {{#each secondaryRoles}}
                                        <span class="badge bg-light text-muted border" style="font-size: 9px;">+{{this}}</span>
                                        {{/each}}
                                    </div>
                                    {{/if}}
                                    <div class="text-muted" style="font-size: 10px;">
                                        <i class="fa-solid fa-key text-muted me-1"></i>{{capabilitiesCount}} caps
                                        {{#if coursesCount}} &bull; <i class="fa-solid fa-book-open text-primary me-0.5"></i>{{coursesCount}} courses{{/if}}
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="small text-muted">{{#if discipline}}{{discipline}}{{else}}—{{/if}}</span>
                            </td>
                            <td>
                                <span class="small text-muted">{{#if infrastructureSector}}{{infrastructureSector}}{{else}}—{{/if}}</span>
                            </td>
                            <td>
                                {{#if isBlocked}}
                                <span class="admin-badge admin-badge-danger" title="Account Suspended"><i class="fa-solid fa-ban me-1"></i> Suspended</span>
                                {{else}}
                                {{#if isRestricted}}
                                <span class="admin-badge admin-badge-warning" title="Account Restricted"><i class="fa-solid fa-triangle-exclamation me-1"></i> Restricted</span>
                                {{else}}
                                <span class="admin-badge admin-badge-success">Active</span>
                                {{/if}}
                                {{/if}}
                            </td>
                            <td>
                                {{#if isVerified}}
                                <span class="admin-badge admin-badge-success"><i class="fa-solid fa-check me-1"></i> Verified</span>
                                {{else}}
                                <span class="admin-badge admin-badge-neutral">Unverified</span>
                                {{/if}}
                            </td>
                            <td class="small text-muted">
                                {{formatDate createdAt}}
                            </td>
                            <td class="text-end pe-4">
                                <div class="table-actions">
                                    <a href="/admin/network/users/{{_id}}" class="btn btn-sm btn-outline-secondary" title="Inspect Profile Dossier">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="openRoleModal('{{_id}}', '{{name}}', '{{primaryRole}}')" title="Assign Role">
                                        <i class="fa-solid fa-user-tag"></i>
                                    </button>
                                    {{#if isBlocked}}
                                    <button type="button" class="btn btn-sm btn-outline-success" onclick="quickRestoreUser('{{_id}}', '{{name}}')" title="Restore Account">
                                        <i class="fa-solid fa-lock-open"></i>
                                    </button>
                                    {{else}}
                                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="openSuspendModal('{{_id}}', '{{name}}')" title="Suspend Account">
                                        <i class="fa-solid fa-ban"></i>
                                    </button>
                                    {{/if}}
                                </div>
                            </td>
                        </tr>
                        {{/each}}
                        {{else}}
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-users fa-3x mb-3 text-secondary opacity-50"></i>
                                <p class="m-0">No users found matching current filters.</p>
                            </td>
                        </tr>
                        {{/if}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- PAGINATION (PRESERVES VIEW STATE) -->
    {{#if (gt totalPages 1)}}
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 py-3 px-1 mt-3">
        <span class="small text-muted">Showing page {{page}} of {{totalPages}} ({{total}} total users)</span>
        <div class="d-flex gap-2">
            {{#if (gt page 1)}}
            <a href="/admin/network/users?page={{dec page}}&search={{filters.search}}&role={{filters.role}}&status={{filters.status}}&discipline={{filters.discipline}}&sector={{filters.sector}}&verified={{filters.verified}}&view={{#ifEquals viewMode 'table'}}table{{else}}card{{/ifEquals}}" class="btn btn-sm btn-outline-secondary">
                <i class="fa-solid fa-chevron-left me-1"></i> Previous
            </a>
            {{/if}}
            {{#if (lt page totalPages)}}
            <a href="/admin/network/users?page={{inc page}}&search={{filters.search}}&role={{filters.role}}&status={{filters.status}}&discipline={{filters.discipline}}&sector={{filters.sector}}&verified={{filters.verified}}&view={{#ifEquals viewMode 'table'}}table{{else}}card{{/ifEquals}}" class="btn btn-sm btn-outline-secondary">
                Next <i class="fa-solid fa-chevron-right ms-1"></i>
            </a>
            {{/if}}
        </div>
    </div>
    {{/if}}

</div>

<!-- ASSIGN ROLE MODAL (WITH SPECIAL EDUCATOR PROTECTION WARNING) -->
<div class="modal fade" id="roleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 16px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-user-tag text-primary me-2"></i> Assign Profile Role</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="roleForm" onsubmit="submitRoleChange(event)">
                <div class="modal-body py-3">
                    <p class="text-muted small">Managing profile role for <strong id="modalUserName" class="text-dark"></strong>.</p>
                    <input type="hidden" id="modalUserId" name="userId">

                    <div class="mb-3">
                        <label class="form-label fw-bold small">Select New Role</label>
                        <select class="form-select" id="newRoleSelect" name="role" onchange="checkEducatorWarning(this.value)" required>
                            <option value="STUDENT">Student</option>
                            <option value="EDUCATOR">Educator (Admin Protected)</option>
                            <option value="PROFESSIONAL">Professional</option>
                            <option value="MENTOR">Mentor</option>
                            <option value="RECRUITER">Recruiter</option>
                            <option value="FOUNDER">Founder</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small">Reason for Role Change (Mandatory Audit Rationale)</label>
                        <textarea class="form-control" name="reason" id="roleReason" rows="2" placeholder="Explain the justification for this role assignment..." required minlength="3"></textarea>
                    </div>

                    <!-- EDUCATOR GOVERNANCE NOTICE -->
                    <div id="educatorNotice" class="alert alert-warning border-0 small mb-0" style="display: none; border-radius: 12px;">
                        <i class="fa-solid fa-shield-halved me-1 text-warning"></i>
                        <strong>Administrative Privilege:</strong> The <em>Educator</em> role can only be assigned by an authorized Administrator. Normal users cannot self-assign or self-revoke this role. This action will be recorded in the audit trail.
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="saveRoleBtn">Confirm &amp; Audit Role</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- SUSPEND USER MODAL -->
<div class="modal fade" id="suspendModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 16px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-danger"><i class="fa-solid fa-ban me-2"></i> Suspend User Account</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="suspendForm" onsubmit="submitSuspend(event)">
                <div class="modal-body py-3">
                    <p class="text-muted small">You are suspending the account for <strong id="suspendUserName" class="text-dark"></strong>.</p>
                    <input type="hidden" id="suspendUserId" name="userId">

                    <div class="alert alert-danger border-0 small mb-3" style="border-radius: 12px;">
                        <i class="fa-solid fa-triangle-exclamation me-1"></i>
                        <strong>Impact:</strong> Suspending this account will immediately revoke all active sessions, block authentication, and disable platform participation until restored.
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small">Administrative Reason (Required)</label>
                        <textarea class="form-control" name="reason" id="suspendReason" rows="3" placeholder="Provide compliance or governance justification for this suspension..." required minlength="3"></textarea>
                    </div>

                    <div class="mb-2">
                        <label class="form-label fw-bold small d-block">Enforced Restrictions</label>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="restrMessaging" value="no_messaging" checked>
                            <label class="form-check-label small" for="restrMessaging">Block Messaging</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="restrJobs" value="no_applications" checked>
                            <label class="form-check-label small" for="restrJobs">Block Job Applications</label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger" id="confirmSuspendBtn">Confirm Suspension</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- VERIFICATION STATUS MODAL -->
<div class="modal fade" id="verificationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 16px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-shield-check text-success me-2"></i> Update Verification State</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="verificationForm" onsubmit="submitVerification(event)">
                <div class="modal-body py-3">
                    <p class="text-muted small">Update infrastructure verification state for <strong id="modalVerifUserName" class="text-dark"></strong>.</p>
                    <input type="hidden" id="modalVerifUserId" name="userId">

                    <div class="mb-3">
                        <label class="form-label fw-bold small">Verification State</label>
                        <select class="form-select" id="verifStatusSelect" name="status" required>
                            <option value="UNVERIFIED">Unverified</option>
                            <option value="UNDER_REVIEW">Under Review</option>
                            <option value="VERIFIED">Verified</option>
                            <option value="REJECTED">Rejected</option>
                        </select>
                    </div>

                    <div class="mb-2">
                        <label class="form-label fw-bold small">Audit Notes / Rationale (Optional)</label>
                        <textarea class="form-control" name="notes" id="verifNotes" rows="3" placeholder="Enter reason or verification credentials checked..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Update Verification</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
let roleModalInstance, verificationModalInstance, suspendModalInstance;

document.addEventListener('DOMContentLoaded', () => {
    if (window.bootstrap) {
        roleModalInstance = new bootstrap.Modal(document.getElementById('roleModal'));
        verificationModalInstance = new bootstrap.Modal(document.getElementById('verificationModal'));
        suspendModalInstance = new bootstrap.Modal(document.getElementById('suspendModal'));
    }
});

function openRoleModal(userId, name, currentRole) {
    document.getElementById('modalUserId').value = userId;
    document.getElementById('modalUserName').innerText = name;
    const select = document.getElementById('newRoleSelect');
    select.value = (currentRole || 'STUDENT').toUpperCase();
    if (document.getElementById('roleReason')) {
        document.getElementById('roleReason').value = '';
    }
    checkEducatorWarning(select.value);
    roleModalInstance.show();
}

function checkEducatorWarning(role) {
    const notice = document.getElementById('educatorNotice');
    if (role === 'EDUCATOR') {
        notice.style.display = 'block';
    } else {
        notice.style.display = 'none';
    }
}

async function submitRoleChange(e) {
    e.preventDefault();
    const btn = document.getElementById('saveRoleBtn') || e.target.querySelector('button[type="submit"]');
    const userId = document.getElementById('modalUserId').value;
    const role = document.getElementById('newRoleSelect').value;
    const reason = (document.getElementById('roleReason')?.value || '').trim();

    if (role === 'EDUCATOR') {
        const confirmRes = await Swal.fire({
            title: 'Assign Educator Role?',
            text: 'You are about to assign the privileged Educator role. This grants verified educator status and is audit logged.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#198754',
            confirmButtonText: 'Yes, Assign Educator'
        });
        if (!confirmRes.isConfirmed) return;
    }

    if (window.zeitnahSetSubmitting) window.zeitnahSetSubmitting(btn, 'Auditing...');

    try {
        const res = await fetch(`/admin/network/users/${userId}/role`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ role, reason })
        });
        const json = await res.json();
        if (json.success) {
            Swal.fire({ icon: 'success', title: 'Role Updated', text: json.message, timer: 1500, showConfirmButton: false });
            setTimeout(() => window.location.reload(), 1500);
        } else {
            if (window.zeitnahResetSubmitting) window.zeitnahResetSubmitting(btn);
            Swal.fire({ icon: 'error', title: 'Update Failed', text: json.message || 'Could not update role' });
        }
    } catch(err) {
        if (window.zeitnahResetSubmitting) window.zeitnahResetSubmitting(btn);
        Swal.fire({ icon: 'error', title: 'Network Error', text: err.message });
    }
}

function openSuspendModal(userId, name) {
    document.getElementById('suspendUserId').value = userId;
    document.getElementById('suspendUserName').innerText = name;
    document.getElementById('suspendReason').value = '';
    suspendModalInstance.show();
}

async function submitSuspend(e) {
    e.preventDefault();
    const btn = document.getElementById('confirmSuspendBtn');
    const userId = document.getElementById('suspendUserId').value;
    const reason = document.getElementById('suspendReason').value.trim();
    const restrictions = [];
    if (document.getElementById('restrMessaging').checked) restrictions.push('no_messaging');
    if (document.getElementById('restrJobs').checked) restrictions.push('no_applications');

    if (window.zeitnahSetSubmitting) window.zeitnahSetSubmitting(btn, 'Suspending...');

    try {
        const res = await fetch(`/admin/network/users/${userId}/suspend`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ reason, restrictions })
        });
        const json = await res.json();
        if (json.success) {
            Swal.fire({ icon: 'success', title: 'User Suspended', text: json.message, timer: 1500, showConfirmButton: false });
            setTimeout(() => window.location.reload(), 1500);
        } else {
            if (window.zeitnahResetSubmitting) window.zeitnahResetSubmitting(btn);
            Swal.fire({ icon: 'error', title: 'Suspension Failed', text: json.message || 'Could not suspend user' });
        }
    } catch(err) {
        if (window.zeitnahResetSubmitting) window.zeitnahResetSubmitting(btn);
        Swal.fire({ icon: 'error', title: 'Network Error', text: err.message });
    }
}

async function quickRestoreUser(userId, name) {
    const confirmRes = await Swal.fire({
        title: 'Restore Account?',
        text: `Are you sure you want to lift the suspension for ${name}?`,
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#198754',
        confirmButtonText: 'Yes, Restore User'
    });
    if (!confirmRes.isConfirmed) return;

    try {
        const res = await fetch(`/admin/network/users/${userId}/restore`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ reason: 'Suspension lifted by administrator' })
        });
        const json = await res.json();
        if (json.success) {
            Swal.fire({ icon: 'success', title: 'User Restored', text: json.message, timer: 1500, showConfirmButton: false });
            setTimeout(() => window.location.reload(), 1500);
        } else {
            Swal.fire({ icon: 'error', title: 'Restoration Failed', text: json.message || 'Could not restore user' });
        }
    } catch(err) {
        Swal.fire({ icon: 'error', title: 'Network Error', text: err.message });
    }
}

function openVerificationModal(userId, name, currentStatus) {
    document.getElementById('modalVerifUserId').value = userId;
    document.getElementById('modalVerifUserName').innerText = name;
    document.getElementById('verifStatusSelect').value = (currentStatus || 'UNVERIFIED').toUpperCase();
    verificationModalInstance.show();
}

async function submitVerification(e) {
    e.preventDefault();
    const btn = e.target.querySelector('button[type="submit"]');
    const userId = document.getElementById('modalVerifUserId').value;
    const status = document.getElementById('verifStatusSelect').value;
    const notes = document.getElementById('verifNotes').value;

    if (window.zeitnahSetSubmitting) window.zeitnahSetSubmitting(btn, 'Saving...');

    try {
        const res = await fetch(`/admin/network/users/${userId}/verification`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ status, notes })
        });
        const json = await res.json();
        if (json.success) {
            Swal.fire({ icon: 'success', title: 'Verification Updated', text: json.message, timer: 1500, showConfirmButton: false });
            setTimeout(() => window.location.reload(), 1500);
        } else {
            if (window.zeitnahResetSubmitting) window.zeitnahResetSubmitting(btn);
            Swal.fire({ icon: 'error', title: 'Update Failed', text: json.message || 'Could not update verification' });
        }
    } catch(err) {
        if (window.zeitnahResetSubmitting) window.zeitnahResetSubmitting(btn);
        Swal.fire({ icon: 'error', title: 'Network Error', text: err.message });
    }
}
</script>
