<div class="container-fluid mt-4 mb-5">

    <!-- HERO HEADER -->
    <div class="hero-card mb-4" style="background: linear-gradient(135deg, rgba(18, 49, 76, 0.95), rgba(29, 78, 137, 0.9)), url('/images/banner.jpg') center/cover; padding: 32px 36px; border-radius: 24px; position: relative; overflow: hidden; box-shadow: 0 12px 32px rgba(18, 49, 76, 0.15);">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 position-relative" style="z-index: 2;">
            <div>
                <span class="badge mb-2 px-3 py-2" style="background: rgba(159, 213, 178, 0.2); color: #9fd5b2; border: 1px solid rgba(159, 213, 178, 0.35); border-radius: 30px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px;">
                    <i class="fa-solid fa-briefcase me-1"></i> Phase 2 Governance
                </span>
                <h2 class="text-white fw-bold m-0" style="font-size: 28px; letter-spacing: -0.5px;">Job Governance Center</h2>
                <p class="text-light opacity-75 mt-2 mb-0" style="font-size: 14px;">Monitor, moderate, unpublish, restore, or close infrastructure job postings across verified organizations.</p>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <a href="/admin/ai/matching" class="btn btn-outline-light px-3 py-2">
                    <i class="fa-solid fa-brain me-1"></i> AI Matching
                </a>
                <a href="/admin/businesses" class="btn btn-light px-3 py-2">
                    <i class="fa-solid fa-building-shield me-1"></i> Businesses
                </a>
            </div>
        </div>
    </div>

    <!-- STATS -->
    <div class="row g-4 mb-4">
        <div class="col-xl-2 col-md-4 col-6">
            <div class="stat-card stat-dark">
                <div>
                    <small>Total Jobs</small>
                    <h2>{{stats.total}}</h2>
                </div>
                <i class="fa-solid fa-briefcase stat-icon"></i>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-6">
            <div class="stat-card stat-green">
                <div>
                    <small>Published</small>
                    <h2>{{stats.published}}</h2>
                </div>
                <i class="fa-solid fa-circle-check stat-icon"></i>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-6">
            <div class="stat-card stat-yellow">
                <div>
                    <small>Drafts</small>
                    <h2>{{stats.draft}}</h2>
                </div>
                <i class="fa-solid fa-file-pen stat-icon"></i>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-6">
            <div class="stat-card stat-blue">
                <div>
                    <small>Closed / Archive</small>
                    <h2>{{stats.closed}}</h2>
                </div>
                <i class="fa-solid fa-box-archive stat-icon"></i>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-6">
            <div class="stat-card stat-red">
                <div>
                    <small>Flagged / Moderation</small>
                    <h2>{{stats.flagged}}</h2>
                </div>
                <i class="fa-solid fa-flag stat-icon"></i>
            </div>
        </div>
    </div>

    <!-- TABS (PRESERVES VIEW STATE) -->
    <ul class="nav nav-tabs mb-4 border-bottom" style="font-size: 14px; font-weight: 600;">
        <li class="nav-item">
            <a class="nav-link {{#ifEquals tab 'all'}}active text-primary{{else}}text-muted{{/ifEquals}}" href="/admin/jobs?tab=all&view={{#ifEquals viewMode 'table'}}table{{else}}card{{/ifEquals}}">
                All ({{stats.total}})
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{#ifEquals tab 'published'}}active text-success{{else}}text-muted{{/ifEquals}}" href="/admin/jobs?tab=published&view={{#ifEquals viewMode 'table'}}table{{else}}card{{/ifEquals}}">
                Published ({{stats.published}})
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{#ifEquals tab 'draft'}}active text-warning{{else}}text-muted{{/ifEquals}}" href="/admin/jobs?tab=draft&view={{#ifEquals viewMode 'table'}}table{{else}}card{{/ifEquals}}">
                Draft ({{stats.draft}})
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{#ifEquals tab 'closed'}}active text-secondary{{else}}text-muted{{/ifEquals}}" href="/admin/jobs?tab=closed&view={{#ifEquals viewMode 'table'}}table{{else}}card{{/ifEquals}}">
                Closed ({{stats.closed}})
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{#ifEquals tab 'flagged'}}active text-danger{{else}}text-muted{{/ifEquals}}" href="/admin/jobs?tab=flagged&view={{#ifEquals viewMode 'table'}}table{{else}}card{{/ifEquals}}">
                Flagged ({{stats.flagged}})
            </a>
        </li>
    </ul>

    <!-- FILTER TOOLBAR -->
    <form class="card p-3 mb-3 border-0 shadow-sm" method="GET" action="/admin/jobs" id="jobFilterForm" style="border-radius: 16px;">
        <input type="hidden" name="tab" value="{{tab}}">
        <input type="hidden" name="view" value="{{#ifEquals viewMode 'table'}}table{{else}}card{{/ifEquals}}">
        <div class="row g-2 align-items-center">
            <div class="col-lg-4 col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                    <input type="text" class="form-control border-start-0" name="search" value="{{filters.search}}" placeholder="Search jobs by title, discipline, location...">
                </div>
            </div>
            <div class="col-lg-3 col-md-3 col-6">
                <select class="form-select" name="discipline" onchange="document.getElementById('jobFilterForm').submit()">
                    <option value="all">All Disciplines</option>
                    {{#each disciplines}}
                    <option value="{{this}}" {{#ifEquals ../filters.discipline this}}selected{{/ifEquals}}>{{this}}</option>
                    {{/each}}
                </select>
            </div>
            <div class="col-lg-3 col-md-3 col-6">
                <select class="form-select" name="sector" onchange="document.getElementById('jobFilterForm').submit()">
                    <option value="all">All Sectors</option>
                    {{#each sectors}}
                    <option value="{{this}}" {{#ifEquals ../filters.sector this}}selected{{/ifEquals}}>{{this}}</option>
                    {{/each}}
                </select>
            </div>
            <div class="col-lg-2 col-md-12 text-end">
                <button type="submit" class="btn btn-primary w-100"><i class="fa-solid fa-filter me-1"></i> Filter</button>
            </div>
        </div>
    </form>

    <!-- VIEW TOGGLE -->
    {{> admin/view-toggle section="jobs" total=total itemLabel="jobs" viewMode=viewMode}}

    <!-- CARD VIEW (DEFAULT) -->
    <div class="admin-cards-container {{#ifEquals viewMode 'table'}}d-none{{/ifEquals}}" id="jobsCardView" data-section="jobs">
        <div class="row g-3">
            {{#if records.length}}
            {{#each records}}
            <div class="col-xl-4 col-md-6 col-12">
                <div class="admin-governance-card">
                    <div class="admin-card-header">
                        <span class="badge {{#ifEquals businessStatus 'APPROVED'}}bg-success-subtle text-success{{else}}bg-warning-subtle text-warning{{/ifEquals}} border" style="font-size: 11px;">
                            {{businessName}}
                        </span>
                        <div>
                            {{#ifEquals statusNormalized 'PUBLISHED'}}
                            <span class="admin-badge admin-badge-published">Published</span>
                            {{else}}
                            {{#ifEquals statusNormalized 'DRAFT'}}
                            <span class="admin-badge admin-badge-draft">Draft</span>
                            {{else}}
                            {{#ifEquals statusNormalized 'CLOSED'}}
                            <span class="admin-badge admin-badge-closed">Closed</span>
                            {{else}}
                            <span class="admin-badge admin-badge-neutral">{{statusNormalized}}</span>
                            {{/ifEquals}}
                            {{/ifEquals}}
                            {{/ifEquals}}
                            {{#if isFlagged}}
                            <span class="admin-badge admin-badge-flagged ms-1" title="Flagged"><i class="fa-solid fa-flag"></i></span>
                            {{/if}}
                        </div>
                    </div>

                    <div class="admin-card-body">
                        <h4 class="admin-card-title">
                            <a href="/admin/jobs/{{_id}}" class="text-decoration-none" style="color:var(--text);">{{title}}</a>
                        </h4>
                        <div class="admin-card-subtitle text-truncate">
                            <i class="fa-solid fa-layer-group me-1"></i> {{#if discipline}}{{discipline}}{{else}}General{{/if}} • {{#if infrastructureSector}}{{infrastructureSector}}{{else}}Infrastructure{{/if}}
                        </div>

                        <div class="admin-card-meta-list">
                            <div class="admin-card-meta-item">
                                <i class="fa-solid fa-briefcase"></i>
                                <span>{{#if minYearsExperience}}{{minYearsExperience}}–{{maxYearsExperience}} yrs{{else}}Experience: {{experienceLevel}}{{/if}}</span>
                            </div>
                            <div class="admin-card-meta-item">
                                <i class="fa-solid fa-location-dot"></i>
                                <span class="text-truncate">{{#if location}}{{location}}{{else}}Remote{{/if}} ({{workMode}})</span>
                            </div>
                            {{#if applicantsCount}}
                            <div class="admin-card-meta-item">
                                <i class="fa-solid fa-users"></i>
                                <span>{{applicantsCount}} Applications</span>
                            </div>
                            {{/if}}
                            <div class="admin-card-meta-item">
                                <i class="fa-regular fa-calendar"></i>
                                <span>Published {{formatDate publishedAt}}</span>
                            </div>
                        </div>
                    </div>

                    <div class="admin-card-footer">
                        <a href="/admin/jobs/{{_id}}" class="btn btn-sm btn-outline-secondary" title="View Job Detail">
                            <i class="fa-solid fa-eye me-1"></i> View
                        </a>
                        <a href="/admin/ai/job-matches?jobId={{_id}}" class="btn btn-sm btn-outline-info" title="Inspect AI Matches">
                            <i class="fa-solid fa-brain me-1"></i> Matches
                        </a>
                        {{#ifEquals statusNormalized 'PUBLISHED'}}
                        <button type="button" class="btn btn-sm btn-outline-warning" onclick="openUnpublishModal('{{_id}}', '{{title}}')" title="Unpublish">
                            <i class="fa-solid fa-pause"></i>
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="openCloseModal('{{_id}}', '{{title}}')" title="Close">
                            <i class="fa-solid fa-lock"></i>
                        </button>
                        {{/ifEquals}}
                        {{#ifEquals statusNormalized 'CLOSED'}}
                        <button type="button" class="btn btn-sm btn-outline-success" onclick="restoreJob('{{_id}}', '{{title}}', this)" title="Restore">
                            <i class="fa-solid fa-rotate-left"></i> Restore
                        </button>
                        {{/ifEquals}}
                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="openFlagModal('{{_id}}', '{{title}}')" title="Flag for Review">
                            <i class="fa-solid fa-flag"></i>
                        </button>
                    </div>
                </div>
            </div>
            {{/each}}
            {{else}}
            <div class="col-12">
                <div class="admin-empty-state">
                    <div class="admin-empty-state-icon">
                        <i class="fa-solid fa-briefcase"></i>
                    </div>
                    <div class="admin-empty-state-title">No Job Postings Found</div>
                    <p class="admin-empty-state-desc">There are currently no job opportunities matching the selected filters or status.</p>
                </div>
            </div>
            {{/if}}
        </div>
    </div>

    <!-- TABLE VIEW -->
    <div class="admin-table-container {{#ifEquals viewMode 'table'}}{{else}}d-none{{/ifEquals}}" id="jobsTableView" data-section="jobs">
        <div class="card border-0 shadow-sm" style="border-radius: 16px; overflow: hidden;">
            <div class="table-responsive mb-0">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr style="font-size: 12px; text-transform: uppercase;">
                            <th class="ps-4">Job Title</th>
                            <th>Business</th>
                            <th>Discipline</th>
                            <th>Sector</th>
                            <th>Experience</th>
                            <th>Location / Mode</th>
                            <th>Status</th>
                            <th>Published</th>
                            <th class="text-end pe-4" style="min-width: 180px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#if records.length}}
                        {{#each records}}
                        <tr>
                            <td class="ps-4">
                                <a href="/admin/jobs/{{_id}}" class="fw-bold text-decoration-none" style="color:var(--text);">
                                    {{title}}
                                </a>
                                <div class="text-muted" style="font-size: 11px;">
                                    {{#if minYearsExperience}}{{minYearsExperience}}–{{maxYearsExperience}} yrs{{else}}Entry level{{/if}}
                                </div>
                            </td>
                            <td>
                                <div class="small fw-semibold">{{businessName}}</div>
                                <span class="badge {{#ifEquals businessStatus 'APPROVED'}}bg-success-subtle text-success{{else}}bg-warning-subtle text-warning{{/ifEquals}}" style="font-size: 10px;">
                                    {{businessStatus}}
                                </span>
                            </td>
                            <td class="small text-muted">{{#if discipline}}{{discipline}}{{else}}—{{/if}}</td>
                            <td class="small text-muted">{{#if infrastructureSector}}{{infrastructureSector}}{{else}}—{{/if}}</td>
                            <td class="small text-muted">{{experienceLevel}}</td>
                            <td class="small text-muted">
                                {{#if location}}{{location}}{{else}}Remote{{/if}} ({{workMode}})
                            </td>
                            <td>
                                {{#ifEquals statusNormalized 'PUBLISHED'}}
                                <span class="admin-badge admin-badge-published">Published</span>
                                {{else}}
                                {{#ifEquals statusNormalized 'DRAFT'}}
                                <span class="admin-badge admin-badge-draft">Draft</span>
                                {{else}}
                                {{#ifEquals statusNormalized 'CLOSED'}}
                                <span class="admin-badge admin-badge-closed">Closed</span>
                                {{else}}
                                <span class="admin-badge admin-badge-neutral">{{statusNormalized}}</span>
                                {{/ifEquals}}
                                {{/ifEquals}}
                                {{/ifEquals}}

                                {{#if isFlagged}}
                                <span class="admin-badge admin-badge-flagged ms-1" title="Flagged"><i class="fa-solid fa-flag"></i></span>
                                {{/if}}
                            </td>
                            <td class="small text-muted">{{formatDate publishedAt}}</td>
                            <td class="text-end pe-4">
                                <div class="table-actions">
                                    <a href="/admin/jobs/{{_id}}" class="btn btn-sm btn-outline-secondary" title="View Job Detail">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>
                                    <a href="/admin/ai/job-matches?jobId={{_id}}" class="btn btn-sm btn-outline-info" title="Inspect AI Matches">
                                        <i class="fa-solid fa-brain"></i>
                                    </a>
                                    {{#ifEquals statusNormalized 'PUBLISHED'}}
                                    <button type="button" class="btn btn-sm btn-outline-warning" onclick="openUnpublishModal('{{_id}}', '{{title}}')" title="Unpublish">
                                        <i class="fa-solid fa-pause"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="openCloseModal('{{_id}}', '{{title}}')" title="Close">
                                        <i class="fa-solid fa-lock"></i>
                                    </button>
                                    {{/ifEquals}}
                                    {{#ifEquals statusNormalized 'CLOSED'}}
                                    <button type="button" class="btn btn-sm btn-outline-success" onclick="restoreJob('{{_id}}', '{{title}}', this)" title="Restore">
                                        <i class="fa-solid fa-rotate-left"></i>
                                    </button>
                                    {{/ifEquals}}
                                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="openFlagModal('{{_id}}', '{{title}}')" title="Flag for Review">
                                        <i class="fa-solid fa-flag"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        {{/each}}
                        {{else}}
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-briefcase fa-3x mb-3 text-secondary opacity-50"></i>
                                <p class="m-0">No job postings found matching current filters.</p>
                            </td>
                        </tr>
                        {{/if}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- PAGINATION (PRESERVES VIEW STATE) -->
    {{#if (gt totalPages 1)}}
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 py-3 px-1 mt-3">
        <span class="small text-muted">Page {{page}} of {{totalPages}} ({{total}} total jobs)</span>
        <div class="d-flex gap-2">
            {{#if (gt page 1)}}
            <a href="/admin/jobs?tab={{tab}}&page={{dec page}}&search={{filters.search}}&discipline={{filters.discipline}}&sector={{filters.sector}}&view={{#ifEquals viewMode 'table'}}table{{else}}card{{/ifEquals}}" class="btn btn-sm btn-outline-secondary">
                <i class="fa-solid fa-chevron-left me-1"></i> Previous
            </a>
            {{/if}}
            {{#if (lt page totalPages)}}
            <a href="/admin/jobs?tab={{tab}}&page={{inc page}}&search={{filters.search}}&discipline={{filters.discipline}}&sector={{filters.sector}}&view={{#ifEquals viewMode 'table'}}table{{else}}card{{/ifEquals}}" class="btn btn-sm btn-outline-secondary">
                Next <i class="fa-solid fa-chevron-right ms-1"></i>
            </a>
            {{/if}}
        </div>
    </div>
    {{/if}}

</div>

<!-- UNPUBLISH MODAL -->
<div class="modal fade" id="unpublishJobModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 16px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-warning"><i class="fa-solid fa-pause me-2"></i> Unpublish Job</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="unpublishJobForm" onsubmit="submitUnpublish(event)">
                <div class="modal-body py-3">
                    <p class="small text-muted">Unpublishing <strong id="unpublishJobTitle" class="text-dark"></strong>. The opportunity will no longer appear on public network boards.</p>
                    <input type="hidden" id="unpublishJobId">
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Reason for Unpublishing</label>
                        <textarea class="form-control" id="unpublishReason" rows="3" placeholder="Provide reason (e.g. Expired role, misleading details)..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning text-dark">Confirm Unpublish</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- CLOSE MODAL -->
<div class="modal fade" id="closeJobModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 16px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-danger"><i class="fa-solid fa-lock me-2"></i> Close Job</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="closeJobForm" onsubmit="submitClose(event)">
                <div class="modal-body py-3">
                    <p class="small text-muted">Mark <strong id="closeJobTitle" class="text-dark"></strong> as closed.</p>
                    <input type="hidden" id="closeJobId">
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Reason for Closing (Optional)</label>
                        <input type="text" class="form-control" id="closeReason" placeholder="Position filled, project cancelled, etc.">
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Confirm Close</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- FLAG MODAL -->
<div class="modal fade" id="flagJobModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 16px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-danger"><i class="fa-solid fa-flag me-2"></i> Flag Job for Moderation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="flagJobForm" onsubmit="submitFlag(event)">
                <div class="modal-body py-3">
                    <p class="small text-muted">Flagging <strong id="flagJobTitle" class="text-dark"></strong> for administrative investigation.</p>
                    <input type="hidden" id="flagJobId">
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Flagging Reason (Mandatory)</label>
                        <textarea class="form-control" id="flagReason" rows="3" placeholder="Provide investigation notes (e.g. suspicious external links, spam, duplicate)..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Confirm Flag</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
let unpublishModal, closeModal, flagModal;

document.addEventListener('DOMContentLoaded', () => {
    if (window.bootstrap) {
        unpublishModal = new bootstrap.Modal(document.getElementById('unpublishJobModal'));
        closeModal = new bootstrap.Modal(document.getElementById('closeJobModal'));
        flagModal = new bootstrap.Modal(document.getElementById('flagJobModal'));
    }
});

function openUnpublishModal(id, title) {
    document.getElementById('unpublishJobId').value = id;
    document.getElementById('unpublishJobTitle').innerText = title;
    document.getElementById('unpublishReason').value = '';
    unpublishModal.show();
}

async function submitUnpublish(e) {
    e.preventDefault();
    const id = document.getElementById('unpublishJobId').value;
    const reason = document.getElementById('unpublishReason').value;
    const submitBtn = e.target.querySelector('button[type="submit"]');
    const resetBtn = window.zeitnahSetSubmitting ? window.zeitnahSetSubmitting(submitBtn, 'Unpublishing...') : () => {};

    try {
        const res = await fetch(`/admin/jobs/${id}/unpublish`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ reason })
        });
        const json = await res.json();
        if (json.success) {
            Swal.fire({ icon: 'success', title: 'Unpublished', text: json.message, timer: 1500, showConfirmButton: false });
            setTimeout(() => window.location.reload(), 1500);
        } else {
            resetBtn();
            Swal.fire({ icon: 'error', title: 'Failed', text: json.message });
        }
    } catch(err) {
        resetBtn();
        Swal.fire({ icon: 'error', title: 'Error', text: err.message });
    }
}

function openCloseModal(id, title) {
    document.getElementById('closeJobId').value = id;
    document.getElementById('closeJobTitle').innerText = title;
    document.getElementById('closeReason').value = '';
    closeModal.show();
}

async function submitClose(e) {
    e.preventDefault();
    const id = document.getElementById('closeJobId').value;
    const reason = document.getElementById('closeReason').value;
    const submitBtn = e.target.querySelector('button[type="submit"]');
    const resetBtn = window.zeitnahSetSubmitting ? window.zeitnahSetSubmitting(submitBtn, 'Closing...') : () => {};

    try {
        const res = await fetch(`/admin/jobs/${id}/close`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ reason })
        });
        const json = await res.json();
        if (json.success) {
            Swal.fire({ icon: 'success', title: 'Job Closed', text: json.message, timer: 1500, showConfirmButton: false });
            setTimeout(() => window.location.reload(), 1500);
        } else {
            resetBtn();
            Swal.fire({ icon: 'error', title: 'Failed', text: json.message });
        }
    } catch(err) {
        resetBtn();
        Swal.fire({ icon: 'error', title: 'Error', text: err.message });
    }
}

async function restoreJob(id, title, btn) {
    const confirmRes = await Swal.fire({
        title: 'Restore Job?',
        text: `Restore ${title} to active publication?`,
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#198754',
        confirmButtonText: 'Yes, Restore'
    });
    if (!confirmRes.isConfirmed) return;

    const resetBtn = (window.zeitnahSetSubmitting && btn) ? window.zeitnahSetSubmitting(btn, 'Restoring...') : () => {};

    try {
        const res = await fetch(`/admin/jobs/${id}/restore`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }
        });
        const json = await res.json();
        if (json.success) {
            Swal.fire({ icon: 'success', title: 'Job Restored', text: json.message, timer: 1500, showConfirmButton: false });
            setTimeout(() => window.location.reload(), 1500);
        } else {
            resetBtn();
            Swal.fire({ icon: 'error', title: 'Failed', text: json.message });
        }
    } catch(err) {
        resetBtn();
        Swal.fire({ icon: 'error', title: 'Error', text: err.message });
    }
}

function openFlagModal(id, title) {
    document.getElementById('flagJobId').value = id;
    document.getElementById('flagJobTitle').innerText = title;
    document.getElementById('flagReason').value = '';
    flagModal.show();
}

async function submitFlag(e) {
    e.preventDefault();
    const id = document.getElementById('flagJobId').value;
    const reason = document.getElementById('flagReason').value;
    const submitBtn = e.target.querySelector('button[type="submit"]');
    const resetBtn = window.zeitnahSetSubmitting ? window.zeitnahSetSubmitting(submitBtn, 'Flagging...') : () => {};

    try {
        const res = await fetch(`/admin/jobs/${id}/flag`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ reason })
        });
        const json = await res.json();
        if (json.success) {
            Swal.fire({ icon: 'success', title: 'Job Flagged', text: json.message, timer: 1500, showConfirmButton: false });
            setTimeout(() => window.location.reload(), 1500);
        } else {
            resetBtn();
            Swal.fire({ icon: 'error', title: 'Failed', text: json.message });
        }
    } catch(err) {
        resetBtn();
        Swal.fire({ icon: 'error', title: 'Error', text: err.message });
    }
}
</script>
