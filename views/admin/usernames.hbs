}

/* RESERVED GRID */
.un-reserved-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 12px;
}
.un-reserved-pill {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(0,0,0,0.25);
    border: 1px solid rgba(255,255,255,0.08);
    padding: 8px 14px;
    border-radius: 12px;
    font-size: 13px;
}
.un-reserved-pill.core {
    border-color: rgba(159,213,178,0.25);
}

/* MODAL */
.un-modal {
    background: #1a222d;
    border-radius: 20px;
    border: 1px solid rgba(255,255,255,0.1);
    box-shadow: 0 20px 60px rgba(0,0,0,0.6);
}
.un-modal-user-box {
    background: rgba(0,0,0,0.3);
    border-radius: 14px;
    border: 1px solid rgba(255,255,255,0.06);
}
.un-ig-text {
    background: rgba(0,0,0,0.4);
    color: #9fd5b2;
    border-color: rgba(255,255,255,0.1);
    font-weight: 700;
}
.un-input {
    background: rgba(0,0,0,0.25);
    border-color: rgba(255,255,255,0.1);
    color: #fff;
    border-radius: 10px;
}
.un-input:focus {
    background: rgba(0,0,0,0.35);
    color: #fff;
    border-color: #9fd5b2;
}
</style>

<script>
let currentManageUserId = null;
let debounceTimer = null;
let reservedKeywordsCache = [];

function switchTab(tabId) {
    document.querySelectorAll('.un-tab-content').forEach(el => el.classList.remove('active'));
    document.querySelectorAll('.un-tab-btn').forEach(el => el.classList.remove('active'));

    const tab = document.getElementById(tabId);
    const btn = document.getElementById('btn-' + tabId);
    if (tab) tab.classList.add('active');
    if (btn) btn.classList.add('active');

    if (tabId === 'tab-reserved') {
        loadReservedKeywords();
    }
}

function submitFilter() {
    document.getElementById('filterForm').submit();
}

function clearSearch() {
    document.getElementById('searchInput').value = '';
    submitFilter();
}

function openManageModalFromButton(btn) {
    const id = btn.getAttribute('data-id');
    const name = btn.getAttribute('data-name');
    const email = btn.getAttribute('data-email');
    const username = btn.getAttribute('data-username');
    const inCooldown = btn.getAttribute('data-cooldown') === 'true';

    currentManageUserId = id;
    document.getElementById('modalUserName').innerText = name;
    document.getElementById('modalUserEmail').innerText = email;
    document.getElementById('modalCurrentUsername').innerText = username ? '@' + username : '@none';
    document.getElementById('modalNewUsernameInput').value = username || '';
    document.getElementById('modalAvailabilityBadge').innerHTML = '';
    document.getElementById('modalSaveBtn').disabled = true;

    const cooldownWarn = document.getElementById('modalCooldownWarning');
    if (inCooldown) {
        cooldownWarn.style.display = 'block';
    } else {
        cooldownWarn.style.display = 'none';
    }

    const modal = new bootstrap.Modal(document.getElementById('manageUsernameModal'));
    modal.show();
}

function onUsernameInputChanged() {
    clearTimeout(debounceTimer);
    const input = document.getElementById('modalNewUsernameInput');
    const saveBtn = document.getElementById('modalSaveBtn');
    const badge = document.getElementById('modalAvailabilityBadge');
    const rawVal = input.value.trim().replace(/^@/, '');

    if (!rawVal) {
        badge.innerHTML = '';
        saveBtn.disabled = true;
        return;
    }

    badge.innerHTML = '<span class="text-muted"><i class="fa-solid fa-spinner fa-spin me-1"></i> Checking availability...</span>';
    saveBtn.disabled = true;

    debounceTimer = setTimeout(() => {
        fetch(`/usernames/api/check-availability?username=${encodeURIComponent(rawVal)}&excludeUserId=${currentManageUserId}`)
            .then(res => res.json())
            .then(data => {
                if (data.available) {
                    badge.innerHTML = `<span class="text-success fw-bold"><i class="fa-solid fa-circle-check me-1"></i> @${data.username} is available</span>`;
                    saveBtn.disabled = false;
                } else {
                    badge.innerHTML = `<span class="text-danger fw-semibold"><i class="fa-solid fa-circle-xmark me-1"></i> ${data.reason || 'Unavailable'}</span>`;
                    saveBtn.disabled = true;
                }
            })
            .catch(err => {
                badge.innerHTML = `<span class="text-danger">Error checking availability</span>`;
                saveBtn.disabled = true;
            });
    }, 300);
}

function requestGeneratedSuggestion() {
    const name = document.getElementById('modalUserName').innerText;
    const email = document.getElementById('modalUserEmail').innerText;

    fetch('/usernames/api/generate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ userId: currentManageUserId, name, email })
    })
    .then(res => res.json())
    .then(data => {
        if (data.success && data.suggestion) {
            document.getElementById('modalNewUsernameInput').value = data.suggestion;
            onUsernameInputChanged();
        }
    });
}

function submitUsernameChange() {
    const newUsername = document.getElementById('modalNewUsernameInput').value.trim();
    const reason = document.getElementById('modalReasonSelect').value;

    Swal.fire({
        title: 'Confirm Username Change',
        html: `You are about to change this learner's handle to <strong>@${newUsername.replace(/^@/, '')}</strong>.<br><small class="text-muted">Reason: ${reason}</small>`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#12314c',
        confirmButtonText: 'Yes, Update'
    }).then((result) => {
        if (!result.isConfirmed) return;

        fetch(`/usernames/api/change/${currentManageUserId}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ newUsername, reason })
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                Swal.fire('Updated!', `Username updated to @${data.newUsername}`, 'success').then(() => {
                    location.reload();
                });
            } else {
                Swal.fire('Error', data.message || 'Failed to update username.', 'error');
            }
        })
        .catch(err => {
            Swal.fire('Error', err.message, 'error');
        });
    });
}

function refreshHealth() {
    fetch('/usernames/api/health')
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                Swal.fire('Diagnostic Scan Complete', `Total Users: ${data.health.totalUsers}<br>Issues: ${data.health.totalIssues}`, 'info')
                    .then(() => location.reload());
            }
        });
}

function loadReservedKeywords() {
    const grid = document.getElementById('reservedGrid');
    fetch('/usernames/api/reserved')
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                reservedKeywordsCache = data.list;
                renderReservedKeywords(data.list);
            }
        });
}

function renderReservedKeywords(list) {
    const grid = document.getElementById('reservedGrid');
    if (!list.length) {
        grid.innerHTML = '<div class="text-muted p-3">No reserved handles found.</div>';
        return;
    }

    grid.innerHTML = list.map(item => `
        <div class="un-reserved-pill ${item.isSystemCore ? 'core' : ''}">
            <div>
                <strong>@${item.keyword}</strong>
                <small class="d-block text-muted" style="font-size:10px">${item.isSystemCore ? 'Core System' : 'Custom'}</small>
            </div>
            ${!item.isSystemCore ? `
                <button class="btn btn-link text-danger p-0 ms-2" onclick="deleteReserved('${item.keyword}')" title="Delete">
                    <i class="fa-solid fa-trash-can"></i>
                </button>
            ` : '<i class="fa-solid fa-lock text-muted" style="font-size:11px;" title="Immutable core handle"></i>'}
        </div>
    `).join('');
}

function filterReservedList() {
    const q = document.getElementById('reservedSearchInput').value.toLowerCase().trim();
    const filtered = reservedKeywordsCache.filter(item => item.keyword.includes(q));
    renderReservedKeywords(filtered);
}

function openAddReservedModal() {
    const modal = new bootstrap.Modal(document.getElementById('addReservedModal'));
    modal.show();
}

function submitAddReserved() {
    const keyword = document.getElementById('reservedKeywordInput').value.trim();
    const reason = document.getElementById('reservedReasonInput').value.trim();

    fetch('/usernames/api/reserved/add', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ keyword, reason })
    })
    .then(res => res.json())
    .then(data => {
        if (data.success) {
            Swal.fire('Added', `@${data.keyword} is now reserved`, 'success').then(() => {
                bootstrap.Modal.getInstance(document.getElementById('addReservedModal')).hide();
                loadReservedKeywords();
            });
        } else {
            Swal.fire('Error', data.message, 'error');
        }
    });
}

function deleteReserved(keyword) {
    Swal.fire({
        title: `Remove @${keyword}?`,
        text: 'This handle will no longer be restricted for new users.',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonText: 'Remove'
    }).then(res => {
        if (!res.isConfirmed) return;

        fetch('/usernames/api/reserved/delete', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ keyword })
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                Swal.fire('Removed', '', 'success').then(() => loadReservedKeywords());
            } else {
                Swal.fire('Error', data.message, 'error');
            }
        });
    });
}

let bulkCandidatesCache = [];
function loadBulkPreview() {
    fetch('/usernames/api/bulk-preview', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ limit: 100 })
    })
    .then(res => res.json())
    .then(data => {
        if (data.success) {
            bulkCandidatesCache = data.preview.candidates;
            document.getElementById('bulkCountLabel').innerText = data.preview.candidates.length;
            const tbody = document.getElementById('bulkPreviewTbody');

            if (!data.preview.candidates.length) {
                tbody.innerHTML = '<tr><td colspan="4" class="text-center py-4 text-muted">All accounts already have valid usernames!</td></tr>';
            } else {
                tbody.innerHTML = data.preview.candidates.map(c => `
                    <tr>
                        <td><strong>${c.name}</strong></td>
                        <td class="text-muted">${c.email}</td>
                        <td><span class="badge bg-secondary">${c.currentUsername}</span></td>
                        <td><span class="un-badge-username">@${c.suggestedUsername}</span></td>
                    </tr>
                `).join('');
            }
            document.getElementById('bulkPreviewContainer').style.display = 'block';
        }
    });
}

function confirmBulkApply() {
    if (!bulkCandidatesCache.length) return;

    Swal.fire({
        title: `Apply to ${bulkCandidatesCache.length} users?`,
        text: 'Generated usernames will be assigned to these accounts.',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonText: 'Apply Generated Usernames'
    }).then(result => {
        if (!result.isConfirmed) return;

        fetch('/usernames/api/bulk-apply', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ candidates: bulkCandidatesCache })
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                Swal.fire('Completed', `Updated ${data.updated} accounts.`, 'success').then(() => {
                    location.reload();
                });
            } else {
                Swal.fire('Error', data.message, 'error');
            }
        });
    });
}

function launchConflictModal(username, userA, userB) {
    Swal.fire({
        title: `Resolve @${username} Conflict`,
        html: `Select which user retains @${username}. The other user will be assigned a new generated handle.`,
        showDenyButton: true,
        showCancelButton: true,
        confirmButtonText: 'User 1 Keeps Handle',
        denyButtonText: 'User 2 Keeps Handle'
    }).then((result) => {
        let winner = null;
        let loser = null;

        if (result.isConfirmed) {
            winner = userA;
            loser = userB;
        } else if (result.isDenied) {
            winner = userB;
            loser = userA;
        } else {
            return;
        }

        fetch('/usernames/api/resolve-conflict', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ winnerUserId: winner, loserUserId: loser })
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                Swal.fire('Conflict Resolved', `Reassigned handle to @${data.loserNewUsername}`, 'success').then(() => location.reload());
            } else {
                Swal.fire('Error', data.message, 'error');
            }
        });
    });
}
</script>
