#!/usr/bin/env node

require('dotenv').config();

const logger = require('../Helpers/logger');

// Top-level crash prevention for production
process.on('unhandledRejection', (reason) => {
  logger.error('Unhandled Promise Rejection:', reason?.stack || reason?.message || reason);
});

process.on('uncaughtException', (error) => {
  logger.error('Uncaught Exception:', error?.stack || error?.message || error);
});

/**
 * Module dependencies.
 */
var app = require('../app');
var debug = require('debug')('zeitnah:server');
var http = require('http');

/**
 * Get port from environment and store in Express.
 */
var port = normalizePort(process.env.PORT || '3000');
app.set('port', port);

/**
 * Create HTTP server.
 */
var server = http.createServer(app);

/**
 * Listen on provided port.
 */
// ── Large-upload timeout configuration ──
// The default Node.js 18+ requestTimeout is 300 s (5 min).
// A 5 GB video at 50 Mbps takes ~14 minutes just for the browser→server
// transfer, plus additional time for server→S3/VdoCipher re-upload.
// Without these overrides uploads >~3 GB are forcibly terminated.
server.requestTimeout   = 3600000;  // 1 hour — total time for the full request
server.headersTimeout   = 3660000;  // Must exceed requestTimeout (Node.js requirement)
server.keepAliveTimeout =   65000;  // Slightly above common LB idle timeout (60 s)
server.timeout          = 3600000;  // Socket inactivity timeout (mirrors requestTimeout)

server.listen(port);
server.on('error', onError);
server.on('listening', onListening);

/**
 * Normalize port
 */
function normalizePort(val) {
    const port = parseInt(val, 10);

    if (isNaN(port)) return val;
    if (port >= 0) return port;

    return false;
}

/**
 * Event listener for HTTP server "error"
 */
function onError(error) {
    if (error.syscall !== 'listen') {
        throw error;
    }

    const bind =
        typeof port === 'string'
            ? 'Pipe ' + port
            : 'Port ' + port;

    switch (error.code) {
        case 'EACCES':
            console.error(bind + ' requires elevated privileges');
            process.exit(1);
            break;

        case 'EADDRINUSE':
            console.error(bind + ' is already in use');
            process.exit(1);
            break;

        default:
            throw error;
    }
}

/**
 * Event listener for HTTP server "listening"
 */
function onListening() {
    const addr = server.address();

    const bind =
        typeof addr === 'string'
            ? 'pipe ' + addr
            : 'port ' + addr.port;

    console.log("✅ Zeitnah running on " + bind);
    debug('Listening on ' + bind);
}